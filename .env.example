# Optional deployment-owned identity. Values here override Administrator-managed branding.
# Leave a value empty to allow the Administrator value (or the RatelDesk default) to apply.
Branding__ApplicationName=Acme Service Desk
Branding__OrganizationName=Acme IT
Branding__ApplicationUrl=https://support.example.com
Branding__OrganizationUrl=https://www.example.com
Branding__SupportUrl=https://www.example.com/support
Branding__SupportEmail=support@example.com
Branding__LogoUrl=https://www.example.com/assets/logo.svg
Branding__CompactLogoUrl=https://www.example.com/assets/logo-mark.svg
Branding__FaviconUrl=https://www.example.com/favicon.ico
Branding__EmailFromDisplayName=Acme Service Desk
Branding__Tagline=Helpful service management

# Compose maps this application verbosity alias into RatelDesk__Logging__MinimumLevel.
# Per-category opt-ins use canonical container environment keys; see
# docs/deployment/application-logging.md. These values require recreation.
RATELDESK_LOG_MINIMUM_LEVEL=Warning
# Docker json-file retention: 200 MiB per file, five files including the active
# file, approximately 1 GiB combined per container. Separate from app verbosity.
RATELDESK_DOCKER_LOG_MAX_SIZE=200m
RATELDESK_DOCKER_LOG_MAX_FILE=5
