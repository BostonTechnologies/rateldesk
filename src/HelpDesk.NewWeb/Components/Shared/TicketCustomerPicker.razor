@using Helpdesk.Shared.DTOs.Customer

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<div class="ticket-customer" @onclick:stopPropagation="true">
    @if (!string.IsNullOrWhiteSpace(CustomerId))
    {
        <MudTooltip Text="@DisplayText">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="ticket-customer-chip">
                @DisplayText
            </MudChip>
        </MudTooltip>
    }
    else
    {
        <MudAutocomplete T="CustomerDto"
                         Placeholder="Select user"
                         Value="selectedCustomer"
                         ValueChanged="Assign"
                         SearchFunc="SearchCustomers"
                         ToStringFunc="@(customer => CustomerLabel(customer))"
                         Variant="Variant.Text"
                         Dense="true"
                         Clearable="false"
                         CoerceText="false"
                         ResetValueOnEmptyText="true"
                         DebounceInterval="250"
                         Disabled="@(ReadOnly || string.IsNullOrWhiteSpace(OrganizationId))"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                         Class="ticket-customer-picker">
            <ItemTemplate Context="customer">
                <MudStack Spacing="0" Class="py-1">
                    <MudText Typo="Typo.body2">@customer.Name</MudText>
                    <MudText Typo="Typo.caption">@customer.Email</MudText>
                </MudStack>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText Typo="Typo.body2" Class="px-3 py-2">
                    @(string.IsNullOrWhiteSpace(OrganizationId) ? "No customer scope." : "No matching customer users.")
                </MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
    }
</div>

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string TicketId { get; set; } = default!;
    [Parameter] public string TicketType { get; set; } = default!;
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public string? CustomerId { get; set; }
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public string? CustomerEmail { get; set; }
    [Parameter] public EventCallback<CustomerSelection> CustomerChanged { get; set; }

    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    private readonly List<CustomerDto> customers = new();
    private string? loadedOrganizationId;
    private CustomerDto? selectedCustomer;

    private string DisplayText => FirstNonEmpty(CustomerName, CustomerEmail, CustomerId) ?? "User";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(loadedOrganizationId, OrganizationId, StringComparison.Ordinal))
        {
            loadedOrganizationId = OrganizationId;
            customers.Clear();
            selectedCustomer = null;

            if (!ReadOnly && !string.IsNullOrWhiteSpace(OrganizationId) && string.IsNullOrWhiteSpace(CustomerId))
            {
                await LoadCustomersAsync();
            }
        }
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            var all = await Api.GetFromJsonAsync<List<CustomerDto>>($"api/v1/ticketing/customers?module={TicketType.TrimEnd('s')}&organizationId={Uri.EscapeDataString(OrganizationId ?? string.Empty)}") ?? new();
            customers.AddRange(all
                .Where(x => x.IsEnabled && string.Equals(x.OrganizationId, OrganizationId, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase));
        }
        catch
        {
            customers.Clear();
            Snackbar.Add("Unable to load customer users right now.", Severity.Warning);
        }
    }

    private async Task<IEnumerable<CustomerDto>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(OrganizationId))
        {
            return Enumerable.Empty<CustomerDto>();
        }

        if (customers.Count == 0)
        {
            await LoadCustomersAsync();
        }

        var term = value?.Trim();
        return string.IsNullOrWhiteSpace(term)
            ? customers.Take(20)
            : customers
                .Where(x => Contains(x.Name, term) || Contains(x.Email, term))
                .Take(20);
    }

    private async Task Assign(CustomerDto? customer)
    {
        if (customer is null)
        {
            return;
        }

        try
        {
            var response = await Api.PostAsJsonAsync(
                $"api/v1/{TicketType}/{TicketId}/customer",
                new { CustomerId = customer.Id });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await BuildErrorMessageAsync(response), Severity.Error);
                selectedCustomer = null;
                return;
            }

            CustomerId = customer.Id;
            CustomerName = customer.Name;
            CustomerEmail = customer.Email;
            await CustomerChanged.InvokeAsync(new CustomerSelection(customer.Id, customer.Name, customer.Email));
            Snackbar.Add("Ticket user updated.", Severity.Success);
        }
        catch
        {
            selectedCustomer = null;
            Snackbar.Add("Unable to update the ticket user.", Severity.Error);
        }
    }

    private static string CustomerLabel(CustomerDto? customer) =>
        customer is null ? string.Empty : FirstNonEmpty(customer.Name, customer.Email, customer.Id) ?? string.Empty;

    private static bool Contains(string? value, string term) =>
        value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private static async Task<string> BuildErrorMessageAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(body)
            ? "Unable to update the ticket user."
            : $"Unable to update the ticket user: {body}";
    }

    public sealed record CustomerSelection(string CustomerId, string? CustomerName, string? CustomerEmail);
}
