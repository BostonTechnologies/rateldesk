@using Helpdesk.Shared.ServiceIdentity
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory

<MudStack Spacing="1" data-testid="service-connection-readiness">
    @if (loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (settings is { Enabled: true, LinksEnabled: true } && settings.Readiness.Length == 0)
    { <MudText Typo="Typo.caption" Color="Color.Success">Connections enabled for this installation</MudText> }
    else if (settings is not null)
    {
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">Complete installation setup</MudText>
                @if (Locked("enabled") || Locked("linksEnabled"))
                {
                    <MudAlert Dense="true" Severity="Severity.Info">Deployment configuration locks connections. Your operator must enable ServiceIdentity:Enabled and ServiceLinks:Enabled and confirm the public web and API addresses.</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body2">Enable protected service connections using this installation's configured public addresses.</MudText>
                    @if (!ValidUrl(settings.WebBaseUrl)) { <MudTextField Label="This RatelDesk web address" @bind-Value="webUrl" Immediate="true" ReadOnly="@Locked("webBaseUrl")" Margin="Margin.Dense" Variant="Variant.Outlined" /> }
                    @if (!ValidUrl(settings.ApiBaseUrl)) { <MudTextField Label="This RatelDesk API address" @bind-Value="apiUrl" Immediate="true" ReadOnly="@Locked("apiBaseUrl")" Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Use the configured API address; it can differ from the web address." /> }
                    <MudButton OnClick="EnableAsync" Color="Color.Primary" Variant="Variant.Outlined" Disabled="@(busy || !ValidUrl(webUrl) || !ValidUrl(apiUrl))">@(busy ? "Enabling…" : "Enable connections")</MudButton>
                }
                @if (settings.Readiness.Length > 0) { <MudText Typo="Typo.caption">Setup needs: @string.Join(", ", settings.Readiness)</MudText> }
                <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Connection settings (advanced)">
                    <MudText Typo="Typo.body2">Web: @settings.WebBaseUrl · API: @settings.ApiBaseUrl</MudText>
                    <MudText Typo="Typo.body2">Issuer: @settings.Issuer · audience: @settings.Audience</MudText>
                    <MudText Typo="Typo.caption">Deployment locks: @(settings.LockedFields.Length == 0 ? "None" : string.Join(", ", settings.LockedFields)). Existing issuer and keys are preserved.</MudText>
                </MudExpansionPanel></MudExpansionPanels>
            </MudStack>
        </MudPaper>
    }
    @if (error is not null) { <MudAlert Severity="Severity.Warning" Dense="true">@error <MudButton Size="Size.Small" Disabled="busy" OnClick="LoadAsync">Retry</MudButton></MudAlert> }
</MudStack>

@code {
    [Parameter] public EventCallback<bool> ReadyChanged { get; set; }
    private ServicePublicSettingsDto? settings;
    private string webUrl = "", apiUrl = "";
    private string? error;
    private bool loading = true, busy;
    private bool Locked(string field) => settings?.LockedFields.Contains(field, StringComparer.OrdinalIgnoreCase) == true;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try
        {
            settings = await HttpClientFactory.CreateClient("HelpdeskApi").GetFromJsonAsync<ServicePublicSettingsDto>("api/v1/admin/service-clients/public-settings");
            webUrl = settings?.WebBaseUrl ?? ""; apiUrl = settings?.ApiBaseUrl ?? "";
            await ReadyChanged.InvokeAsync(settings is { Enabled: true, LinksEnabled: true } && settings.Readiness.Length == 0);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        { settings = null; error = "Installation readiness is unavailable or your account cannot manage it. An installation administrator can enable connections in this step."; await ReadyChanged.InvokeAsync(false); }
        finally { loading = false; }
    }
    private async Task EnableAsync()
    {
        if (settings is null || busy || Locked("enabled") || Locked("linksEnabled")) return;
        busy = true; error = null;
        try
        {
            var issuer = string.IsNullOrWhiteSpace(settings.Issuer) ? apiUrl.TrimEnd('/') + "/services" : settings.Issuer;
            using var response = await HttpClientFactory.CreateClient("ServiceLinkApi").PutAsJsonAsync("api/v1/admin/service-clients/public-settings",
                new ServicePublicSettingsUpdate(settings.Revision, true, webUrl.Trim(), apiUrl.Trim(), issuer, settings.Audience));
            if (!response.IsSuccessStatusCode) { error = "Setup could not be confirmed. Retry to review the current revision and deployment locks."; return; }
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        { error = "Setup could not be confirmed. Retry to review the stored settings before enabling again."; }
        finally { busy = false; }
    }
    private static bool ValidUrl(string value) => Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" && string.IsNullOrEmpty(uri.UserInfo) && string.IsNullOrEmpty(uri.Query) && string.IsNullOrEmpty(uri.Fragment);
}
