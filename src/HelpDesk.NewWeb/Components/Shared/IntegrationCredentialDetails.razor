@using System.Net
@using System.Text.Json
@using Helpdesk.Shared.Auth
@using Helpdesk.Shared.DTOs.Auth
@implements IDisposable
@inject IHttpClientFactory Clients

<CredentialReviewSurface Title="@($"Integration credential: {Credential.Name}")" Wide="true" OpenerId="@($"credential-details-{Credential.Id:N}")" OnClose="RequestClose">
    <header class="credential-heading">
        <span class="credential-key"><MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Large" /></span>
        <div class="credential-heading-text">
            <p class="credential-eyebrow">Integration credential</p>
            <h2>@Credential.Name</h2>
            <div class="credential-badges">
                <span class="credential-badge @(Status == "Active" ? "credential-active" : "")">@Status</span>
                <span class="credential-badge">@PurposeLabel</span>
            </div>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="RequestClose" Disabled="@working" aria-label="Close credential details" />
    </header>

    <div class="review-body credential-details-body">
        @if (error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@error</MudAlert> }
        @if (notice is not null) { <p class="credential-notice" role="status">@notice</p> }
        @if (confirmDiscard)
        {
            <div class="credential-discard" role="alert">
                <p>Your permission draft has not been applied. Discard it and close?</p>
                <MudButton OnClick="KeepEditing" Size="Size.Small" Disabled="@working">Keep editing</MudButton>
                <MudButton OnClick="DiscardAndClose" Size="Size.Small" Color="Color.Error" Disabled="@working">Discard draft</MudButton>
            </div>
        }

        <section class="credential-metadata" aria-label="Credential connection and lifetime">
            <div class="credential-resource">
                <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Primary" />
                <div><span class="credential-label">@(Credential.McpResourceUri is null ? "Connection" : "HTTP MCP server")</span><strong>@(Credential.McpResourceUri ?? "RatelDesk API / CLI / stdio MCP")</strong></div>
            </div>
            <dl class="credential-facts">
                <div><dt>Created</dt><dd>@UtcDate(Credential.CreatedAtUtc)</dd></div>
                <div><dt>Exact expiry (UTC)</dt><dd><code>@Credential.ExpiresAtUtc.UtcDateTime.ToString("O")</code></dd></div>
                <div><dt>Last used</dt><dd>@(Credential.LastUsedAtUtc is { } used ? UtcDate(used) : "Never")</dd></div>
                <div><dt>Credential prefix</dt><dd><code>@Credential.Prefix</code></dd></div>
                @if (RevokedAtUtc is { } revoked) { <div><dt>Revoked</dt><dd>@UtcDate(revoked)</dd></div> }
                <div><dt>Organization</dt><dd>@OrganizationName</dd></div>
            </dl>
        </section>

        <section class="credential-access" aria-labelledby="credential-access-title">
            <div class="credential-section-heading">
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
                <div><h3 id="credential-access-title">Configured access</h3><p>@Permissions.Count @(Permissions.Count == 1 ? "permission" : "permissions") · @OrganizationName</p></div>
                @if (!editing && access?.CanEdit == true)
                { <MudButton OnClick="StartEditing" Disabled="@(working || loading)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" data-testid="credential-edit-access">Edit access</MudButton> }
            </div>
            @if (editing)
            {
                <div class="credential-editor" data-testid="credential-access-editor">
                    <p>Edit permissions for <strong>@OrganizationName</strong>. The same credential and secret stay connected, with their existing expiry.</p>
                    <CredentialPermissionSelector EligiblePermissions="@(access?.AvailablePermissions ?? [])" SelectedValues="@draftPermissions" SelectedValuesChanged="ChangePermissions" Disabled="@(working || review is not null)" />
                    @if (UnavailableDraftPermissions.Count > 0)
                    {
                        <div class="credential-unavailable">
                            <strong>Saved permissions outside your current authority</strong>
                            <p>These remain in your draft. Remove them explicitly or restore your account's authority before applying.</p>
                            @foreach (var permission in UnavailableDraftPermissions)
                            {
                                <div class="credential-unavailable-row"><code>@permission</code><MudButton Size="Size.Small" OnClick="() => RemoveUnavailable(permission)" Disabled="@(working || review is not null)">Remove</MudButton></div>
                            }
                        </div>
                    }
                    @if (review is not null)
                    {
                        <section class="credential-change-review" aria-label="Review permission changes" data-testid="credential-access-review">
                            <h4>Review changes</h4>
                            <div class="credential-change-columns">
                                <div><strong>Add (@review.AddedPermissions.Count)</strong><ul>@foreach (var permission in review.AddedPermissions) { <li>@permission</li> }</ul>@if (review.AddedPermissions.Count == 0) { <p>None</p> }</div>
                                <div><strong>Remove (@review.RemovedPermissions.Count)</strong><ul>@foreach (var permission in review.RemovedPermissions) { <li>@permission</li> }</ul>@if (review.RemovedPermissions.Count == 0) { <p>None</p> }</div>
                            </div>
                            <p>@review.Permissions.Count permissions after applying. Organization, purpose, resource, secret and exact expiry stay the same.</p>
                            <label class="credential-consent"><input type="checkbox" @bind="consent" disabled="@working" /> I approve these exact permission changes.</label>
                            <p class="credential-review-expiry">Review valid until @review.ExpiresAtUtc.UtcDateTime.ToString("HH:mm:ss 'UTC'").</p>
                        </section>
                    }
                </div>
            }
            else
            {
                <details class="credential-grant-group" open>
                    <summary><MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" /><strong>@OrganizationName</strong><span>@Permissions.Count @(Permissions.Count == 1 ? "permission" : "permissions")</span></summary>
                    @foreach (var group in Permissions.GroupBy(p => p.Split('.')[0]).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <div class="credential-permission-group"><h4>@group.Key</h4><div>@foreach (var permission in group.Order(StringComparer.OrdinalIgnoreCase)) { <span class="credential-permission">@permission</span> }</div></div>
                    }
                </details>
                @if (access?.EditUnavailableReason is { } reason) { <p class="credential-edit-reason">@reason</p> }
            }
        </section>

        <section class="credential-admission" aria-labelledby="credential-admission-title">
            <div class="credential-section-heading">
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" />
                <div><h3 id="credential-admission-title">Current admission</h3><p>Configured grants, current account authority and MCP policies.</p></div>
                <MudButton OnClick="RefreshAccess" Disabled="@(loading || working)" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh">Refresh admission</MudButton>
            </div>
            @if (loading) { <MudProgressLinear Indeterminate="true" aria-label="Loading current access" /> }
            else if (access is not null)
            {
                <div class="credential-admission-card">
                    <div><strong>Account authority</strong><p>@(Credential.Purpose == IntegrationCredentialGrantKinds.OwnerAdministrationPurpose && access.PolicyState != "None" ? $"{access.EffectivePermissions.Count} permissions admitted by the owner authority and this credential's policy." : $"{access.EffectivePermissions.Count} of {access.Permissions.Count} configured permissions currently available.")</p></div>
                    @if (access.DeniedPermissions.Count > 0) { <div><strong>Currently unavailable</strong><p>@string.Join(", ", access.DeniedPermissions)</p></div> }
                    <div><strong>MCP operation policies</strong><p>@access.PolicySummary</p></div>
                </div>
            }
            else { <p>Current admission is unavailable. Refresh to check your account's authority before editing.</p> }
        </section>
    </div>
    <footer class="credential-footer">
        <p><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> The secret was shown once and cannot be recovered.</p>
        <div class="credential-footer-actions">
            @if (editing)
            {
                <MudButton OnClick="CancelEditing" Disabled="@working">Cancel edit</MudButton>
                @if (refreshRequired)
                { <MudButton OnClick="RefreshAccess" Disabled="@(working || loading)" Variant="Variant.Filled" Color="Color.Primary">Refresh current access</MudButton> }
                else if (review is null)
                { <MudButton OnClick="ReviewChanges" Disabled="@(working || loading || draftPermissions.Count == 0 || !DraftChanged || access?.CanEdit != true)" Variant="Variant.Filled" Color="Color.Primary">@(working ? "Reviewing…" : "Review changes")</MudButton> }
                else
                {
                    <MudButton OnClick="BackToEditing" Disabled="@working">Back to editing</MudButton>
                    <MudButton OnClick="ApplyChanges" Disabled="@(working || !consent)" Variant="Variant.Filled" Color="Color.Primary">@(working ? "Applying…" : "Apply access changes")</MudButton>
                }
            }
            else { <MudButton OnClick="RequestClose" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton> }
        </div>
    </footer>
</CredentialReviewSurface>

@code {
    [Parameter, EditorRequired] public CredentialDetailsModel Credential { get; set; } = default!;
    [Parameter] public EventCallback<IntegrationCredentialAccessDetails> OnAccessChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private IntegrationCredentialAccessDetails? access;
    private IntegrationCredentialAccessReview? review;
    private HashSet<string> draftPermissions = new(StringComparer.OrdinalIgnoreCase);
    private bool loading, working, editing, consent, refreshRequired, confirmDiscard;
    private string? error, notice;
    private string Path => $"api/v1/integration-credentials/{Credential.Id:N}/access";
    private DateTimeOffset? RevokedAtUtc => access?.RevokedAtUtc ?? Credential.RevokedAtUtc;
    private string Status => RevokedAtUtc is not null ? "Revoked" : Credential.ExpiresAtUtc <= DateTimeOffset.UtcNow ? "Expired" : "Active";
    private string PurposeLabel => Credential.Purpose switch { "mcp" => "HTTP MCP", IntegrationCredentialGrantKinds.OwnerAdministrationPurpose => "HTTP MCP owner administration", "mcp-setup" => "Temporary verification", _ => "API / CLI / stdio MCP" };
    private string OrganizationName => access?.OrganizationName ?? Credential.OrganizationName;
    private IReadOnlyList<string> Permissions => access?.Permissions ?? Credential.Permissions;
    private IReadOnlyList<string> UnavailableDraftPermissions => draftPermissions.Except(access?.AvailablePermissions ?? [], StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
    private bool DraftChanged => !draftPermissions.SetEquals(Permissions);
    private static string UtcDate(DateTimeOffset value) => value.UtcDateTime.ToString("dd MMM yyyy · HH:mm 'UTC'");
    protected override Task OnInitializedAsync() => RefreshAccess();

    private async Task RefreshAccess()
    {
        if (loading || working) return;
        loading = true; error = null; review = null; consent = false;
        try
        {
            using var response = await Clients.CreateClient("HelpdeskApi").GetAsync(Path, lifetime.Token);
            if (!response.IsSuccessStatusCode) { error = await Failure(response); return; }
            access = await response.Content.ReadFromJsonAsync<IntegrationCredentialAccessDetails>(lifetime.Token)
                ?? throw new JsonException("Missing access result.");
            refreshRequired = false;
            await OnAccessChanged.InvokeAsync(access);
            if (editing) notice = DraftChanged ? "Current access refreshed. Your draft is preserved; review the changes again." : "Your draft matches the currently saved permissions.";
        }
        catch (Exception e) when (e is HttpRequestException or OperationCanceledException or JsonException)
        { if (!lifetime.IsCancellationRequested) error = "Current access could not be loaded. Check your connection and refresh; your draft is preserved."; }
        finally { loading = false; }
    }

    private async Task StartEditing()
    {
        if (loading || working || editing) return;
        await RefreshAccess();
        if (error is not null || access?.CanEdit != true) return;
        draftPermissions = access.Permissions.ToHashSet(StringComparer.OrdinalIgnoreCase);
        editing = true; notice = null; review = null; consent = false;
    }

    private void ChangePermissions(IEnumerable<string> values)
    {
        if (working || review is not null) return;
        // Lost authority must not silently discard saved grants when another checkbox changes.
        draftPermissions = values.Concat(UnavailableDraftPermissions).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }
    private void RemoveUnavailable(string permission) { if (!working && review is null) draftPermissions.Remove(permission); }
    private void BackToEditing() { if (working) return; review = null; consent = false; }
    private void CancelEditing()
    {
        if (working) return;
        editing = false; review = null; consent = false; refreshRequired = false; confirmDiscard = false; error = notice = null;
        draftPermissions.Clear();
    }

    private async Task ReviewChanges()
    {
        if (working || access?.CanEdit != true || !DraftChanged || refreshRequired) return;
        working = true; error = notice = null; consent = false; confirmDiscard = false;
        try
        {
            using var response = await Clients.CreateClient("SystemPairingApi").PostAsJsonAsync(Path + "/review",
                new IntegrationCredentialAccessDraft(draftPermissions.Order(StringComparer.OrdinalIgnoreCase).ToArray(), access.Version), lifetime.Token);
            if (!response.IsSuccessStatusCode) { error = await Failure(response); refreshRequired = response.StatusCode == HttpStatusCode.Conflict; return; }
            review = await response.Content.ReadFromJsonAsync<IntegrationCredentialAccessReview>(lifetime.Token)
                ?? throw new JsonException("Missing review result.");
        }
        catch (Exception e) when (e is HttpRequestException or OperationCanceledException or JsonException)
        { if (!lifetime.IsCancellationRequested) error = "The review could not be loaded. Your draft is preserved; retry when connected."; }
        finally { working = false; }
    }

    private async Task ApplyChanges()
    {
        if (working || review is null || !consent || refreshRequired) return;
        working = true; error = notice = null; confirmDiscard = false;
        try
        {
            using var response = await Clients.CreateClient("SystemPairingApi").PostAsJsonAsync(Path + "/apply",
                new ApplyIntegrationCredentialAccess(review.Confirmation, true), lifetime.Token);
            if (!response.IsSuccessStatusCode)
            {
                error = await Failure(response);
                refreshRequired = response.StatusCode == HttpStatusCode.Conflict || (int)response.StatusCode >= 500;
                review = null; consent = false;
                return;
            }
            access = await response.Content.ReadFromJsonAsync<IntegrationCredentialAccessDetails>(lifetime.Token)
                ?? throw new JsonException("Missing applied result.");
            editing = false; review = null; consent = false; draftPermissions.Clear();
            await OnAccessChanged.InvokeAsync(access);
            notice = "Access updated. The existing credential, secret and exact expiry are unchanged.";
        }
        catch (Exception e) when (e is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (!lifetime.IsCancellationRequested) error = "The save result could not be confirmed. Your draft is preserved. Refresh current access before reviewing another change.";
            refreshRequired = true; review = null; consent = false;
        }
        finally { working = false; }
    }

    private static async Task<string> Failure(HttpResponseMessage response)
    {
        if (response.StatusCode == HttpStatusCode.Unauthorized) return "Sign in again to manage this credential. Your draft is preserved.";
        if (response.StatusCode == HttpStatusCode.Forbidden) return "Your current account cannot grant this access. Check its organization permissions, then refresh admission. Your draft is preserved.";
        if (response.StatusCode == HttpStatusCode.NotFound) return "This credential is no longer available to your account.";
        if ((int)response.StatusCode >= 500) return "The service could not confirm this operation. Refresh current access; your draft is preserved.";
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<AccessProblem>();
            var detail = problem?.Detail ?? problem?.Message ?? problem?.Errors?.SelectMany(item => item.Value).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(detail) && detail.Length <= 800) return detail + " Your draft is preserved.";
        }
        catch (JsonException) { /* Some gateways return a plain error response. */ }
        return "The change was rejected. Refresh current access and review your permissions again. Your draft is preserved.";
    }

    private Task RequestClose()
    {
        if (working) return Task.CompletedTask;
        if (editing && DraftChanged) { confirmDiscard = true; return Task.CompletedTask; }
        return OnClose.InvokeAsync();
    }
    private void KeepEditing() => confirmDiscard = false;
    private Task DiscardAndClose() => working ? Task.CompletedTask : OnClose.InvokeAsync();
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
    private sealed record AccessProblem(string? Detail, Dictionary<string, string[]>? Errors, string? Message);
}
