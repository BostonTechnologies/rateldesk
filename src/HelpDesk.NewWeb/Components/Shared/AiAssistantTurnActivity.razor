@using HelpDesk.NewWeb.Services
@using Helpdesk.Shared.AiAssistant.Chat
@using System.Text.Json

<section class="ai-assistant-activity" data-testid="ai-assistant-activity">
    <button type="button" class="activity-heading" aria-expanded="@expanded.ToString().ToLowerInvariant()" @onclick="Toggle">
        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
        <span>Activity · @Turn.Summary</span>
        @if (HasPendingApproval)
        {
            <span class="approval-heading-status">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                <span>Approval required</span>
            </span>
        }
        @if (!Turn.Completed && State is ChatState.Processing or ChatState.WaitingForChildren)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>@(State == ChatState.WaitingForChildren ? "Waiting for delegated follow-ups…" : "Working…")</span>
        }
    </button>
    @if (Preferences.ShowSubagents && (Turn.Children.Count > 0 || Unassociated.Any()))
    {
        <details class="child-panel">
            <summary>Agents · @Turn.Children.Count identified</summary>
            @foreach (var card in Turn.Children.Values)
            {
                <details class="child-card" @key="card.Id">
                    <summary>@(card.Name ?? card.Id) · @(card.State ?? "State unknown")</summary>
                    <small>Run @card.Id</small>
                    @if (card.DurationMs is { } elapsed) { <span>@elapsed ms</span> }
                    @if (card.Summary is { } summary) { <p>@summary</p> }
                    @foreach (var poll in Turn.Operations.Where(x => x.Result is { } result && card.PollResults.Contains(result.Sequence)))
                    {
                        <AiAssistantToolActivity @key="poll.Sequence" Operation="poll" Preferences="Preferences" TurnEnded="Turn.Completed" />
                    }
                    @foreach (var diagnostic in card.Diagnostics)
                    {
                        <AiAssistantCode Text="@(diagnostic.MetadataJson ?? diagnostic.Text)" Label="Observation details" />
                    }
                </details>
            }
            @foreach (var observation in Unassociated)
            {
                var trace = ChatOperation.Read(observation.MetadataJson);
                <details class="child-card">
                    <summary>@(trace?.Child?.Name ?? trace?.DisplayName ?? "Agent") · @(trace?.Child?.State ?? "State unknown") · Run ID unavailable</summary>
                    <AiAssistantCode Text="@(observation.MetadataJson ?? observation.Text)" Label="Observation details" />
                </details>
            }
        </details>
    }
    @foreach (var operation in Turn.Operations.Where(ShowOperation))
    {
        <AiAssistantToolActivity @key="operation.Sequence" Operation="operation" Preferences="Preferences" TurnEnded="Turn.Completed"
                                 AwaitingApproval="@Turn.Activity.Any(item => item.CallId == operation.CallId && IsPendingApproval(item))" />
    }
    @if (expanded || HasPendingApproval || Turn.HasError)
    {
        @foreach (var completion in Turn.NativeTurns.Where(x => x.QuietEnd || x.TurnOutcome is "failed" or "skipped"))
        {
            <div class="activity-interaction" role="status" data-testid="ai-assistant-turn-outcome">
                <MudText>@(completion.TurnOutcome == "failed" ? "Assistant turn failed."
                    : completion.QuietEnd ? "Assistant deliberately ended this turn without a reply." : "Assistant skipped this turn.")</MudText>
            </div>
        }
        @foreach (var item in Turn.Activity)
        {
            if (item.Type == "usage" && !Preferences.ShowUsage || item.Type == "processing_state" && !Preferences.ShowProcessing
                || item.Type == "compaction" && !Preferences.ShowCompaction || item.Type == "subagent") { continue; }
            var isPendingApproval = IsPendingApproval(item);
            <div class="@(isPendingApproval ? "activity-interaction approval-callout" : "activity-interaction")"
                 data-testid="@(isPendingApproval ? "ai-assistant-approval" : null)">
                @if (isPendingApproval)
                {
                    <div class="approval-status" role="status" aria-live="polite">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">Approval required</MudText>
                    </div>
                }
                <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere">@item.Text</MudText>
                @if (ChatOperation.Read(item.MetadataJson)?.Details?.Measures is { } measures) { <AiAssistantCode Text="@measures" Label="Recorded measures" /> }
                @if (isPendingApproval)
                {
                    <div class="approval-actions">
                        @foreach (var option in JsonSerializer.Deserialize<List<ChatOption>>(item.OptionsJson ?? "[]") ?? [])
                        {
                            <MudButton Class="approval-action"
                                       Color="@ApprovalColor(option.Key)"
                                       Variant="@ApprovalVariant(option.Key)"
                                       StartIcon="@ApprovalIcon(option.Key)"
                                       Disabled="Busy"
                                       data-approval-key="@option.Key"
                                       OnClick="@(() => Approval.InvokeAsync((item.CallId!, option.Key)))">@option.Label</MudButton>
                        }
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public ChatTurn Turn { get; set; } = null!;
    [Parameter] public ChatDisplayPreferences Preferences { get; set; } = new();
    [Parameter] public ChatState State { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(string CallId, string Key)> Approval { get; set; }
    private IEnumerable<AiAssistantChatEvent> Unassociated => Turn.Activity.Where(item => item.Type == "subagent"
        && ChatOperation.Read(item.MetadataJson)?.ProviderEvent?.SubagentId is null
        && ChatOperation.Read(item.MetadataJson)?.Child?.RunId is null);
    private bool ShowOperation(ChatOperation operation) => !Preferences.ShowSubagents || operation.Result is null
        || operation.Metadata?.Outcome == "failed"
        || !Turn.Children.Values.Any(card => card.PollResults.Contains(operation.Result.Sequence));
    private bool expanded, initialized, completed;
    protected override void OnParametersSet()
    {
        if (!initialized || completed != Turn.Completed) expanded = Turn.InitiallyExpanded;
        if (Turn.HasError || Turn.NativeTurns.Any(x => x.QuietEnd || x.TurnOutcome == "skipped")
            || (Turn.HasPendingApproval && State != ChatState.Archived)) expanded = true;
        completed = Turn.Completed; initialized = true;
    }
    private void Toggle() => expanded = !expanded;
    private bool HasPendingApproval => Turn.Activity.Any(IsPendingApproval);
    private bool IsPendingApproval(AiAssistantChatEvent item) => item.Type == "approval_request"
        && State == ChatState.AwaitingApproval
        && !Turn.Activity.Any(x => x.Type is ("approval_response" or "approval_closed") && x.CallId == item.CallId);
    private static Color ApprovalColor(string key) => key == "deny" ? Color.Error : Color.Primary;
    private static Variant ApprovalVariant(string key) => key == "deny" ? Variant.Outlined : Variant.Filled;
    private static string ApprovalIcon(string key) => key == "deny"
        ? Icons.Material.Filled.Block
        : Icons.Material.Filled.CheckCircle;
    private static string Icon(ChatActivityMetadata? metadata) => metadata?.Outcome == "failed" ? Icons.Material.Filled.ErrorOutline
        : metadata?.ToolKind switch
        {
            "skill" => Icons.Material.Filled.MenuBook,
            "mcp" => Icons.Material.Filled.Hub,
            "discovery" => Icons.Material.Filled.Search,
            _ => Icons.Material.Filled.Build
        };
}
