@using HelpDesk.NewWeb.Models
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<MudStack Spacing="2" data-testid="netratel-m2m-form">
    <MudText Typo="Typo.subtitle1">NetRatel M2M</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Create an organization-owned service connection with explicit customer grants.</MudText>
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
        <MudButton Size="Size.Small" Variant="@(manual ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" OnClick="ShowGuided" Disabled="@(busy || loading || reveal is not null)" data-testid="netratel-guided-mode">Link NetRatel</MudButton>
        @if (AllowManualCreation)
        {
            <MudButton Size="Size.Small" Variant="@(manual ? Variant.Filled : Variant.Outlined)" OnClick="ShowManual" Disabled="@(busy || loading || reveal is not null)" data-testid="netratel-manual-mode">Manual credentials</MudButton>
        }
    </MudStack>
    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Dense="true" Severity="Severity.Error">@error</MudAlert>
    }
    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (reveal is { } visibleReveal)
    {
        <MudAlert @key="visibleReveal" Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" data-testid="netratel-secret-reveal">
            <MudText Typo="Typo.subtitle2">Save this new client secret now</MudText>
            <MudText Typo="Typo.body2">This is its only display. Store it in your secret manager before leaving this screen.</MudText>
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="6"><MudTextField Value="@reveal.Client.ClientId" Label="Client ID" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Value="@reveal.ClientSecret" Label="New client secret" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Value="@reveal.Issuer" Label="Issuer / authority" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Value="@reveal.TokenEndpoint" Label="Token endpoint" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Value="@reveal.Audience" Label="Audience" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Value="@string.Join(" ", reveal.Scopes)" Label="Approved scopes" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField Value="@reveal.DockerEnvironmentExample" Label="Docker environment example" ReadOnly="true" Lines="7" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => ClearReveal(visibleReveal))">I have saved it</MudButton>
        </MudAlert>
    }
    else
    {
        @if (!manual && DeploymentManaged)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">The outbound profile belongs to deployment configuration. Automated linking cannot replace it. Use Manual credentials and the advanced outbound settings to configure the approved values in your deployment.</MudAlert>
        }
        @if (!manual && LinkManaged)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">The outbound profile belongs to an approved reciprocal link. Use its recovery or disconnect actions below before approving a changed destination or grant.</MudAlert>
        }
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Value="@organizationId" ValueChanged="OrganizationChanged" Label="Local organization" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" data-testid="netratel-local-organization">
                    @foreach (var organization in organizations)
                    {
                        <MudSelectItem Value="@organization.Id">@organization.Name (@organization.Id)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Approved incident customer" Value="@customerIds.FirstOrDefault()" ValueChanged="CustomerChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="@string.IsNullOrEmpty(organizationId)">
                    @foreach (var customer in customers.Where(customer => customer.OrganizationId == organizationId && customer.IsEnabled))
                    {
                        <MudSelectItem Value="@customer.Id">@customer.Name (@customer.Id)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="NetRatel → RatelDesk permissions" MultiSelection="true" MultiSelectionTextFunc="SelectedScopeText" SelectedValues="@scopes" SelectedValuesChanged="ScopesChanged" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var scope in InboundScopes)
                    {
                        <MudSelectItem Value="@scope.Key">@scope.Value</MudSelectItem>
                    }
                </MudSelect>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                    @foreach (var scope in scopes.Order(StringComparer.Ordinal))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@ScopeLabel(scope)</MudChip>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
        @if (manual)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="name" Label="Service name" Required="true" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="peerInstanceId" Label="Verified NetRatel instance ID" Required="true" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="peerTenantId" Label="Approved NetRatel tenant ID" Required="true" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="sourceInstanceId" Label="NetRatel Flow source instance ID" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Use NetRatel's persisted producer GUID for incident access." /></MudItem>
                @if (scopes.Contains("rateldesk.orchestration.callback"))
                {
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="callbackRequestIds" Label="Approved callback request IDs" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Comma-separated IDs of actual recorded RatelDesk requests." /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="callbackTaskIds" Label="Approved callback task IDs" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Comma-separated IDs of their recorded orchestration tasks." /></MudItem>
                }
            </MudGrid>
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">This creates only the inbound NetRatel service client. Configure the separate outbound NetRatel-issued client in <MudLink Href="/admin/automation/integration/orchestrator">NetRatel orchestrator</MudLink>.</MudAlert>
            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateManualAsync" Disabled="@(busy || !CanCreateManual)">@(busy ? "Creating…" : "Create and reveal service client")</MudButton>
        }
        else
        {
            <form method="post" action="/account/integration-credentials/link/start" data-enhance="false" data-testid="netratel-link-start">
                <AntiforgeryToken />
                <input type="hidden" name="localTenantId" value="@organizationId" />
                @foreach (var customerId in customerIds.Order(StringComparer.Ordinal))
                {
                    <input type="hidden" name="customerIds" value="@customerId" />
                }
                @foreach (var scope in scopes.Order(StringComparer.Ordinal))
                {
                    <input type="hidden" name="inboundScopes" value="@scope" />
                }
                <input type="hidden" name="outboundScopes" value="netratel.orchestration.read" />
                @if (outboundInvoke)
                {
                    <input type="hidden" name="outboundScopes" value="netratel.orchestration.invoke" />
                }
                <MudCheckBox T="bool" @bind-Value="outboundInvoke" Label="Allow RatelDesk to invoke NetRatel orchestration tasks" Dense="true" />
                @if (outboundInvoke && !scopes.Contains("rateldesk.orchestration.callback"))
                {
                    <MudAlert Dense="true" Severity="Severity.Info">Task invocation requires the reverse task callback permission so recorded executions can complete. Enable Task callbacks or choose read-only orchestration access.</MudAlert>
                }
                <MudTextField @bind-Value="peerWebBaseUrl" name="peerWebBaseUrl" Label="NetRatel Web base URL" Required="true" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="https://netratel.example.com" />
                <MudTextField @bind-Value="requestedPeerTenantId" name="requestedResponderTenantId" Label="Requested NetRatel tenant ID (optional)" Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="The NetRatel administrator selects its authorized tenant. You will review that exact selection before final approval." />
                <MudText Typo="Typo.caption" HtmlTag="p" Class="mt-2">Discovery → NetRatel administrator approval → review both grants → your final approval → authenticated checks in both directions.</MudText>
                <MudButton Class="mt-2" ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || loading || reveal is not null || DeploymentManaged || LinkManaged || !CanStart)">Continue to NetRatel</MudButton>
            </form>
        }
    }
    <NetRatelServiceLinks />
    @if (AllowManualCreation)
    {
        <MudExpansionPanels Dense="true">
            <MudExpansionPanel Text="Service clients and rotation">
                <MudButton Size="Size.Small" OnClick="RefreshClientsAsync" Disabled="@(busy || loading)">Refresh clients</MudButton>
                <MudTable Items="@clients" Dense="true" Breakpoint="Breakpoint.Sm" data-testid="netratel-service-client-list">
                    <HeaderContent><MudTh>Client</MudTh><MudTh>Approved boundary</MudTh><MudTh>Status / source</MudTh><MudTh>Actions</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Client"><MudText Typo="Typo.body2">@context.Name</MudText><MudText Typo="Typo.caption">@context.ClientId</MudText></MudTd>
                        <MudTd DataLabel="Approved boundary"><MudText Typo="Typo.body2">Organization @context.OrganizationId · peer tenant @context.PeerTenantId</MudText><MudText Typo="Typo.caption">@string.Join(", ", context.Scopes)</MudText></MudTd>
                        <MudTd DataLabel="Status / source">@context.Status · @context.Source · credential @context.CredentialRevision</MudTd>
                        <MudTd DataLabel="Actions">
                            @if (context.ReadOnly)
                            {
                                <MudChip T="string" Size="Size.Small">Deployment read-only</MudChip>
                            }
                            else if (context.LinkId is not null)
                            {
                                <MudText Typo="Typo.caption">Managed by reciprocal link. Use its coordinated rotation/disconnect actions above.</MudText>
                            }
                            else if (context.Status != "revoked")
                            {
                                @if (pendingActionClient == context.Id)
                                {
                                    <MudText Typo="Typo.caption">@(pendingAction == "revoke" ? "Immediately revoke this inbound service?" : "Rotate this manual credential? Save its replacement before updating NetRatel.")</MudText>
                                    <MudButton Size="Size.Small" OnClick="CancelPendingAction" Disabled="@busy">Cancel</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Warning" Disabled="@busy" OnClick="() => ClientActionAsync(context)">Confirm</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Disabled="@busy" OnClick='@(() => PrepareClientAction(context.Id, "rotate"))'>Rotate</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Error" Disabled="@busy" OnClick='@(() => PrepareClientAction(context.Id, "revoke"))'>Revoke</MudButton>
                                }
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
</MudStack>

@code {
    [Parameter] public bool AllowManualCreation { get; set; } = true;
    [Parameter] public bool DeploymentManaged { get; set; }
    [Parameter] public bool LinkManaged { get; set; }
    [Parameter] public string? InitialPeerWebBaseUrl { get; set; }
    [Parameter] public string? InitialLocalOrganizationId { get; set; }
    [Parameter] public string? InitialLocalCustomerId { get; set; }
    [Parameter] public string? InitialPeerTenantId { get; set; }
    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    private HttpClient MutationApi => HttpClientFactory.CreateClient("ServiceLinkApi");
    private static readonly IReadOnlyDictionary<string, string> InboundScopes = new Dictionary<string, string>
    {
        ["rateldesk.incidents.create"] = "Create incidents for the selected customers",
        ["rateldesk.incident-receipts.read"] = "Read source capabilities and incident receipts",
        ["rateldesk.incident-targets.read"] = "Validate approved incident targets",
        ["rateldesk.orchestration.callback"] = "Report correlated orchestration task results"
    };
    private List<OrganizationDto> organizations = [];
    private List<CustomerDto> customers = [];
    private List<NetRatelServiceClientMetadata> clients = [];
    private HashSet<string> customerIds = new(StringComparer.Ordinal);
    private HashSet<string> scopes = new(InboundScopes.Keys, StringComparer.Ordinal);
    private NetRatelServiceClientReveal? reveal;
    private string organizationId = string.Empty, name = string.Empty, peerInstanceId = string.Empty, peerTenantId = string.Empty;
    private string sourceInstanceId = string.Empty, peerWebBaseUrl = string.Empty, requestedPeerTenantId = string.Empty;
    private string callbackRequestIds = string.Empty, callbackTaskIds = string.Empty;
    private string? error, pendingAction;
    private Guid? pendingActionClient;
    private bool manual, busy, disposed, loading = true, outboundInvoke = true;
    private bool NeedsSource => scopes.Any(scope => scope.StartsWith("rateldesk.incident", StringComparison.Ordinal));
    private bool HasMapping => !string.IsNullOrWhiteSpace(organizationId) && scopes.Count > 0 && (!NeedsSource || customerIds.Count > 0);
    private bool CanStart => HasMapping && (!outboundInvoke || scopes.Contains("rateldesk.orchestration.callback")) && Uri.TryCreate(peerWebBaseUrl, UriKind.Absolute, out _);
    private bool CanCreateManual => HasMapping && !string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(peerInstanceId) && !string.IsNullOrWhiteSpace(peerTenantId) && (!NeedsSource || Guid.TryParse(sourceInstanceId, out _))
        && (!scopes.Contains("rateldesk.orchestration.callback") || (ParseIds(callbackRequestIds).Length > 0 && ParseIds(callbackTaskIds).Length > 0));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var organizationTask = Api.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations");
            var customerTask = Api.GetFromJsonAsync<List<CustomerDto>>("api/v1/customers");
            await Task.WhenAll(organizationTask, customerTask);
            organizations = (organizationTask.Result ?? []).Where(organization => organization.IsEnabled).OrderBy(organization => organization.Name, StringComparer.Ordinal).ToList();
            customers = customerTask.Result ?? [];
            if (Uri.TryCreate(InitialPeerWebBaseUrl, UriKind.Absolute, out var initialPeer) && initialPeer.Scheme is "https" or "http")
                peerWebBaseUrl = initialPeer.AbsoluteUri;
            requestedPeerTenantId = InitialPeerTenantId ?? "";
            if (organizations.Any(organization => organization.Id == InitialLocalOrganizationId))
            {
                organizationId = InitialLocalOrganizationId!;
                if (customers.Any(customer => customer.Id == InitialLocalCustomerId && customer.OrganizationId == organizationId && customer.IsEnabled))
                    customerIds.Add(InitialLocalCustomerId!);
            }
            if (AllowManualCreation) await ReloadClientsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            error = "The authorized organizations and service clients could not be loaded. Refresh to retry.";
        }
        finally { loading = false; }
    }
    private void ShowGuided() { if (disposed || busy || loading || reveal is not null) return; manual = false; scopes = new HashSet<string>(scopes, StringComparer.Ordinal) { "rateldesk.orchestration.callback" }; error = null; }
    private void ShowManual() { if (disposed || busy || loading || reveal is not null) return; manual = true; scopes = scopes.Where(scope => scope != "rateldesk.orchestration.callback").ToHashSet(StringComparer.Ordinal); error = null; }
    private void ClearReveal(NetRatelServiceClientReveal expected) { if (!disposed && !busy && ReferenceEquals(reveal, expected)) reveal = null; }
    private void ClearPendingAction() { pendingActionClient = null; pendingAction = null; }
    private void CancelPendingAction() { if (!disposed && !busy) ClearPendingAction(); }
    private void PrepareClientAction(Guid id, string action) { if (disposed || busy || loading || reveal is not null) return; pendingActionClient = id; pendingAction = action; }
    private void OrganizationChanged(string value) { organizationId = value; customerIds.Clear(); }
    private void CustomerChanged(string value) => customerIds = string.IsNullOrEmpty(value) ? [] : new HashSet<string>([value], StringComparer.Ordinal);
    private void ScopesChanged(IEnumerable<string>? values) => scopes = values?.ToHashSet(StringComparer.Ordinal) ?? [];
    private static string SelectedScopeText(IReadOnlyList<string> selected) => $"{selected.Count} selected permissions";
    private static string ScopeLabel(string scope) => scope switch
    {
        "rateldesk.incidents.create" => "Incident creation", "rateldesk.incident-receipts.read" => "Receipt reconciliation",
        "rateldesk.incident-targets.read" => "Target validation", "rateldesk.orchestration.callback" => "Task callbacks", _ => scope
    };
    private async Task ReloadClientsAsync()
    {
        clients = []; ClearPendingAction();
        try { clients = await Api.GetFromJsonAsync<List<NetRatelServiceClientMetadata>>("api/v1/admin/service-clients") ?? []; }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException) { error = "Service clients could not be loaded."; }
    }
    private async Task RefreshClientsAsync()
    {
        if (disposed || busy || loading || reveal is not null) return;
        busy = true; error = null;
        try { await ReloadClientsAsync(); }
        finally { busy = false; }
    }
    private async Task CreateManualAsync()
    {
        if (disposed || !CanCreateManual || busy || reveal is not null) return;
        busy = true; error = null;
        try
        {
            using var response = await MutationApi.PostAsJsonAsync("api/v1/admin/service-clients", new
            {
                Name = name.Trim(), OrganizationId = organizationId, PeerInstanceId = peerInstanceId.Trim(), PeerTenantId = peerTenantId.Trim(),
                Scopes = scopes.Order(StringComparer.Ordinal).ToArray(), CustomerIds = customerIds.Order(StringComparer.Ordinal).ToArray(),
                SourceInstanceId = Guid.TryParse(sourceInstanceId, out var source) ? (Guid?)source : null,
                ResourceConstraintsJson = JsonSerializer.Serialize(new
                {
                    organization_id = organizationId,
                    customer_ids = customerIds.Order(StringComparer.Ordinal).ToArray(),
                    request_ids = ParseIds(callbackRequestIds), task_ids = ParseIds(callbackTaskIds),
                    tenant_id = (string?)null, resource_ids = Array.Empty<string>(), request_definition_ids = Array.Empty<string>()
                })
            });
            if (!response.IsSuccessStatusCode) { error = ServiceError(response.StatusCode); return; }
            if (disposed) return;
            var issued = await response.Content.ReadFromJsonAsync<NetRatelServiceClientReveal>();
            if (disposed) return;
            reveal = issued;
            if (reveal is null) error = "Creation was accepted, but the one-time reveal is unavailable. Revoke the client and create a replacement.";
            await ReloadClientsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            error = "The result could not be confirmed. Refresh the service list before creating another client.";
        }
        finally { busy = false; }
    }
    private async Task ClientActionAsync(NetRatelServiceClientMetadata client)
    {
        if (disposed || client.ReadOnly || busy || reveal is not null || pendingActionClient != client.Id) return;
        var action = pendingAction;
        if (action is not ("rotate" or "revoke")) return;
        busy = true; error = null;
        try
        {
            using var response = action == "rotate"
                ? await MutationApi.PostAsJsonAsync($"api/v1/admin/service-clients/{client.Id:D}/rotate", new { ExpectedCredentialRevision = client.CredentialRevision })
                : await MutationApi.PostAsync($"api/v1/admin/service-clients/{client.Id:D}/revoke", null);
            if (!response.IsSuccessStatusCode) { error = ServiceError(response.StatusCode); return; }
            if (disposed) return;
            if (action == "rotate")
            {
                var issued = await response.Content.ReadFromJsonAsync<NetRatelServiceClientReveal>();
                if (disposed) return;
                reveal = issued;
            }
            ClearPendingAction();
            await ReloadClientsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException) { error = "The service change could not be confirmed. Refresh its current status before retrying."; }
        finally { busy = false; }
    }
    private static string ServiceError(System.Net.HttpStatusCode status) => status switch
    {
        System.Net.HttpStatusCode.Conflict => "The service changed elsewhere or is deployment-owned. Refresh its effective state before retrying.",
        System.Net.HttpStatusCode.Forbidden => "Administrator authorization and enabled organization/customer grants are required.",
        _ => "The service change was rejected. Check the exact peer, tenant, source and customer grants."
    };
    private static string[] ParseIds(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();
    public void Dispose() { disposed = true; reveal = null; ClearPendingAction(); }
}
