@using System.Net
@using System.Text.Json
@using Polly.Timeout
@using Polly.CircuitBreaker
@using Helpdesk.Shared.DTOs.Change
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<StatePopup @key="scope" Kind="change" Label="@ChangeLifecycleDisplay.Label(LifecycleState)" TrackingId="@(TrackingId ?? ChangeId)"
            Color="@ChangeLifecycleDisplay.StatusColor(LifecycleState)" CanEdit="CanOpen" Busy="pending" Loading="loading" Error="@error"
            Guidance="@guidance" DetailUrl="@(ShowDetailsLink ? $"/changes/{Uri.EscapeDataString(ChangeId)}" : null)" Choices="choices"
            Opening="LoadOptions" Apply="UpdateLifecycle" Reload="ReloadCurrent" />

@code {
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public string ChangeId { get; set; } = string.Empty;
    [Parameter] public string? TrackingId { get; set; }
    [Parameter] public string? ChangeTitle { get; set; }
    [Parameter] public bool DetailActions { get; set; }
    [Parameter] public bool ShowDetailsLink { get; set; } = true;
    [Parameter] public bool RetainsDraft { get; set; }
    [Parameter] public ChangeLifecycleState LifecycleState { get; set; }
    [Parameter] public EventCallback<ChangeDto> ChangeUpdated { get; set; }

    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    private HttpClient Commands => HttpClientFactory.CreateClient(HelpdeskCommandHttpClients.CommandsClientName);
    private (string Id, bool Write, bool Approve) scope;
    private CancellationTokenSource cancellation = new();
    private IReadOnlyList<StatePopupChoice> choices = [];
    private ChangeLifecycleOptionsDto? loadedOptions;
    private bool pending, loading, disposed;
    private string? error, guidance;
    private bool CanOpen => !string.IsNullOrWhiteSpace(ChangeId) &&
        !ChangeLifecycleDisplay.IsTerminal(LifecycleState) &&
        (CanWrite || CanApprove && LifecycleState == ChangeLifecycleState.PendingApproval);

    protected override void OnParametersSet()
    {
        var next = (ChangeId, CanWrite, CanApprove);
        if (next == scope) return;
        cancellation.Cancel(); cancellation.Dispose(); cancellation = new();
        scope = next;
        pending = loading = false;
        error = guidance = null;
        choices = [];
        loadedOptions = null;
    }

    private async Task LoadOptions()
    {
        if (pending || loading || !CanOpen) return;
        var origin = scope;
        var token = cancellation.Token;
        loading = true;
        error = null;
        choices = [];
        try
        {
            var path = $"api/v1/changes/{Uri.EscapeDataString(origin.Id)}/lifecycle-options";
            var options = await Api.GetFromJsonAsync<ChangeLifecycleOptionsDto>(DetailActions ? path + "?detail=true" : path, token);
            if (!Current(origin, token)) return;
            if (options?.Id != origin.Id)
            {
                error = "Permitted actions could not be confirmed. Reload current state.";
                return;
            }
            loadedOptions = options;
            LifecycleState = options.LifecycleState;
            guidance = options.Guidance;
            choices = options.Choices.Select(option => new StatePopupChoice(
                (int)option.State, ActionLabel(option.State), option.UnavailableReason, RequiresConfirmation(option.State))).ToArray();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException or TimeoutRejectedException or BrokenCircuitException)
        {
            if (Current(origin, token)) error = "Permitted actions could not be loaded. Reload current state or open the change details.";
        }
        finally { if (Current(origin, token)) loading = false; }
    }

    private async Task<bool> UpdateLifecycle(int value)
    {
        var newState = (ChangeLifecycleState)value;
        if (pending || loading || loadedOptions is not { } snapshot || newState == LifecycleState ||
            !choices.Any(option => option.Value == value && option.UnavailableReason is null)) return false;
        var origin = scope;
        var token = cancellation.Token;
        var request = new ChangeLifecycleRequest(newState, ExpectedLifecycleState: snapshot.LifecycleState,
            ExpectedUpdatedAt: snapshot.UpdatedAt);
        if (RequiresConfirmation(newState))
            return await ConfirmClosure(request, snapshot, origin, token);

        pending = true;
        error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var path = $"api/v1/changes/{Uri.EscapeDataString(origin.Id)}";
            using var response = snapshot.Choices.Any(option => option.State == newState && option.RequiresDetailUpdate)
                ? await Commands.PutAsJsonAsync(path, new UpdateChangeDto
                {
                    LifecycleState = request.LifecycleState, ExpectedLifecycleState = request.ExpectedLifecycleState,
                    ExpectedUpdatedAt = request.ExpectedUpdatedAt
                }, token)
                : await Commands.PostAsJsonAsync(path + "/lifecycle", request, token);
            if (!Current(origin, token)) return false;
            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode switch
                {
                    HttpStatusCode.Forbidden => "You no longer have permission for this action. Reload current state.",
                    HttpStatusCode.Conflict => "This change was updated during your action. Reload current state before trying again.",
                    HttpStatusCode.BadRequest => "The lifecycle action is no longer available. Reload current state or open details to review approvals and template requirements.",
                    _ => "The lifecycle update could not be confirmed. Reload current state before trying again."
                };
                choices = [];
                return false;
            }
            var updated = await response.Content.ReadFromJsonAsync<ChangeDto>(token);
            if (!Current(origin, token)) return false;
            if (updated?.Id != origin.Id || !Enum.IsDefined(updated.LifecycleState))
            {
                error = "The saved lifecycle could not be confirmed. Reload current state before trying again.";
                choices = [];
                return false;
            }
            return await AcceptUpdate(updated);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException or TimeoutRejectedException or BrokenCircuitException)
        {
            if (Current(origin, token)) { error = "The save result could not be confirmed. Reload current state before trying again."; choices = []; }
            return false;
        }
        finally
        {
            if (Current(origin, token))
            {
                pending = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ReloadCurrent()
    {
        if (pending || loading) return;
        var origin = scope;
        var token = cancellation.Token;
        loading = true;
        try
        {
            var updated = await Api.GetFromJsonAsync<ChangeDto>($"api/v1/changes/{Uri.EscapeDataString(origin.Id)}", token);
            if (!Current(origin, token)) return;
            if (updated?.Id != origin.Id) { error = "Current change could not be loaded. Reopen its details."; return; }
            LifecycleState = updated.LifecycleState;
            error = null;
            await ChangeUpdated.InvokeAsync(updated);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException or TimeoutRejectedException or BrokenCircuitException)
        {
            if (Current(origin, token)) error = "Current change could not be loaded. Reopen its details or try again.";
        }
        finally { if (Current(origin, token)) loading = false; }
        if (Current(origin, token)) await LoadOptions();
    }

    private bool Current((string Id, bool Write, bool Approve) origin, CancellationToken token) => !disposed && !token.IsCancellationRequested && scope == origin;
    public void Dispose() { disposed = true; cancellation.Cancel(); cancellation.Dispose(); }

    private static bool RequiresConfirmation(ChangeLifecycleState state) =>
        state is ChangeLifecycleState.Cancelled or ChangeLifecycleState.ImplementedFailed;

    private static string ActionLabel(ChangeLifecycleState state) => state switch
    {
        ChangeLifecycleState.Submitted => "Submit",
        ChangeLifecycleState.Cancelled => "Cancel",
        _ => ChangeLifecycleDisplay.Label(state)
    };

    private async Task<bool> ConfirmClosure(ChangeLifecycleRequest request, ChangeLifecycleOptionsDto snapshot,
        (string Id, bool Write, bool Approve) origin, CancellationToken token)
    {
        var cancelling = request.LifecycleState == ChangeLifecycleState.Cancelled;
        var dialog = await Dialogs.ShowAsync<ChangeClosureDialog>(cancelling ? "Cancel change" : "Record failed implementation",
            new DialogParameters<ChangeClosureDialog>
            {
                { item => item.ChangeId, origin.Id },
                { item => item.Summary, $"{TrackingId ?? origin.Id} · {ChangeTitle}" },
                { item => item.Action, request },
                { item => item.ReasonRequired, snapshot.Choices.Single(option => option.State == request.LifecycleState).RequiresComment },
                { item => item.WarnAboutExecution, cancelling && snapshot.LifecycleState == ChangeLifecycleState.ImplementationInProgress },
                { item => item.RetainsDraft, RetainsDraft },
                { item => item.ScopeToken, token }
            },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true, BackdropClick = false });
        var result = await dialog.Result;
        return Current(origin, token) && result?.Data is ChangeDto updated && await AcceptUpdate(updated);
    }

    private async Task<bool> AcceptUpdate(ChangeDto updated)
    {
        LifecycleState = updated.LifecycleState;
        await ChangeUpdated.InvokeAsync(updated);
        if (!disposed)
        {
            var guidance = ChangeLifecycleDisplay.IsTerminal(updated.LifecycleState) ? " Find this change in History." : "";
            var status = $"Change status is {ChangeLifecycleDisplay.Label(updated.LifecycleState)}.";
            Snackbar.Add(status + guidance, Severity.Success);
        }
        return true;
    }
}
