@using System.Net
@using System.Text.Json
@using Polly.Timeout
@using Polly.CircuitBreaker
@using Helpdesk.Shared.DTOs.Change
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<StatePopup @key="scope" Kind="change" Label="@GetLifecycleLabel(LifecycleState)" TrackingId="@(TrackingId ?? ChangeId)"
            Color="@GetLifecycleColor(LifecycleState)" CanEdit="CanOpen" Busy="pending" Loading="loading" Error="@error"
            Guidance="@guidance" DetailUrl="@($"/changes/{Uri.EscapeDataString(ChangeId)}")" Choices="choices"
            Opening="LoadOptions" Apply="UpdateLifecycle" Reload="ReloadCurrent" />

@code {
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public string ChangeId { get; set; } = string.Empty;
    [Parameter] public string? TrackingId { get; set; }
    [Parameter] public ChangeLifecycleState LifecycleState { get; set; }
    [Parameter] public EventCallback<ChangeDto> ChangeUpdated { get; set; }

    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    private HttpClient Commands => HttpClientFactory.CreateClient(HelpdeskCommandHttpClients.CommandsClientName);
    private (string Id, bool Write, bool Approve) scope;
    private CancellationTokenSource cancellation = new();
    private IReadOnlyList<StatePopupChoice> choices = [];
    private bool pending, loading, disposed;
    private string? error, guidance;
    private bool CanOpen => !string.IsNullOrWhiteSpace(ChangeId) &&
        LifecycleState is not (ChangeLifecycleState.ImplementedSuccess or ChangeLifecycleState.ImplementedBackedOut) &&
        (CanWrite || CanApprove && LifecycleState == ChangeLifecycleState.PendingApproval);

    protected override void OnParametersSet()
    {
        var next = (ChangeId, CanWrite, CanApprove);
        if (next == scope) return;
        cancellation.Cancel(); cancellation.Dispose(); cancellation = new();
        scope = next;
        pending = loading = false;
        error = guidance = null;
        choices = [];
    }

    private async Task LoadOptions()
    {
        if (pending || loading || !CanOpen) return;
        var origin = scope;
        var token = cancellation.Token;
        loading = true;
        error = null;
        choices = [];
        try
        {
            var options = await Api.GetFromJsonAsync<ChangeLifecycleOptionsDto>($"api/v1/changes/{Uri.EscapeDataString(origin.Id)}/lifecycle-options", token);
            if (!Current(origin, token)) return;
            if (options?.Id != origin.Id)
            {
                error = "Permitted actions could not be confirmed. Reload current state.";
                return;
            }
            LifecycleState = options.LifecycleState;
            guidance = options.Guidance;
            choices = options.Choices.Select(option => new StatePopupChoice((int)option.State,
                option.State == ChangeLifecycleState.Submitted ? "Submit" : GetLifecycleLabel(option.State), option.UnavailableReason)).ToArray();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException or TimeoutRejectedException or BrokenCircuitException)
        {
            if (Current(origin, token)) error = "Permitted actions could not be loaded. Reload current state or open the change details.";
        }
        finally { if (Current(origin, token)) loading = false; }
    }

    private async Task<bool> UpdateLifecycle(int value)
    {
        var newState = (ChangeLifecycleState)value;
        if (pending || loading || newState == LifecycleState || !choices.Any(option => option.Value == value && option.UnavailableReason is null)) return false;
        var origin = scope;
        var token = cancellation.Token;
        pending = true;
        error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var response = await Commands.PostAsJsonAsync($"api/v1/changes/{Uri.EscapeDataString(origin.Id)}/lifecycle", new { LifecycleState = newState }, token);
            if (!Current(origin, token)) return false;
            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode switch
                {
                    HttpStatusCode.Forbidden => "You no longer have permission for this action. Reload current state.",
                    HttpStatusCode.Conflict => "This change was updated during your action. Reload current state before trying again.",
                    HttpStatusCode.BadRequest => "The lifecycle action is no longer available. Reload current state or open details to review approvals and template requirements.",
                    _ => "The lifecycle update could not be confirmed. Reload current state before trying again."
                };
                choices = [];
                return false;
            }
            var updated = await response.Content.ReadFromJsonAsync<ChangeDto>(token);
            if (!Current(origin, token)) return false;
            if (updated?.Id != origin.Id || !Enum.IsDefined(updated.LifecycleState))
            {
                error = "The saved lifecycle could not be confirmed. Reload current state before trying again.";
                choices = [];
                return false;
            }
            LifecycleState = updated.LifecycleState;
            await ChangeUpdated.InvokeAsync(updated);
            if (!disposed) Snackbar.Add($"Change status updated to {GetLifecycleLabel(updated.LifecycleState)}.{(updated.State == TicketState.Resolved ? " Find implemented changes using History." : "")}", Severity.Success);
            return true;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException or TimeoutRejectedException or BrokenCircuitException)
        {
            if (Current(origin, token)) { error = "The save result could not be confirmed. Reload current state before trying again."; choices = []; }
            return false;
        }
        finally
        {
            if (Current(origin, token))
            {
                pending = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ReloadCurrent()
    {
        if (pending || loading) return;
        var origin = scope;
        var token = cancellation.Token;
        loading = true;
        try
        {
            var updated = await Api.GetFromJsonAsync<ChangeDto>($"api/v1/changes/{Uri.EscapeDataString(origin.Id)}", token);
            if (!Current(origin, token)) return;
            if (updated?.Id != origin.Id) { error = "Current change could not be loaded. Reopen its details."; return; }
            LifecycleState = updated.LifecycleState;
            error = null;
            await ChangeUpdated.InvokeAsync(updated);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException or TimeoutRejectedException or BrokenCircuitException)
        {
            if (Current(origin, token)) error = "Current change could not be loaded. Reopen its details or try again.";
        }
        finally { if (Current(origin, token)) loading = false; }
        if (Current(origin, token)) await LoadOptions();
    }

    private bool Current((string Id, bool Write, bool Approve) origin, CancellationToken token) => !disposed && !token.IsCancellationRequested && scope == origin;
    public void Dispose() { disposed = true; cancellation.Cancel(); cancellation.Dispose(); }

    private static string GetLifecycleLabel(ChangeLifecycleState state) => state switch
    {
        ChangeLifecycleState.PendingApproval => "Pending Approval",
        ChangeLifecycleState.ApprovedForImplementation => "Approved For Implementation",
        ChangeLifecycleState.ImplementationInProgress => "Implementation In Progress",
        ChangeLifecycleState.ImplementedSuccess => "Implemented - Success",
        ChangeLifecycleState.ImplementedBackedOut => "Implemented - Backed Out",
        _ => state.ToString()
    };

    private static Color GetLifecycleColor(ChangeLifecycleState state) => state switch
    {
        ChangeLifecycleState.Submitted => Color.Info,
        ChangeLifecycleState.PendingApproval => Color.Warning,
        ChangeLifecycleState.ApprovedForImplementation => Color.Primary,
        ChangeLifecycleState.ImplementationInProgress => Color.Secondary,
        ChangeLifecycleState.ImplementedSuccess => Color.Success,
        ChangeLifecycleState.ImplementedBackedOut => Color.Warning,
        _ => Color.Default
    };
}
