@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="review-backdrop">
    <section class="review-surface" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1" @ref="surface" @onkeydown="KeyDown">
        @ChildContent
    </section>
</div>
@code {
    [Parameter] public string Title { get; set; } = "Review connection";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ElementReference? Opener { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference surface;
    private IJSObjectReference? module;
    private int reviewId;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/credentialReview.js");
        reviewId = await module.InvokeAsync<int>("openReview", surface, Opener);
    }
    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("closeReview", reviewId); await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
