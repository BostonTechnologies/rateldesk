@using HelpDesk.NewWeb.Services
@using Helpdesk.Shared.Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory

<MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Style="min-width:0" @onclick:stopPropagation="true">
    <MudText Typo="Typo.body2" Style="overflow-wrap:anywhere" data-testid="ticket-assigned-queue">@(Name ?? "Main Queue")</MudText>
    @if (TicketQueueActions.CanTransfer(Access, Module, OrganizationId, GroupId))
    {
        <MudTooltip Text="Move to queue">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.DriveFileMove" aria-label="Move to queue"
                           OnClick="MoveAsync" Disabled="busy" />
        </MudTooltip>
    }
    @if (GroupId != null && Unassigned && Access?.HasRestrictedWorkforceAccess == true &&
         TicketQueueActions.CanWrite(Access, Module, OrganizationId, GroupId))
    {
        <MudTooltip Text="Claim ticket">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.PersonAdd" aria-label="Claim ticket"
                           OnClick="ClaimAsync" Disabled="busy" />
        </MudTooltip>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string Module { get; set; } = "";
    [Parameter, EditorRequired] public string TicketId { get; set; } = "";
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public string? GroupId { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public long Version { get; set; }
    [Parameter] public bool Unassigned { get; set; }
    [Parameter] public CurrentUserAccessProfile? Access { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private bool busy;

    private async Task MoveAsync()
    {
        if (await TicketQueueActions.MoveAsync(DialogService, Snackbar, Module, [(TicketId, OrganizationId, Version)]))
            await Changed.InvokeAsync();
    }

    private async Task ClaimAsync()
    {
        busy = true;
        try
        {
            using var response = await HttpClientFactory.CreateClient("HelpdeskApi").PostAsync(
                $"api/v1/ticket-queues/{Module}/{Uri.EscapeDataString(TicketId)}/claim?expectedVersion={Version}", null);
            if (!response.IsSuccessStatusCode) Snackbar.Add("The ticket is unavailable to claim. Refresh its assignment and access.", Severity.Warning);
            await Changed.InvokeAsync();
        }
        catch (HttpRequestException) { Snackbar.Add("The queue service is unavailable.", Severity.Error); }
        finally { busy = false; }
    }
}
