@inject NavigationManager Navigation

<MudText Typo="Typo.h6" HtmlTag="h2">Timeline</MudText>
@if (Items is null)
{
    <MudText Typo="Typo.body2">The timeline is unavailable. Refresh the page to retry.</MudText>
}
else if (Items.Count == 0)
{
    <MudText Typo="Typo.body2">No public updates yet.</MudText>
}
else
{
    @foreach (var item in Items)
    {
        var message = EmailDisplayDocument.Create(item.MessageHtml, item.MessageText, Navigation.BaseUri,
            PublicBrowserAccess.AccessPath(AccessId) + "/asset/");
        <MudPaper Class="timeline-human-card pa-3 my-3" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.subtitle2">@(item.IsCustomer ? "You" : "Helpdesk")</MudText>
                <time datetime="@item.CreatedUtc.ToString("O")">@item.CreatedUtc.UtcDateTime.ToString("g") UTC</time>
            </MudStack>
            <div class="ticket-message-body">
                @if (string.IsNullOrWhiteSpace(item.MessageHtml))
                {
                    <p class="email-plain-text">@message.Text</p>
                }
                else
                {
                    @((MarkupString)message.Html)
                    @foreach (var link in message.Links)
                    {
                        <p><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Text</a></p>
                    }
                }
            </div>
            @if (item.Hours is > 0)
            {
                <MudText Typo="Typo.caption">@item.Hours h recorded</MudText>
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public IReadOnlyList<PublicTicketTimelineItemDto>? Items { get; set; }
    [Parameter] public Guid AccessId { get; set; }
}
