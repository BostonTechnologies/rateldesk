@using Helpdesk.Shared.Pairing
@using HelpDesk.NewWeb.Services.Pairing
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@implements IDisposable

<div class="pairing-connections" data-testid="system-connections-panel">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
            <MudText Typo="Typo.body2">Pair NetRatel and RatelDesk, then choose the tenants and capabilities for each connection.</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="GenerateAsync" Disabled="@(busy || loading)" data-testid="generate-pairing-code">Generate a Pairing Code</MudButton>
            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate" Disabled="@(busy || loading)" data-testid="create-system-connection">Create Connection</MudButton>
        </MudStack>

        @if (generated is not null)
        {
            <MudPaper Outlined="true" Class="pa-3" data-testid="generated-pairing-code">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">Enter this code in NetRatel</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                        <MudText Typo="Typo.h5" Class="pairing-readable-code">@generated.Code</MudText>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyCodeAsync">Copy code</MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption">Expires @generated.ExpiresAtUtc.ToLocalTime().ToString("g"). Single use. Generating another code replaces this code immediately.</MudText>
                </MudStack>
            </MudPaper>
        }
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="pairing-error" data-testid="system-connection-error" role="alert">@error@if (errorReference is not null) { <span>@(" Reference: ")@errorReference</span> }</MudAlert>
        }
        @if (notice is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" data-testid="system-connection-success" role="status">@notice</MudAlert>
        }
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading connections" />
        }
        @if (createOpen)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <form @onsubmit="PairAsync" @onsubmit:preventDefault data-testid="system-pairing-form">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Create Connection</MudText>
                        <MudTextField T="string" @bind-Value="address" Label="Address" Required="true" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" Placeholder="https://netratel.example.com or 192.168.1.20:5000" autocomplete="off" data-testid="pairing-address" />
                        <MudTextField T="string" @bind-Value="pairingCode" Label="Pairing code" Required="true" Immediate="true" InputType="InputType.Password" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" autocomplete="off" data-testid="pairing-code" />
                        <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Spacing="1">
                            <MudButton Size="Size.Small" OnClick="CloseForm" Disabled="busy">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Link" Disabled="@(!CanPair || busy)" data-testid="pair-and-connect">@(busy ? "Pairing…" : "Pair & connect")</MudButton>
                        </MudStack>
                    </MudStack>
                </form>
            </MudPaper>
        }
        @if (selected is not null && draft is not null)
        {
            <MudPaper Outlined="true" Class="pa-3" data-testid="system-connection-finalization">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">@(Connected(selected) ? "Connection configuration" : "Systems paired")</MudText>
                    <MudText Typo="Typo.body2" Class="pairing-peer-address">@selected.Peer.Name · @selected.Peer.WebOrigin</MudText>
                    @if (directory is null)
                    {
                        <MudText Typo="Typo.body2">The authorized tenant choices could not be loaded.</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ReloadDirectoryAsync" Disabled="busy">Retry tenant choices</MudButton>
                    }
                    else
                    {
                        <form @onsubmit="SaveAsync" @onsubmit:preventDefault data-testid="system-connection-save-form">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-Value="draft.NetRatelTenantId" Label="NetRatel tenant" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" data-testid="connection-netratel-tenant">
                                        @foreach (var tenant in directory.NetRatelTenants) { <MudSelectItem Value="@tenant.Id">@tenant.Name</MudSelectItem> }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" Value="draft.RatelDeskOrganizationId" ValueChanged="OrganizationChanged" Label="RatelDesk organization" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" data-testid="connection-rateldesk-organization">
                                        @foreach (var organization in directory.RatelDeskOrganizations) { <MudSelectItem Value="@organization.Id">@organization.Name</MudSelectItem> }
                                    </MudSelect>
                                </MudItem>
                                @if (draft.CreateIncidents)
                                {
                                    <MudItem xs="12">
                                        <MudSelect T="string" @bind-Value="draft.RatelDeskCustomerId" Label="RatelDesk customer" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" data-testid="connection-rateldesk-customer">
                                            @foreach (var customer in directory.RatelDeskCustomers.Where(customer => customer.ParentId == draft.RatelDeskOrganizationId)) { <MudSelectItem Value="@customer.Id">@customer.Name</MudSelectItem> }
                                        </MudSelect>
                                    </MudItem>
                                }
                                <MudItem xs="12"><MudTextField T="string" @bind-Value="draft.Name" Label="Connection name" Required="true" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" data-testid="connection-name" /></MudItem>
                            </MudGrid>
                            <MudStack Spacing="0" Class="mt-2">
                                <MudCheckBox T="bool" @bind-Value="draft.CreateIncidents" Label="Create incidents — NetRatel → RatelDesk" Dense="true" Disabled="busy" data-testid="connection-create-incidents" />
                                <MudCheckBox T="bool" @bind-Value="draft.RunAutomation" Label="Run automation — RatelDesk → NetRatel" Dense="true" Disabled="busy" data-testid="connection-run-automation" />
                            </MudStack>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Spacing="1" Class="mt-2">
                                <MudButton Size="Size.Small" OnClick="CloseForm" Disabled="busy">Back to connections</MudButton>
                                <MudButton Size="Size.Small" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave || busy)" data-testid="save-system-connection">@(busy ? "Saving…" : "Save")</MudButton>
                            </MudStack>
                        </form>
                    }
                </MudStack>
            </MudPaper>
        }
        @if (!loading && connections.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No system connections yet. Generate a code here or enter a code from NetRatel.</MudText>
        }
        @foreach (var connection in connections)
        {
            <MudPaper @key="connection.Id" Outlined="true" Class="pa-3" data-testid="system-connection-row" data-connection-id="@connection.Id">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                        <MudText Typo="Typo.subtitle2">@(connection.Mapping?.Name ?? connection.Peer.Name)</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(Connected(connection) ? Color.Success : Color.Default)" Variant="Variant.Outlined">@(Connected(connection) ? "Connected" : connection.Mapping is null ? "Systems paired" : "Needs configuration")</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="pairing-peer-address">@connection.Peer.WebOrigin</MudText>
                    @if (connection.Mapping is { } mapping)
                    {
                        <MudText Typo="Typo.body2">NetRatel: @ChoiceName(DirectoryFor(connection.PairId)?.NetRatelTenants, mapping.NetRatelTenantId) · RatelDesk: @ChoiceName(DirectoryFor(connection.PairId)?.RatelDeskOrganizations, mapping.RatelDeskOrganizationId)</MudText>
                        @if (mapping.RatelDeskCustomerId is not null) { <MudText Typo="Typo.caption">Customer: @ChoiceName(DirectoryFor(connection.PairId)?.RatelDeskCustomers, mapping.RatelDeskCustomerId)</MudText> }
                        <MudText Typo="Typo.caption">@(mapping.CreateIncidents ? "Create incidents: NetRatel → RatelDesk" : "") @(mapping.CreateIncidents && mapping.RunAutomation ? " · " : "") @(mapping.RunAutomation ? "Run automation: RatelDesk → NetRatel" : "")</MudText>
                    }
                    @if (connection.LastTest is { } lastTest)
                    {
                        <MudAlert Severity="@(lastTest.Success ? Severity.Success : Severity.Warning)" Dense="true" data-testid="connection-test-result">@lastTest.Message · @lastTest.TestedAtUtc.ToLocalTime().ToString("g")</MudAlert>
                    }
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        <MudButton Size="Size.Small" OnClick="() => ViewAsync(connection)" Disabled="busy" data-testid="view-system-connection">View</MudButton>
                        @if (connection.Mapping is not null)
                        {
                            <MudButton Size="Size.Small" OnClick="() => TestAsync(connection)" Disabled="busy" data-testid="test-system-connection">Test connection</MudButton>
                            <MudButton Size="Size.Small" OnClick="() => AddMappingAsync(connection)" Disabled="busy">Add connection</MudButton>
                        }
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(connection)" Disabled="busy" data-testid="delete-system-connection">Delete connection</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
        <MudStack Row="true"><MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@(busy || loading)">Refresh connections</MudButton></MudStack>
    </MudStack>
</div>

@code {
    private SystemConnectionApi Api => new(HttpClientFactory);
    private readonly CancellationTokenSource lifetime = new();
    private List<PairingConnectionDto> connections = [];
    private PairingCodeDto? generated;
    private PairingConnectionDto? selected;
    private PairingSetupDirectory? directory;
    private readonly Dictionary<string, PairingSetupDirectory> directories = new(StringComparer.Ordinal);
    private ConnectionDraft? draft;
    private string address = "", pairingCode = "", pairFingerprint = "", pairOperationId = "";
    private string? error, errorReference, notice;
    private bool loading = true, busy, createOpen, disposed;
    private long generation, loadingGeneration;
    private bool CanPair => SystemConnectionApi.NormalizeAddress(address) is not null && ValidCode(pairingCode);
    private bool CanSave => draft is not null && directory is not null && !string.IsNullOrWhiteSpace(draft.Name) &&
        directory.NetRatelTenants.Any(t => t.Id == draft.NetRatelTenantId) && directory.RatelDeskOrganizations.Any(t => t.Id == draft.RatelDeskOrganizationId) &&
        (draft.CreateIncidents || draft.RunAutomation) && (!draft.CreateIncidents || directory.RatelDeskCustomers.Any(c => c.Id == draft.RatelDeskCustomerId && c.ParentId == draft.RatelDeskOrganizationId));
    private static bool Connected(PairingConnectionDto connection) => string.Equals(connection.Status, "connected", StringComparison.OrdinalIgnoreCase);
    private static bool ValidCode(string value) => value.Trim().Replace("-", "", StringComparison.Ordinal) is { Length: 8 } code && code.All(char.IsAsciiLetterOrDigit);

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (busy || disposed) return;
        loading = true; ClearMessages();
        var current = ++generation;
        loadingGeneration = current;
        try
        {
            var loaded = await Api.ListAsync(lifetime.Token);
            if (!Current(current)) return;
            connections = loaded;
            loading = false;
            StateHasChanged();
            await Task.WhenAll(loaded.Select(c => c.PairId).Distinct().Select(async pairId =>
            {
                try { var choices = await Api.DirectoryAsync(pairId, lifetime.Token); if (Current(current)) directories[pairId] = choices; }
                catch (Exception exception) when (Expected(exception)) { }
            }));
            if (!Current(current)) return;
            var incomplete = connections.FirstOrDefault(c => !Connected(c));
            if (selected is null && !createOpen && incomplete is not null) await BeginFinalizeAsync(incomplete, false);
        }
        catch (Exception exception) when (Expected(exception)) { if (Current(current)) Failure(exception); }
        finally { if (!disposed && loadingGeneration == current) loading = false; }
    }
    private void OpenCreate()
    {
        if (busy) return;
        ClearMessages(); selected = null; draft = null; directory = null; createOpen = true; address = ""; pairingCode = ""; pairOperationId = "";
    }
    private void CloseForm()
    {
        if (busy) return;
        createOpen = false; pairingCode = ""; selected = null; draft = null; directory = null;
    }
    private async Task GenerateAsync()
    {
        if (busy) return;
        busy = true; ClearMessages(); var current = ++generation;
        try { var code = await Api.GenerateAsync(lifetime.Token); if (Current(current)) generated = code; }
        catch (Exception exception) when (Expected(exception)) { if (Current(current)) Failure(exception); }
        finally { if (Current(current)) busy = false; }
    }
    private async Task CopyCodeAsync()
    {
        if (generated is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", generated.Code); notice = "Pairing code copied."; }
        catch (JSException) { error = "Copy is unavailable in this browser. Select and copy the displayed code."; }
    }
    private async Task PairAsync()
    {
        if (busy || !CanPair) return;
        var normalized = SystemConnectionApi.NormalizeAddress(address)!;
        var code = pairingCode.Trim().ToUpperInvariant();
        var fingerprint = normalized + "|" + code;
        if (fingerprint != pairFingerprint || pairOperationId.Length == 0) { pairFingerprint = fingerprint; pairOperationId = Guid.NewGuid().ToString("D"); }
        busy = true; ClearMessages(); var current = ++generation;
        try
        {
            var paired = await Api.PairAsync(new(normalized, code, pairOperationId), lifetime.Token);
            if (!Current(current)) return;
            pairingCode = ""; pairFingerprint = ""; createOpen = false; Upsert(paired);
            await BeginFinalizeAsync(paired, false); notice = "Systems paired. Choose the mapping and capabilities, then Save.";
        }
        catch (Exception exception) when (Expected(exception)) { if (Current(current)) Failure(exception); }
        finally { if (Current(current)) busy = false; }
    }
    private Task ViewAsync(PairingConnectionDto connection) => SelectAsync(connection, false);
    private Task AddMappingAsync(PairingConnectionDto connection) => SelectAsync(connection, true);
    private async Task SelectAsync(PairingConnectionDto connection, bool newMapping)
    {
        if (busy) return;
        busy = true; ClearMessages();
        try { await BeginFinalizeAsync(connection, newMapping); }
        catch (Exception exception) when (Expected(exception)) { Failure(exception); }
        finally { if (!disposed) busy = false; }
    }
    private async Task BeginFinalizeAsync(PairingConnectionDto connection, bool newMapping)
    {
        selected = connection; createOpen = false; directory = null;
        draft = newMapping || connection.Mapping is null ? new ConnectionDraft
        {
            Id = Guid.NewGuid().ToString("D"), PairId = connection.PairId, Name = connection.Peer.Name + " connection"
        } : ConnectionDraft.From(connection.Mapping);
        var loaded = await Api.DirectoryAsync(connection.PairId, lifetime.Token);
        if (disposed || selected != connection) return;
        directory = loaded; directories[connection.PairId] = loaded;
    }
    private async Task ReloadDirectoryAsync()
    {
        if (busy || selected is null) return;
        busy = true; ClearMessages();
        try { directory = await Api.DirectoryAsync(selected.PairId, lifetime.Token); directories[selected.PairId] = directory; }
        catch (Exception exception) when (Expected(exception)) { Failure(exception); }
        finally { if (!disposed) busy = false; }
    }
    private void OrganizationChanged(string value)
    {
        if (draft is null) return;
        draft.RatelDeskOrganizationId = value;
        if (directory?.RatelDeskCustomers.Any(c => c.Id == draft.RatelDeskCustomerId && c.ParentId == value) != true) draft.RatelDeskCustomerId = null;
    }
    private async Task SaveAsync()
    {
        if (busy || !CanSave || draft is null) return;
        busy = true; ClearMessages(); var current = ++generation;
        try
        {
            var saved = await Api.SaveAsync(draft.Mapping(), lifetime.Token);
            if (!Current(current)) return;
            Upsert(saved); selected = null; draft = null; directory = null;
            notice = Connected(saved) ? "Connected. The selected mapping and capabilities are active." : "The connection needs configuration. Review the saved mapping and retry.";
        }
        catch (Exception exception) when (Expected(exception)) { if (Current(current)) Failure(exception); }
        finally { if (Current(current)) busy = false; }
    }
    private async Task TestAsync(PairingConnectionDto connection)
    {
        if (busy || connection.Mapping is null) return;
        busy = true; ClearMessages(); var current = ++generation;
        try
        {
            var result = await Api.TestAsync(connection.Mapping, lifetime.Token);
            if (Current(current)) Upsert(connection with { LastTest = result });
        }
        catch (Exception exception) when (Expected(exception)) { if (Current(current)) Failure(exception); }
        finally { if (Current(current)) busy = false; }
    }
    private async Task DeleteAsync(PairingConnectionDto connection)
    {
        if (busy) return;
        busy = true; ClearMessages(); var current = ++generation;
        try
        {
            await Api.DeleteAsync(connection, lifetime.Token);
            if (!Current(current)) return;
            loading = false;
            connections.RemoveAll(c => c.Id == connection.Id || connection.Mapping is null && c.PairId == connection.PairId);
            if (selected?.Id == connection.Id) { selected = null; draft = null; directory = null; }
            notice = "Connection deleted. Local access is revoked.";
        }
        catch (Exception exception) when (Expected(exception)) { if (Current(current)) Failure(exception); }
        finally { if (Current(current)) busy = false; }
    }
    private void Upsert(PairingConnectionDto connection)
    {
        connections.RemoveAll(c => c.Id == connection.Id || c.PairId == connection.PairId && c.Mapping is null);
        connections.Add(connection);
    }
    private bool Current(long value) => !disposed && value == generation;
    private void ClearMessages() { error = null; errorReference = null; notice = null; }
    private void Failure(Exception exception)
    {
        if (disposed) return;
        error = exception is SystemConnectionException failure ? failure.Message : "The connection service could not be reached or its response was incomplete. Retry this action; your connection draft is retained.";
        errorReference = exception is SystemConnectionException apiError ? apiError.Reference : "connection-service-unavailable";
    }
    private static bool Expected(Exception exception) => exception is SystemConnectionException or HttpRequestException or JsonException or OperationCanceledException or IOException;
    private PairingSetupDirectory? DirectoryFor(string pairId) => directories.GetValueOrDefault(pairId);
    private static string ChoiceName(IEnumerable<PairingChoice>? choices, string id) => choices?.FirstOrDefault(c => c.Id == id)?.Name ?? id;
    public void Dispose() { disposed = true; ++generation; generated = null; pairingCode = ""; pairFingerprint = ""; lifetime.Cancel(); lifetime.Dispose(); }
    private sealed class ConnectionDraft
    {
        public string Id { get; set; } = "";
        public string PairId { get; set; } = "";
        public string Name { get; set; } = "";
        public string NetRatelTenantId { get; set; } = "";
        public string RatelDeskOrganizationId { get; set; } = "";
        public string? RatelDeskCustomerId { get; set; }
        public bool CreateIncidents { get; set; }
        public bool RunAutomation { get; set; }
        public PairingMapping Mapping() => new(Id, PairId, Name.Trim(), NetRatelTenantId, RatelDeskOrganizationId, CreateIncidents ? RatelDeskCustomerId : null, CreateIncidents, RunAutomation);
        public static ConnectionDraft From(PairingMapping mapping) => new() { Id = mapping.Id, PairId = mapping.PairId, Name = mapping.Name, NetRatelTenantId = mapping.NetRatelTenantId, RatelDeskOrganizationId = mapping.RatelDeskOrganizationId, RatelDeskCustomerId = mapping.RatelDeskCustomerId, CreateIncidents = mapping.CreateIncidents, RunAutomation = mapping.RunAutomation };
    }
}
