@using Helpdesk.Shared.DTOs.Attachment
@using Helpdesk.Shared.DTOs.Worklog
@using Helpdesk.Shared.Enums
@implements IDisposable
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<div class="ticket-activity-tabs @Class">
    <div class="activity-tab-strip" role="tablist" aria-label="Ticket activity">
        @foreach (var tab in AvailableTabs)
        {
            <button @key="tab.Id" @ref="tab.Element" type="button" role="tab" id="@TabId(tab.Id)"
                    aria-controls="@PanelId(tab.Id)" aria-selected="@((activeTab == tab.Id).ToString().ToLowerInvariant())"
                    tabindex="@(activeTab == tab.Id ? 0 : -1)" class="activity-tab @(activeTab == tab.Id ? "active" : "")"
                    @onclick="() => SelectTab(tab.Id)" @onkeydown="e => NavigateTabs(e, tab.Id)">
                <MudIcon Icon="@tab.Icon" Size="Size.Small" aria-hidden="true" />
                <span>@(tab.Id == "messages" ? MessagesTabText : tab.Label)</span>
                @if (tab.HasCount)
                {
                    <span class="activity-count" aria-label="@CountLabel(tab.Id)">@CountText(tab.Id)</span>
                }
            </button>
        }
    </div>
    @foreach (var tab in AvailableTabs.Where(x => visited.Contains(x.Id)))
    {
        var panelVersion = scopeVersion;
        <div @key="@(scope + tab.Id)" id="@PanelId(tab.Id)" role="tabpanel" aria-labelledby="@TabId(tab.Id)"
             tabindex="0" hidden="@(activeTab != tab.Id)" class="activity-panel">
            @switch (tab.Id)
            {
                case "messages":
                    @if (MessagesContent is not null) { @MessagesContent }
                    else { <TicketMessages TicketId="@TicketId" TicketType="@TicketType" /> }
                    break;
                case "timeline":
                    <TicketTimeline ReadOnly="@(!CanContribute)" TicketId="@TicketId" TicketType="@TicketType"
                                    PublicMode="@PublicMode" OnWorklogAdded="@(() => panelVersion == scopeVersion ? OnWorklogAdded.InvokeAsync() : Task.CompletedTask)" OnTimelineLoaded="@(items => OnTimelineLoaded(panelVersion, items))" />
                    break;
                case "attachments":
                    <TicketAttachments ReadOnly="@(!CanContribute)" TicketId="@TicketId" OnAttachmentsLoaded="@(items => OnAttachmentsLoaded(panelVersion, items))" />
                    break;
                case "listeners":
                    <TicketListeners ReadOnly="@(!CanManage)" TicketId="@TicketId" TicketType="@TicketType" OnListenersLoaded="@(items => OnListenersLoaded(panelVersion, items))" />
                    break;
                case "ai":
                    <AiAssistantChat TicketId="@TicketId" TicketType="@TicketType" />
                    break;
                case "relations":
                    <TicketRelations ReadOnly="@(!CanManage)" TicketId="@TicketId" TicketType="@TicketType" OnRelationsLoaded="@(items => OnRelationsLoaded(panelVersion, items))" />
                    break;
            }
        </div>
    }
</div>

@code {
    [Parameter] public string TicketId { get; set; } = string.Empty;
    [Parameter] public string TicketType { get; set; } = "incidents";
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public bool PublicMode { get; set; }
    [Parameter] public bool CanContribute { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public EventCallback OnWorklogAdded { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string MessagesTabText { get; set; } = "Messages";
    [Parameter] public RenderFragment? MessagesContent { get; set; }

    private sealed class Tab(string id, string label, string icon, bool hasCount = false)
    {
        public string Id { get; } = id;
        public string Label { get; } = label;
        public string Icon { get; } = icon;
        public bool HasCount { get; } = hasCount;
        public ElementReference Element;
    }
    private readonly List<Tab> tabs = new()
    {
        new("messages", "Messages", Icons.Material.Filled.Email),
        new("timeline", "Timeline", Icons.Material.Filled.AccessTime, true),
        new("attachments", "Attachments", Icons.Material.Filled.AttachFile, true),
        new("listeners", "Listeners", Icons.Material.Filled.People, true),
        new("ai", "AI Assistant", Icons.Material.Filled.AutoAwesome),
        new("relations", "Relations", Icons.Material.Filled.AccountTree, true)
    };
    private IEnumerable<Tab> AvailableTabs => tabs.Where(x => (x.Id != "ai" || CanManage && !PublicMode) && (x.Id != "relations" || IsIncidentType));
    private readonly Dictionary<string, int?> counts = new();
    private readonly HashSet<string> unavailableCounts = new();
    private readonly HashSet<string> visited = new() { "messages" };
    private readonly string instanceId = $"activity-{Guid.NewGuid():N}";
    private string activeTab = "messages";
    private string? scope;
    private long scopeVersion;
    private bool restoreSelection;
    private CancellationTokenSource cancellation = new();
    private bool IsIncidentType => string.Equals(TicketType, "incidents", StringComparison.OrdinalIgnoreCase);
    private string TabId(string id) => $"{instanceId}-{id}";
    private string PanelId(string id) => $"{instanceId}-{id}-panel";
    private string StorageKey => $"ticket-tabs-selection:v2:{TicketType}:{TicketId}";
    private string CountText(string id) => counts.GetValueOrDefault(id) is int count ? (count > 999 ? "999+" : count.ToString()) : unavailableCounts.Contains(id) ? "—" : "…";
    private string CountLabel(string id) => counts.GetValueOrDefault(id) is int count ? $"{count} items" : unavailableCounts.Contains(id) ? "Count unavailable" : "Loading count";

    protected override async Task OnParametersSetAsync()
    {
        var nextScope = $"{TicketType}:{TicketId}:{OrganizationId}:{PublicMode}";
        if (nextScope != scope)
        {
            cancellation.Cancel(); cancellation.Dispose(); cancellation = new();
            scope = nextScope;
            scopeVersion++;
            activeTab = "messages";
            visited.Clear(); visited.Add(activeTab);
            counts.Clear(); unavailableCounts.Clear();
            restoreSelection = true;
            await PreloadCounts(cancellation.Token);
        }
        if (!AvailableTabs.Any(x => x.Id == activeTab)) activeTab = "messages";
        visited.RemoveWhere(id => !AvailableTabs.Any(x => x.Id == id));
        visited.Add(activeTab);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoreSelection) return;
        restoreSelection = false;
        var expectedVersion = scopeVersion;
        try
        {
            // Numeric legacy indices are deliberately ignored: optional tabs change their meaning.
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (scopeVersion == expectedVersion && AvailableTabs.Any(x => x.Id == stored))
            {
                activeTab = stored!; visited.Add(activeTab); StateHasChanged();
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task SelectTab(string id)
    {
        if (!AvailableTabs.Any(x => x.Id == id)) return;
        activeTab = id; visited.Add(id);
        try { await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, id); }
        catch (JSException) { }
    }

    private async Task NavigateTabs(KeyboardEventArgs e, string id)
    {
        var available = AvailableTabs.ToList();
        var index = available.FindIndex(x => x.Id == id);
        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % available.Count,
            "ArrowLeft" => (index + available.Count - 1) % available.Count,
            "Home" => 0,
            "End" => available.Count - 1,
            _ => -1
        };
        if (next < 0) return;
        await SelectTab(available[next].Id);
        await available[next].Element.FocusAsync();
    }

    private async Task PreloadCounts(CancellationToken token)
    {
        if (string.IsNullOrEmpty(TicketId)) return;
        var api = HttpClientFactory.CreateClient("HelpdeskApi");
        var type = Uri.EscapeDataString(TicketType);
        var id = Uri.EscapeDataString(TicketId);
        await Task.WhenAll(AvailableTabs.Where(x => x.HasCount).Select(async tab =>
        {
            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(token);
            timeout.CancelAfter(TimeSpan.FromSeconds(3));
            try
            {
                var count = tab.Id == "relations"
                    ? (await api.GetFromJsonAsync<List<TicketRelationDto>>($"api/v1/incidents/{id}/relations", timeout.Token))?.Count ?? 0
                    : await api.GetFromJsonAsync<int>($"api/v1/{type}/{id}/{tab.Id}/count", timeout.Token);
                if (!token.IsCancellationRequested) counts[tab.Id] = count;
            }
            catch (OperationCanceledException) { if (!token.IsCancellationRequested) unavailableCounts.Add(tab.Id); }
            catch (HttpRequestException) { if (!token.IsCancellationRequested) unavailableCounts.Add(tab.Id); }
            catch (System.Text.Json.JsonException) { if (!token.IsCancellationRequested) unavailableCounts.Add(tab.Id); }
        }));
    }

    private void OnTimelineLoaded(long version, List<TicketTimelineEventDto> events)
    {
        if (version != scopeVersion) return;
        counts["timeline"] = string.Equals(TicketType, "changes", StringComparison.OrdinalIgnoreCase) ? events.Count : events.Count(x => !IsSystemEvent(x));
    }
    private void OnAttachmentsLoaded(long version, List<AttachmentDto> attachments) { if (version == scopeVersion) counts["attachments"] = attachments.Count; }
    private void OnListenersLoaded(long version, int count) { if (version == scopeVersion) counts["listeners"] = count; }
    private void OnRelationsLoaded(long version, int count) { if (version == scopeVersion) counts["relations"] = count; }
    private static bool IsSystemEvent(TicketTimelineEventDto e) =>
        string.Equals(e.CreatedByUserId, "system", StringComparison.OrdinalIgnoreCase) ||
        e.EventType is TimelineEventType.EmailDelivery or TimelineEventType.StatusChange or TimelineEventType.AssignmentChange or TimelineEventType.SystemNotification;
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
