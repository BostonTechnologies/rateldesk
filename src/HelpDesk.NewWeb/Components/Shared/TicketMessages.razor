@implements IDisposable
@inject IHttpClientFactory HttpClientFactory

<MudPaper Class="pa-3 ticket-message-container" Elevation="0">
    @if (_loading)
    {
        <div role="status"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> Loading content…</div>
    }
    else if (_error)
    {
        <div role="alert">Unable to load this content. <MudButton Size="Size.Small" OnClick="LoadAsync">Retry</MudButton></div>
    }
    else if (_content is not null && (!string.IsNullOrWhiteSpace(_content.Html) || !string.IsNullOrWhiteSpace(_content.Text)))
    {
        @if (!string.IsNullOrWhiteSpace(_content.From) || _content.ReceivedUtc is not null)
        {
            <MudText Typo="Typo.caption" Class="mb-2">From: @(_content.From ?? "—") · @_content.ReceivedUtc?.ToLocalTime().ToString("g")</MudText>
        }
        <EmailContent Html="@_content.Html" Text="@_content.Text" OnEscape="OnEscape" />
    }
    else
    {
        <MudText>No content available.</MudText>
    }
</MudPaper>

@code {
    [Parameter] public string TicketId { get; set; } = string.Empty;
    [Parameter] public string TicketType { get; set; } = "incidents";
    [Parameter] public EventCallback OnEscape { get; set; }
    private bool _loading, _error, _disposed;
    private TicketMessageContent? _content;
    private (string, string)? _loadedKey;
    private CancellationTokenSource? _loadCts;

    protected override Task OnParametersSetAsync()
    {
        var key = (TicketType, TicketId);
        if (_loadedKey == key) return Task.CompletedTask;
        _loadedKey = key;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        var cancellation = _loadCts = new CancellationTokenSource();
        _loading = true; _error = false; _content = null;
        try
        {
            var content = await TicketMessageContent.LoadAsync(HttpClientFactory.CreateClient("HelpdeskApi"), TicketType, TicketId, cancellation.Token);
            if (!_disposed && ReferenceEquals(_loadCts, cancellation)) _content = content;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or NotSupportedException or OperationCanceledException)
        {
            if (!_disposed && ReferenceEquals(_loadCts, cancellation)) _error = true;
        }
        finally
        {
            if (!_disposed && ReferenceEquals(_loadCts, cancellation)) _loading = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
