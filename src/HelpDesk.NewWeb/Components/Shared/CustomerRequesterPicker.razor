@using Helpdesk.Shared.DTOs.Customer
@using Helpdesk.Shared.DTOs.Organization
@implements IDisposable
@inject IDialogService DialogService

<CreationSearchPicker TItem="CustomerDto" @key="refreshKey" LookupUrl="@LookupUrl" Value="@CustomerId"
                      ItemId="@(item => item.Id)" ItemLabel="@(item => $"{item.Name} ({item.Email})")"
                      Label="User the ticket is for" Kind="customers" Placeholder="@Placeholder"
                      Required="true" Disabled="@string.IsNullOrWhiteSpace(OrganizationId)" Margin="@Margin"
                      AutoSelectSingle="@LockWhenSingleCustomer" LockWhenSingle="@LockWhenSingleCustomer"
                      SelectionChanged="OnCustomerSelected" SearchTextChanged="@(text => searchText = text)">
    <ItemTemplate Context="customer">
        <span class="d-flex flex-column py-1">
            <span class="mud-typography mud-typography-body2" style="overflow-wrap:anywhere">@customer.Name</span>
            <span class="mud-typography mud-typography-caption">@customer.Email</span>
        </span>
    </ItemTemplate>
</CreationSearchPicker>
@if (AllowCreate && !string.IsNullOrWhiteSpace(OrganizationId))
{
    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="creating" OnClick="OpenCreateCustomerDialog">Create user</MudButton>
}

@code {
    [Parameter] public string Module { get; set; } = "incident";
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public string? CustomerId { get; set; }
    [Parameter] public EventCallback<string?> CustomerIdChanged { get; set; }
    [Parameter] public List<OrganizationDto> Organizations { get; set; } = new();
    [Parameter] public bool Dense { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.Normal;
    [Parameter] public bool AllowCreate { get; set; } = true;
    [Parameter] public bool LockWhenSingleCustomer { get; set; }

    private string searchText = "";
    private string? scope;
    private bool creating, disposed;
    private int refreshKey;
    private string LookupUrl => string.IsNullOrWhiteSpace(OrganizationId) ? "" :
        $"api/v1/ticketing/customers/search?module={Uri.EscapeDataString(Module)}&organizationId={Uri.EscapeDataString(OrganizationId)}";
    private string Placeholder => string.IsNullOrWhiteSpace(OrganizationId) ? "Select an organization first" : "Search name or email";
    protected override void OnParametersSet()
    {
        if (scope == LookupUrl) return;
        scope = LookupUrl;
        searchText = "";
    }
    public Task RefreshAsync() { refreshKey++; return InvokeAsync(StateHasChanged); }
    private Task OnCustomerSelected(CustomerDto? customer) => CustomerIdChanged.InvokeAsync(customer?.Id);

    private async Task OpenCreateCustomerDialog()
    {
        if (!AllowCreate || creating || string.IsNullOrWhiteSpace(OrganizationId)) return;
        var organizationId = OrganizationId;
        var expectedScope = scope;
        var (name, email) = ParseSearchText(searchText);
        var parameters = new DialogParameters
        {
            ["Organizations"] = Organizations,
            ["OrganizationId"] = organizationId,
            ["LockOrganization"] = true,
            ["InitialName"] = name,
            ["InitialEmail"] = email,
            ["Title"] = "Create User"
        };
        creating = true;
        try
        {
            var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Create User", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;
            if (disposed || expectedScope != scope || result is null || result.Canceled) return;
            if (result.Data is CustomerDto created && created.OrganizationId == organizationId)
            {
                await CustomerIdChanged.InvokeAsync(created.Id);
                await RefreshAsync();
            }
        }
        finally { creating = false; }
    }
    private static (string Name, string Email) ParseSearchText(string searchText)
    {
        var value = searchText.Trim();
        return value.Contains('@', StringComparison.Ordinal) ? (value[..value.IndexOf('@')], value) : (value, "");
    }
    public void Dispose() => disposed = true;
}
