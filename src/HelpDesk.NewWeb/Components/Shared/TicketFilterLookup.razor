<CreationSearchPicker TItem="TicketFilterOptionDto" LookupUrl="@LookupUrl" Label="@Label" Kind="options"
                      Placeholder="@(Dimension == "customer" ? "All authorized tenants" : "Type to search")"
                      ItemId="option => option.Id" ItemLabel="option => option.Label"
                      SelectionChanged="Choose" ClearAfterSelection="true" LoadOnOpen="true" />

@code {
    [Parameter] public string Module { get; set; } = "incident";
    [Parameter] public string Dimension { get; set; } = "customer";
    [Parameter] public string Label { get; set; } = "Customer";
    [Parameter] public List<string> OrganizationIds { get; set; } = [];
    [Parameter] public EventCallback<TicketFilterOptionDto> Selected { get; set; }
    private string LookupUrl => $"api/v1/ticketing/filter-options?picker=true&module={Uri.EscapeDataString(Module)}&dimension={Uri.EscapeDataString(Dimension)}"
        + string.Concat(OrganizationIds.Order(StringComparer.Ordinal).Select(id => $"&customerOrgId={Uri.EscapeDataString(id)}"));

    private Task Choose(TicketFilterOptionDto? option) =>
        option is null ? Task.CompletedTask : Selected.InvokeAsync(option);
}
