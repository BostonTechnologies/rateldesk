@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<AiAssistantComposer> Logger

<div class="chat-composer" @ref="root" data-testid="ai-assistant-composer">
    <textarea aria-label="Message Netclaw" placeholder="Message Netclaw…" rows="3"
              @bind:get="Value" @bind:set="ChangedAsync" @bind:event="oninput" disabled="@Disabled" readonly="@ReadOnly" maxlength="16000"></textarea>
    <div class="composer-actions">
        <span class="composer-identity"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /><span>Netclaw</span>
            @if (!string.IsNullOrWhiteSpace(Identity)) { <span>· @Identity</span> }
        </span>
        <button type="button" class="composer-send" data-chat-send disabled="@(Disabled || submitting || string.IsNullOrWhiteSpace(Value))" @onclick="SendAsync">
            <span>@SendLabel</span><MudIcon Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" />
        </button>
    </div>
</div>
<p class="composer-hint">Enter to send · Alt+Enter for a new line</p>
@if (ShowAttachmentNotice) { <p class="composer-notice">Text messages only. Ticket attachments are not automatically shared.</p> }

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ShowAttachmentNotice { get; set; } = true;
    [Parameter] public string Identity { get; set; } = "";
    [Parameter] public string SendLabel { get; set; } = "Send";
    [Parameter] public EventCallback Send { get; set; }
    private ElementReference root;
    private IJSObjectReference? module;
    private bool disposed;
    private bool submitting;
    private DotNetObjectReference<AiAssistantComposer>? reference;
    private Task ChangedAsync(string value) => ValueChanged.InvokeAsync(value);
    private Task SendAsync() => SubmitAsync(Value);
    [JSInvokable] public Task SubmitFromInputAsync(string text) => InvokeAsync(() => SubmitAsync(text));
    private async Task SubmitAsync(string text)
    {
        if (disposed || Disabled || submitting || string.IsNullOrWhiteSpace(text)) return;
        submitting = true;
        try
        {
            // The DOM value includes the last keystroke even when the input callback is still queued.
            if (!ReadOnly) await ValueChanged.InvokeAsync(text);
            if (!disposed && !Disabled) await Send.InvokeAsync();
        }
        finally { submitting = false; }
    }
    public async Task FocusAsync() { if (module is not null) await module.InvokeVoidAsync("focus", root); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (firstRender)
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/AiAssistantComposer.razor.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attach", root, reference);
        }
        if (module is not null && !disposed) await module.InvokeVoidAsync("resize", root);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is null) return;
        try
        {
            try { await module.InvokeVoidAsync("detach", root); }
            finally { await module.DisposeAsync(); }
        }
        catch (JSDisconnectedException) { Logger.LogDebug("Chat composer circuit disconnected during disposal."); }
        finally { reference?.Dispose(); }
    }
}
