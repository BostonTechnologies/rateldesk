@using Helpdesk.Shared.Auth

<fieldset class="permission-selector" aria-label="Ordinary credential permissions" data-testid="credential-permission-selector">
    <legend>Permissions</legend>
    <label class="permission-search">Search eligible permissions
        <input type="search" value="@search" @oninput="SearchChanged" placeholder="Search permissions" />
    </label>
    <p aria-live="polite">@Selected.Count selected / @Eligible.Count available. @Displayed.Count shown.</p>
    <div class="permission-actions">
        <button type="button" @onclick="SelectDisplayedAsync" disabled="@(Disabled || Displayed.Count == 0)">Select @Displayed.Count displayed eligible permissions</button>
        <button type="button" @onclick="ClearAsync" disabled="@(Disabled || Selected.Count == 0)">Clear selection</button>
    </div>
    @if (Selected.Count > 0)
    {
        <p class="permission-selected">Selected (including search-hidden): @string.Join(", ", Selected.Order(StringComparer.OrdinalIgnoreCase))</p>
    }
    <div class="permission-groups">
        @foreach (var group in Displayed.GroupBy(Category))
        {
            <section aria-label="@($"{group.Key} permissions")" @key="group.Key">
                <div class="permission-group-heading">
                    <strong>@group.Key</strong>
                    <button type="button" @onclick="() => SelectGroupAsync(group.Key)" disabled="@Disabled">Select displayed @group.Key</button>
                    <button type="button" @onclick="() => ClearGroupAsync(group.Key)" disabled="@Disabled">Clear @group.Key</button>
                </div>
                @foreach (var permission in group)
                {
                    <label class="permission-choice" @key="permission"><input type="checkbox" checked="@Selected.Contains(permission)" @onchange="args => ToggleAsync(permission, args)" disabled="@Disabled" /> @permission</label>
                }
            </section>
        }
    </div>
    @if (Eligible.Count == 0) { <p>Choose an authorized organization to view eligible permissions.</p> }
    @if (FormFieldName is not null)
    {
        @foreach (var permission in Selected.Order(StringComparer.OrdinalIgnoreCase))
        {
            <input type="hidden" name="@FormFieldName" value="@permission" />
        }
    }
</fieldset>

@code {
    [Parameter] public IEnumerable<string> EligiblePermissions { get; set; } = [];
    [Parameter] public IEnumerable<string> SelectedValues { get; set; } = [];
    [Parameter] public EventCallback<IEnumerable<string>> SelectedValuesChanged { get; set; }
    [Parameter] public string? FormFieldName { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string search = "";
    private IReadOnlyList<string> Eligible => EligiblePermissions
        .Where(p => HelpdeskPermissions.AssignablePermissions.Contains(p, StringComparer.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
    private HashSet<string> Selected => SelectedValues.Intersect(Eligible, StringComparer.OrdinalIgnoreCase).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> Displayed => Eligible.Where(p => p.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private static string Category(string permission) => permission.Split('.')[0];
    private void SearchChanged(ChangeEventArgs args) => search = args.Value?.ToString() ?? "";
    private Task SelectDisplayedAsync() => ChangeAsync(Selected.Union(Displayed, StringComparer.OrdinalIgnoreCase));
    private Task SelectGroupAsync(string category) => ChangeAsync(Selected.Union(Displayed.Where(p => Category(p) == category), StringComparer.OrdinalIgnoreCase));
    private Task ClearGroupAsync(string category) => ChangeAsync(Selected.Where(p => Category(p) != category));
    private Task ClearAsync() => ChangeAsync([]);
    private Task ToggleAsync(string permission, ChangeEventArgs args)
    {
        var values = Selected;
        if (args.Value is true) values.Add(permission); else values.Remove(permission);
        return ChangeAsync(values);
    }
    private Task ChangeAsync(IEnumerable<string> values) => Disabled ? Task.CompletedTask :
        SelectedValuesChanged.InvokeAsync(values.Intersect(Eligible, StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray());
}
