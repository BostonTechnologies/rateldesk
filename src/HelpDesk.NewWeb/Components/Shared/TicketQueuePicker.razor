@using Helpdesk.Shared.DTOs.TicketQueue

<div class="ticket-queue-picker">
    <CreationSearchPicker TItem="TicketQueueOptionDto" LookupUrl="@LookupUrl" Value="@Value"
                          Label="@Label" Placeholder="@Placeholder" Kind="queues" Disabled="@Disabled"
                          ItemId="@(queue => queue.Id ?? MainQueue)" ItemLabel="@(queue => queue.Name)"
                          SelectionChanged="@SelectionChanged" />
</div>

@code {
    public const string MainQueue = "main";
    [Parameter, EditorRequired] public string Module { get; set; } = "";
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Label { get; set; } = "Queue";
    [Parameter] public string Placeholder { get; set; } = "All authorized queues";
    [Parameter] public bool Transfer { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<TicketQueueOptionDto?> SelectionChanged { get; set; }

    private string LookupUrl => Transfer && string.IsNullOrWhiteSpace(OrganizationId)
        ? ""
        : $"api/v1/ticket-queues/{Module}?picker=true&transfer={Transfer.ToString().ToLowerInvariant()}" +
          (OrganizationId == null ? "" : "&organizationId=" + Uri.EscapeDataString(OrganizationId));
}
