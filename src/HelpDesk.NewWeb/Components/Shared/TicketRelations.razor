@using Helpdesk.Shared.Enums
@using Helpdesk.Shared.DTOs.Incident
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<MudStack Spacing="2">
    @if (!ReadOnly)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
            <MudSelect T="string" Label="Ticket type" @bind-Value="SelectedType" Dense="true" Style="max-width:10rem">
                <MudSelectItem Value="@string.Empty">All types</MudSelectItem>
                <MudSelectItem Value='@("incidents")'>Incident</MudSelectItem>
                <MudSelectItem Value='@("requests")'>Request</MudSelectItem>
                <MudSelectItem Value='@("changes")'>Change</MudSelectItem>
                <MudSelectItem Value='@("request-tasks")'>Request task</MudSelectItem>
            </MudSelect>
            <MudAutocomplete T="TicketLinkChoice" Label="Reference or title" @bind-Value="selected"
                             SearchFunc="SearchAsync" ToStringFunc="@(x => x is null ? string.Empty : x.Reference + " — " + x.Title)"
                             MinCharacters="1" DebounceInterval="250" Dense="true" Clearable="true" MaxItems="25"
                             Style="min-width:12rem;flex:1">
                <ItemTemplate><span>@context.Type · @context.Reference — @context.Title</span></ItemTemplate>
            </MudAutocomplete>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(selected is null || linking)" OnClick="LinkAsync">Link ticket</MudButton>
        </MudStack>
    }
    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@error <MudButton Size="Size.Small" OnClick="ReloadAsync">Retry</MudButton></MudAlert>
    }
    <MudTable T="TicketRelationDto" @ref="table" ServerData="LoadAsync" Dense="true" Hover="true" Elevation="0"
              Class="compact-table" FixedHeader="true" FixedFooter="true" Height="320px"
              data-table-surface="shared-ticketrelations-1" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Relation</MudTh><MudTh>Ticket</MudTh><MudTh>State</MudTh><MudTh>Created</MudTh><MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Relation">@RelationLabel(context)</MudTd>
            <MudTd DataLabel="Ticket">
                <MudStack Spacing="0">
                    <MudLink Href="@OtherUrl(context)">@OtherReference(context)</MudLink>
                    <MudText Typo="Typo.caption">@OtherType(context) · @OtherTitle(context)</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="State">@(context.IsOutgoing ? context.TargetLifecycleState ?? context.TargetState.ToString() : context.SourceLifecycleState ?? context.SourceState.ToString())</MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc.ToLocalTime().ToString("g")</MudTd>
            <MudTd>
                <div class="workspace-actions">
                    <WorkspaceAction Icon="@Icons.Material.Filled.OpenInNew" Label="Open related ticket in new tab" Href="@OtherUrl(context)" Target="_blank" />
                    <WorkspaceAction Icon="@Icons.Material.Filled.Close" Label="Remove neutral relation"
                                     Disabled="@(ReadOnly || context.RelationType != TicketRelationType.RelatedTo || deleting.Contains(context.Id))"
                                     OnClick="@(() => DeleteRelationAsync(context))" />
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Typo="Typo.body2">No visible ticket relations.</MudText></NoRecordsContent>
        <LoadingContent><MudText Typo="Typo.body2">Loading relations…</MudText></LoadingContent>
        <PagerContent><MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" /></PagerContent>
    </MudTable>
</MudStack>

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string TicketId { get; set; } = string.Empty;
    [Parameter] public string TicketType { get; set; } = "incidents";
    [Parameter] public EventCallback<int> OnRelationsLoaded { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private MudTable<TicketRelationDto>? table;
    private TicketLinkChoice? selected;
    private string selectedType = string.Empty;
    private string SelectedType { get => selectedType; set { selectedType = value; selected = null; lookupGeneration++; } }
    private readonly HashSet<Guid> deleting = [];
    private string? error;
    private string? loadedId;
    private bool linking;
    private int lookupGeneration;
    private string BasePath => $"api/v1/tickets/{Uri.EscapeDataString(TicketId)}/relations";
    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == TicketId) return;
        loadedId = TicketId; lookupGeneration++; selected = null;
        if (table is not null) await table.ReloadServerData();
    }
    private async Task<TableData<TicketRelationDto>> LoadAsync(TableState state, CancellationToken ct)
    {
        try
        {
            error = null;
            if (string.IsNullOrWhiteSpace(TicketId)) return new() { Items = [], TotalItems = 0 };
            var page = await HelpdeskApi.GetFromJsonAsync<TicketRelationPage>($"{BasePath}/?page={state.Page + 1}&pageSize={state.PageSize}", ct);
            await OnRelationsLoaded.InvokeAsync(page?.TotalCount ?? 0);
            return new() { Items = page?.Items ?? [], TotalItems = page?.TotalCount ?? 0 };
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return new() { Items = [], TotalItems = 0 }; }
        catch (HttpRequestException) { error = "Relations could not be loaded. Check your current access and retry."; return new() { Items = [], TotalItems = 0 }; }
    }
    private async Task<IEnumerable<TicketLinkChoice>> SearchAsync(string query, CancellationToken ct)
    {
        var generation = ++lookupGeneration; var id = TicketId; var type = selectedType;
        try
        {
            var result = await HelpdeskApi.GetFromJsonAsync<TicketLinkChoicePage>($"{BasePath}/choices?search={Uri.EscapeDataString(query)}&type={Uri.EscapeDataString(type)}&pageSize=25", ct);
            return generation == lookupGeneration && id == TicketId && type == selectedType ? result?.Items ?? [] : [];
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { return []; }
        catch (HttpRequestException) { error = "Ticket search is unavailable for the current scope."; return []; }
    }
    private Task ReloadAsync() => table?.ReloadServerData() ?? Task.CompletedTask;
    private async Task LinkAsync()
    {
        if (selected is null || linking) return;
        linking = true;
        try
        {
            using var result = await HelpdeskApi.PostAsJsonAsync(BasePath + "/", new LinkTicketRequest(selected.Id));
            if (!result.IsSuccessStatusCode) { error = "The selected tickets cannot currently be linked. Refresh your selection and permissions."; return; }
            selected = null; await ReloadAsync();
        }
        catch (HttpRequestException) { error = "Linking failed. Refresh relations before retrying."; }
        finally { linking = false; }
    }
    private async Task DeleteRelationAsync(TicketRelationDto relation)
    {
        if (!deleting.Add(relation.Id)) return;
        try
        {
            using var result = await HelpdeskApi.DeleteAsync($"{BasePath}/{relation.Id:D}");
            if (!result.IsSuccessStatusCode) { error = "The relation cannot currently be removed."; return; }
            await ReloadAsync();
        }
        catch (HttpRequestException) { error = "Removing the relation failed. Refresh and retry."; }
        finally { deleting.Remove(relation.Id); }
    }
    private static string RelationLabel(TicketRelationDto r) => r.RelationType switch
    {
        TicketRelationType.AutomationFailureOf => r.IsOutgoing ? "Automation failure of" : "Has automation failure",
        TicketRelationType.DuplicateOf => r.IsOutgoing ? "Duplicate of" : "Has duplicate",
        _ => "Related to"
    };
    private static string OtherUrl(TicketRelationDto r) => r.IsOutgoing ? r.TargetUrl : r.SourceUrl;
    private static string OtherType(TicketRelationDto r) => r.IsOutgoing ? r.TargetType : r.SourceType;
    private static string OtherReference(TicketRelationDto r) => r.IsOutgoing ? r.TargetTrackingId : r.SourceTrackingId;
    private static string OtherTitle(TicketRelationDto r) => r.IsOutgoing ? r.TargetSubject : r.SourceSubject;
}
