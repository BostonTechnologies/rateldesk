@using Helpdesk.Shared.DTOs.Organization

<CreationSearchPicker TItem="OrganizationDto" LookupUrl="@LookupUrl" Value="@Value"
                      ItemId="@(item => item.Id)" ItemLabel="Format"
                      Label="Organization" Kind="organizations" Placeholder="Search organization name"
                      Required="@Required" Disabled="@Disabled" Margin="@Margin"
                      AutoSelectSingle="@AutoSelectSingle" LockWhenSingle="@LockWhenSingle"
                      SelectionChanged="SelectionChanged" SelectedItemLoaded="SelectedItemLoaded">
    <ItemTemplate Context="organization">
        <span class="d-flex flex-column py-1">
            <span class="mud-typography mud-typography-body2" style="overflow-wrap:anywhere">@organization.Name</span>
            @if (!string.IsNullOrWhiteSpace(organization.DnsName)) { <span class="mud-typography mud-typography-caption">@organization.DnsName</span> }
        </span>
    </ItemTemplate>
</CreationSearchPicker>

@code {
    [Parameter] public string Module { get; set; } = "incident";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<OrganizationDto?> SelectionChanged { get; set; }
    [Parameter] public EventCallback<OrganizationDto?> SelectedItemLoaded { get; set; }
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoSelectSingle { get; set; } = true;
    [Parameter] public bool LockWhenSingle { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    private string LookupUrl => $"api/v1/ticketing/organizations/search?module={Uri.EscapeDataString(Module)}";
    private static string Format(OrganizationDto item) => string.IsNullOrWhiteSpace(item.DnsName) ? item.Name : $"{item.Name} ({item.DnsName})";
}
