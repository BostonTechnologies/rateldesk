@using Helpdesk.Shared.AiAssistant.Chat
@using System.Text.Json
@using HelpDesk.NewWeb.Services
@using System.Security.Claims
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<AiAssistantChat> Logger
@inject IDialogService Dialogs

@if (capabilities is { Enabled: false, CanViewHistory: false })
{
    <MudAlert Severity="Severity.Info">@capabilities.Reason</MudAlert>
    @if (OrganizationId is null) { <TicketAiAssistant TicketId="@TicketId" TicketType="@TicketType" /> }
    @if (capabilities.SetupUrl is { } setup) { <MudLink Href="@setup">Configure AI providers</MudLink> }
}
else
{
<div @ref="root" class="ai-conversation-surface @(Workspace ? "ai-chat-workspace" : "") @(fullscreen ? "ai-chat-fullscreen" : "")" role="@(fullscreen ? "dialog" : "region")" aria-modal="@(fullscreen ? "true" : null)" aria-label="Conversation" data-pending-scheduled-reports="@PendingScheduledReports">
<header class="conversation-header">
    <div class="conversation-identity"><span class="conversation-avatar"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /></span><div><h2>@Title</h2><small>@(string.IsNullOrWhiteSpace(Identity) ? StateLabel(state) : $"{Identity} · {StateLabel(state)}")</small></div></div>
    <div class="conversation-actions">
        @if (state is ChatState.Processing or ChatState.WaitingForChildren || state == ChatState.WaitingForScheduledReports && !CanReply)
        {
            <MudTooltip Text="Stop waiting"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.StopCircle" aria-label="Stop waiting" Disabled="@(busy || capabilities?.CanWrite == false || UnresolvedMessageId is null)" OnClick="StopWaitingAsync" /></MudTooltip>
        }
        @if (provider is (ChatProviderKind.OpenAiAgents or ChatProviderKind.CodexAppServer) && state is (ChatState.Processing or ChatState.AwaitingApproval or ChatState.WaitingForChildren or ChatState.DeliveryUnknown))
        {
            <MudTooltip Text="Cancel remote turn"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Cancel"
                aria-label="Cancel remote turn" Disabled="@(busy || capabilities?.CanWrite == false || UnresolvedMessageId is null)" OnClick="CancelRemoteAsync" /></MudTooltip>
        }
        @if (state != ChatState.Archived && (Archive.HasDelegate || OrganizationId is null && InvestigationId is null))
        {
            <MudTooltip Text="Archive conversation"><MudIconButton Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" aria-label="Archive conversation" Disabled="@(busy || capabilities?.CanWrite == false || state != ChatState.Idle || conversation == Guid.Empty || (!Archive.HasDelegate && capabilities?.Enabled == false))" OnClick="ArchiveCurrentAsync" /></MudTooltip>
        }
        <MudTooltip Text="@(fullscreen ? "Restore conversation" : "Maximise conversation")"><MudIconButton Size="Size.Small" Icon="@(fullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" aria-label="@(fullscreen ? "Restore conversation" : "Maximise conversation")" Disabled="@(module is null || conversation == Guid.Empty)" OnClick="ToggleFullscreenAsync" /></MudTooltip>
        <div class="chat-settings-anchor">
            <MudTooltip Text="Chat display settings"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Settings" aria-label="Chat display settings" aria-expanded="@settingsOpen.ToString().ToLowerInvariant()" data-chat-popover-trigger="settings" OnClick="@(() => settingsOpen = !settingsOpen)" /></MudTooltip>
            @if (settingsOpen)
            {
                <div class="chat-display-settings" popover="manual" role="dialog" aria-label="Chat display settings" data-chat-popover="settings">
                    <strong>Chat display settings</strong>
                    <label><input type="checkbox" checked="@preferences.Compact" @onchange="e => SavePreferenceAsync(() => preferences.Compact = e.Value is true)" />Compact tool rows</label>
                    <label><input type="checkbox" checked="@preferences.ShowTimestamps" @onchange="e => SavePreferenceAsync(() => preferences.ShowTimestamps = e.Value is true)" />Timestamps</label>
                    <label><input type="checkbox" checked="@preferences.ShowIdentifiers" @onchange="e => SavePreferenceAsync(() => preferences.ShowIdentifiers = e.Value is true)" />Call IDs on rows</label>
                    <label><input type="checkbox" checked="@preferences.AutoExpand" @onchange="e => SavePreferenceAsync(() => preferences.AutoExpand = e.Value is true)" />Expand details automatically</label>
                    <label><input type="checkbox" checked="@preferences.ShowUsage" @onchange="e => SavePreferenceAsync(() => preferences.ShowUsage = e.Value is true)" />Token usage</label>
                    <label><input type="checkbox" checked="@preferences.ShowProcessing" @onchange="e => SavePreferenceAsync(() => preferences.ShowProcessing = e.Value is true)" />Processing trace</label>
                    <label><input type="checkbox" checked="@preferences.ShowCompaction" @onchange="e => SavePreferenceAsync(() => preferences.ShowCompaction = e.Value is true)" />Compaction</label>
                    <label><input type="checkbox" checked="@preferences.ShowSubagents" @onchange="e => SavePreferenceAsync(() => preferences.ShowSubagents = e.Value is true)" />Subagent activity</label>
                    @if (provider == ChatProviderKind.OpenAiAgents && state is (ChatState.Idle or ChatState.Archived))
                    {
                        <button type="button" disabled="@(busy || capabilities?.CanWrite == false)" @onclick="CleanupRemoteAsync">Delete remote session</button>
                    }
                    @if (OrganizationId is not null && SavedContext is not null) { <div class="conversation-context">@SavedContext</div> }
                </div>
            }
        </div>
        @if (conversation != Guid.Empty && (ShowConnectionStatus || fullscreen))
        {
            <AiNetclawConnectionStatus ApiRoute="@Route" OrganizationName="@Identity" ConversationId="conversation" />
        }
    </div>
</header>
<div class="ai-chat-content"><div class="ai-chat-scroll">
    @if (OrganizationId is null && SavedContext is not null) { <div class="conversation-context">@SavedContext</div> }
    @if (capabilities is { Enabled: false, Reason: { } providerReason })
    {
        <MudAlert Severity="Severity.Info" Dense="true">@providerReason</MudAlert>
    }
    @if (conversation != Guid.Empty && connectionStatus != "Connected" && state != ChatState.Archived)
    {
        <p class="ai-chat-live-status" role="status">Live updates: @connectionStatus</p>
    }
    @if (OrganizationId is null && InvestigationId is null && history.Count > 0)
    {
        <MudSelect T="Guid" Label="Conversation history" Value="conversation" ValueChanged="SelectConversationAsync" Disabled="busy">
            @foreach (var entry in history)
            {
                <MudSelectItem T="Guid" Value="entry.ConversationId">@(entry.State == ChatState.Archived ? "Archived" : "Current") · @entry.LastActivityUtc.ToLocalTime().ToString("g") · @ActorLabel(entry.CreatedByUserId)</MudSelectItem>
            }
        </MudSelect>
        @if (hasOlderHistory) { <MudButton Disabled="busy" OnClick="LoadOlderHistoryAsync">Older conversations</MudButton> }
    }
    @if (OrganizationId is null && InvestigationId is null && capabilities?.Profiles is { Count: > 1 } available)
    {
        <ChatProviderSelector Profiles="available" Label="Provider for next conversation" @bind-Value="nextProfile"
                              Disabled="@(busy || capabilities.CanWrite == false || state != ChatState.Idle)" />
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(busy || capabilities.CanWrite == false || state != ChatState.Idle)" OnClick="NewAsync">Start new conversation</MudButton>
    }
    @if (state == ChatState.Archived)
    {
        <MudAlert Severity="Severity.Info">Archived transcript — read-only. Its remote session is not resumed.</MudAlert>
        @if (OrganizationId is null && InvestigationId is null) { <MudButton Disabled="busy" OnClick="@(() => SelectConversationAsync(Guid.Empty))">Return to current conversation</MudButton> }
    }
    @if (state == ChatState.DeliveryUnknown)
    {
        @if (continuation?.ScheduledWorkUnconfirmed == true)
        {
            <MudAlert Severity="Severity.Warning">
                <strong>Scheduled report unconfirmed</strong>
                <p>@recoveryResult</p>
                @if (continuation.ScheduledReports is { Length: > 0 } reports)
                {
                    <p>Reminder IDs @string.Join(", ", reports.Select(report => report.Id))</p>
                }
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning">Delivery or completion could not be confirmed. AiAssistant may already have accepted this turn. Checking the session never resends it.</MudAlert>
            @if (recoveryResult is not null) { <MudAlert Severity="Severity.Info">@recoveryResult</MudAlert> }
            <MudButton Disabled="@(busy || capabilities?.CanWrite == false)" OnClick="ReconcileAsync">Check saved session</MudButton>
        }
        @if (recoveryAt is not null) { <small>Last check: @recoveryAt.Value.UtcDateTime.ToString("u") · reference @conversation</small> }
        @if (capabilities?.CanWrite != false) {
        <MudCheckBox T="bool" @bind-Value="acknowledgeAbandon" Disabled="busy" Label="I understand the old turn may still execute. Archive this transcript without retrying it. Remote side effects may already have occurred." />
        <MudButton Color="Color.Warning" Disabled="@(busy || !acknowledgeAbandon || UnresolvedMessageId is null)" OnClick="AbandonAsync">Abandon unresolved turn and archive</MudButton>
        }
    }
    @if (state is ChatState.Processing or ChatState.AwaitingApproval or ChatState.WaitingForChildren or ChatState.WaitingForScheduledReports)
    {
        <div role="status" data-testid="chat-observation-status" class="pa-3">
            <strong>@(state switch
            {
                ChatState.AwaitingApproval => "Waiting for your decision",
                ChatState.WaitingForChildren => "Waiting for delegated follow-ups",
                ChatState.WaitingForScheduledReports => "Waiting for scheduled reports",
                _ => $"Awaiting {ProviderName}"
            })</strong>
            <p>@(recoveryResult ?? "RatelDesk keeps observing this request. A connection does not prove that the task is complete.")</p>
            @if (events.LastOrDefault(item => item.Type == "operator") is { } activeInput)
            {
                <small>Elapsed: @TimeSpan.FromTicks(Math.Max(0, (DateTimeOffset.UtcNow - activeInput.CreatedUtc).Ticks)).ToString("g")</small>
            }
            @if (events.LastOrDefault(item => item.Type is "assistant" or "tool_call" or "tool_result" or "usage" or "approval_request" or "error") is { } activity)
            {
                <small> · Last saved remote activity: @activity.CreatedUtc.UtcDateTime.ToString("u")</small>
            }
        </div>
    }
    @foreach (var registration in backgroundReports.Select(binding => binding.Parent).Append(continuation).OfType<ChatTurnCompletion>())
    {
        @if (registration.ScheduledReports?.Any(report => !report.Unconfirmed) == true)
        {
            <div class="ai-chat-live-status">
                @foreach (var report in registration.ScheduledReports.Where(report => !report.Unconfirmed))
                {
                    <span>Scheduled report @report.Id · @(report.DueAtUtc?.UtcDateTime.ToString("u") ?? "Due time unknown")</span>
                }
                <button type="button" disabled="@(busy || capabilities?.CanWrite == false)" @onclick="() => StopScheduledAsync(registration.OperatorMessageId)">Stop observing reports</button>
            </div>
        }
    }
    @if (error is not null) { <MudAlert Severity="Severity.Warning">@error</MudAlert> }
    <div class="@(Workspace ? "ai-chat-transcript" : null)" role="@(Workspace ? "log" : null)" aria-label="@(Workspace ? "Saved conversation" : null)">
    @if (Workspace && events.All(x => x.Type != "operator") && conversation != Guid.Empty && state == ChatState.Idle)
    {
        <p class="ai-chat-empty">@(OrganizationId is null ? "Your ticket context is saved. Ask a question to begin the investigation." : "Your organization guidance is saved. Send a message to begin. No tickets are included.")</p>
    }
    @foreach (var turn in AiAssistantChatPresentation.Build(events))
    {
        <section @key="turn.Operator.Sequence" class="ai-assistant-turn" data-testid="ai-assistant-turn">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.caption">@ActorLabel(turn.Operator.CreatedByUserId) · @turn.Operator.CreatedUtc.ToLocalTime().ToString("g")</MudText>
                <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere">@turn.Operator.Text</MudText>
            </MudPaper>
            @if (turn.Operations.Count > 0 || !turn.Completed || turn.HasError || turn.Activity.Any(VisibleActivity)
                || turn.NativeTurns.Any(x => x.QuietEnd || x.TurnOutcome == "skipped"))
            {
                <AiAssistantTurnActivity Turn="turn" State="state" Busy="@(busy || capabilities?.CanWrite == false)" Preferences="preferences" Approval="@(answer => ApproveAsync(answer.CallId, answer.Key))" />
            }
            @foreach (var response in turn.Responses)
            {
                <div class="pa-3" data-testid="ai-assistant-response">
                    <MudText Typo="Typo.caption">@ProviderName · @response.CreatedUtc.ToLocalTime().ToString("t")</MudText>
                    <AiAssistantMarkdown Text="@response.Text" />
                </div>
            }
        </section>
    }
    @if (artifacts.Count > 0)
    {
        <div class="pa-3" aria-label="Conversation artifacts">
            @foreach (var artifact in artifacts)
            {
                <MudButton StartIcon="@Icons.Material.Outlined.Download" Size="Size.Small" Disabled="@(module is null)"
                           OnClick="@(() => DownloadArtifactAsync(artifact))">@artifact.Name</MudButton>
            }
        </div>
    }
    @if (draft.Length > 0) { <div class="pa-3" data-testid="ai-assistant-draft"><AiAssistantMarkdown Text="@draft" /></div> }
    </div>
    </div>
    <div class="@(Workspace ? "ai-chat-composer" : null)">
    @if (provider is ChatProviderKind.OpenAiAgents or ChatProviderKind.CodexAppServer)
    {
        <MudText Typo="Typo.caption">@(provider == ChatProviderKind.CodexAppServer ? "Using ChatGPT plan" : "API project billing")</MudText>
    }
    <AiAssistantComposer @key="conversation" @bind-Value="message" Send="SendAsync" DraftScope="@draftScope" Discard="DiscardDraftAsync" ReadOnly="@(submittedMessage is not null)" SendLabel="@(submittedMessage is null ? "Send" : "Retry message")" Identity="@Identity" ProviderName="@ProviderName" ShowAttachmentNotice="@(OrganizationId is null)" Disabled="@(busy || capabilities?.CanWrite == false || capabilities?.Enabled == false || !CanReply || conversation == Guid.Empty)" />
    </div>
</div>
</div>

}

@code {
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public Guid? SelectedConversationId { get; set; }
    [Parameter] public string Title { get; set; } = "AI Assistant";
    [Parameter] public string Identity { get; set; } = "";
    [Parameter] public RenderFragment? SavedContext { get; set; }
    [Parameter] public EventCallback Archive { get; set; }
    [Parameter] public Guid? InvestigationId { get; set; }
    [Parameter] public bool Workspace { get; set; }
    [Parameter] public bool ShowConnectionStatus { get; set; } = true;
    [Parameter] public EventCallback<ChatState> StateChanged { get; set; }
    [Parameter] public string TicketId { get; set; } = string.Empty;
    [Parameter] public string TicketType { get; set; } = "incidents";
    [Parameter] public string? TicketOrganizationId { get; set; }
    private readonly List<AiAssistantChatEvent> events = [];
    private readonly List<ChatConversationSummary> history = [];
    private readonly CancellationTokenSource cancellation = new();
    private CancellationTokenSource? streamCancellation;
    private Task stream = Task.CompletedTask;
    private Task selection = Task.CompletedTask;
    private bool disposed;
    private Guid conversation, messageId = Guid.NewGuid();
    private ChatMessageRequest? submittedMessage;
    private ChatState state;
    private string message = "", draft = "";
    private string? error;
    private ChatCapabilities? capabilities;
    private ChatProviderKind provider;
    private Guid? providerProfileId, nextProfile;
    private IReadOnlyList<ChatProviderArtifact> artifacts = [];
    private string ProviderName => capabilities?.Profiles?.FirstOrDefault(item => item.Id == providerProfileId)?.Name
        ?? (provider switch
        {
            ChatProviderKind.OpenAiAgents => "OpenAI Agents",
            ChatProviderKind.CodexAppServer => "Codex App Server",
            _ => "Netclaw"
        });
    private long cursor;
    private bool busy;
    private bool acknowledgeAbandon, hasOlderHistory;
    private Guid resolutionId = Guid.NewGuid();
    private ElementReference root;
    private IJSObjectReference? module;
    private DotNetObjectReference<AiAssistantChat>? reference;
    private bool fullscreen, settingsOpen;
    private ChatDisplayPreferences preferences = new();
    private string? recoveryResult;
    private DateTimeOffset? recoveryAt;
    private ChatTurnCompletion? continuation;
    private ChatScheduledBinding[] backgroundReports = [];
    private bool CanReply => state == ChatState.Idle || state == ChatState.WaitingForScheduledReports
        && continuation is { TurnOutcome: "completed" } && (continuation.PendingChildRunIds ?? continuation.OpenChildRunIds) is not { Length: > 0 };
    private int PendingScheduledReports => (continuation?.ScheduledReports?.Count(report => !report.Unconfirmed) ?? 0)
        + backgroundReports.Sum(binding => binding.Parent.ScheduledReports?.Count(report => !report.Unconfirmed) ?? 0);
    private string connectionStatus = "Connecting";
    private string? currentActor, draftScope;
    private ChatDraftStorage? draftStorage;
    private ChatIdentitySnapshot? identity;
    private string ActorLabel(string? actor) => actor == currentActor && currentActor is not null ? "You" : "Helpdesk operator";
    private static string StateLabel(ChatState value) => value switch { ChatState.Idle => "Ready", ChatState.Processing => "Working", ChatState.WaitingForChildren => "Waiting for delegated work", ChatState.WaitingForScheduledReports => "Waiting for scheduled reports", ChatState.AwaitingApproval => "Needs a decision", ChatState.DeliveryUnknown => "Needs recovery", _ => "Archived" };
    private bool VisibleActivity(AiAssistantChatEvent item) => item.Type switch
    {
        "usage" => preferences.ShowUsage, "processing_state" => preferences.ShowProcessing,
        "compaction" => preferences.ShowCompaction, "subagent" => preferences.ShowSubagents, _ => true
    };
    private Guid? UnresolvedMessageId => events.LastOrDefault(x => x.Type == "operator")?.ClientMessageId;
    private string Route => OrganizationId is null ? $"api/v1/{TicketType}/{TicketId}/ai-assistant/chat" : $"api/v1/ai/chat/organizations/{Uri.EscapeDataString(OrganizationId)}";
    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    private HttpClient Commands => HttpClientFactory.CreateClient("HelpdeskChatCommands");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var ct = cancellation.Token;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (disposed) return;
        identity = new(user);
        AuthenticationStateProvider.AuthenticationStateChanged += IdentityChanged;
        currentActor = ChatDraftStorage.Actor(user);
        draftStorage = new(JS, Logger);
        try
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/AiAssistantChat.razor.js");
            if (disposed) { if (imported is not null) await imported.DisposeAsync(); return; }
            module = imported;
            if (module is null) return;
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("watchPopover", root, reference, "settings");
            var stored = await module.InvokeAsync<string?>("readPreferences", currentActor);
            if (stored is not null) { try { preferences = JsonSerializer.Deserialize<ChatDisplayPreferences>(stored) ?? new(); } catch (JsonException ex) { Logger.LogDebug(ex, "Saved chat display preferences were invalid."); } }
        }
        catch (JSException ex) { Logger.LogDebug(ex, "Enhanced chat presentation is unavailable."); }
        try
        {
            using var api = Api;
            capabilities = await api.GetFromJsonAsync<ChatCapabilities>(
                OrganizationId is null ? $"api/v1/{TicketType}/{TicketId}/ai-assistant/chat-capabilities" : $"{Route}/capabilities", ct);
            if (capabilities is { Enabled: false, CanViewHistory: false })
            {
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (HttpRequestException)
        {
            error = "Unable to check AI Assistant availability. Refresh to try again.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return; }
        if (disposed) return;
        await SelectConversationAsync(SelectedConversationId ?? InvestigationId ?? Guid.Empty);
        if (!disposed) await InvokeAsync(StateHasChanged);
    }

    private Task SelectConversationAsync(Guid id) => selection = SelectCoreAsync(id);

    private async Task SelectCoreAsync(Guid id)
    {
        if (disposed) return;
        busy = true;
        try
        {
            var previousCancellation = streamCancellation;
            streamCancellation = null;
            if (previousCancellation is not null)
            {
                try { await previousCancellation.CancelAsync(); await stream; }
                finally { previousCancellation.Dispose(); }
            }
            stream = Task.CompletedTask;
            if (disposed) return;
            connectionStatus = "Connecting"; error = null;
            backgroundReports = []; continuation = null; recoveryResult = null; recoveryAt = null;
            events.Clear(); artifacts = []; draft = ""; cursor = 0; acknowledgeAbandon = false;
            resolutionId = Guid.NewGuid(); messageId = Guid.NewGuid(); message = ""; submittedMessage = null; draftScope = null; conversation = Guid.Empty;
            using var api = Api;
            if (id == Guid.Empty && OrganizationId is null && capabilities is { Enabled: false, CanViewHistory: true })
            {
                var available = await api.GetFromJsonAsync<ChatConversationSummary[]>($"{Route}/history", cancellation.Token) ?? [];
                if (available.Length == 0) return;
                id = available[0].ConversationId;
            }
            var snapshot = await api.GetFromJsonAsync<ChatSnapshot>(id == Guid.Empty ? Route : $"{Route}?conversationId={id}", cancellation.Token);
            if (snapshot is not null)
            {
                conversation = snapshot.ConversationId; provider = snapshot.Provider; providerProfileId = snapshot.ProviderProfileId; state = snapshot.State;
                ApplyRecovery(snapshot);
                await StateChanged.InvokeAsync(state);
                if (provider == ChatProviderKind.OpenAiAgents) await LoadArtifactsAsync();
                events.AddRange(snapshot.Events); cursor = events.LastOrDefault()?.Sequence ?? 0;
                if (snapshot.State != ChatState.Archived && capabilities?.CanWrite != false && draftStorage is not null)
                {
                    var surface = Workspace ? "workspace" : "ticket";
                    var scope = OrganizationId is null
                        ? $"{Route}/{Uri.EscapeDataString(TicketOrganizationId ?? "")}/{surface}"
                        : $"{Route}/{surface}";
                    draftScope = ChatDraftStorage.Scope(currentActor, scope, conversation);
                    var saved = await draftStorage.ReadAsync<ChatMessageRequest>(draftScope);
                    if (disposed || cancellation.IsCancellationRequested) return;
                    if (saved?.Text is { Length: <= 16000 } text)
                    {
                        message = text;
                        if (saved.Pending is { ClientMessageId: var messageKey, Text.Length: > 0 and <= 16000 } pending
                            && messageKey != Guid.Empty && pending.ConversationId == conversation)
                        {
                            submittedMessage = pending;
                            if (events.Any(x => x.Type == "operator" && x.ClientMessageId == messageKey))
                                await AcknowledgeMessageAsync(pending);
                        }
                    }
                }
                history.Clear();
                if (OrganizationId is null && InvestigationId is null) await LoadOlderHistoryAsync();
                if (disposed) return;
                streamCancellation = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token);
                stream = ReadAsync(streamCancellation.Token);
            }
        }
        catch (HttpRequestException) { conversation = Guid.Empty; connectionStatus = "Unavailable"; error = "Chat is unavailable. Existing conversations remain stored."; }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { connectionStatus = "Disconnected"; }
        finally { busy = false; }
    }

    private async Task LoadOlderHistoryAsync()
    {
        try
        {
            using var api = Api;
            var page = await api.GetFromJsonAsync<List<ChatConversationSummary>>($"{Route}/history?skip={history.Count}", cancellation.Token) ?? [];
            hasOlderHistory = page.Count == 50;
            foreach (var item in page) if (!history.Any(x => x.ConversationId == item.ConversationId)) history.Add(item);
        }
        catch (HttpRequestException) { error = "Conversation history could not be loaded. The current transcript is unchanged."; }
    }

    private void ApplyRecovery(ChatSnapshot snapshot)
    {
        recoveryAt = snapshot.RecoveryLastAttemptUtc;
        recoveryResult = snapshot.RecoveryResult;
        continuation = snapshot.Continuation;
        backgroundReports = snapshot.BackgroundReports ?? [];
    }

    private async Task ReadAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                using var request = new HttpRequestMessage(HttpMethod.Get, $"{Route}/stream?conversationId={conversation}&cursor={cursor}");
                using var api = Api;
                using var response = await api.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, ct);
                if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound)
                {
                    await InvokeAsync(() => { events.Clear(); message = draft = ""; draftScope = null; submittedMessage = null; conversation = Guid.Empty; connectionStatus = "Access unavailable"; error = "You no longer have access to this conversation."; StateHasChanged(); });
                    return;
                }
                response.EnsureSuccessStatusCode();
                using var reader = new StreamReader(await response.Content.ReadAsStreamAsync(ct));
                string? line; string kind = "", data = "";
                while ((line = await reader.ReadLineAsync(ct)) is not null)
                {
                    if (line.StartsWith("event: ")) kind = line[7..];
                    else if (line.StartsWith("data: ")) data = line[6..];
                    else if (line.Length == 0)
                    {
                        var frameKind = kind; var frameData = data;
                        await InvokeAsync(async () =>
                        {
                            if (disposed || ct.IsCancellationRequested) return;
                            if (frameKind == "chat" && JsonSerializer.Deserialize<AiAssistantChatEvent>(frameData) is { } item)
                            {
                                if (item.Sequence > cursor) { events.Add(item); cursor = item.Sequence; }
                                if (item.Type == "operator" && submittedMessage is { } sent && item.ClientMessageId == sent.ClientMessageId) await AcknowledgeMessageAsync(sent);
                                if (item.Type is "assistant" or "turn_completed" or "turn_cancelled") draft = "";
                                if (provider == ChatProviderKind.OpenAiAgents && item.Type == "file") await LoadArtifactsAsync();
                            }
                            else if (frameKind == "recovery" && JsonSerializer.Deserialize<ChatSnapshot>(frameData) is { } recovery)
                                ApplyRecovery(recovery);
                            else if (frameKind == "text-delta") draft = JsonSerializer.Deserialize<ChatDelta>(frameData)?.Text ?? "";
                            else if (frameKind == "state")
                            {
                                state = JsonSerializer.Deserialize<ChatState>(frameData);
                                await StateChanged.InvokeAsync(state);
                                if (state is ChatState.Idle or ChatState.Archived) draft = "";
                            }
                            connectionStatus = "Connected"; StateHasChanged();
                        });
                        kind = ""; data = "";
                    }
                }
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
            catch (Exception ex) when (ex is HttpRequestException or IOException or JsonException or OperationCanceledException)
            {
                await InvokeAsync(() => { connectionStatus = "Reconnecting"; StateHasChanged(); });
            }
            await InvokeAsync(() => { connectionStatus = "Reconnecting"; draft = ""; StateHasChanged(); });
            try { await Task.Delay(TimeSpan.FromSeconds(2), ct); }
            catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
        }
    }

    private async Task SendAsync()
    {
        if (busy || capabilities?.CanWrite == false || !CanReply || conversation == Guid.Empty || string.IsNullOrWhiteSpace(message)) return;
        busy = true; error = null;
        var submitted = submittedMessage ??= new ChatMessageRequest(conversation, messageId, message);
        try
        {
            await SaveDraftAsync();
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/messages", submitted, cancellation.Token);
            if (response.IsSuccessStatusCode) await AcknowledgeMessageAsync(submitted);
            else if (response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound)
            {
                submittedMessage = null;
                await SaveDraftAsync();
                error = "Message was not accepted. Check the conversation state.";
            }
            else error = "Message acceptance could not be confirmed. Retry uses the original message ID.";
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "Delivery response was interrupted. Retry uses the original message ID. You can check the saved conversation first."; }
        finally { busy = false; }
    }
    private async Task AcknowledgeMessageAsync(ChatMessageRequest submitted)
    {
        if (submittedMessage?.ClientMessageId != submitted.ClientMessageId) return;
        if (message == submitted.Text) message = "";
        submittedMessage = null;
        messageId = Guid.NewGuid();
        await SaveDraftAsync();
    }
    private Task SaveDraftAsync() => draftStorage?.WriteAsync(draftScope, message, submittedMessage) ?? Task.CompletedTask;
    private async Task DiscardDraftAsync()
    {
        if (busy || submittedMessage is not null) return;
        message = "";
        await SaveDraftAsync();
    }
    private async Task ApproveAsync(string callId, string key)
    {
        busy = true; error = null;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/interactions/{Uri.EscapeDataString(callId)}", new ChatApprovalRequest(conversation, key), cancellation.Token);
            if (!response.IsSuccessStatusCode) error = "Approval was not accepted. It may already have been answered.";
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "Approval delivery is uncertain. Wait for the conversation to recover."; }
        finally { busy = false; }
    }
    private async Task NewAsync()
    {
        busy = true;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/new", new ChatNewWithProfileRequest(conversation, nextProfile), cancellation.Token);
            response.EnsureSuccessStatusCode();
            var snapshot = await response.Content.ReadFromJsonAsync<ChatSnapshot>(cancellation.Token);
            if (snapshot is not null)
            {
                await SelectConversationAsync(snapshot.ConversationId);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "The archive response was interrupted. Reload the current conversation before trying again."; }
        finally { busy = false; }
    }
    private Task CancelRemoteAsync() => UnresolvedMessageId is { } active
        ? ProviderCommandAsync("cancel", new ChatCancelRequest(conversation, active), "Unable to request cancellation for this turn.")
        : Task.CompletedTask;

    private Task CleanupRemoteAsync() => ProviderCommandAsync("remote-cleanup", new ChatNewRequest(conversation),
        "Unable to request remote cleanup for this conversation.");

    private async Task ProviderCommandAsync<T>(string command, T request, string failure)
    {
        if (busy || conversation == Guid.Empty) return;
        busy = true; error = null;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/{command}", request, cancellation.Token);
            if (!response.IsSuccessStatusCode) error = failure;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = failure; }
        finally { busy = false; }
    }

    private async Task LoadArtifactsAsync()
    {
        try
        {
            using var api = Api;
            artifacts = await api.GetFromJsonAsync<ChatProviderArtifact[]>($"{Route}/artifacts?conversationId={conversation}", cancellation.Token) ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException)
        {
            Logger.LogDebug("Conversation artifacts could not be listed: {FailureType}", ex.GetType().Name);
        }
    }

    private async Task DownloadArtifactAsync(ChatProviderArtifact artifact)
    {
        if (module is null) return;
        try
        {
            using var api = Api;
            await using var bytes = await api.GetStreamAsync($"{Route}/artifacts/{artifact.Id}?conversationId={conversation}", cancellation.Token);
            using var file = new DotNetStreamReference(bytes);
            await module.InvokeVoidAsync("downloadArtifact", cancellation.Token, artifact.Name, file);
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or JSException or OperationCanceledException)
        { error = "This artifact could not be downloaded."; }
    }

    private async Task ReconcileAsync()
    {
        busy = true; error = null;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/reconcile", new ChatNewRequest(conversation), cancellation.Token);
            if (!response.IsSuccessStatusCode) error = "The session check was not accepted. Refresh the conversation state.";
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "The session check was interrupted. No message was resent."; }
        finally { busy = false; }
    }

    private async Task StopScheduledAsync(Guid parent)
    {
        busy = true;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/stop-waiting",
                new ChatStopWaitingRequest(conversation, parent, ScheduledOnly: true), cancellation.Token);
            if (!response.IsSuccessStatusCode) error = "Scheduled observation changed. Refresh the conversation.";
        }
        catch (HttpRequestException) { error = "Unable to stop scheduled observation. Refresh the conversation."; }
        finally { busy = false; }
    }

    private async Task StopWaitingAsync()
    {
        if (UnresolvedMessageId is not { } expectedMessage) return;
        var expectedConversation = conversation;
        if (await Dialogs.ShowMessageBoxAsync("Stop waiting?",
            "The remote assistant may still be processing. RatelDesk will stop waiting locally and will not resend this request automatically.",
            yesText: "Stop waiting", cancelText: "Keep waiting") != true) return;
        if (disposed || state is not (ChatState.Processing or ChatState.WaitingForChildren or ChatState.WaitingForScheduledReports)
            || conversation != expectedConversation || UnresolvedMessageId != expectedMessage) return;
        busy = true; error = null;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/stop-waiting", new ChatStopWaitingRequest(conversation, expectedMessage), cancellation.Token);
            if (!response.IsSuccessStatusCode) error = "Stopping locally was not accepted. Refresh the conversation state.";
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "The stop-waiting request was interrupted. Refresh the conversation state; no message is resent automatically."; }
        finally { busy = false; }
    }

    private async Task AbandonAsync()
    {
        if (UnresolvedMessageId is not { } expectedMessage) return;
        busy = true; error = null;
        try
        {
            using var api = Commands;
            using var response = await api.PostAsJsonAsync($"{Route}/abandon", new ChatAbandonRequest(conversation, resolutionId, expectedMessage, acknowledgeAbandon), cancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                if (OrganizationId is null && InvestigationId is null) await SelectConversationAsync(Guid.Empty);
                else { state = ChatState.Archived; await StateChanged.InvokeAsync(state); await SelectConversationAsync(conversation); }
            }
            else error = "Abandonment was not accepted. The turn may already have changed or been resolved.";
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { error = "The resolution response was interrupted. Retry uses the same resolution ID; no message is resent."; }
        finally { busy = false; }
    }

    private void IdentityChanged(Task<AuthenticationState> changed) => _ = InvokeAsync(async () =>
    {
        var user = (await changed).User;
        if (disposed || identity?.Matches(user) == true) return;
        identity = new(user);
        var priorActor = currentActor;
        currentActor = ChatDraftStorage.Actor(user);
        draftScope = null;
        await cancellation.CancelAsync(); events.Clear(); message = draft = ""; submittedMessage = null; conversation = Guid.Empty;
        if (currentActor != priorActor && draftStorage is not null) await draftStorage.ClearActorAsync(priorActor);
        capabilities = new(false, "Your account changed. Reload to check current access.", false); StateHasChanged();
    });
    private async Task SavePreferenceAsync(Action update)
    {
        update();
        if (module is not null) { try { await module.InvokeVoidAsync("savePreferences", currentActor, JsonSerializer.Serialize(preferences)); } catch (JSException ex) { Logger.LogDebug(ex, "Chat display preferences could not be stored."); } }
    }
    [JSInvokable] public Task ClosePopoverAsync() => InvokeAsync(() => { settingsOpen = false; StateHasChanged(); });
    private Task ArchiveCurrentAsync() => Archive.HasDelegate ? Archive.InvokeAsync() : NewAsync();
    private async Task ToggleFullscreenAsync()
    {
        if (module is null) return;
        fullscreen = !fullscreen;
        await module.InvokeVoidAsync(fullscreen ? "maximise" : "restore", root, reference);
    }
    [JSInvokable] public Task RestoreConversationAsync() => InvokeAsync(async () =>
    {
        if (!fullscreen) return;
        fullscreen = false;
        if (module is not null) await module.InvokeVoidAsync("restore", root);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        AuthenticationStateProvider.AuthenticationStateChanged -= IdentityChanged;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("unwatchPopover", root); await module.InvokeVoidAsync("restore", root); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { Logger.LogDebug("Chat presentation circuit disconnected during disposal."); }
        }
        reference?.Dispose();
        if (draftStorage is not null) await draftStorage.DisposeAsync();
        await cancellation.CancelAsync();
        await selection;
        await stream;
        streamCancellation?.Dispose();
        cancellation.Dispose();
    }
}
