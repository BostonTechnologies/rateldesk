@using Helpdesk.Shared.DTOs.User
@using System.Text.Json
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<AssigneeSelector Module="@TicketType.TrimEnd('s')" OrganizationId="@OrganizationId" TicketId="@TicketId"
                  Value="@AssignedToId" SelectedName="@SelectedName" SelectedEmail="@SelectedEmail"
                  Label="@(TicketType == "changes" ? "Implementor" : "Assignee")"
                  ReadOnly="ReadOnly" Busy="saving" Compact="true" AllowUnassigned="@(TicketType != "changes")"
                  SelectionChanged="Assign" />

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public string TicketId { get; set; } = default!;
    [Parameter] public string TicketType { get; set; } = default!;
    [Parameter] public string? AssignedToId { get; set; }
    [Parameter] public string? SelectedName { get; set; }
    [Parameter] public string? SelectedEmail { get; set; }
    [Parameter] public EventCallback<string?> AssignedToIdChanged { get; set; }
    [Parameter] public EventCallback<UserDto?> AssignmentChanged { get; set; }
    private (string, string?, string, bool) scope;
    private CancellationTokenSource lifetime = new();
    private bool saving, disposed;
    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");

    protected override void OnParametersSet()
    {
        var nextScope = (TicketType, OrganizationId, TicketId, ReadOnly);
        if (scope == nextScope) return;
        scope = nextScope;
        lifetime.Cancel();
        lifetime.Dispose();
        lifetime = new();
    }

    private async Task Assign(UserDto? candidate)
    {
        if (ReadOnly || saving || candidate?.Id == AssignedToId) return;
        var origin = scope;
        var token = lifetime.Token;
        var ticketId = Uri.EscapeDataString(TicketId);
        saving = true;
        try
        {
            using var response = TicketType switch
            {
                "incidents" => await Api.PutAsJsonAsync($"api/v1/incidents/{ticketId}", new UpdateIncidentDto { AssignedToId = candidate?.Id ?? string.Empty }, token),
                "requests" => await Api.PostAsJsonAsync("api/v1/requests/bulk/assign", new { Ids = new[] { TicketId }, AssignedToId = candidate?.Id }, token),
                "changes" => await Api.PostAsJsonAsync($"api/v1/changes/{ticketId}/assignee", new { ImplementorUserId = candidate?.Id }, token),
                _ => throw new InvalidOperationException("Unsupported ticket module.")
            };
            if (disposed || token.IsCancellationRequested || scope != origin) return;
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Assignment failed. Refresh and try again.", Severity.Error);
                return;
            }
            if (TicketType == "changes") candidate = await response.Content.ReadFromJsonAsync<UserDto>(token);
            if (disposed || token.IsCancellationRequested || scope != origin) return;
            AssignedToId = candidate?.Id;
            await AssignedToIdChanged.InvokeAsync(AssignedToId);
            if (!disposed && scope == origin) await AssignmentChanged.InvokeAsync(candidate);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!disposed && scope == origin) Snackbar.Add("Assignment failed. Refresh and try again.", Severity.Error);
        }
        finally { saving = false; }
    }

    public void Dispose()
    {
        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
