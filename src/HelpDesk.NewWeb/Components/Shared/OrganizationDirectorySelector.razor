@implements IDisposable
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory

<MudAutocomplete T="TenantLookupDto" Label="@Label" Value="selected" ValueChanged="SelectAsync"
                 SearchFunc="SearchAsync" ToStringFunc="@(row => row?.Name ?? string.Empty)"
                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" MinCharacters="0" MaxItems="50"
                 DebounceInterval="300" Variant="Variant.Outlined" Margin="Margin.Dense" Error="@(error is not null)" ErrorText="@error" />

@code {
    [Parameter] public string Label { get; set; } = "Organization";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    private TenantLookupDto? selected;
    private string? appliedId;
    private string? error;
    private long selectionVersion;
    private long searchVersion;
    private readonly CancellationTokenSource lifetime = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Value == appliedId) return;
        appliedId = Value;
        var version = Interlocked.Increment(ref selectionVersion);
        Interlocked.Increment(ref searchVersion);
        error = null;
        if (string.IsNullOrWhiteSpace(Value)) { selected = null; return; }
        var id = Value;
        var cancellationToken = lifetime.Token;
        selected = new TenantLookupDto { Id = id, Name = "Saved organization (unavailable)" };
        try
        {
            var rows = await HttpClientFactory.CreateClient("HelpdeskApi").GetFromJsonAsync<List<TenantLookupDto>>(
                $"api/v1/admin/directories/organizations/lookup?selectedId={Uri.EscapeDataString(id)}", cancellationToken);
            if (version == selectionVersion && Value == id) selected = rows?.SingleOrDefault() ?? selected;
        }
        catch (Exception ex) when (IsReadFailure(ex, cancellationToken))
        {
            if (version == selectionVersion) error = "Organization names are unavailable. The saved filter is retained; try searching again.";
        }
    }

    private async Task<IEnumerable<TenantLookupDto>> SearchAsync(string? search, CancellationToken cancellationToken)
    {
        var version = Interlocked.Increment(ref searchVersion);
        error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            return await HttpClientFactory.CreateClient("HelpdeskApi").GetFromJsonAsync<List<TenantLookupDto>>(
                $"api/v1/admin/directories/organizations/lookup?search={Uri.EscapeDataString(search ?? string.Empty)}", cancellationToken) ?? [];
        }
        catch (Exception ex) when (IsReadFailure(ex, cancellationToken))
        {
            if (version == searchVersion)
            {
                error = "Organizations could not be loaded. Try searching again.";
                await InvokeAsync(StateHasChanged);
            }
            return [];
        }
    }
    private static bool IsReadFailure(Exception exception, CancellationToken cancellationToken) =>
        exception is HttpRequestException or JsonException or Polly.CircuitBreaker.BrokenCircuitException or Polly.Timeout.TimeoutRejectedException ||
        exception is OperationCanceledException && !cancellationToken.IsCancellationRequested;
    private async Task SelectAsync(TenantLookupDto? value) { Interlocked.Increment(ref selectionVersion); Interlocked.Increment(ref searchVersion); error = null; selected = value; appliedId = value?.Id; await ValueChanged.InvokeAsync(value?.Id); }
    public void Dispose() { Interlocked.Increment(ref selectionVersion); Interlocked.Increment(ref searchVersion); lifetime.Cancel(); lifetime.Dispose(); }
}
