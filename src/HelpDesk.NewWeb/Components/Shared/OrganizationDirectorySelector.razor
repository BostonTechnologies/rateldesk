<CreationSearchPicker TItem="TenantLookupDto" LookupUrl="api/v1/admin/directories/organizations/search" Label="@Label"
                      Value="@Value" SelectionChanged="SelectAsync" ItemId="row => row.Id" ItemLabel="row => row.Name"
                      UnavailableSelection="@(id => new TenantLookupDto { Id = id, Name = "Saved organization (unavailable)" })"
                      HydrationFailureMessage="Organization names are unavailable. The saved filter is retained; try searching again."
                      SearchFailureMessage="Organizations could not be loaded. Try searching again."
                      Placeholder="All organizations" Kind="organizations" LoadOnOpen="true" />

@code {
    [Parameter] public string Label { get; set; } = "Organization";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task SelectAsync(TenantLookupDto? value) => ValueChanged.InvokeAsync(value?.Id);
}
