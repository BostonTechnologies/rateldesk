<MudPaper Class="directory-workspace" Elevation="0">
    <div class="directory-heading">
        <div><MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText></div>
        <div class="directory-heading-actions">
            <MudTooltip Text="Refresh directory"><MudIconButton Icon="@Icons.Material.Outlined.Refresh" aria-label="Refresh directory" Disabled="Refreshing" OnClick="@(() => OnRefresh.InvokeAsync())" /></MudTooltip>
            @PrimaryAction
        </div>
    </div>
    <div class="directory-toolbar">@ToolbarContent</div>
    <div class="directory-result-summary" role="status" aria-live="polite">
        @(Refreshing ? Loaded ? "Refreshing…" : "Loading…" : Error is not null ? Loaded ? $"Showing previous results · {TotalCount:N0} results" : "Directory unavailable" : $"{TotalCount:N0} results")
    </div>
    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert>
    }
    <div class="directory-table-region" role="region" aria-label="@($"{Title} table; scroll for more columns")" tabindex="0">@ChildContent</div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Loaded { get; set; }
    [Parameter] public bool Refreshing { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public RenderFragment? PrimaryAction { get; set; }
    [Parameter] public RenderFragment? ToolbarContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
