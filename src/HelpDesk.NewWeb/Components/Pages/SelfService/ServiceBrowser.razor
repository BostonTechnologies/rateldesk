@page "/self-service"
@page "/self-service/{ServiceId}"
@layout SelfServiceLayout
@implements IDisposable
@attribute [Authorize(Roles = "SelfService.User,HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<ServiceBrowser> Logger

@using System.Net.Http.Json
@using MudBlazor
@using Helpdesk.Shared.DTOs.Service

<PageTitle>Self Service</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="self-service-page">
  <div class="self-service-catalog">
    <section class="self-service-header">
        <h1 class="catalog-accessible-heading">@CurrentCatalogTitle</h1>
        @if (!string.IsNullOrWhiteSpace(ServiceId))
        { <MudBreadcrumbs Items="_breadcrumbs" Class="self-service-breadcrumbs" /> }
        <div class="self-service-toolbar" role="search" aria-label="Service catalogue">
        <MudTextField @bind-Value="searchString"
                      @bind-Value:after="PersistSearch"
                      Label="Search services and requests"
                      Clearable="true"
                      Placeholder="Search services and requests"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="self-service-search" />
        <span class="self-service-result-count" role="status">@VisibleRequestSummary</span>
        </div>
    </section>

    @if (loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
            @loadError
            <MudButton OnClick="ReloadAsync" Size="Size.Small">Retry</MudButton>
        </MudAlert>
    }
    else if (loading)
    {
        <MudProgressLinear Indeterminate="true" Class="self-service-loading" />
        <div class="self-service-card-grid">
            @for (var i = 0; i < 6; i++)
            {
                <MudSkeleton Class="self-service-card-skeleton" />
            }
        </div>
    }
    else if (!filteredItems.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @(string.IsNullOrWhiteSpace(searchString) ? "No services or requests are available in this folder." : "No services or requests match your search.")
            @if (!string.IsNullOrWhiteSpace(searchString))
            {
                <MudButton OnClick="ClearSearch" Size="Size.Small">Clear search</MudButton>
            }
            else if (!string.IsNullOrWhiteSpace(ServiceId))
            {
                <MudButton Href="/self-service" Size="Size.Small">Back to Service Catalog</MudButton>
            }
        </MudAlert>
    }
    else
    {
        <div class="self-service-card-grid">
            @foreach (var item in filteredItems)
            {
                <button type="button"
                        class="self-service-catalog-card @GetCardClass(item)"
                        title="@($"{item.Name}: {GetDescription(item)}")"
                        aria-label="@($"{item.Name}. {GetDescription(item)}. {(item.ItemType == ServiceItemType.Service ? GetRequestCountText(item.AvailableRequestCount) : "Open request form")}")"
                        @onclick="() => OpenItem(item)">
                    <span class="self-service-card-top">
                        <span class="self-service-icon-shell">
                            @if (item.ItemType == ServiceItemType.Service)
                            {
                                <MudBadge Color="Color.Primary"
                                          Content="@GetBadgeText(item)"
                                          Overlap="true"
                                          Visible="@(item.AvailableRequestCount > 0)"
                                          Class="self-service-count-badge">
                                    <span class="self-service-icon-button" aria-hidden="true">
                                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" />
                                    </span>
                                </MudBadge>
                            }
                            else
                            {
                                <span class="self-service-icon-button" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Size="Size.Large" />
                                </span>
                            }
                        </span>
                        <span class="self-service-card-arrow" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </span>
                    </span>

                    <span class="self-service-card-body">
                        <span class="self-service-card-title">@item.Name</span>
                        <span class="self-service-card-description">@GetDescription(item)</span>
                    </span>

                    <span class="self-service-card-footer">
                        @if (item.ItemType == ServiceItemType.Service)
                        {
                            <span class="self-service-card-meta">@GetRequestCountText(item.AvailableRequestCount)</span>
                        }
                        else
                        {
                            <span class="self-service-card-meta">Request</span>
                            @if (item.ReleaseStatus == Helpdesk.Shared.Models.RequestFormReleaseStatus.InTesting)
                            {
                                <span class="self-service-status-pill">In Testing</span>
                            }
                        }
                    </span>
                </button>
            }
        </div>
    }
  </div>
</MudContainer>

@code {
    [Parameter] public string? ServiceId { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private bool loading = true;
    private string? searchString;
    private List<ServiceItemDto> serviceItems = new();
    private List<BreadcrumbItem> _breadcrumbs = new();
    private string? appliedQuerySearch;
    private string? loadedServiceId;
    private bool hasLoaded;
    private string? loadError;
    private CancellationTokenSource? loadCts;

    private IEnumerable<ServiceItemDto> filteredItems =>
        string.IsNullOrWhiteSpace(searchString)
            ? serviceItems
            : serviceItems.Where(i =>
                (i.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private string CurrentCatalogTitle => _breadcrumbs.Count > 1
        ? _breadcrumbs[^1].Text
        : "Service Catalog";

    private string VisibleRequestSummary
    {
        get
        {
            var directRequests = serviceItems.Count(i => i.ItemType == ServiceItemType.RequestForm);
            var nestedRequests = serviceItems
                .Where(i => i.ItemType == ServiceItemType.Service)
                .Sum(i => i.AvailableRequestCount);
            return GetRequestCountText(directRequests + nestedRequests);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(appliedQuerySearch, QuerySearch, StringComparison.Ordinal))
        {
            appliedQuerySearch = QuerySearch;
            searchString = QuerySearch;
        }

        if (hasLoaded && string.Equals(loadedServiceId, ServiceId, StringComparison.Ordinal)) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
        loadCts = new CancellationTokenSource();
        var token = loadCts.Token;
        var serviceId = ServiceId;
        loading = true;
        loadError = null;
        try
        {
            await LoadData(token);
            if (token.IsCancellationRequested) return;
            loadedServiceId = serviceId;
            hasLoaded = true;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception)
        {
            if (!token.IsCancellationRequested) loadError = "The Service Catalog could not be loaded. Please retry.";
        }
        finally
        {
            if (!token.IsCancellationRequested) loading = false;
        }
    }

    private async Task LoadData(CancellationToken token)
    {
        var endpoint = string.IsNullOrWhiteSpace(ServiceId)
            ? "api/v1/service-items"
            : $"api/v1/service-items/{ServiceId}";

        var items = await HelpdeskApi.GetFromJsonAsync<List<ServiceItemDto>>(endpoint, token) ?? new();
        token.ThrowIfCancellationRequested();
        serviceItems = items;
        await BuildBreadcrumbs(token);
    }

    private async Task BuildBreadcrumbs(CancellationToken token)
    {
        var items = new List<BreadcrumbItem> { new("Service Catalog", "/self-service", false) };

        if (!string.IsNullOrWhiteSpace(ServiceId))
        {
            try
            {
                var chain = await HelpdeskApi.GetFromJsonAsync<List<BreadcrumbDto>>($"api/v1/services/{ServiceId}/breadcrumb", token);
                if (chain is not null && chain.Any())
                {
                    foreach (var c in chain)
                    {
                        items.Add(new BreadcrumbItem(c.Name, $"/self-service/{c.Id}", false));
                    }
                    items[^1] = new BreadcrumbItem(items[^1].Text, href: null, disabled: true);
                    _breadcrumbs = items;
                    return;
                }
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
            catch (HttpRequestException error)
            {
                Logger.LogDebug("Service breadcrumb unavailable for {ServiceId}; HTTP status {StatusCode}.", ServiceId, error.StatusCode);
            }
        }

        _breadcrumbs = items;
    }

    private void OpenItem(ServiceItemDto item)
    {
        if (item.ItemType == ServiceItemType.Service)
        {
            NavigationManager.NavigateTo($"/self-service/{item.Id}");
        }
        else
        {
            NavigationManager.NavigateTo($"/self-service/request/{item.Id}");
        }
    }

    private void PersistSearch()
    {
        var uri = NavigationManager.GetUriWithQueryParameter("search", string.IsNullOrWhiteSpace(searchString) ? null : searchString);
        NavigationManager.NavigateTo(uri, replace: true);
    }

    private void ClearSearch()
    {
        searchString = null;
        PersistSearch();
    }

    public void Dispose()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
    }

    private static string GetCardClass(ServiceItemDto item) =>
        item.ItemType == ServiceItemType.Service
            ? "self-service-folder-card"
            : "self-service-request-card";

    private static string GetBadgeText(ServiceItemDto item) =>
        item.AvailableRequestCount > 99 ? "99+" : item.AvailableRequestCount.ToString();

    private static string GetRequestCountText(int count) =>
        count == 1 ? "1 request" : $"{count} requests";

    private static string GetDescription(ServiceItemDto item) =>
        string.IsNullOrWhiteSpace(item.Description)
            ? (item.ItemType == ServiceItemType.Service
                ? "Open this folder to browse request options."
                : "Start this self-service request.")
            : item.Description;
}
