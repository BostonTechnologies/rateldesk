@page "/account/integration-credentials/link/respond/{AttemptId}"
@page "/account/integration-credentials/link/review/{AttemptId}"
@page "/account/integration-credentials/link/result"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@using Helpdesk.Shared.ServiceLink
@using System.Text.Json
@using HelpDesk.NewWeb.Services
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>NetRatel link approval</PageTitle>
<MudPaper Class="helpdesk-content-surface pa-4" data-testid="service-link-consent-page">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h5" HtmlTag="h1">@(!IsConsentRoute ? "Connection needs attention" : CanOfferResponderApproval ? "Approve NetRatel connection" : CanOfferFinalApproval ? "Review NetRatel connection" : "NetRatel connection")</MudText>
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (!IsConsentRoute || error is not null || status is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@(error ?? ServiceLinkFailurePresentation.Message(ServiceLinkFailure.From(Status, Stage, CorrelationId)))</MudAlert>
            @if (ServiceLinkFailure.NormalizeStage(Stage) == "start" && !IsSafeResultAttempt && Status != "relationship-already-exists")
            {
                <MudText Typo="Typo.body2">Correct the peer address or local selection, then retry setup. No approval was accepted by this page.</MudText>
                <MudButton Href="/account/integration-credentials?tab=system-connections&purpose=netratel-m2m" Color="Color.Primary">Correct setup and retry</MudButton>
            }
            @if (IsSafeResultAttempt)
            {
                <MudText Typo="Typo.body2">Review this setup's current status and available action below.</MudText>
                <NetRatelServiceLinks @key="ResultAttemptId" AttemptId="@ResultAttemptId" />
            }
            else if (ServiceLinkFailure.NormalizeStage(Stage) is "remote-review" or "remote-approve" or "approve" or "continue" || Status == "relationship-already-exists")
            {
                <MudText Typo="Typo.body2">Open System connections and continue the existing setup for this peer. If approval was already saved, return to the initiating product from that setup.</MudText>
            }
            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudButton Href="/account/integration-credentials?tab=system-connections" Color="Color.Primary" Variant="Variant.Filled">Open System connections</MudButton>
                <MudButton Href="/notifications">View notifications</MudButton>
            </MudStack>
            <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Manual connection settings"><MudButton Href="/admin/automation/integration/orchestrator">Manual outbound settings</MudButton></MudExpansionPanel></MudExpansionPanels>
        }
        else
        {
            <MudText Typo="Typo.body2">1 · Connect   →   2 · Approve   →   3 · Connected</MudText>
            <ServiceLinkConsentDetails Initiator="@status.Descriptor.InitiatorEndpointSnapshot" Responder="@status.Descriptor.ResponderEndpointSnapshot" Grants="DisplayedGrants" />
            @if (CanOfferResponderApproval)
            {
                <MudText Typo="Typo.caption">The receiver source namespace remains pending until this local consent is saved.</MudText>
                <form method="post" action="/account/integration-credentials/link/respond" data-enhance="false" data-testid="service-link-responder-approval">
                    <AntiforgeryToken />
                    <input type="hidden" name="attemptId" value="@AttemptId" />
                    <input type="hidden" name="descriptorHash" value="@status.Descriptor.DescriptorHash" />
                    <input type="hidden" name="localTenantId" value="@organizationId" />
                    @foreach (var customerId in customerIds)
                    {
                        <input type="hidden" name="customerIds" value="@customerId" />
                    }
                    @foreach (var scope in scopes)
                    {
                        <input type="hidden" name="inboundScopes" value="@scope" />
                    }
                    @foreach (var scope in RequestedOutboundScopes.Where(scope => scope != "netratel.orchestration.invoke" || outboundInvoke))
                    {
                        <input type="hidden" name="outboundScopes" value="@scope" />
                    }
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Value="@organizationId" ValueChanged="OrganizationChanged" Label="Approve local organization" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var organization in organizations)
                                {
                                    <MudSelectItem Value="@organization.Id">@organization.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Value="@customerIds.FirstOrDefault()" ValueChanged="CustomerChanged" Label="Approve incident customer" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="@string.IsNullOrEmpty(organizationId)">
                                @foreach (var customer in customers.Where(customer => customer.OrganizationId == organizationId && customer.IsEnabled))
                                {
                                    <MudSelectItem Value="@customer.Id">@customer.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" Style="@(IncidentOnly ? "display:none" : null)">
                            <MudSelect T="string" Label="Approve or narrow requested inbound permissions" MultiSelection="true" SelectedValues="@scopes" SelectedValuesChanged="ScopesChanged" Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (var scope in RequestedInboundScopes)
                                {
                                    <MudSelectItem Value="@scope">@scope</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    @if (RequestedOutboundScopes.Contains("netratel.orchestration.invoke"))
                    {
                        <MudCheckBox T="bool" Value="outboundInvoke" ValueChanged="OutboundInvokeChanged" Label="Allow RatelDesk to invoke NetRatel orchestration tasks" Dense="true" />
                    }
                    @if (outboundInvoke && !scopes.Contains("rateldesk.orchestration.callback"))
                    {
                        <MudAlert Dense="true" Severity="Severity.Info">Task invocation requires the reverse task callback permission. Enable the requested callback permission or narrow orchestration access to read-only.</MudAlert>
                    }
                    <label class="d-flex align-center my-3"><input type="checkbox" @bind="confirmed" name="confirmed" value="true" required class="mr-2" />I approve this connection for the selected organization and incident customer.</label>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanApproveRemote)">Approve and return to NetRatel</MudButton>
                </form>
            }
            else if (CanOfferFinalApproval)
            {
                <MudAlert Dense="true" Severity="Severity.Info">NetRatel selected the tenant and grant shown above. Your final confirmation authorizes the exact local grant; the server then exchanges and verifies both independent credentials.</MudAlert>
                <form method="post" action="/account/integration-credentials/link/confirm" data-enhance="false" data-testid="service-link-final-approval">
                    <AntiforgeryToken />
                    <input type="hidden" name="attemptId" value="@AttemptId" />
                    <input type="hidden" name="grantHash" value="@status.GrantHash" />
                    <label class="d-flex align-center my-3"><input type="checkbox" @bind="confirmed" name="confirmed" value="true" required class="mr-2" />I approve this connection and the selected NetRatel tenant.</label>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Approve and complete setup</MudButton>
                </form>
            }
            else if (status.OrganizationBindingInvalid)
            {
                <MudAlert Dense="true" Severity="Severity.Warning">This setup has an invalid organization selection and no saved approval. Its original grants cannot be changed. Use the permitted cancellation action below, then start a new setup.</MudAlert>
            }
            else if (status.LifecycleState is "revoked" or "expired" or "failed" || status.Decision == "abort")
            {
                <MudAlert Dense="true" Severity="Severity.Warning">This setup is no longer open for approval. Review its stored status below and start a new setup when offered.</MudAlert>
            }
            else if (status.GrantSummary is null)
            {
                <MudAlert Dense="true" Severity="Severity.Info">No approval is saved. The original approving account must continue in its authorized browser session; connection checks begin after consent.</MudAlert>
            }
            else if (status.AvailableAction == "review")
            {
                <MudAlert Dense="true" Severity="Severity.Info">The peer approval is saved. Open the final review below to approve the exact local grant.</MudAlert>
            }
            else
            {
                <MudAlert Dense="true" Severity="Severity.Info">The approved grants are saved. Review the connection status and complete any remaining authenticated checks below.</MudAlert>
            }
            @if (!CanOfferResponderApproval && !CanOfferFinalApproval)
            {
                <NetRatelServiceLinks @key="status.AttemptId" AttemptId="@status.AttemptId" ShowReviewLink="false" />
            }
            <MudStack Row="true"><MudButton Href="/account/integration-credentials?tab=system-connections">Back to System connections</MudButton></MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string? AttemptId { get; set; }
    [SupplyParameterFromQuery(Name = "attemptId")] public string? ResultAttemptId { get; set; }
    private bool IsSafeResultAttempt => !IsConsentRoute && ResultAttemptId is { Length: > 0 and <= 256 } && ResultAttemptId.All(character => char.IsAsciiLetterOrDigit(character) || character is '-' or '_');
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "stage")] public string? Stage { get; set; }
    [SupplyParameterFromQuery(Name = "correlationId")] public string? CorrelationId { get; set; }
    private ServiceLinkAdminStatus? status;
    private List<OrganizationDto> organizations = [];
    private List<CustomerDto> customers = [];
    private string organizationId = "";
    private HashSet<string> customerIds = new(StringComparer.Ordinal), scopes = new(StringComparer.Ordinal);
    private bool loading = true, outboundInvoke, confirmed;
    private long loadRevision;
    private CancellationTokenSource? observation;
    private bool disposed;
    private string? error;
    private bool IsResponderRoute => new Uri(Navigation.Uri).AbsolutePath.Contains("/respond/", StringComparison.Ordinal);
    private bool IsConsentRoute => !string.IsNullOrEmpty(AttemptId) && string.Equals(new Uri(Navigation.Uri).AbsolutePath,
        "/account/integration-credentials/link/" + (IsResponderRoute ? "respond/" : "review/") + Uri.EscapeDataString(AttemptId), StringComparison.Ordinal);
    private bool CanOfferResponderApproval => IsResponderRoute && status is { LocalRole: "responder", AvailableAction: "respond", GrantSummary: null, OrganizationBindingInvalid: false, Decision: "undecided", LifecycleState: "awaiting_approval" };
    private bool CanOfferFinalApproval => !IsResponderRoute && status is { LocalRole: "initiator", AvailableAction: "review", GrantSummary: not null, Decision: "undecided", LifecycleState: "approved" };
    private IEnumerable<string> RequestedInboundScopes => status?.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "rateldesk").SelectMany(grant => grant.Scopes).Distinct(StringComparer.Ordinal) ?? [];
    private IEnumerable<string> RequestedOutboundScopes => status?.Descriptor.RequestedGrants.Where(grant => grant.TargetProduct == "netratel").SelectMany(grant => grant.Scopes).Distinct(StringComparer.Ordinal) ?? [];
    private ServiceLinkGrant[] DisplayedGrants => status?.GrantSummary?.Grants ?? (status?.Descriptor.RequestedGrants ?? []).Select(grant => !CanOfferResponderApproval ? grant
        : grant.TargetProduct == "rateldesk" ? grant with
        {
            TargetTenantId = organizationId, Scopes = scopes.Order(StringComparer.Ordinal).ToArray(),
            ResourceConstraints = grant.ResourceConstraints with { OrganizationId = string.IsNullOrEmpty(organizationId) ? null : organizationId, CustomerIds = customerIds.Order(StringComparer.Ordinal).ToArray() }
        }
        : grant with { CallerTenantId = organizationId, Scopes = RequestedOutboundScopes.Where(scope => scope != "netratel.orchestration.invoke" || outboundInvoke).Order(StringComparer.Ordinal).ToArray() }).ToArray();
    private bool IncidentOnly => RequestedOutboundScopes.ToHashSet(StringComparer.Ordinal).SetEquals([ServiceLinkContract.ControlScope, ServiceLinkContract.VerifyScope]);
    private bool CanApproveRemote => !string.IsNullOrWhiteSpace(organizationId) && scopes.Count > 0 && (!outboundInvoke || scopes.Contains("rateldesk.orchestration.callback")) && (!scopes.Any(scope => scope.StartsWith("rateldesk.incident", StringComparison.Ordinal)) || customerIds.Count == 1);

    protected override async Task OnParametersSetAsync()
    {
        StopObservation();
        var revision = ++loadRevision;
        var attemptId = AttemptId;
        var route = new Uri(Navigation.Uri).AbsolutePath;
        var responder = IsResponderRoute;
        loading = true; error = null; status = null; confirmed = false;
        organizationId = ""; customerIds.Clear(); scopes.Clear();
        organizations = []; customers = []; outboundInvoke = false;
        if (string.IsNullOrEmpty(attemptId) || !IsConsentRoute) { loading = false; return; }
        bool IsCurrent() => !disposed && revision == loadRevision && attemptId == AttemptId && route == new Uri(Navigation.Uri).AbsolutePath;
        try
        {
            var api = HttpClientFactory.CreateClient("HelpdeskApi");
            using var statusResponse = await api.GetAsync("api/v1/admin/service-links/attempts/" + Uri.EscapeDataString(attemptId));
            if (!statusResponse.IsSuccessStatusCode)
            {
                var failure = await ServiceLinkFailurePresentation.ReadAsync(statusResponse, "status");
                if (IsCurrent()) error = ServiceLinkFailurePresentation.Message(failure);
                return;
            }
            var loadedStatus = await statusResponse.Content.ReadFromJsonAsync<ServiceLinkAdminStatus>();
            if (!IsCurrent()) return;
            if (loadedStatus is not null && (loadedStatus.AttemptId != attemptId || loadedStatus.Descriptor.AttemptId != attemptId))
                throw new JsonException("The returned consent belongs to another attempt.");
            List<OrganizationDto> loadedOrganizations = [];
            List<CustomerDto> loadedCustomers = [];
            if (responder && loadedStatus is { LocalRole: "responder", AvailableAction: "respond", GrantSummary: null, OrganizationBindingInvalid: false })
            {
                var organizationTask = api.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations");
                var customerTask = api.GetFromJsonAsync<List<CustomerDto>>("api/v1/customers");
                await Task.WhenAll(organizationTask, customerTask);
                if (!IsCurrent()) return;
                loadedOrganizations = (organizationTask.Result ?? []).Where(organization => organization.IsEnabled && (string.IsNullOrEmpty(loadedStatus.LocalTenantId) || organization.Id == loadedStatus.LocalTenantId)).ToList();
                loadedCustomers = customerTask.Result ?? [];
            }
            status = loadedStatus;
            organizations = loadedOrganizations; customers = loadedCustomers;
            if (CanOfferResponderApproval)
            {
                scopes = RequestedInboundScopes.ToHashSet(StringComparer.Ordinal);
                outboundInvoke = RequestedOutboundScopes.Contains("netratel.orchestration.invoke");
                if (organizations.Count == 1) OrganizationChanged(organizations[0].Id);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (IsCurrent()) error = "The protected grant summary is unavailable or this attempt is no longer authorized. Refresh its stored status before proceeding.";
        }
        finally
        {
            if (IsCurrent())
            {
                loading = false;
                if (error is null && NeedsObservation(status))
                {
                    observation = new CancellationTokenSource();
                    _ = ObserveAsync(revision, attemptId, route, observation.Token);
                }
            }
        }
    }
    private void OrganizationChanged(string value)
    {
        confirmed = false; organizationId = value; customerIds.Clear();
        var allowed = customers.Where(customer => customer.OrganizationId == value && customer.IsEnabled).ToArray();
        if (allowed.Length == 1) customerIds.Add(allowed[0].Id);
    }
    private void CustomerChanged(string value) { confirmed = false; customerIds = string.IsNullOrEmpty(value) ? [] : new HashSet<string>([value], StringComparer.Ordinal); }
    private void ScopesChanged(IEnumerable<string>? values) { confirmed = false; scopes = values?.ToHashSet(StringComparer.Ordinal) ?? []; }
    private void OutboundInvokeChanged(bool value) { confirmed = false; outboundInvoke = value; }
    private static bool NeedsObservation(ServiceLinkAdminStatus? value) => value?.LifecycleState is "awaiting_approval" or "approved" or "prepared" or "verified" or "commit_decided" or "in_doubt" or "revocation_pending";
    private async Task ObserveAsync(long revision, string attemptId, string route, CancellationToken cancellation)
    {
        bool IsCurrent() => !disposed && !cancellation.IsCancellationRequested && revision == loadRevision &&
            AttemptId == attemptId && route == new Uri(Navigation.Uri).AbsolutePath;
        try
        {
            for (var delaySeconds = 2; delaySeconds <= 10 && IsCurrent(); delaySeconds += 2)
            {
                await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellation);
                if (!IsCurrent()) return;
                using var response = await HttpClientFactory.CreateClient("HelpdeskApi").GetAsync(
                    "api/v1/admin/service-links/attempts/" + Uri.EscapeDataString(attemptId), cancellation);
                var failure = response.IsSuccessStatusCode ? null : ServiceLinkFailurePresentation.Message(await ServiceLinkFailurePresentation.ReadAsync(response, "status"));
                var current = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<ServiceLinkAdminStatus>(cancellation) : null;
                if (response.IsSuccessStatusCode && (current is null || current.AttemptId != attemptId || current.Descriptor.AttemptId != attemptId))
                    throw new JsonException("The returned consent belongs to another attempt.");
                await InvokeAsync(() =>
                {
                    if (!IsCurrent()) return;
                    // Preserve unsaved organization/customer choices while the durable approval is unchanged.
                    if (current?.LifecycleState != status?.LifecycleState || current?.AvailableAction != status?.AvailableAction ||
                        current?.LinkRevision != status?.LinkRevision || current?.GrantHash != status?.GrantHash ||
                        current?.Descriptor.DescriptorHash != status?.Descriptor.DescriptorHash || current?.LocalTenantId != status?.LocalTenantId ||
                        current?.OrganizationBindingInvalid != status?.OrganizationBindingInvalid || current?.Decision != status?.Decision)
                        confirmed = false;
                    status = current;
                    error = failure;
                    StateHasChanged();
                });
                if (!IsCurrent() || !NeedsObservation(status)) return;
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return; }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            await InvokeAsync(() =>
            {
                if (!IsCurrent()) return;
                status = null; confirmed = false;
                error = "The protected grant summary is unavailable or this attempt is no longer authorized. Refresh its stored status before proceeding.";
                StateHasChanged();
            });
        }
    }
    private void StopObservation() { observation?.Cancel(); observation?.Dispose(); observation = null; }
    public void Dispose() { disposed = true; loadRevision++; StopObservation(); }
}
