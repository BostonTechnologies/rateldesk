@page "/ai/prompts"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@using Helpdesk.Shared.DTOs.AiOps
@using Helpdesk.Shared.DTOs.Organization
@inject IHttpClientFactory Clients

<PageTitle>AI prompts</PageTitle>
<MudStack Spacing="3">
    <MudText Typo="Typo.h4">AI prompts</MudText>
    <MudText>Organization guidance is saved by revision. Existing investigations retain their original guidance.</MudText>
    @if (error is not null) { <MudAlert Severity="Severity.Warning">@error</MudAlert> }
    <MudSelect T="string" Label="Organization" Value="@organization" ValueChanged="ChangeOrganization" Disabled="busy">
        @foreach (var org in organizations) { <MudSelectItem Value="@org.Id">@org.Name</MudSelectItem> }
    </MudSelect>
    @foreach (var prompt in prompts)
    {
        <MudButton OnClick="@(() => Edit(prompt))" Disabled="busy">@prompt.Name · revision @prompt.Revision @(prompt.IsDefault ? "· Default" : "") @(prompt.Archived ? "· Archived" : "")</MudButton>
    }
    <MudButton OnClick="New" Disabled="@(busy || organization.Length == 0)">New prompt</MudButton>
    <MudTextField @bind-Value="name" Label="Name" Disabled="@(busy || organization.Length == 0)" MaxLength="120" />
    <MudTextField @bind-Value="description" Label="Description" Disabled="@(busy || organization.Length == 0)" MaxLength="500" />
    <MudTextField @bind-Value="content" Label="Guidance" Disabled="@(busy || organization.Length == 0)" Lines="8" MaxLength="12000" />
    <MudCheckBox T="bool" Disabled="@(busy || organization.Length == 0)" @bind-Value="isDefault" Label="Always include in new investigations for this organization" />
    <MudCheckBox T="bool" Disabled="@(busy || organization.Length == 0)" @bind-Value="archived" Label="Archived (unavailable for new investigations)" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(busy || organization.Length == 0 || name.Length == 0)">Save revision</MudButton>
</MudStack>
@code {
    private List<OrganizationDto> organizations = [];
    private List<AiPromptDto> prompts = [];
    private string organization = "", name = "", description = "", content = "";
    private Guid id = Guid.NewGuid();
    private int revision;
    private bool isDefault, archived, busy;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        try { organizations = await Clients.CreateClient("HelpdeskApi").GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations") ?? []; }
        catch (HttpRequestException) { error = "Unable to load organizations."; }
    }
    private async Task ChangeOrganization(string value)
    {
        busy = true; organization = value; New();
        try { await Load(); }
        finally { busy = false; }
    }
    private async Task Load()
    {
        try { prompts = await Clients.CreateClient("HelpdeskApi").GetFromJsonAsync<List<AiPromptDto>>($"api/v1/ai/ops/prompts?organizationId={Uri.EscapeDataString(organization)}") ?? []; }
        catch (HttpRequestException) { error = "Unable to load prompts."; }
    }
    private void New() { id = Guid.NewGuid(); revision = 0; name = description = content = ""; isDefault = archived = false; }
    private void Edit(AiPromptDto p) { id = p.Id; revision = p.Revision; name = p.Name; description = p.Description; content = p.Content; isDefault = p.IsDefault; archived = p.Archived; }
    private async Task Save()
    {
        busy = true; error = null;
        try
        {
            using var response = await Clients.CreateClient("SystemPairingApi").PutAsJsonAsync($"api/v1/ai/ops/prompts/{id}", new SaveAiPromptDto(organization, name, description, content, revision, isDefault, archived));
            if (!response.IsSuccessStatusCode) { error = "Save was rejected. Reload a changed revision, or unset the existing default before selecting another. Your draft is preserved."; return; }
            var saved = await response.Content.ReadFromJsonAsync<AiPromptDto>(); if (saved is not null) Edit(saved); await Load();
        }
        catch (HttpRequestException) { error = "Save could not be confirmed. Reload the prompt before another change."; }
        finally { busy = false; }
    }
}
