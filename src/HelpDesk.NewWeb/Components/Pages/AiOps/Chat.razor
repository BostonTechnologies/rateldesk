@page "/ai/chat"
@attribute [Authorize]
@using Helpdesk.Shared.AiAssistant.Chat
@using HelpDesk.NewWeb.Components.Shared
@implements IAsyncDisposable
@inject IHttpClientFactory Clients
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Authentication

<PageTitle>Chat · RatelDesk</PageTitle>
<main class="chat-page" data-testid="organization-chat">
    <header class="chat-page-heading">
        <div><p class="chat-eyebrow">AI OPERATIONS</p><h1>Chat</h1><p class="chat-page-description">A place to work things through with Netclaw.</p></div>
        <div class="chat-workspace-controls">
            <label class="chat-tenant">Organization
                <select value="@organization" @onchange="ChangeOrganization" disabled="@(loading || organizations.Count == 0)">
                    @if (organization.Length == 0) { <option value="">Select an organization</option> }
                    @foreach (var org in organizations) { <option value="@org.Id">@org.Name</option> }
                </select>
            </label>
            @if (organization.Length > 0) { <AiNetclawConnectionStatus @key="organization" ApiRoute="@Route" OrganizationName="@OrganizationName(organization)" ConversationId="selected?.ConversationId" /> }
        </div>
    </header>
    @if (error is not null) { <div class="chat-notice chat-error" role="alert">@error</div> }
    @if (loading) { <div class="chat-loading" role="status"><span class="chat-loading-dot"></span>Opening your chat workspace…</div> }
    else if (organization.Length == 0)
    {
        <section class="chat-no-access"><MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" /><h2>No chat workspace available</h2><p>Select an available organization with AI Ops access to continue.</p></section>
    }
    else
    {
        <div class="chat-workspace">
            <aside class="chat-history" aria-label="Chat history">
                <button type="button" class="chat-new-button" @onclick="StartNew" disabled="@(busy || !CanStart)"><MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" /><span>New chat</span></button>
                <form class="chat-history-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <label class="chat-visually-hidden" for="organization-chat-search">Search recent chats</label><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                    <input id="organization-chat-search" value="@search" @oninput="SearchChangedAsync" maxlength="200" placeholder="Search recent chats" />
                </form>
                <div class="chat-history-label"><span>RECENT CONVERSATIONS</span><button type="button" class="chat-icon-button" @onclick="SearchAsync" aria-label="Refresh chats"><MudIcon Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" /></button></div>
                <nav class="chat-history-list" aria-label="Saved conversations">
                    @if (history.Count == 0) { <p class="chat-history-empty">@(search.Length > 0 ? "No matching chats." : "Organization conversations will appear here.")</p> }
                    @foreach (var chat in history)
                    {
                        <a @key="chat.ConversationId" class="chat-history-item @(selected?.ConversationId == chat.ConversationId ? "selected" : "")" href="@Url(organization, chat.ConversationId)" aria-current="@(selected?.ConversationId == chat.ConversationId ? "page" : null)">
                            <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" />
                            <span><strong>@chat.Title</strong><small><span class="chat-state-dot @StateClass(chat.State)"></span>@StateLabel(chat.State)<span class="chat-history-time" title="@chat.LastActivityUtc.ToLocalTime().ToString("g")">@chat.LastActivityUtc.ToLocalTime().ToString("dd MMM")</span></small></span>
                        </a>
                    }
                    @if (hasMore) { <button type="button" class="chat-secondary-button chat-load-more" @onclick="MoreAsync">Older conversations</button> }
                </nav>
                <label class="chat-archive-toggle"><input type="checkbox" checked="@includeArchived" @onchange="ArchivedChangedAsync" />Show archived chats</label>
                @if (capabilities?.SetupUrl is { } setup) { <a class="chat-settings-link" href="@setup"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />Netclaw connection</a> }
                else { <span class="chat-settings-link" title="An administrator manages this connection"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />Netclaw connection</span> }
            </aside>
            @if (selected is { } savedChat)
            {
                <section class="chat-selected" aria-label="Organization conversation workspace">
                    <AiAssistantChat @key="savedChat.ConversationId" OrganizationId="@savedChat.OrganizationId" SelectedConversationId="savedChat.ConversationId" Workspace="true" Title="@savedChat.Title" Identity="@OrganizationName(savedChat.OrganizationId)" Archive="ArchiveAsync" StateChanged="@(state => StateChanged(savedChat.ConversationId, state))">
                        <SavedContext><details><summary>Saved organization guidance</summary><pre>@savedChat.GuidanceSnapshot</pre></details></SavedContext>
                    </AiAssistantChat>
                </section>
            }
            else
            {
                <section class="chat-canvas" aria-label="Organization conversation workspace">
                    <header class="chat-conversation-heading"><div class="chat-assistant-identity"><h2>Netclaw · @OrganizationName(organization)</h2></div></header>
                    <div class="chat-transcript">
                        @if (capabilities?.Enabled != true)
                        {
                            <div class="chat-welcome chat-connect"><div class="chat-welcome-mark"><MudIcon Icon="@Icons.Material.Outlined.Forum" /></div><p class="chat-eyebrow">YOUR ORGANIZATION WORKSPACE</p><h2>Connect with Netclaw</h2>
                                <p>@(capabilities?.Reason ?? "Connection details are unavailable. Refresh the workspace to try again.")</p>
                                @if (capabilities?.SetupUrl is { } connection) { <a class="chat-primary-button" href="@connection">Set up Netclaw <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /></a> }
                            </div>
                        }
                        else
                        {
                            <div class="chat-welcome"><div class="chat-welcome-mark"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></div><p class="chat-eyebrow">NETCLAW · @OrganizationName(organization)</p><h2>What would you like to work on?</h2><p>Write a script, review notifications, or talk through your next task.</p>
                                <div class="chat-starters" aria-label="Conversation starters">
                                    @foreach (var starter in Starters) { <button type="button" class="chat-starter" @onclick="() => UseStarterAsync(starter.Prompt)" disabled="@(!CanStart || busy || pendingStart is not null)"><MudIcon Icon="@starter.Icon" Size="Size.Small" /><strong>@starter.Title</strong><span>@starter.Description</span></button> }
                                </div>
                                @if (prompts.Any(x => !x.IsDefault))
                                {
                                    <details class="chat-guidance"><summary>Additional guidance</summary>
                                        @foreach (var prompt in prompts.Where(x => !x.IsDefault)) { <label><input type="checkbox" checked="@promptIds.Contains(prompt.Id)" disabled="@(busy || pendingStart is not null)" @onchange="e => SelectPrompt(prompt.Id, e)" />@prompt.Name</label> }
                                    </details>
                                }
                            </div>
                        }
                    </div>
                    @if (capabilities?.Enabled == true)
                    {
                        <div class="chat-composer-area"><AiAssistantComposer @ref="composer" @bind-Value="message" Send="SendFirstAsync" Disabled="@(!CanStart || busy)" ReadOnly="@(pendingStart is not null)" Identity="@OrganizationName(organization)" SubmitWithModifier="true" ShowAttachmentNotice="false" SendLabel="@(pendingStart is null ? "Send" : "Retry message")" /></div>
                    }
                </section>
            }
        </div>
    }
</main>
