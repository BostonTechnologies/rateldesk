@page "/account/integration-credentials/approve"
@attribute [Authorize]
@using Helpdesk.Shared.DTOs.Auth
@inject IHttpClientFactory Clients

<PageTitle>Approve a client connection</PageTitle>
<MudPaper Class="helpdesk-content-surface pa-4" data-testid="integration-pairing-approval">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" HtmlTag="h1">Approve a client connection</MudText>
        <MudText>Enter the code displayed by your client. Signing in does not approve a connection.</MudText>
        @if (Status is "approved" or "denied")
        {
            <MudAlert Severity="@(Status == "approved" ? Severity.Success : Severity.Info)" role="status">
                @(Status == "approved" ? "Connection approved. Return to the client to securely save its credential." : "Connection denied. No credential was created.")
            </MudAlert>
        }
        else
        {
            @if (message is not null || Status is not null)
            {
                <MudAlert Severity="Severity.Warning" role="alert">@(message ?? "Approval could not complete. Enter the client code again and review its current access.")</MudAlert>
            }
            <MudTextField T="string" @bind-Value="humanCode" Label="Client code" HelperText="For example ABCD-EFGH; only use a code from a client you are connecting." Immediate="true" MaxLength="16" autocomplete="off" data-testid="integration-pairing-code" />
            <MudButton OnClick="ReviewAsync" Disabled="@(busy || !RendererInfo.IsInteractive)" Variant="Variant.Filled" Color="Color.Primary" data-testid="integration-pairing-review">Review connection</MudButton>
            @if (review is not null)
            {
                <section aria-label="Connection consent" data-testid="integration-pairing-consent">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Review access for @review.Name</MudText>
                    <MudText>Code: @review.HumanCode</MudText>
                    <MudText>Purpose: @(review.Purpose == "mcp" ? "HTTP MCP gateway" : "API / CLI / stdio MCP")</MudText>
                    @if (review.McpResourceUri is not null) { <MudText>Resource: @review.McpResourceUri</MudText> }
                    <MudText>Approval expires: @review.ExpiresAtUtc.ToString("u")</MudText>
                    <MudText Class="mb-3">Choose access deliberately. The credential remains limited by your account's current permissions and can be revoked from Integration credentials.</MudText>
                    <form method="post" action="/account/integration-credentials/pairing-consent" data-testid="integration-pairing-consent-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="humanCode" value="@review.HumanCode" />
                        <label for="pairing-organization">Organization</label>
                        <select id="pairing-organization" name="organizationId" class="pairing-select" value="@organizationId" @onchange="OrganizationChanged" required>
                            <option value="">Choose an organization</option>
                            @foreach (var organization in review.Organizations) { <option value="@organization.Id">@organization.Name</option> }
                        </select>
                        <fieldset class="pairing-permissions" @key="organizationId">
                            <legend>Permissions</legend>
                            @foreach (var permission in AvailablePermissions)
                            {
                                <label><input type="checkbox" name="permissions" value="@permission" /> @permission</label>
                            }
                            @if (string.IsNullOrEmpty(organizationId)) { <p>Choose an organization to view your current permissions.</p> }
                        </fieldset>
                        <label for="pairing-lifetime">Credential lifetime (days)</label>
                        <input id="pairing-lifetime" name="lifetimeDays" type="number" min="1" max="90" value="30" required class="pairing-lifetime" />
                        <p>Default 30 days; maximum 90. Credentials remain revocable.</p>
                        <label class="pairing-consent"><input type="checkbox" name="consent" /> I approve this client connection with the permissions selected above.</label>
                        <div class="pairing-actions">
                            <button type="submit" name="decision" value="deny" class="pairing-deny">Deny connection</button>
                            <button type="submit" name="decision" value="approve" class="pairing-approve" disabled="@string.IsNullOrEmpty(organizationId)">Approve connection</button>
                        </div>
                    </form>
                </section>
            }
        }
        <MudLink Href="/account/integration-credentials?tab=credentials">Manage integration credentials</MudLink>
    </MudStack>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    private string humanCode = "";
    private string organizationId = "";
    private string? message;
    private IntegrationPairingReview? review;
    private bool busy;
    private IEnumerable<string> AvailablePermissions => review?.Organizations.FirstOrDefault(o => o.Id == organizationId)?.Permissions ?? [];
    private void OrganizationChanged(ChangeEventArgs args) => organizationId = args.Value?.ToString() ?? "";
    private async Task ReviewAsync()
    {
        busy = true; message = null; review = null; organizationId = "";
        try
        {
            using var response = await Clients.CreateClient("SystemPairingApi").PostAsJsonAsync(
                "api/v1/integration-credentials/pairing/review", new IntegrationPairingReviewRequest(humanCode));
            if (response.IsSuccessStatusCode) review = await response.Content.ReadFromJsonAsync<IntegrationPairingReview>();
            else message = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                ? "Too many code attempts. Wait a few minutes before retrying."
                : "This code is unavailable or expired. Check the client and start a new connection if needed.";
        }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { message = "The connection service is unavailable. Retry when it is reachable."; }
        finally { busy = false; }
    }
}
