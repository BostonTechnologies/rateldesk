@page "/account/integration-credentials/approve"
@attribute [Authorize]
@using Helpdesk.Shared.DTOs.Auth
@using Helpdesk.Shared.Services
@inject IHttpClientFactory Clients
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

@if (!Embedded) { <PageTitle>Review connection access</PageTitle> }
<MudPaper Class="helpdesk-content-surface pa-4" data-testid="integration-pairing-approval">
    <MudText Typo="Typo.h5" HtmlTag="@(Embedded ? "h2" : "h1")">Review connection access</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">Use a code from the deployment or client you are connecting. Signing in does not approve access.</MudText>
    @if (Status is "approved" or "denied")
    {
        <MudAlert Severity="@(Status == "approved" ? Severity.Success : Severity.Info)" role="status">
            @(Status == "approved" ? "Connection approved. Return to the client or deployment to continue." : "Connection denied. No access was granted.")
        </MudAlert>
    }
    @if (message is not null || Status is not (null or "approved" or "denied"))
    { <MudAlert Severity="Severity.Warning" role="alert">@(message ?? "Approval could not complete. Enter the code again and review its current access.")</MudAlert> }
    <div class="approval-entries">
        @if (isAdministrator)
        {
            <section class="approval-entry host-entry" aria-label="HTTP MCP host deployment">
                <h2>HTTP MCP host deployment</h2>
                <p>Authorize the reviewed deployment settings for this server.</p>
                <label>Host code <input @ref="hostCodeInput" value="@hostCode" @oninput="HostCodeChanged" @onkeydown="HostKeyDown" maxlength="16" autocomplete="off" placeholder="ABCD-EFGH" /></label>
                <button type="button" @ref="hostReviewButton" @onclick="ReviewHostAsync" disabled="@(busy || !RendererInfo.IsInteractive)" class="entry-review">Review host</button>
            </section>
        }
        <section class="approval-entry client-entry" aria-label="CLI / MCP client access">
            <h2>CLI / MCP client access</h2>
            <p>Grant one client explicit access through your account.</p>
            <label>Client code <input @ref="clientCodeInput" value="@humanCode" @oninput="ClientCodeChanged" @onkeydown="ClientKeyDown" maxlength="16" autocomplete="off" placeholder="ABCD-EFGH" data-testid="integration-pairing-code" /></label>
            <button type="button" @ref="clientReviewButton" @onclick="ReviewAsync" disabled="@(busy || !RendererInfo.IsInteractive)" class="entry-review" data-testid="integration-pairing-review">Review client</button>
        </section>
    </div>
    @if (Kind == "host" && !isAdministrator)
    { <MudAlert Severity="Severity.Info" Class="mt-2">An authorized administrator must review host deployment codes. You can review your own client access here.</MudAlert> }
    @if (!Embedded) { <MudLink Href="/account/integration-credentials?tab=credentials" Class="mt-3">Manage integration credentials</MudLink> }
</MudPaper>

@if (review is not null)
{
    <CredentialReviewSurface Title="Connection consent" OnClose="CloseReviewAsync" Opener="@ReviewOpener">
        <h2>@(IsVerifier ? "Temporary verification client" : $"Review client: {review.Name}")</h2>
        <form method="post" action="/account/integration-credentials/pairing-consent" data-testid="integration-pairing-consent-form" data-preserve-consent="true" class="consent-form">
            <AntiforgeryToken />
            <input type="hidden" name="humanCode" value="@review.HumanCode" />
            <div class="review-body" data-testid="integration-pairing-consent">
                <p>Code: <strong>@review.HumanCode</strong> · @(review.Purpose == "mcp" ? "HTTP MCP" : "API / CLI / stdio MCP")</p>
                @if (review.McpResourceUri is not null) { <p>Resource: @review.McpResourceUri</p> }
                <p>Approval expires: @review.ExpiresAtUtc.ToString("u")</p>
                @if (IsVerifier)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Allows initialization, catalog discovery and the authenticated status check only. No ticket, customer or other business access. Access expires after five minutes and is revoked when verification ends.</MudAlert>
                }
                else { <p>Choose exact access deliberately. Your current account permissions continue to limit this credential.</p> }
                <label for="pairing-organization">Organization</label>
                <select id="pairing-organization" name="organizationId" class="pairing-select" value="@organizationId" @onchange="OrganizationChanged" required>
                    <option value="">Choose an organization</option>
                    @foreach (var organization in review.Organizations) { <option value="@organization.Id">@organization.Name</option> }
                </select>
                @if (!string.IsNullOrEmpty(organizationId)) { <p>Selected organization: <strong>@review.Organizations.First(o => o.Id == organizationId).Name</strong></p> }
                @if (!IsVerifier)
                {
                    <CredentialPermissionSelector @key="organizationId" EligiblePermissions="@AvailablePermissions" SelectedValues="@selectedPermissions" SelectedValuesChanged="PermissionsChanged" FormFieldName="permissions" />
                    <label for="pairing-lifetime">Credential lifetime (days)</label>
                    <input id="pairing-lifetime" name="lifetimeDays" type="number" min="1" max="90" @bind="lifetimeDays" required class="pairing-lifetime" />
                    <p>Default 30 days; maximum 90. Credentials remain revocable.</p>
                }
                <label class="pairing-consent"><input type="checkbox" name="consent" @bind="consent" /> @(IsVerifier ? "I approve only this temporary status verification." : "I approve this client connection with the permissions selected above.")</label>
                <p class="consent-feedback" role="alert" hidden></p>
            </div>
            <footer>
                <button type="button" @onclick="CloseReviewAsync">Close</button>
                <button type="submit" name="decision" value="deny">Deny connection</button>
                <button type="submit" name="decision" value="approve" class="pairing-approve" disabled="@(!consent || string.IsNullOrEmpty(organizationId) || (!IsVerifier && selectedPermissions.Count == 0))">Approve connection</button>
            </footer>
        </form>
    </CredentialReviewSurface>
}
@if (hostReview is not null)
{
    <CredentialReviewSurface Title="Host deployment consent" OnClose="CloseReviewAsync" Opener="@ReviewOpener">
        <h2>Review host: @hostReview.Proposal.Name</h2>
        <form method="post" action="/account/integration-credentials/host-consent" data-preserve-consent="true" class="consent-form">
            <AntiforgeryToken />
            <input type="hidden" name="humanCode" value="@hostReview.HumanCode" />
            <input type="hidden" name="proposalHash" value="@hostReview.Proposal.ProposalHash" />
            <input type="hidden" name="sourceHash" value="@hostReview.Proposal.SourceHash" />
            <div class="review-body">
                <p>Authorize this deployment proposal. Each consumer approves its own access separately.</p>
                <dl><dt>Code / expires</dt><dd>@hostReview.HumanCode / @hostReview.ExpiresAtUtc.ToString("u")</dd>
                    <dt>Public origin</dt><dd>@hostReview.Proposal.PublicOrigin</dd><dt>MCP resource</dt><dd>@hostReview.Proposal.ResourceUri</dd>
                    <dt>Instance / authentication</dt><dd>@hostReview.Proposal.Instance / @hostReview.Proposal.AuthenticationMode</dd>
                    <dt>API destination</dt><dd>@hostReview.Proposal.ApiBaseUrl</dd><dt>MCP destination</dt><dd>@hostReview.Proposal.McpDestination</dd></dl>
                @if (hostReview.Proposal.ReviewSettings.Count > 0)
                {
                    <details open><summary>Effective deployment settings and winning sources</summary>
                        <dl class="host-settings">@foreach (var setting in hostReview.Proposal.ReviewSettings)
                        { <dt>@setting.Key</dt><dd><span>@setting.Value</span><small>Source: @setting.Source</small></dd> }</dl>
                    </details>
                }
                <ul>@foreach (var change in hostReview.Proposal.Changes) { <li>@change</li> }</ul>
                <details><summary>Proposal and source references</summary><p>@hostReview.Proposal.ProposalHash</p><p>@hostReview.Proposal.SourceHash</p></details>
                <label class="pairing-consent"><input type="checkbox" name="consent" @bind="hostConsent" /> I authorize these exact deployment settings and source generation.</label>
                <p class="consent-feedback" role="alert" hidden></p>
            </div>
            <footer><button type="button" @onclick="CloseReviewAsync">Close</button><button type="submit" name="decision" value="deny">Deny host</button><button type="submit" name="decision" value="approve" class="pairing-approve" disabled="@(!hostConsent)">Approve host</button></footer>
        </form>
    </CredentialReviewSurface>
}

@code {
    [Parameter] public bool Embedded { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? Kind { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    private string humanCode = "", hostCode = "", organizationId = "";
    private string? message, appliedCode;
    private IntegrationPairingReview? review;
    private HostDeploymentReview? hostReview;
    private HashSet<string> selectedPermissions = new(StringComparer.OrdinalIgnoreCase);
    private bool busy, isAdministrator, consent, hostConsent;
    private int lifetimeDays = 30;
    private long reviewRevision;
    private ElementReference hostCodeInput, clientCodeInput, hostReviewButton, clientReviewButton;
    private bool openedFromCode;
    private ElementReference ReviewOpener => lastReviewHost ? (openedFromCode ? hostCodeInput : hostReviewButton) : (openedFromCode ? clientCodeInput : clientReviewButton);
    private bool IsVerifier => review?.GrantKind == "setup-verification";
    private IEnumerable<string> AvailablePermissions => review?.Organizations.FirstOrDefault(o => o.Id == organizationId)?.Permissions ?? [];
    protected override async Task OnInitializedAsync() => isAdministrator = CurrentUserAccessProfile.FromClaims((await AuthenticationState.GetAuthenticationStateAsync()).User).IsHelpdeskAdmin;
    protected override void OnParametersSet()
    {
        if (Code == appliedCode) return;
        appliedCode = Code;
        if (Kind == "host") hostCode = NormalizeCode(Code); else humanCode = NormalizeCode(Code);
    }
    private static string NormalizeCode(string? code)
    {
        var normalized = new string((code ?? "").Where(c => !char.IsWhiteSpace(c) && c != '-').ToArray()).ToUpperInvariant();
        return normalized.Length == 8 ? normalized.Insert(4, "-") : normalized;
    }
    private void HostCodeChanged(ChangeEventArgs args) { hostCode = args.Value?.ToString() ?? ""; InvalidateLookup(); }
    private void ClientCodeChanged(ChangeEventArgs args) { humanCode = args.Value?.ToString() ?? ""; InvalidateLookup(); }
    private void InvalidateLookup() { if (busy) { ++reviewRevision; busy = false; } }
    private Task HostKeyDown(KeyboardEventArgs args) => args.Key == "Enter" ? LookupAsync(true, true) : Task.CompletedTask;
    private Task ClientKeyDown(KeyboardEventArgs args) => args.Key == "Enter" ? LookupAsync(false, true) : Task.CompletedTask;
    private void OrganizationChanged(ChangeEventArgs args)
    { organizationId = args.Value?.ToString() ?? ""; selectedPermissions.Clear(); consent = false; }
    private Task PermissionsChanged(IEnumerable<string> values)
    { selectedPermissions = values.Intersect(AvailablePermissions, StringComparer.OrdinalIgnoreCase).ToHashSet(StringComparer.OrdinalIgnoreCase); consent = false; return Task.CompletedTask; }
    private Task CloseReviewAsync()
    { ++reviewRevision; review = null; hostReview = null; busy = false; return Task.CompletedTask; }
    private bool lastReviewHost;
    private Task ReviewAsync() => LookupAsync(false);
    private Task ReviewHostAsync() => LookupAsync(true);
    private async Task LookupAsync(bool host, bool fromCode = false)
    {
        if (busy || review is not null || hostReview is not null) return;
        if (host && !isAdministrator) { message = "An authorized administrator must review host deployment codes."; return; }
        var revision = ++reviewRevision;
        busy = true; message = null; lastReviewHost = host; openedFromCode = fromCode;
        var code = NormalizeCode(host ? hostCode : humanCode);
        if (host) hostCode = code; else humanCode = code;
        try
        {
            using var response = await Clients.CreateClient("SystemPairingApi").PostAsJsonAsync(host
                ? "api/v1/integration-credentials/host-proposals/review" : "api/v1/integration-credentials/pairing/review", new IntegrationPairingReviewRequest(code));
            if (revision != reviewRevision) return;
            if (response.IsSuccessStatusCode)
            {
                var reviewedHost = host ? await response.Content.ReadFromJsonAsync<HostDeploymentReview>() : null;
                var reviewedClient = host ? null : await response.Content.ReadFromJsonAsync<IntegrationPairingReview>();
                if (revision != reviewRevision) return;
                if (reviewedHost is not null && (!Uri.TryCreate(reviewedHost.Proposal.PublicOrigin, UriKind.Absolute, out var proposedOrigin) ||
                    proposedOrigin.GetLeftPart(UriPartial.Authority) != new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)))
                { message = "This host proposal belongs to a different public RatelDesk origin. Open the trusted deployment URL and review its host code there."; return; }
                hostReview = reviewedHost; review = reviewedClient;
                organizationId = ""; selectedPermissions.Clear(); consent = hostConsent = false; lifetimeDays = 30;
            }
            else message = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                ? "Too many code attempts. Wait a few minutes before retrying."
                : "This code is unavailable or expired for this connection kind. Check whether you need Review host or Review client, then retry.";
        }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { if (revision == reviewRevision) message = "The connection service is unavailable. Retry when it is reachable."; }
        finally { if (revision == reviewRevision) busy = false; }
    }
}
