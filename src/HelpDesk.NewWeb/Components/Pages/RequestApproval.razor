@page "/public/access/{AccessId:guid}/request"
@layout PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.Models


@inject PublicBrowserAccess PublicAccess

<PageTitle>Request Approval</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-12">
    <MudPaper Class="pa-6 pa-md-8" Elevation="2">
        @if (approval is null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                This approval session is unavailable. Open the original email to continue or request a replacement link.
            </MudAlert>
        }
        else
        {
            <MudStack Spacing="3">
                @if (ReviewUnavailable)
                {
                    <MudAlert Severity="Severity.Error">The decision could not be recorded. Check the current approval status before trying again.</MudAlert>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <img src="/branding/rateldesk-mark.webp" alt="RatelDesk" style="max-height:46px; max-width:220px;" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@approval.TrackingId</MudText>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">Request Approval</MudText>
                    <MudChip T="string" Color="@GetStatusColor(approval.ApprovalStatus)" Variant="Variant.Outlined">
                        @approval.ApprovalStatus
                    </MudChip>
                </MudStack>

                <MudDivider />

                <MudText Typo="Typo.h6">@approval.RequestTitle</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@approval.RequestDescription</MudText>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.overline">Approval Task</MudText>
                        <MudText Typo="Typo.body1">@approval.TaskName</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.overline">Due</MudText>
                        <MudText Typo="Typo.body1">@FormatDate(approval.DueAt)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.overline">Reviewed</MudText>
                        <MudText Typo="Typo.body1">@FormatDate(approval.ReviewedAtUtc)</MudText>
                    </MudItem>
                </MudGrid>

                <MudDivider />

                <MudText Typo="Typo.h6">Submitted Info</MudText>
                @if (approval.PayloadFields.Count == 0)
                {
                    <MudText Typo="Typo.body2">No submitted fields.</MudText>
                }
                else
                {
                    <MudTable T="RequestApprovalPayloadFieldDto" Items="approval.PayloadFields" Dense="true" Hover="true" Class="compact-table" FixedHeader="true" FixedFooter="true" data-table-surface="pages-requestapproval-1">
                        <HeaderContent>
                            <MudTh>Field</MudTh>
                            <MudTh>Value</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Field">@context.Key</MudTd>
                            <MudTd DataLabel="Value" Style="overflow-wrap:anywhere">@context.Value</MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                @if (!approval.CanReview)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        This approval is no longer pending.
                    </MudAlert>
                }
                else
                {
                    <form method="post" action="@DecisionPath" data-enhance="false">
                        <AntiforgeryToken />
                        <button class="mud-button-root mud-button-filled mud-button-filled-primary" type="submit" name="decision" value="approve">Approve</button>
                    </form>
                    <details>
                        <summary>Reject</summary>
                        <form method="post" action="@DecisionPath" data-enhance="false">
                            <AntiforgeryToken />
                            <label for="review-reason">Reason for rejection</label>
                            <textarea id="review-reason" name="reason" maxlength="1000" required></textarea>
                            <button class="mud-button-root mud-button-outlined mud-button-outlined-error" type="submit" name="decision" value="reject">Reject Request</button>
                        </form>
                    </details>
                }
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid AccessId { get; set; }
    [SupplyParameterFromQuery(Name = "review")] public string? Review { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PublicRequestReviewDto? approval;
    private bool ReviewUnavailable => Review == "unavailable";
    private string DecisionPath => PublicBrowserAccess.AccessPath(AccessId) + "/request/decision";

    protected override async Task OnInitializedAsync()
    {
        approval = await PublicAccess.ReadAsync<PublicRequestReviewDto>(HttpContext, AccessId, "request");
    }

    private static string FormatDate(DateTimeOffset? value) =>
        value.HasValue ? value.Value.ToLocalTime().ToString("g") : "Not set";

    private static Color GetStatusColor(RequestTaskApprovalStatus status) => status switch
    {
        RequestTaskApprovalStatus.Approved => Color.Success,
        RequestTaskApprovalStatus.Rejected => Color.Error,
        RequestTaskApprovalStatus.Expired => Color.Error,
        RequestTaskApprovalStatus.Superseded => Color.Info,
        _ => Color.Warning
    };
}
