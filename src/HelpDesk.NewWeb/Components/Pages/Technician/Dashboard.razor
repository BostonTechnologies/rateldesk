@page "/technician/dashboard"
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Dashboard> Logger

@using Helpdesk.Shared.DTOs.Dashboard
@attribute [Authorize(Roles = "Incident.Manager,Request.Manager,Change.Manager,HelpdeskAdmin")]

@using HelpDesk.NewWeb.Models

<PageTitle>Technician Dashboard</PageTitle>

@if (summary == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    <MudProgressLinear Indeterminate="true" Class="my-7" />

}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h6">Open Incidents</MudText>
                <MudText Typo="Typo.h3">@summary.OpenIncidentsCount</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h6">Resolved Today</MudText>
                <MudText Typo="Typo.h3">@summary.ResolvedTodayCount</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Class="pa-4">
                <MudText Typo="Typo.h6">Pending Changes</MudText>
                <MudText Typo="Typo.h3">@summary.PendingChangesCount</MudText>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private TechnicianDashboardDto? summary;

    protected override async Task OnInitializedAsync()
    {

        try
        {
            summary = await HelpdeskApi.GetFromJsonAsync<TechnicianDashboardDto>("api/v1/dashboard/technician-summary");
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Technician dashboard data could not be loaded ({ExceptionType}).", ex.GetType().Name);
        }
    }
}
