@page "/home"
@attribute [Authorize]
@implements IDisposable

@using Helpdesk.Shared.DTOs.Dashboard
@using Helpdesk.Shared.DTOs.Change
@using Helpdesk.Shared.DTOs.Incident
@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.Models
@using System.Text.Json

@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Home> Logger

<PageTitle>@(isAdministrator ? "Operations Overview" : "Home")</PageTitle>

<AuthorizeView Roles="HelpdeskAdmin">
    <Authorized Context="homeAuth">
        <div class="helpdesk-page home-dashboard" data-testid="operations-overview">
            <header class="dashboard-heading">
                <div>
                    <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-page-title">Operations Overview</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Your workload and the latest incident, request and change activity.</MudText>
                </div>
                <div class="dashboard-refresh">
                    <span role="status">@FreshnessLabel</span>
                    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small" OnClick="RefreshAsync" Disabled="@loading" aria-label="Refresh Operations Overview">Refresh</MudButton>
                </div>
            </header>
            @if (loading) { <MudProgressLinear Indeterminate="true" aria-label="Refreshing Operations Overview" /> }
            <div class="dashboard-columns">
                <aside aria-label="Current workload" class="dashboard-workload">
                    <MudPaper Class="helpdesk-content-surface dashboard-summary-panel" Elevation="0">
                        @if (errors.TryGetValue("workload", out var workloadError))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" role="alert">@workloadError <MudButton Size="Size.Small" OnClick="LoadSummaryAsync" Disabled="@loadingPanels.Contains("workload")">Retry workload</MudButton></MudAlert>
                        }
                        <section aria-labelledby="incident-workload-title">
                            <MudText Typo="Typo.h6" HtmlTag="h2" id="incident-workload-title">Incidents</MudText>
                            <div class="dashboard-kpi-grid">
                                @foreach (var (state, count) in summary.IncidentCountsByState.Where(x => x.Value > 0))
                                {
                                    <a class="dashboard-kpi-card" href="@($"/incidents?state={Uri.EscapeDataString(state.ToString())}")"><span>@TicketStateLabel(state)</span><strong>@count</strong></a>
                                }
                            </div>
                            @if (!loading && !errors.ContainsKey("workload") && !summary.IncidentCountsByState.Any(x => x.Value > 0)) { <p class="dashboard-empty-state">No incident workload.</p> }
                        </section>
                        <section aria-labelledby="request-workload-title">
                            <MudText Typo="Typo.h6" HtmlTag="h2" id="request-workload-title">Requests</MudText>
                            <div class="dashboard-kpi-grid">
                                @foreach (var (state, count) in summary.RequestCountsByState.Where(x => x.Value > 0))
                                {
                                    <a class="dashboard-kpi-card" href="@($"/requests?state={Uri.EscapeDataString(state)}")"><span>@RequestStateLabel(state)</span><strong>@count</strong></a>
                                }
                            </div>
                            @if (!loading && !errors.ContainsKey("workload") && !summary.RequestCountsByState.Any(x => x.Value > 0)) { <p class="dashboard-empty-state">No request workload.</p> }
                        </section>
                        <section aria-labelledby="change-workload-title">
                            <MudText Typo="Typo.h6" HtmlTag="h2" id="change-workload-title">Changes</MudText>
                            <div class="dashboard-kpi-grid">
                                @if (summary.PendingChanges > 0)
                                {
                                    <a class="dashboard-kpi-card" href="/changes"><span>Pending changes</span><strong>@summary.PendingChanges</strong></a>
                                }
                                @foreach (var (state, count) in summary.ChangeCountsByState.Where(x => x.Value > 0))
                                {
                                    <a class="dashboard-kpi-card" href="@($"/changes?lifecycleState={Uri.EscapeDataString(state)}")"><span>@ChangeStateLabel(state)</span><strong>@count</strong></a>
                                }
                            </div>
                            @if (!loading && !errors.ContainsKey("workload") && summary.PendingChanges == 0 && !summary.ChangeCountsByState.Any(x => x.Value > 0)) { <p class="dashboard-empty-state">No change workload.</p> }
                        </section>
                    </MudPaper>
                </aside>
                <div class="dashboard-recent-work" aria-label="Recent work">
                    <OperationsRecentPanel Title="Recent incidents" ViewAllHref="/incidents" EmptyText="No recent incidents." Items="recentIncidents" Error="@errors.GetValueOrDefault("incidents")" Loading="@loadingPanels.Contains("incidents")" Retry="LoadIncidentsAsync" />
                    <OperationsRecentPanel Title="Recent requests" ViewAllHref="/requests" EmptyText="No recent requests." Items="recentRequests" Error="@errors.GetValueOrDefault("requests")" Loading="@loadingPanels.Contains("requests")" Retry="LoadRequestsAsync" />
                    <OperationsRecentPanel Title="Recent changes" ViewAllHref="/changes" EmptyText="No recent changes." Items="recentChanges" Error="@errors.GetValueOrDefault("changes")" Loading="@loadingPanels.Contains("changes")" Retry="LoadChangesAsync" />
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <AuthorizeView Roles="SelfService.User" Context="selfServiceAuth">
            <Authorized>
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h4">Welcome to Helpdesk</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">
                        Use Self Service to submit and review your own requests. Your access is scoped to your organization.
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Href="/self-service" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Storefront">Self Service</MudButton>
                        <MudButton Href="/self-service/my-requests" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong">My Requests</MudButton>
                    </MudStack>
                </MudStack>
            </Authorized>
            <NotAuthorized>
                <AuthorizeView Roles="Tenant.Roles.Assign" Context="tenantAdministratorAuth">
                    <Authorized>
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h4">Tenant administration</MudText>
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                                Manage the tenant roles and member access assigned to your organization.
                            </MudText>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Href="/tenant-administration" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Group">Tenant Members</MudButton>
                                <MudButton Href="/admin/roles" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AdminPanelSettings">Tenant Roles</MudButton>
                            </MudStack>
                        </MudStack>
                    </Authorized>
                    <NotAuthorized>
                        <AuthorizeView Roles="Incident.User,Incident.Read,Incident.Write,Incident.Manager,Request.User,Request.Read,Request.Write,Request.Manager,Change.User,Change.Read,Change.Write,Change.Manager" Context="workspaceAuth">
                            <Authorized>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.h4">Welcome to Helpdesk</MudText>
                                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Use the workspace navigation to access the modules assigned to you.</MudText>
                                </MudStack>
                            </Authorized>
                            <NotAuthorized>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.h4">No module access assigned</MudText>
                                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Ask an instance or tenant administrator to assign access for your organization.</MudText>
                                </MudStack>
                            </NotAuthorized>
                        </AuthorizeView>
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>


@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private readonly CancellationTokenSource lifetime = new();
    private readonly Dictionary<string, string> errors = new(StringComparer.Ordinal);
    private readonly HashSet<string> loadingPanels = new(StringComparer.Ordinal);
    private readonly HashSet<string> loadedPanels = new(StringComparer.Ordinal);
    private AdminDashboardDto summary = new();
    private IReadOnlyList<OperationsRecentPanel.Row> recentIncidents = [];
    private IReadOnlyList<OperationsRecentPanel.Row> recentRequests = [];
    private IReadOnlyList<OperationsRecentPanel.Row> recentChanges = [];
    private bool loading, disposed, isAdministrator;
    private DateTimeOffset? lastRefreshAttempt;
    private string FreshnessLabel => loading ? "Refreshing…" : lastRefreshAttempt is { } time
        ? $"Last refresh {time.ToLocalTime():g}{(errors.Count > 0 ? " · Some panels need attention" : "")}" : "Updates on refresh";

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationStateTask is not null ? (await AuthenticationStateTask).User : null;
        isAdministrator = user?.IsInRole("HelpdeskAdmin") == true;
        if (isAdministrator) await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (loading || disposed) return;
        loading = true;
        try { await Task.WhenAll(LoadSummaryAsync(), LoadIncidentsAsync(), LoadRequestsAsync(), LoadChangesAsync()); }
        finally { if (!disposed) { loading = false; lastRefreshAttempt = DateTimeOffset.UtcNow; } }
    }

    private Task LoadSummaryAsync() => LoadPanelAsync("workload", "Workload", async () =>
        summary = await HelpdeskApi.GetFromJsonAsync<AdminDashboardDto>("api/v1/dashboard/admin-summary", lifetime.Token) ?? throw new JsonException("Missing workload response."));
    private Task LoadIncidentsAsync() => LoadPanelAsync("incidents", "Recent incidents", async () =>
    {
        var response = await HelpdeskApi.GetFromJsonAsync<PagedResponse<IncidentDto>>("api/v1/incidents?page=1&pageSize=5", lifetime.Token) ?? throw new JsonException("Missing incidents response.");
        recentIncidents = response.Items.Take(5).Select(item => new OperationsRecentPanel.Row(item.Id, item.TrackingId, item.Subject, TicketStateLabel(item.State), item.UpdatedAt, $"/incidents/{item.Id}")).ToList();
    });
    private Task LoadRequestsAsync() => LoadPanelAsync("requests", "Recent requests", async () =>
    {
        var response = await HelpdeskApi.GetFromJsonAsync<PagedResponse<RequestDto>>("api/v1/requests?page=1&pageSize=5", lifetime.Token) ?? throw new JsonException("Missing requests response.");
        recentRequests = response.Items.Take(5).Select(item => new OperationsRecentPanel.Row(item.Id, item.TrackingId, item.Title, TicketStateLabel(item.State), item.UpdatedAt, $"/requests/{item.Id}")).ToList();
    });
    private Task LoadChangesAsync() => LoadPanelAsync("changes", "Recent changes", async () =>
    {
        var response = await HelpdeskApi.GetFromJsonAsync<PagedResponse<ChangeDto>>("api/v1/changes?page=1&pageSize=5", lifetime.Token) ?? throw new JsonException("Missing changes response.");
        recentChanges = response.Items.Take(5).Select(item => new OperationsRecentPanel.Row(item.Id, item.TrackingId, item.Title, GetChangeLifecycleLabel(item.LifecycleState), item.UpdatedAt, $"/changes/{item.Id}")).ToList();
    });

    private async Task LoadPanelAsync(string key, string label, Func<Task> load)
    {
        if (disposed || !loadingPanels.Add(key)) return;
        try
        {
            await load();
            if (!disposed) { loadedPanels.Add(key); errors.Remove(key); }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
            Logger.LogDebug("Operations Overview panel {Panel} cancelled during navigation.", key);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or IOException or OperationCanceledException)
        {
            Logger.LogWarning("Operations Overview panel {Panel} could not be loaded ({ExceptionType}).", key, exception.GetType().Name);
            if (!disposed) errors[key] = $"{label} could not be refreshed. {(loadedPanels.Contains(key) ? "Showing the last loaded data." : "Retry this panel.")}";
        }
        finally { loadingPanels.Remove(key); }
    }

    private static string TicketStateLabel(TicketState state) => state switch
    {
        TicketState.WaitingReply => "Waiting for reply", TicketState.Replied => "Customer replied",
        TicketState.InProgress => "In progress", TicketState.PendingApproval => "Pending approval", TicketState.OnHold => "On hold", _ => state.ToString()
    };
    private static string RequestStateLabel(string state) => Enum.TryParse<TicketState>(state, true, out var value) ? TicketStateLabel(value) : state;
    private static string ChangeStateLabel(string state) => Enum.TryParse<ChangeLifecycleState>(state, true, out var value) ? GetChangeLifecycleLabel(value) : state;
    private static string GetChangeLifecycleLabel(ChangeLifecycleState state) => state switch
    {
        ChangeLifecycleState.Draft => "Draft", ChangeLifecycleState.Submitted => "Submitted", ChangeLifecycleState.PendingApproval => "Pending approval",
        ChangeLifecycleState.ApprovedForImplementation => "Approved for implementation", ChangeLifecycleState.ImplementationInProgress => "Implementation in progress",
        ChangeLifecycleState.ImplementedSuccess => "Implemented · Success", ChangeLifecycleState.ImplementedBackedOut => "Implemented · Backed out", _ => state.ToString()
    };
    public void Dispose() { disposed = true; lifetime.Cancel(); lifetime.Dispose(); }
}
