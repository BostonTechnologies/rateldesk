@attribute [Authorize(Roles = "Request.User,Request.Read,Request.Write,Request.Manager,HelpdeskAdmin")]

@using Helpdesk.Shared.DTOs.Request

@inject IHttpClientFactory HttpClientFactory

<OperatorTicketCreateForm Module="request" Title="Create New Request"
                          CreateAsync="CreateRequestAsync" />

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private Task<HttpResponseMessage> CreateRequestAsync(OperatorTicketCreateFormModel model)
    {
        var dto = new CreateRequestDto
        {
            Title = model.Title,
            Description = model.Description,
            Priority = model.Priority,
            OrganizationId = model.OrganizationId,
            CustomerId = model.CustomerId,
            AssignedToId = model.AssignedToId,
            CategoryIds = model.CategoryIds.ToList()
        };

        return HelpdeskApi.PostAsJsonAsync("api/v1/requests", dto);
    }
}
