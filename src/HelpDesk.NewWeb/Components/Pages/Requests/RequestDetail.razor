    private async Task LoadTeamMembersAsync()
    {
        var ticketId = Id;
        var version = ticketVersion;
        var token = ticketLifetime.Token;
        try
        {
            var users = await HelpdeskApi.GetFromJsonAsync<List<UserDto>>($"api/v1/ticketing/assignees?module=request&organizationId={Uri.EscapeDataString(request?.OrganizationId ?? string.Empty)}", token) ?? new();
            if (!IsCurrent(version)) return;
            userDisplayNames = users
                .Where(u => !string.IsNullOrWhiteSpace(u.Id))
                .GroupBy(u => u.Id)
                .ToDictionary(
                    g => g.Key,
                    g => string.IsNullOrWhiteSpace(g.First().Name) ? g.Key : g.First().Name,
                    StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            if (IsCurrent(version)) userDisplayNames = new(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task ResolveRolesAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var user = (await AuthenticationStateTask).User;
        canViewWorkflowPayload = user.IsInRole("HelpdeskAdmin")
            || user.Claims.Any(c =>
                (c.Type == ClaimTypes.Role || c.Type == "roles")
                && string.Equals(c.Value, "HelpdeskAdmin", StringComparison.OrdinalIgnoreCase));
    }

    private string GetAssigneeDisplay(string? assignedToId)
    {
        if (string.IsNullOrWhiteSpace(assignedToId))
        {
            return "-";
        }

        return userDisplayNames.TryGetValue(assignedToId, out var name) ? name : assignedToId;
    }

    private async Task StartTaskAsync(RequestTaskDto task)
    {
        await ExecuteTaskActionAsync(task.Id, "start", "Task started.");
    }

    private async Task CompleteTaskAsync(RequestTaskDto task)
    {
        var version = ticketVersion;
        var dialog = await DialogService.ShowAsync<CompleteRequestTaskDialog>(
            "Complete Task",
            new DialogParameters
            {
                [nameof(CompleteRequestTaskDialog.TaskName)] = task.Name
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (!IsCurrent(version) || result.Canceled) return;

        await ExecuteTaskActionAsync(task.Id, "complete", "Task completed.");
    }

    private async Task FailTaskAsync(RequestTaskDto task)
    {
        await ExecuteTaskActionAsync(task.Id, "fail", "Task marked failed.");
    }

    private async Task RetryTaskAsync(RequestTaskDto task)
    {
        if (!canRetryAutomationTasks)
        {
            return;
        }

        await ExecuteTaskActionAsync(task.Id, "retry", "Task retry requested.");
    }

    private bool HasAutomationRecoveryContext(RequestTaskDto task)
        => !string.IsNullOrWhiteSpace(GetAutomationRecoverySearch(task));

    private static bool RequiresManualReconciliation(string? status)
        => string.Equals(status, "SubmitUncertainManualReconcile", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "ExecutionUnknownManualReconcile", StringComparison.OrdinalIgnoreCase);

    private string BuildAutomationRecoveryLink(RequestTaskDto task)
        => $"/notifications?source={Uri.EscapeDataString("Orchestration")}&search={Uri.EscapeDataString(GetAutomationRecoverySearch(task) ?? string.Empty)}";

    private static string? GetAutomationRecoverySearch(RequestTaskDto task)
        => FirstNonEmpty(
            task.OrchestrationExternalRunId,
            task.OrchestrationExternalRequestId,
            task.OrchestratorExecutionId,
            task.AutomationBindingId);

    private async Task ExecuteTaskActionAsync(string taskId, string action, string successMessage)
    {
        var task = tasks.FirstOrDefault(x => x.Id == taskId);
        if (taskActionInProgress || task is null || !CanOperateTask(task)) return;
        var version = ticketVersion;
        var token = ticketLifetime.Token;
        taskActionInProgress = true;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/request-tasks/{taskId}/{action}", new { }, token);
            if (!IsCurrent(version)) return;
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync(token);
                if (IsCurrent(version)) Snackbar.Add(string.IsNullOrWhiteSpace(error) ? $"Failed to {action} task." : error, Severity.Error);
                return;
            }
            await RefreshRequestAndTasksAsync();
            if (IsCurrent(version)) Snackbar.Add(successMessage, Severity.Success);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (IsCurrent(version)) Snackbar.Add($"Failed to {action} task: {ex.Message}", Severity.Error); }
        finally { if (IsCurrent(version)) taskActionInProgress = false; }
    }

    private async Task RefreshRequestAndTasksAsync()
    {
        if (isUpdating) return;
        var version = ticketVersion;
        var refresh = ++refreshVersion;
        var token = ticketLifetime.Token;
        var ticketId = Id;
        var updatedTask = HelpdeskApi.GetFromJsonAsync<RequestDto>($"api/v1/requests/{ticketId}", token);
        var tasksTask = HelpdeskApi.GetFromJsonAsync<List<RequestTaskDto>>($"api/v1/requests/{ticketId}/tasks", token);
        var workflowTask = LoadWorkflowTimelineAsync(reset: true);
        await Task.WhenAll(updatedTask, tasksTask, workflowTask);
        if (!IsCurrent(version) || refresh != refreshVersion || isUpdating) return;
        var updated = await updatedTask;
        if (updated is not null)
        {
            // Worklog, task and SLA refreshes update metadata without discarding the details draft.
            if (hasChanges && request is not null && originalRequest is not null)
            {
                var draft = request;
                var baseline = originalRequest;
                request = CloneRequest(updated);
                request.State = draft.State;
                request.Priority = draft.Priority;
                request.CategoryIds = selectedCategoryIds.ToList();
                originalRequest = CloneRequest(updated);
                originalRequest.State = baseline.State;
                originalRequest.Priority = baseline.Priority;
                originalRequest.CategoryIds = baseline.CategoryIds.ToList();
            }
            else
            {
                originalRequest = CloneRequest(updated);
                request = CloneRequest(updated);
                selectedCategoryIds = updated.CategoryIds.ToHashSet();
            }
        }
        tasks = await tasksTask ?? new List<RequestTaskDto>();
    }

    private async Task ReloadWorkflowTimelineAsync()
    {
