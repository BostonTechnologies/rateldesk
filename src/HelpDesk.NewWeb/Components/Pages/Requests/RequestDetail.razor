    private async Task LoadTasksAsync()
    {
        var ticketId = Id;
        var version = ticketVersion;
        var token = ticketLifetime.Token;
        tasksLoading = true;
        try
        {
            var loaded = await HelpdeskApi.GetFromJsonAsync<List<RequestTaskDto>>($"api/v1/requests/{ticketId}/tasks", token) ?? new();
