        SlaStatus.Completed => Color.Success,
        _ => Color.Default
    };

    private void ApplyTaskSnapshot(List<RequestTaskDto> snapshot)
    {
        tasks = snapshot;
        var rows = new List<RequestTaskRow>(snapshot.Count);
        foreach (var task in snapshot)
        {
            if (!taskRowsById.TryGetValue(task.Id, out var row)) taskRowsById[task.Id] = row = new(task);
            else row.Task = task;
            rows.Add(row);
        }
        var retained = snapshot.Select(x => x.Id).ToHashSet(StringComparer.Ordinal);
        foreach (var removed in taskRowsById.Keys.Where(x => !retained.Contains(x)).ToArray()) taskRowsById.Remove(removed);
        taskRows = rows;
    }

