@using Helpdesk.Shared.Services
@inject AuthenticationStateProvider AccessAuthenticationState
@page "/requests/{Id}"
@implements IDisposable
@attribute [Authorize(Roles = "Request.User,Request.Read,Request.Write,Request.Manager,HelpdeskAdmin")]

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

@using System.Net.Http.Json
@using System.Security.Claims
@using Helpdesk.Shared.DTOs.Category
@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.DTOs.User
@using Helpdesk.Shared.Enums
@using Helpdesk.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization

<NavigationLock ConfirmExternalNavigation="@hasChanges" OnBeforeInternalNavigation="ConfirmNavigation" />

<PageTitle>Request: @(request?.Title ?? "...")</PageTitle>

@if (loading)
{
    <MudPaper Class="pa-4 d-flex justify-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudPaper>
}
else if (request == null)
{
    <MudAlert Severity="Severity.Error">Could not load the request. It may not exist or an error occurred.</MudAlert>
}
else
{
    <MudGrid Spacing="3" AlignItems="AlignItems.Stretch">
        <MudItem xs="12" md="9" Class="d-flex flex-column">
            <HelpDesk.NewWeb.Components.Shared.TicketHeader
                Title="@request.Title"
                TrackingId="@request.TrackingId"
                Status="@request.State"
                Priority="@request.Priority"
                LastUpdated="@(request.UpdatedAt ?? request.CreatedAt)"
                CustomerName="@request.CustomerName"
                CustomerEmail="@request.CustomerEmail"
                CategoryIds="@selectedCategoryIds"
                AllCategories="@categories"
                CategoryRemoved="OnCategoryRemoved" ReadOnly="@(!CanManage || isUpdating)">
            </HelpDesk.NewWeb.Components.Shared.TicketHeader>

            @if (!string.IsNullOrWhiteSpace(request.WorkflowStatus))
            {
                <MudAlert Severity="@GetWorkflowAlertSeverity(request.WorkflowStatus)"
                          Dense="true"
                          Variant="Variant.Outlined"
                          Class="mt-2">
                    <MudText Typo="Typo.subtitle2">Workflow: @request.WorkflowStatus</MudText>
                    @if (!string.IsNullOrWhiteSpace(request.WorkflowBlockReason))
                    {
                        <MudText Typo="Typo.body2">@request.WorkflowBlockReason</MudText>
                    }
                    @if (request.WorkflowUpdatedAt.HasValue)
                    {
                        <MudText Typo="Typo.caption">Updated @request.WorkflowUpdatedAt.Value.LocalDateTime.ToString("g")</MudText>
                    }
                </MudAlert>
            }

            <MudTabs Rounded="true" Outlined="true" PanelClass="pa-3" Class="flex-grow-1 mt-2">
                <MudTabPanel Text="Activity">
                    <TicketActivityTabs
                        TicketId="@Id"
                        TicketType="requests"
                        OrganizationId="@request.OrganizationId"
                        PublicMode="false" CanContribute="@CanContribute" CanManage="@CanManage"
                        OnWorklogAdded="HandleWorklogAdded"
                        Class="flex-grow-1" />
                </MudTabPanel>
                <MudTabPanel Text="Tasks">
                    <MudPaper Class="pa-3">
                        @if (tasksLoading)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (tasks.Count == 0)
                        {
                            <MudText Typo="Typo.body2">No tasks for this request.</MudText>
                        }
                        else
                        {
                            <MudTable T="RequestTaskDto" Items="tasks" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Order</MudTh>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Assignee</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Order">@context.Order</MudTd>
                                    <MudTd DataLabel="Name">
                                        <MudText Typo="Typo.body2">@context.Name</MudText>
                                        @if (!string.IsNullOrWhiteSpace(context.Description))
                                        {
                                            <MudText Typo="Typo.caption">@context.Description</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudChip T="string" Size="Size.Small" Color="@(context.Type == RequestTaskType.Automation ? Color.Info : Color.Default)">
                                            @context.Type
                                        </MudChip>
                                        @if (context.Type == RequestTaskType.Automation && context.AutomationBindingSyncState is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Class="ml-1" Color="@GetBindingStateColor(context.AutomationBindingSyncState.Value)">
                                                @context.AutomationBindingSyncState
                                            </MudChip>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(context.AutomationBlockReason))
                                        {
                                            <MudText Typo="Typo.caption">@context.AutomationBlockReason</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small" Color="@GetTaskStatusColor(context.Status)">
                                            @context.Status
                                        </MudChip>
                                        @if (context.Type == RequestTaskType.Automation && !string.IsNullOrWhiteSpace(context.LastAutomationStatus))
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                External orchestration: @(RequiresManualReconciliation(context.LastAutomationStatus) ? "Reconciliation required" : context.LastAutomationStatus)
                                                @if (context.LastAutomationUpdatedAt.HasValue)
                                                {
                                                    <span> (@context.LastAutomationUpdatedAt.Value.LocalDateTime.ToString("g"))</span>
                                                }
                                            </MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Assignee">@GetAssigneeDisplay(context.AssignedToId)</MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudStack Row="true" Spacing="1">
                                            @if (context.Status == RequestTaskStatus.Pending)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           Disabled="@(!CanOperateTask(context) || taskActionInProgress || (context.Type == RequestTaskType.Automation && !context.AutomationReadyToStart))"
                                                           OnClick="@(async () => await StartTaskAsync(context))">Start</MudButton>
                                            }
                                            @if (context.Type == RequestTaskType.Manual && context.Status == RequestTaskStatus.InProgress)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Disabled="@(!CanOperateTask(context) || taskActionInProgress)"
                                                           OnClick="@(async () => await CompleteTaskAsync(context))">Complete</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(!CanOperateTask(context) || taskActionInProgress)"
                                                           OnClick="@(async () => await FailTaskAsync(context))">Fail</MudButton>
                                            }
                                            @if (context.Type == RequestTaskType.Automation && context.Status == RequestTaskStatus.InProgress)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="true">Running</MudButton>
                                            }
                                            @if (context.Type == RequestTaskType.Automation && context.Status == RequestTaskStatus.Failed && canRetryAutomationTasks && !RequiresManualReconciliation(context.LastAutomationStatus))
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!CanOperateTask(context) || taskActionInProgress)"
                                                           OnClick="@(async () => await RetryTaskAsync(context))">Retry</MudButton>
                                            }
                                            @if (context.Type == RequestTaskType.Automation && HasAutomationRecoveryContext(context))
                                            {
                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           Color="Color.Info"
                                                           Href="@BuildAutomationRecoveryLink(context)">
                                                    Recovery
                                                </MudButton>
                                            }
                                        </MudStack>
                                        @if (context.Type == RequestTaskType.Automation && HasAutomationRecoveryContext(context))
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block mt-1">
                                                Run: @(context.OrchestrationExternalRunId ?? context.OrchestratorExecutionId ?? "-")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                Request: @(context.OrchestrationExternalRequestId ?? "-")
                                            </MudText>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudTabPanel>
                <MudTabPanel Text="Workflow">
                    <MudPaper Class="pa-3">
                        <MudStack Row="true" Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
                            <MudSelect T="string" Label="Event Group" Dense="true" Value="@workflowCategoryGroup" ValueChanged="OnWorkflowCategoryGroupChanged" Style="min-width: 180px;">
                                <MudSelectItem T="string" Value="@("All")">All</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Tasks")">Tasks</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Workflow")">Workflow</MudSelectItem>
                                <MudSelectItem T="string" Value="@("SLA")">SLA</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Orchestrator")">Orchestrator</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="string" Label="Range" Dense="true" Value="@workflowRange" ValueChanged="OnWorkflowRangeChanged" Style="min-width: 140px;">
                                <MudSelectItem T="string" Value="@("24h")">Last 24h</MudSelectItem>
                                <MudSelectItem T="string" Value="@("7d")">Last 7d</MudSelectItem>
                                <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                            </MudSelect>
                            <MudTextField T="string" Label="Correlation Id" Dense="true" Value="@workflowCorrelationId" ValueChanged="OnWorkflowCorrelationChanged" />
                            <MudTextField T="string" Label="Search" Dense="true" Value="@workflowSearch" ValueChanged="OnWorkflowSearchChanged" />
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadWorkflowTimelineAsync">Refresh</MudButton>
                        </MudStack>

                        @if (workflowTimelineLoading && workflowTimeline.Count == 0)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (FilteredWorkflowTimeline.Count == 0)
                        {
                            <MudText Typo="Typo.body2">No workflow events found for current filters.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="1">
                                @foreach (var item in FilteredWorkflowTimeline)
                                {
                                    <MudPaper Class="pa-2" Outlined="true">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudChip T="string" Size="Size.Small" Color="@GetWorkflowSeverityColor(item.Severity)">@item.Severity</MudChip>
                                                <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.caption">@item.CreatedAt.LocalDateTime.ToString("g")</MudText>
                                            @if (!string.IsNullOrWhiteSpace(item.CorrelationId))
                                            {
                                                <MudText Typo="Typo.caption">Correlation: @item.CorrelationId</MudText>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }

                        @if (workflowHasMore)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@workflowTimelineLoading" OnClick="LoadMoreWorkflowTimelineAsync">
                                Load More
                            </MudButton>
                        }
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex flex-column">
            <TicketDetailsPanel>
                <ChildContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="12" xl="6">
                                <MudSelect T="TicketState" Value="@request.State" ValueChanged="OnStateChanged"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Label="Status"
                                           Variant="Variant.Outlined"
                                           Disabled="@(!CanManage || isUpdating)">
                                    @foreach (TicketState state in Enum.GetValues(typeof(TicketState)))
                                    {
                                        <MudSelectItem T="TicketState" Value="@state">@state.ToString()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="12" xl="6">
                                <MudSelect T="TicketPriority" Value="@request.Priority" ValueChanged="OnPriorityChanged"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Label="Priority"
                                           Variant="Variant.Outlined"
                                           Disabled="@(!CanManage || isUpdating)">
                                    @foreach (TicketPriority priority in Enum.GetValues(typeof(TicketPriority)))
                                    {
                                        <MudSelectItem T="TicketPriority" Value="@priority">@priority.ToString()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <AssigneeSelector Module="request" OrganizationId="@request.OrganizationId" TicketId="@request.Id"
                                                  Value="@request.AssignedToId" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <HelpDesk.NewWeb.Components.Shared.ServiceCategoryPicker
                                    RequestedType="TicketCategoryType.Request" OrganizationId="@request.OrganizationId" ScopeKey="@request.Id"
                                    SelectedCategoryIds="@selectedCategoryIds"
                                    SelectedCategoryIdsChanged="OnCategorySelectionChanged" ReadOnly="@(!CanManage || isUpdating)"
                                    Dense="true"
                                    Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12">
                                <p class="details-metadata">Created: @(request.CreatedAt.ToString("g"))</p>
                            </MudItem>
                            @if (!string.IsNullOrWhiteSpace(request.SourceTicketId))
                            {
                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">AI Source</MudText>
                                    @if (!string.IsNullOrWhiteSpace(request.SourceTicketId))
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block">
                                            Incident:
                                            <MudLink Href="@($"/incidents/{request.SourceTicketId}")">
                                                @(request.SourceTicketTrackingId ?? request.SourceTicketId)
                                            </MudLink>
                                        </MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.SourceAutomationBindingId))
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block">
                                            Automation binding: @request.SourceAutomationBindingId
                                        </MudText>
                                    }
                                </MudItem>
                            }
                            @if (request.Sla is not null)
                            {
                                <MudItem xs="12">
                                    <TicketSlaSummary Sla="@request.Sla" CanManage="@CanManage" Busy="@isUpdating"
                                                      OnPause="PauseSlaAsync" OnResume="ResumeSlaAsync" />
                                </MudItem>
                            }
                        </MudGrid>
                    </ChildContent>

                    <Actions>
                        <MudButton OnClick="RevertChanges"
                                   Disabled="!CanManage || !hasChanges || isUpdating">Revert</MudButton>
                        <MudButton OnClick="SaveChangesAsync"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="!CanManage || !hasChanges || isUpdating">
                            @if (isUpdating)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            Save Changes
                        </MudButton>
                    </Actions>
            </TicketDetailsPanel>
        </MudItem>
    </MudGrid>
}

@code {
    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if (hasChanges && await DialogService.ShowMessageBoxAsync("Unsaved changes", "Leave this ticket and discard unsaved changes?", yesText: "Discard changes", cancelText: "Keep editing") != true)
            context.PreventNavigation();
    }

    private CurrentUserAccessProfile? accessProfile;
    private bool CanManage => accessProfile?.CanManageRequest(request?.OrganizationId) == true;
    private bool CanContribute => request is not null && accessProfile?.CanContributeRequest(request.OrganizationId, request.CustomerId, request.CustomerEmail) == true;

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    [Parameter] public string Id { get; set; } = string.Empty;
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private RequestDto? request;
    private RequestDto? originalRequest;
    private List<RequestTaskDto> tasks = new();
    private Dictionary<string, string> userDisplayNames = new(StringComparer.OrdinalIgnoreCase);
    private List<TicketCategoryDto> categories = new();
    private HashSet<Guid> selectedCategoryIds = new();
    private bool loading = true;
    private bool tasksLoading;
    private bool taskActionInProgress;
    private bool canRetryAutomationTasks => accessProfile?.CanExecuteRequest(request?.OrganizationId) == true;
    private bool CanOperateTask(RequestTaskDto task) => task.Type == RequestTaskType.Automation ? canRetryAutomationTasks : task.Type == RequestTaskType.Manual && CanManage;
    private bool canViewWorkflowPayload;
    private bool isUpdating;
    private bool hasChanges;
    private readonly List<WorkflowTimelineItemDto> workflowTimeline = new();
    private bool workflowTimelineLoading;
    private bool workflowHasMore;
    private int workflowPage = 1;
    private const int WorkflowPageSize = 50;
    private string workflowCategoryGroup = "All";
    private string workflowRange = "7d";
    private string? workflowCorrelationId;
    private string? workflowSearch;

    private List<WorkflowTimelineItemDto> FilteredWorkflowTimeline => workflowTimeline
        .Where(item =>
            string.IsNullOrWhiteSpace(workflowSearch)
            || item.Title.Contains(workflowSearch, StringComparison.OrdinalIgnoreCase)
            || item.Category.Contains(workflowSearch, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string? loadedRequestId;
    private int ticketVersion, workflowVersion, refreshVersion;
    private bool disposed;
    private CancellationTokenSource ticketLifetime = new();
    private bool IsCurrent(int version) => !disposed && version == ticketVersion;
    public void Dispose() { disposed = true; ticketVersion++; ticketLifetime.Cancel(); ticketLifetime.Dispose(); }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedRequestId == Id) return;
        loadedRequestId = Id;
        request = null; originalRequest = null; selectedCategoryIds = new();
        var version = ++ticketVersion;
        ticketLifetime.Cancel(); ticketLifetime.Dispose(); ticketLifetime = new();
        var token = ticketLifetime.Token;
        taskActionInProgress = false;
        tasks = new(); userDisplayNames.Clear();
        workflowVersion++;
        workflowTimeline.Clear();
        loading = true;
        hasChanges = false;
        isUpdating = false;
        try
        {
            var requestTask = HelpdeskApi.GetFromJsonAsync<RequestDto>($"api/v1/requests/{Id}", token);
            var categoriesTask = HelpdeskApi.GetFromJsonAsync<List<TicketCategoryDto>>($"api/v1/categories?type={(int)TicketCategoryType.Request}", token);
            var requestTasksTask = LoadTasksAsync();
            var workflowTimelineTask = LoadWorkflowTimelineAsync(reset: true);
            var rolesTask = ResolveRolesAsync();
            accessProfile = CurrentUserAccessProfile.FromClaims((await AccessAuthenticationState.GetAuthenticationStateAsync()).User);

            await Task.WhenAll(requestTask, categoriesTask, requestTasksTask, workflowTimelineTask, rolesTask);

            if (!IsCurrent(version)) return;
            originalRequest = await requestTask;
            categories = await categoriesTask ?? new();
            categories = categories
                .GroupBy(x => x.Id)
                .Select(x => x.First())
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.Name)
                .ToList();

            if (originalRequest != null)
            {
                request = CloneRequest(originalRequest);
                selectedCategoryIds = request.CategoryIds.ToHashSet();
                if (CanManage) await LoadTeamMembersAsync();
            }

        }
        catch (Exception ex)
        {
            if (!IsCurrent(version)) return;
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            request = null;
        }
        finally
        {
            if (IsCurrent(version)) loading = false;
        }
    }

    private static RequestDto CloneRequest(RequestDto source)
    {
        return new RequestDto
        {
            Id = source.Id,
            OrganizationId = source.OrganizationId,
            Title = source.Title,
            Description = source.Description,
            State = source.State,
            Priority = source.Priority,
            CreatedAt = source.CreatedAt,
            UpdatedAt = source.UpdatedAt,
            TrackingId = source.TrackingId,
            CustomerId = source.CustomerId,
            CustomerName = source.CustomerName,
            CustomerEmail = source.CustomerEmail,
            CategoryIds = source.CategoryIds.ToList(),
            AssignedToId = source.AssignedToId,
            ServiceId = source.ServiceId,
            RequestFormId = source.RequestFormId,
            PayloadJson = source.PayloadJson,
            SourceTicketId = source.SourceTicketId,
            SourceTicketTrackingId = source.SourceTicketTrackingId,
            SourceAutomationBindingId = source.SourceAutomationBindingId,
            WorkflowStatus = source.WorkflowStatus,
            WorkflowBlockReason = source.WorkflowBlockReason,
            WorkflowUpdatedAt = source.WorkflowUpdatedAt,
            Sla = source.Sla is null ? null : new TicketSlaDto
            {
                StartedAt = source.Sla.StartedAt,
                ResponseDueAt = source.Sla.ResponseDueAt,
                ResolutionDueAt = source.Sla.ResolutionDueAt,
                Status = source.Sla.Status,
                PausedAt = source.Sla.PausedAt,
                ResumeAt = source.Sla.ResumeAt,
                PauseReason = source.Sla.PauseReason,
                ResponseBreached = source.Sla.ResponseBreached,
                ResolutionBreached = source.Sla.ResolutionBreached,
                ResponseRemainingSeconds = source.Sla.ResponseRemainingSeconds,
                ResolutionRemainingSeconds = source.Sla.ResolutionRemainingSeconds,
                ResponsePercentUsed = source.Sla.ResponsePercentUsed,
                ResolutionPercentUsed = source.Sla.ResolutionPercentUsed
            }
        };
    }

    private void OnStateChanged(TicketState newState)
    {
        if (request is null) return;
        request.State = newState;
        hasChanges = true;
    }

    private void OnPriorityChanged(TicketPriority newPriority)
    {
        if (request is null) return;
        request.Priority = newPriority;
        hasChanges = true;
    }

    private void OnCategorySelectionChanged(HashSet<Guid> categoryIds)
    {
        if (request is null) return;
        selectedCategoryIds = categoryIds.ToHashSet();
        request.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = true;
    }

    private void OnCategoryRemoved(Guid id)
    {
        if (request is null) return;

        selectedCategoryIds.Remove(id);
        request.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = true;

    }

    private void RevertChanges()
    {
        if (originalRequest is null || request is null) return;

        request.State = originalRequest.State;
        request.Priority = originalRequest.Priority;
        request.CustomerId = originalRequest.CustomerId;
        request.CustomerName = originalRequest.CustomerName;
        request.CustomerEmail = originalRequest.CustomerEmail;
        selectedCategoryIds = originalRequest.CategoryIds.ToHashSet();
        request.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = false;
    }

    private async Task SaveChangesAsync()
    {
        if (!CanManage || isUpdating || request is null || !hasChanges) return;

        var savingTicketId = Id;
        var version = ticketVersion;
        var token = ticketLifetime.Token;
        refreshVersion++;
        isUpdating = true;

        try
        {
            var updateDto = new UpdateRequestDto
            {
                State = request.State,
                Priority = request.Priority,
                CategoryIds = selectedCategoryIds.ToList()
            };

            using var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/requests/{savingTicketId}", updateDto, token);

            if (!IsCurrent(version)) return;
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<RequestDto>(token);
                if (!IsCurrent(version)) return;
                if (updated is not null)
                {
                    originalRequest = CloneRequest(updated);
                    request = CloneRequest(updated);
                    selectedCategoryIds = updated.CategoryIds.ToHashSet();
                    hasChanges = false;
                }

                Snackbar.Add("Request saved successfully!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync(token);
                if (!IsCurrent(version)) return;
                Snackbar.Add($"Error saving request: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            if (IsCurrent(version)) Snackbar.Add($"A client-side error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (IsCurrent(version)) { isUpdating = false; refreshVersion++; }
        }
    }

    private async Task HandleWorklogAdded()
    {
        var version = ticketVersion;
        try
        {
            await RefreshRequestAndTasksAsync();
        }
        catch (Exception ex)
        {
            if (IsCurrent(version)) Snackbar.Add($"Error refreshing request: {ex.Message}", Severity.Error);
        }
    }

    private async Task PauseSlaAsync()
    {
        if (!CanManage || isUpdating) return;
        var version = ticketVersion;
        var ticketId = Id;
        var token = ticketLifetime.Token;
        var dialog = await DialogService.ShowAsync<HelpDesk.NewWeb.Components.Shared.SlaPauseDialog>(
            "Pause SLA", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (!IsCurrent(version) || !CanManage || result.Canceled || result.Data is not PauseSlaRequest requestBody) return;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{ticketId}/sla/pause", requestBody, token);
            if (!IsCurrent(version)) return;
            if (!response.IsSuccessStatusCode) { Snackbar.Add("Failed to pause SLA.", Severity.Error); return; }
            await HandleWorklogAdded();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (HttpRequestException) { if (IsCurrent(version)) Snackbar.Add("Failed to pause SLA.", Severity.Error); }
    }

    private async Task ResumeSlaAsync()
    {
        if (!CanManage || isUpdating) return;
        var version = ticketVersion;
        var ticketId = Id;
        var token = ticketLifetime.Token;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{ticketId}/sla/resume", new ResumeSlaRequest(), token);
            if (!IsCurrent(version)) return;
            if (!response.IsSuccessStatusCode) { Snackbar.Add("Failed to resume SLA.", Severity.Error); return; }
            await HandleWorklogAdded();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (HttpRequestException) { if (IsCurrent(version)) Snackbar.Add("Failed to resume SLA.", Severity.Error); }
    }

    private static string FormatRemaining(long totalSeconds)
    {
        if (totalSeconds <= 0) return "0m";
        var span = TimeSpan.FromSeconds(totalSeconds);
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{Math.Max(1, span.Minutes)}m";
    }

