    private static string? GetAutomationRecoverySearch(RequestTaskDto task)
        => FirstNonEmpty(
            task.OrchestrationExternalRunId,
            task.OrchestrationExternalRequestId,
            task.OrchestratorExecutionId,
            task.AutomationBindingId,
