            task.Id);

    private async Task ExecuteTaskActionAsync(string taskId, string action, string successMessage)
    {
        var task = tasks.FirstOrDefault(x => x.Id == taskId);
        if (taskActionInProgress || task is null || !CanOperateTask(task)) return;
        var version = ticketVersion;
        var token = ticketLifetime.Token;
        taskActionInProgress = true;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/request-tasks/{taskId}/{action}", new { }, token);
            if (!IsCurrent(version)) return;
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync(token);
                if (IsCurrent(version)) Snackbar.Add(string.IsNullOrWhiteSpace(error) ? $"Failed to {action} task." : error, Severity.Error);
                return;
            }
            await RefreshRequestAndTasksAsync();
            if (IsCurrent(version)) Snackbar.Add(successMessage, Severity.Success);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception ex) { if (IsCurrent(version)) Snackbar.Add($"Failed to {action} task: {ex.Message}", Severity.Error); }
        finally { if (IsCurrent(version)) taskActionInProgress = false; }
    }

    private async Task RefreshRequestAndTasksAsync()
    {
        if (isUpdating) { refreshPending = true; return; }
        var version = ticketVersion;
        var refresh = ++refreshVersion;
        var token = ticketLifetime.Token;
        var ticketId = Id;
        var updatedTask = HelpdeskApi.GetFromJsonAsync<RequestDto>($"api/v1/requests/{ticketId}", token);
        var tasksTask = HelpdeskApi.GetFromJsonAsync<List<RequestTaskDto>>($"api/v1/requests/{ticketId}/tasks", token);
        var workflowTask = LoadWorkflowTimelineAsync(reset: true, preserveWindow: true);
        await Task.WhenAll(updatedTask, tasksTask, workflowTask);
        if (!IsCurrent(version) || refresh != refreshVersion || isUpdating) return;
        var updated = await updatedTask;
        if (updated is not null)
        {
            // Worklog, task and SLA refreshes update metadata without discarding the details draft.
            if (hasChanges && request is not null && originalRequest is not null)
            {
                var draft = request;
                var baseline = originalRequest;
                request = CloneRequest(updated);
                originalRequest = CloneRequest(updated);
                if (draft.State != baseline.State) request.State = draft.State;
                if (draft.Priority != baseline.Priority) request.Priority = draft.Priority;
                if (!selectedCategoryIds.SetEquals(baseline.CategoryIds)) request.CategoryIds = selectedCategoryIds.ToList();
                else selectedCategoryIds = updated.CategoryIds.ToHashSet();
            }
            else
            {
                originalRequest = CloneRequest(updated);
                request = CloneRequest(updated);
                selectedCategoryIds = updated.CategoryIds.ToHashSet();
            }
        }
        ApplyTaskSnapshot(await tasksTask ?? new List<RequestTaskDto>());
        if (request is not null && originalRequest is not null)
            hasChanges = request.State != originalRequest.State || request.Priority != originalRequest.Priority ||
                !selectedCategoryIds.SetEquals(originalRequest.CategoryIds);
    }

