    private static string FormatDeadline(long? ticks)
    {
        if (ticks is not { } value || value <= 0 || value > DateTime.MaxValue.Ticks) return "Not recorded";
        return new DateTime(value, DateTimeKind.Utc).ToLocalTime().ToString("g");
    }
    private static string FormatElapsed(RequestTaskDto task)
    {
        if (task.StartedAt is not { } started) return "Not recorded";
        var end = task.CompletedAt ?? task.AutomationTimedOutAt ?? DateTimeOffset.UtcNow;
        return TimeSpan.FromSeconds(Math.Max(0, Math.Floor((end - started).TotalSeconds))).ToString(@"d\.hh\:mm\:ss");
    }
