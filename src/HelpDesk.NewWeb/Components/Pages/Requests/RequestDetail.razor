    private async Task LoadWorkflowTimelineAsync(bool reset, bool preserveWindow = false)
    {
        var version = ticketVersion;
        var queryVersion = ++workflowVersion;
        var token = ticketLifetime.Token;
        workflowTimelineLoading = true;
        workflowTimelineError = null;
        try
        {
            var pagesToLoad = reset ? (preserveWindow ? workflowPage : 1) : 1;
            var firstPage = reset ? 1 : workflowPage;
            var loaded = new List<WorkflowTimelineItemDto>();
            var total = 0;
            for (var pageNumber = firstPage; pageNumber < firstPage + pagesToLoad; pageNumber++)
            {
                var page = await HelpdeskApi.GetFromJsonAsync<PagedResponse<WorkflowTimelineItemDto>>(BuildWorkflowTimelineUrl(pageNumber), token);
                if (page is null || !IsCurrent(version) || queryVersion != workflowVersion) return;
                loaded.AddRange(page.Items ?? []);
                total = page.TotalCount;
                if (loaded.Count >= total) break;
            }
            if (reset)
            {
                if (!preserveWindow) workflowPage = 1;
                workflowTimeline.Clear();
            }
            workflowTimeline.AddRange(loaded.GroupBy(x => x.NotificationId).Select(x => x.First()));
            workflowHasMore = workflowTimeline.Count < total;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
        catch (Exception error)
        {
            if (!IsCurrent(version) || queryVersion != workflowVersion) return;
            Logger.LogWarning(error, "Workflow timeline could not be refreshed for {RequestId}", Id);
            workflowTimelineError = error is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Forbidden }
                ? "Workflow details require request management access."
                : "Workflow updates could not be loaded. Refresh to try again.";
        }
        finally { if (IsCurrent(version) && queryVersion == workflowVersion) workflowTimelineLoading = false; }
    }

    private string BuildWorkflowTimelineUrl(int page)
    {
        var query = new List<string>
        {
            $"page={page}",
            $"pageSize={WorkflowPageSize}",
            $"includePayload={canViewWorkflowPayload.ToString().ToLowerInvariant()}"
        };

        if (!string.IsNullOrWhiteSpace(workflowCorrelationId))
        {
            query.Add($"correlationId={Uri.EscapeDataString(workflowCorrelationId.Trim())}");
        }

        var categories = workflowCategoryGroup switch
        {
            "Tasks" => "DomainEvent.RequestTask.Blocked,DomainEvent.RequestTask.Unblocked,DomainEvent.RequestTask.Skipped,DomainEvent.RequestTask.Started,DomainEvent.RequestTask.Completed,DomainEvent.RequestTask.Failed,DomainEvent.RequestTask.RetryScheduled,DomainEvent.RequestTask.RetryTriggered,DomainEvent.RequestTask.AutomationSubmitted,DomainEvent.RequestTask.AutomationRunning,DomainEvent.RequestTask.AutomationCompleted,DomainEvent.RequestTask.AutomationFailed",
            "Workflow" => "DomainEvent.Workflow.Evaluated,DomainEvent.Workflow.Progressed,DomainEvent.Workflow.RequestBlockedByTaskFailure,DomainEvent.Workflow.RequestFailedByCriticalTask,DomainEvent.Workflow.TaskFailureIgnored",
            "SLA" => "DomainEvent.RequestTask.SlaStarted,DomainEvent.RequestTask.Escalated,DomainEvent.RequestTask.SlaBreached",
            "Orchestrator" => "DomainEvent.RequestTask.AutomationSubmitted,DomainEvent.RequestTask.AutomationRunning,DomainEvent.RequestTask.AutomationCompleted,DomainEvent.RequestTask.AutomationFailed,DomainEvent.RequestTask.AutomationSubmitRejected,DomainEvent.RequestTask.AutomationSubmitUncertain,DomainEvent.Orchestration.External orchestration.CallbackReceived",
            _ => null
        };

        if (!string.IsNullOrWhiteSpace(categories))
        {
            query.Add($"categories={Uri.EscapeDataString(categories)}");
        }

        DateTimeOffset? sinceUtc = workflowRange switch
        {
            "24h" => DateTimeOffset.UtcNow.AddHours(-24),
            "7d" => DateTimeOffset.UtcNow.AddDays(-7),
            _ => null
        };
        if (sinceUtc.HasValue)
        {
            query.Add($"sinceUtc={Uri.EscapeDataString(sinceUtc.Value.ToString("O"))}");
        }

        return $"api/v1/requests/{Id}/workflow-timeline?{string.Join("&", query)}";
    }

