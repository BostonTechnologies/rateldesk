@using HelpDesk.NewWeb.Services
@implements IDisposable
@using Helpdesk.Shared.Services
@using Helpdesk.Shared.Auth
@inject AuthenticationStateProvider AccessAuthenticationState
@page "/requests"
@attribute [Authorize(Roles = "Request.User,Request.Read,Request.Write,Request.Manager,HelpdeskAdmin")]
@using Helpdesk.Shared.DTOs
@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.DTOs.User

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Requests</PageTitle>

<div class="helpdesk-page">
<MudPaper Class="helpdesk-content-surface pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="helpdesk-page-header">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-page-title">Requests</MudText>
        <MudSpacer />
        <MudTooltip Text="Historic">
            <MudIconButton Icon="@Icons.Material.Filled.History"
                           Color="@(filters.View == "historic" ? Color.Primary : Color.Default)"
                           Variant="@(filters.View == "historic" ? Variant.Filled : Variant.Outlined)"
                           aria-label="Show historic requests"
                           OnClick="ToggleHistoric" />
        </MudTooltip>
        @if (CanCreate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Create</MudButton>
        }
    </MudStack>

    <TicketListFilters Module="request" State="filters" Changed="FiltersChanged" />
    @if (queryError is not null) { <MudAlert Severity="Severity.Error">@queryError <MudButton OnClick="Reload">Retry</MudButton></MudAlert> }

    <TicketTable TTicket="RequestDto"
                 @key="tableKey"
                 InitialPage="@(filters.Page - 1)" PageSize="filters.PageSize" QueryError="queryError"
                 @ref="_table"
                 TicketType="requests"
                 CanEditItem="@(item => accessProfile?.CanManageRequest(item.OrganizationId) == true)"
                 EnableSelection="@CanWriteAny"
                 ServerData="LoadServerData"
                 SelectedItems="_selected"
                 SelectedItemsChanged="@(x => _selected = x)"
                 OnRowClick="NavigateToRequest"
                 BulkStateRequested="ApplyBulkState"
                 BulkAssignRequested="ApplyBulkAssign">
        <SubjectTemplate Context="request">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body2">@request.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(request.SourceTicketId))
                {
                    <MudStack Row="true" Spacing="1" Class="mt-1">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            Ticket origin
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(request.SourceTicketTrackingId))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @request.SourceTicketTrackingId
                            </MudChip>
                        }
                    </MudStack>
                }
            </MudStack>
        </SubjectTemplate>
        <AssigneeTemplate Context="request">
            <TicketAssigneePicker @key="request.Id"
                ReadOnly="@(accessProfile?.CanManageRequest(request.OrganizationId) != true)"
                OrganizationId="@request.OrganizationId"
                TicketId="@request.Id"
                TicketType="requests"
                AssignedToId="@request.AssignedToId"
                AssignedToIdChanged="@(x => request.AssignedToId = x)"
                />
        </AssigneeTemplate>
        <CustomerTemplate Context="request">
            <TicketCustomerPicker
                ReadOnly="@(accessProfile?.CanManageRequest(request.OrganizationId) != true)"
                TicketId="@request.Id"
                TicketType="requests"
                OrganizationId="@request.OrganizationId"
                CustomerId="@request.CustomerId"
                CustomerName="@request.CustomerName"
                CustomerEmail="@request.CustomerEmail"
                CustomerChanged="@(selection => UpdateCustomer(request, selection))" />
        </CustomerTemplate>
    </TicketTable>
</MudPaper>
</div>

@code {
    private CurrentUserAccessProfile? accessProfile;
    private bool CanWriteAny => accessProfile?.HasPermission(HelpdeskPermissions.RequestWrite) == true || accessProfile?.HasPermission(HelpdeskPermissions.RequestManager) == true;
    private bool CanCreate => CanWriteAny || accessProfile?.HasPermission(HelpdeskPermissions.RequestUser) == true;
    private TicketListState filters = new();
    private string? appliedUrl, queryError;
    private int tableKey, generation;
    private bool disposed;
    private CancellationTokenSource? pending;
    protected override async Task OnInitializedAsync()
    {
        filters = TicketListState.Parse(NavigationManager.Uri, false);
        appliedUrl = NavigationManager.Uri;
        NavigationManager.LocationChanged += LocationChanged;
        accessProfile = CurrentUserAccessProfile.FromClaims((await AccessAuthenticationState.GetAuthenticationStateAsync()).User);
    }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (disposed || args.Location == appliedUrl || new Uri(args.Location).AbsolutePath.TrimEnd('/') != "/requests") return;
        _ = InvokeAsync(() => {
            pending?.Cancel(); generation++; _selected.Clear(); queryError = null;
            filters = TicketListState.Parse(args.Location, false); appliedUrl = args.Location; tableKey++; StateHasChanged();
        });
    }
    private void SaveUrl(bool replace = false)
    {
        var url = "/requests?" + filters.Query();
        appliedUrl = NavigationManager.ToAbsoluteUri(url).ToString();
        if (NavigationManager.Uri != appliedUrl) NavigationManager.NavigateTo(url, replace: replace);
    }
    private Task FiltersChanged()
    {
        pending?.Cancel(); generation++; _selected.Clear(); queryError = null; filters.Page = 1; tableKey++; SaveUrl();
        return Task.CompletedTask;
    }
    public void Dispose() { disposed = true; NavigationManager.LocationChanged -= LocationChanged; pending?.Cancel(); pending?.Dispose(); }

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private TicketTable<RequestDto>? _table;
    private HashSet<RequestDto> _selected = new();

    private async Task<TableData<RequestDto>> LoadServerData(TableState state, CancellationToken token)
    {
        pending?.Cancel(); pending?.Dispose(); pending = CancellationTokenSource.CreateLinkedTokenSource(token);
        var cancellation = pending.Token; var currentGeneration = ++generation;
        var nextPageSize = state.PageSize <= 0 ? 25 : state.PageSize;
        var pageChanged = filters.Page != state.Page + 1 || filters.PageSize != nextPageSize;
        if (pageChanged) _selected.Clear();
        filters.Page = state.Page + 1; filters.PageSize = nextPageSize;
        if (pageChanged) SaveUrl();
        queryError = filters.ValidationError;
        if (queryError is not null)
        {
            await InvokeAsync(StateHasChanged);
            return new TableData<RequestDto> { Items = [], TotalItems = 0 };
        }
        try
        {
            var response = await HelpdeskApi.GetFromJsonAsync<PagedResponse<RequestDto>>("api/v1/requests?" + filters.Query(api: true), cancellation);
            cancellation.ThrowIfCancellationRequested();
            if (disposed || currentGeneration != generation) throw new OperationCanceledException(cancellation);
            return new TableData<RequestDto> { Items = response?.Items ?? [], TotalItems = response?.TotalCount ?? 0 };
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (!disposed && currentGeneration == generation) { queryError = "Unable to load tickets. Check the filters and try again."; await InvokeAsync(StateHasChanged); }
            return new TableData<RequestDto> { Items = [], TotalItems = 0 };
        }
    }

    private void NavigateToDetail(string ticketType, string id)
    {
        NavigationManager.NavigateTo($"/{ticketType}/{id}?returnUrl={Uri.EscapeDataString(new Uri(NavigationManager.Uri).PathAndQuery)}");
    }

    private void NavigateToRequest(string id) => NavigateToDetail("requests", id);

    private static void UpdateCustomer(RequestDto request, TicketCustomerPicker.CustomerSelection selection)
    {
        request.CustomerId = selection.CustomerId;
        request.CustomerName = selection.CustomerName;
        request.CustomerEmail = selection.CustomerEmail;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateRequestDialog>("Create Request", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && _table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private Task Reload()
    {
        _selected.Clear();
        return _table?.ReloadServerData() ?? Task.CompletedTask;
    }

    private Task ToggleHistoric()
    {
        filters.View = filters.View == "historic" ? "active" : "historic"; filters.States.Clear();
        return FiltersChanged();
    }



    private async Task ApplyBulkState()
    {
        if (_selected.Count == 0 || _table is null || _selected.Any(item => accessProfile?.CanManageRequest(item.OrganizationId) != true)) return;

        var ids = _selected.Select(x => x.Id).ToList();
        var selectedState = _table.SelectedBulkState;
        var response = await HelpdeskApi.PostAsJsonAsync("/api/v1/requests/bulk/state", new { Ids = ids, NewState = selectedState, Comment = (string?)null });
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"Updated {_selected.Count} request(s) to {selectedState}", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Bulk update failed", Severity.Error);
        }
    }

    private async Task ApplyBulkAssign()
    {
        if (_selected.Count == 0 || _table is null || _selected.Any(item => accessProfile?.CanManageRequest(item.OrganizationId) != true)) return;

        var ids = _selected.Select(x => x.Id).ToList();
        var assigneeId = _table.SelectedBulkAssigneeId;
        var response = await HelpdeskApi.PostAsJsonAsync("/api/v1/requests/bulk/assign", new { Ids = ids, AssignedToId = assigneeId });
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"Assigned {_selected.Count} request(s)", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Bulk assign failed", Severity.Error);
        }
    }

}
