@using Helpdesk.Shared.Services
@using Helpdesk.Shared.Auth
@inject AuthenticationStateProvider AccessAuthenticationState
@page "/incidents"
@attribute [Authorize(Roles = "Incident.User,Incident.Read,Incident.Write,Incident.Manager,HelpdeskAdmin")]
@using Helpdesk.Shared.DTOs.User

@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<PageTitle>Incidents</PageTitle>

<div class="helpdesk-page">
<MudPaper Class="helpdesk-content-surface pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="helpdesk-page-header">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-page-title">Incidents</MudText>
        <MudSpacer />
        <MudTooltip Text="Historic">
            <MudIconButton Icon="@Icons.Material.Filled.History"
                           Color="@(historicOnly ? Color.Primary : Color.Default)"
                           Variant="@(historicOnly ? Variant.Filled : Variant.Outlined)"
                           aria-label="Show historic incidents"
                           OnClick="ToggleHistoric" />
        </MudTooltip>
        @if (CanCreate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Create</MudButton>
        }
    </MudStack>

    <div class="helpdesk-list-toolbar">
        <MudTextField @bind-Value="search"
                      Placeholder="Search incidents"
                      Adornment="Adornment.Start"
                      Icon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnBlur="Reload"
                      OnKeyUp="@(async _ => await DebouncedReload())"
                      Class="helpdesk-list-search" />

    </div>

    <TicketTable TTicket="IncidentDto"
                 @ref="_table"
                 TicketType="incidents"
                 CanEditItem="@(item => accessProfile?.CanManageIncident(item.OrganizationId) == true)"
                 EnableSelection="@CanWriteAny"
                 ServerData="LoadServerData"
                 SelectedItems="_selected"
                 SelectedItemsChanged="@(x => _selected = x)"
                 OnRowClick="NavigateToIncident"
                 BulkStateRequested="ApplyBulkState"
                 BulkAssignRequested="ApplyBulkAssign"
                 BulkActions="AvailableBulkActions"
                 BulkActionRequested="ApplyBulkAction">
        <SubjectTemplate Context="incident">
            <MudStack Spacing="0">
                <IncidentSubjectWithPeek IncidentId="@incident.Id"
                                         Subject="@incident.Subject" />
            </MudStack>
        </SubjectTemplate>
        <AssigneeTemplate Context="incident">
            <TicketAssigneePicker @key="incident.Id"
                ReadOnly="@(accessProfile?.CanManageIncident(incident.OrganizationId) != true)"
                OrganizationId="@incident.OrganizationId"
                TicketId="@incident.Id"
                TicketType="incidents"
                AssignedToId="@incident.AssignedToId"
                AssignedToIdChanged="@(x => incident.AssignedToId = x)"
                />
        </AssigneeTemplate>
        <CustomerTemplate Context="incident">
            <TicketCustomerPicker
                ReadOnly="@(accessProfile?.CanManageIncident(incident.OrganizationId) != true)"
                TicketId="@incident.Id"
                TicketType="incidents"
                OrganizationId="@incident.OrganizationId"
                CustomerId="@incident.CustomerId"
                CustomerName="@incident.CustomerName"
                CustomerEmail="@incident.CustomerEmail"
                CustomerChanged="@(selection => UpdateCustomer(incident, selection))" />
        </CustomerTemplate>
    </TicketTable>
</MudPaper>
</div>

@code {
    private CurrentUserAccessProfile? accessProfile;
    private bool CanWriteAny => accessProfile?.HasPermission(HelpdeskPermissions.IncidentWrite) == true || accessProfile?.HasPermission(HelpdeskPermissions.IncidentManager) == true;
    private bool CanCreate => CanWriteAny || accessProfile?.HasPermission(HelpdeskPermissions.IncidentUser) == true;
    protected override async Task OnInitializedAsync() => accessProfile = CurrentUserAccessProfile.FromClaims((await AccessAuthenticationState.GetAuthenticationStateAsync()).User);

    [Parameter]
    [SupplyParameterFromQuery]
    public string? State { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    [SupplyParameterFromQuery]
    public bool ActiveOnly { get; set; }

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private TicketTable<IncidentDto>? _table;
    private string? search;
    private CancellationTokenSource? _debounceCts;
    private HashSet<IncidentDto> _selected = new();
    private bool historicOnly;
    private string? appliedQuerySearch;
    private IReadOnlyList<TicketTable<IncidentDto>.BulkActionOption> AvailableBulkActions =>
        _selected.Count > 0 && _selected.All(item => accessProfile?.CanDeleteIncident(item.OrganizationId) == true)
            ? IncidentBulkActions : IncidentBulkActions.Where(action => action.Key != "delete").ToList();
    private static readonly IReadOnlyList<TicketTable<IncidentDto>.BulkActionOption> IncidentBulkActions =
    [
        new("delete", "Delete"),
        new("marketing-spam", "Mark as Marketing/Spam")
    ];

    protected override void OnParametersSet()
    {
        if (!string.Equals(appliedQuerySearch, QuerySearch, StringComparison.Ordinal))
        {
            appliedQuerySearch = QuerySearch;
            search = QuerySearch;
            _ = _table?.ReloadServerData();
        }
    }

    // Called by MudTable whenever page/size/sort changes
    private async Task<TableData<IncidentDto>> LoadServerData(TableState state, CancellationToken token)
    {
        var page = state.Page + 1;
        var pageSize = state.PageSize <= 0 ? 10 : state.PageSize;

        var url = $"api/v1/incidents?page={page}&pageSize={pageSize}";

        if (!string.IsNullOrEmpty(State))
            url += $"&state={Uri.EscapeDataString(State)}";
        else if (historicOnly)
            url += "&historicOnly=true";
        else if (ActiveOnly)
            url += "&activeOnly=true";


        if (!string.IsNullOrWhiteSpace(search))
            url += $"&q={Uri.EscapeDataString(search)}";


        var resp = await HelpdeskApi.GetFromJsonAsync<PagedResponse<IncidentDto>>(url, token);

        return new TableData<IncidentDto>
        {
            Items = resp?.Items ?? new List<IncidentDto>(),
            TotalItems = resp?.TotalCount ?? 0
        };
    }

    private void NavigateToDetail(string ticketType, string id) =>
        NavigationManager.NavigateTo($"/{ticketType}/{id}");

    private void NavigateToIncident(string id) => NavigateToDetail("incidents", id);

    private static void UpdateCustomer(IncidentDto incident, TicketCustomerPicker.CustomerSelection selection)
    {
        incident.CustomerId = selection.CustomerId;
        incident.CustomerName = selection.CustomerName;
        incident.CustomerEmail = selection.CustomerEmail;
        incident.RequesterEmail = selection.CustomerEmail;
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CreateIncidentDialog>(
            "Create Incident",
            options);

        var result = await dialog.Result;

        if (!result.Canceled && _table is not null)
            await _table.ReloadServerData();
    }

    private Task Reload()
    {
        _selected.Clear();
        return _table?.ReloadServerData() ?? Task.CompletedTask;
    }

    private async Task ToggleHistoric()
    {
        historicOnly = !historicOnly;
        await Reload();
    }

    private async Task ApplyBulkState()
    {
        if (_selected.Count == 0 || _table is null || _selected.Any(item => accessProfile?.CanManageIncident(item.OrganizationId) != true)) return;
        var selectedState = _table.SelectedBulkState;
        var ids = _selected.Select(x => x.Id).ToList();
        var resp = await HelpdeskApi.PostAsJsonAsync("/api/v1/incidents/bulk/state", new { Ids = ids, NewState = selectedState, Comment = (string?)null });
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"Updated {_selected.Count} incident(s) to {selectedState}", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Bulk update failed", Severity.Error);
        }
    }

    private async Task ApplyBulkAssign()
    {
        if (_selected.Count == 0 || _table is null || _selected.Any(item => accessProfile?.CanManageIncident(item.OrganizationId) != true)) return;
        var assigneeId = _table.SelectedBulkAssigneeId;
        var ids = _selected.Select(x => x.Id).ToList();
        var resp = await HelpdeskApi.PostAsJsonAsync("/api/v1/incidents/bulk/assign", new { Ids = ids, AssignedToId = assigneeId });
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"Assigned {_selected.Count} incident(s)", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Bulk assign failed", Severity.Error);
        }
    }

    private Task ApplyBulkAction(string action) => action switch
    {
        "delete" => ApplyBulkDelete(),
        "marketing-spam" => ApplyBulkMarketingSpam(),
        _ => Task.CompletedTask
    };

    private async Task ApplyBulkDelete()
    {
        if (_selected.Count == 0 || _selected.Any(item => accessProfile?.CanDeleteIncident(item.OrganizationId) != true)) return;
        var count = _selected.Count;
        var confirm = await DialogService.ShowMessageBoxAsync(
            $"Delete {count} selected tickets?",
            "This action will remove the selected tickets and will not notify the requester.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirm != true)
        {
            return;
        }

        var ids = _selected.Select(x => x.Id).ToList();
        var resp = await HelpdeskApi.PostAsJsonAsync("/api/v1/incidents/bulk/delete", new { Ids = ids });
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"Deleted {count} incident(s)", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Bulk delete failed", Severity.Error);
        }
    }

    private async Task ApplyBulkMarketingSpam()
    {
        if (_selected.Count == 0 || _selected.Any(item => accessProfile?.CanManageIncident(item.OrganizationId) != true)) return;
        var count = _selected.Count;
        var confirm = await DialogService.ShowMessageBoxAsync(
            $"Mark {count} selected tickets as Marketing/Spam?",
            "This action will silently close the selected tickets and will not notify the requester.",
            yesText: "Mark as Marketing/Spam",
            cancelText: "Cancel",
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirm != true)
        {
            return;
        }

        var ids = _selected.Select(x => x.Id).ToList();
        var resp = await HelpdeskApi.PostAsJsonAsync("/api/v1/incidents/bulk/marketing-spam", new { Ids = ids });
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"Marked {count} incident(s) as marketing/spam", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Bulk marketing/spam update failed", Severity.Error);
        }
    }

    // Tiny debounce so typing in search doesn’t fetch on every keystroke
    private async Task DebouncedReload()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _debounceCts.Token);
            await Reload();
        }
        catch (TaskCanceledException) { }
    }
}
