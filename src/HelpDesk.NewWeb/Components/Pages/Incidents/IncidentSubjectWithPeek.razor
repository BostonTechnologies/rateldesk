@implements IDisposable

<button @ref="_anchor" type="button" class="incident-preview-trigger" aria-haspopup="dialog"
        aria-expanded="@(_open ? "true" : "false")" aria-controls="@_previewId" aria-label="@($"Preview: {Subject}")"
        @onmouseenter="AnchorEnter" @onmouseleave="AnchorLeave" @onfocus="AnchorFocus" @onblur="AnchorBlur"
        @onclick="Activate" @onclick:stopPropagation="true" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true">
    @Subject
</button>

<MudPopover Open="_open" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="pa-2">
    @if (_open)
    {
        <div id="@_previewId" role="dialog" aria-label="Email preview" class="incident-preview-body" tabindex="-1"
             @onmouseenter="PopoverEnter" @onmouseleave="PopoverLeave" @onfocusin="PopoverFocus" @onfocusout="PopoverBlur"
             @onkeydown="OnKeyDown" @onclick:stopPropagation="true">
            <div class="incident-preview-heading">
                <strong>Email preview</strong>
                <button @ref="_closeButton" type="button" class="incident-preview-close" @onclick="Dismiss">Close preview</button>
            </div>
            <TicketMessages @key="IncidentId" TicketId="@IncidentId" TicketType="incidents" OnEscape="Dismiss" />
        </div>
    }
</MudPopover>

@code {
    [Parameter] public string IncidentId { get; set; } = string.Empty;
    [Parameter] public string Subject { get; set; } = string.Empty;
    private readonly string _previewId = "email-preview-" + Guid.NewGuid().ToString("N");
    private ElementReference _anchor, _closeButton;
    private bool _moveFocus;
    private bool _open, _hoverAnchor, _hoverPopover, _focusAnchor, _focusPopover, _disposed, _dismissed;
    private string? _previousId;
    private CancellationTokenSource? _closeCts;

    protected override void OnParametersSet()
    {
        if (_previousId == IncidentId) return;
        _previousId = IncidentId;
        _closeCts?.Cancel();
        _open = _hoverAnchor = _hoverPopover = _focusAnchor = _focusPopover = _dismissed = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moveFocus && _open) { _moveFocus = false; await _closeButton.FocusAsync(preventScroll: true); }
    }
    private void Activate() { Open(); _moveFocus = true; }
    private void Open() { _dismissed = false; _closeCts?.Cancel(); _open = true; }
    private void AnchorEnter() { _hoverAnchor = true; Open(); }
    private Task AnchorLeave() { _hoverAnchor = false; return TryCloseAfterDelay(); }
    private void AnchorFocus() { _focusAnchor = true; if (!_dismissed) Open(); }
    private Task AnchorBlur() { _focusAnchor = false; return TryCloseAfterDelay(); }
    private void PopoverEnter() { _hoverPopover = true; _closeCts?.Cancel(); }
    private Task PopoverLeave() { _hoverPopover = false; return TryCloseAfterDelay(); }
    private void PopoverFocus() { _focusPopover = true; _closeCts?.Cancel(); }
    private Task PopoverBlur() { _focusPopover = false; return TryCloseAfterDelay(); }
    private async Task OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") await Dismiss(); }
    private async Task Dismiss()
    {
        _dismissed = true; _open = false; _focusPopover = _hoverPopover = false;
        _closeCts?.Cancel();
        await _anchor.FocusAsync(preventScroll: true);
    }
    private async Task TryCloseAfterDelay()
    {
        _closeCts?.Cancel(); _closeCts?.Dispose();
        var cancellation = _closeCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(200, cancellation.Token);
            if (!_disposed && !_hoverAnchor && !_hoverPopover && !_focusAnchor && !_focusPopover)
                _open = _dismissed = false;
        }
        catch (OperationCanceledException) { }
    }
    public void Dispose() { _disposed = true; _closeCts?.Cancel(); _closeCts?.Dispose(); }
}
