@page "/assets"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<PageTitle>Assets</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Assets</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Create</MudButton>
    </MudStack>
    <MudTextField T="string" @bind-Value="search" Label="Search assets" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
    @if (loadError is not null) { <MudAlert Severity="Severity.Error" role="alert">@loadError <MudButton OnClick="LoadAssets">Retry</MudButton></MudAlert> }
    <MudTable Items="FilteredAssets" Loading="loading" Hover="true" Dense="true" T="Asset" RowsPerPage="25" Class="compact-table" FixedHeader="true" FixedFooter="true" data-table-surface="pages-assets-assetlist-1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd><div class="workspace-actions">
                <WorkspaceAction OnClick="() => NavigateToDetail(context.Id)" Label="View" Icon="@Icons.Material.Outlined.Visibility" />
            </div></MudTd>
        </RowTemplate>

<PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
 <NoRecordsContent><MudText Class="pa-3">No matching records.</MudText></NoRecordsContent>
</MudTable>
</MudPaper>

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private List<Asset> assets = new();
    private string search = "";
    private bool loading;
    private string? loadError;
    private IEnumerable<Asset> FilteredAssets => assets.Where(asset => asset.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || asset.Type?.Contains(search, StringComparison.OrdinalIgnoreCase) == true).OrderBy(asset => asset.Name, StringComparer.OrdinalIgnoreCase).ThenBy(asset => asset.Id, StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        await LoadAssets();
    }

    private async Task LoadAssets()
    {
        loading = true; loadError = null;
        try { assets = await HelpdeskApi.GetFromJsonAsync<List<Asset>>("api/v1/assets") ?? new(); }
        catch (Exception failure) when (failure is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { loadError = "Assets could not be loaded. Retry when the service is available."; }
        finally { loading = false; }
    }

    private void NavigateToDetail(string id)
    {
        NavigationManager.NavigateTo($"/assets/{id}");
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateAssetDialog>("Create Asset", options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadAssets();
        }
    }
}
