<MudTooltip Text="@($"{TooltipText} {ExampleText}")">
    <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" aria-label="@($"Help for {Label}")" Class="change-field-help" />
</MudTooltip>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string TooltipText { get; set; } = string.Empty;
    [Parameter] public string? ExampleText { get; set; }
}
