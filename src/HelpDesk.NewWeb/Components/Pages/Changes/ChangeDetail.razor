@using Helpdesk.Shared.Services
@inject AuthenticationStateProvider AccessAuthenticationState
@page "/changes/{Id}"
@implements IDisposable
@attribute [Authorize(Roles = "Change.User,Change.Read,Change.Write,Change.Manager,HelpdeskAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Helpdesk.Shared.DTOs.Article
@using Helpdesk.Shared.DTOs.Category
@using Helpdesk.Shared.DTOs.Change
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.Enums
@using Helpdesk.Shared.Models
@using HelpDesk.NewWeb.Services
@using System.Diagnostics
@using System.Text.Json

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IErrorLoggingService ErrorLogger
@inject ILogger<ChangeDetail> Logger

<NavigationLock ConfirmExternalNavigation="@hasChanges" OnBeforeInternalNavigation="ConfirmNavigation" />

<PageTitle>Change: @(change?.Title ?? "...")</PageTitle>

<style>
    .change-template-locked {
        pointer-events: none;
        opacity: 0.82;
    }
</style>

<ErrorBoundary @ref="renderBoundary">
    <ChildContent>
        @if (loading)
        {
            <MudPaper Class="pa-4 d-flex justify-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </MudPaper>
        }
        else if (change == null)
        {
            <MudAlert Severity="Severity.Error">
                @(loadError ?? "Could not load the change. It may not exist or an error occurred.")
            </MudAlert>
        }
        else
        {
    <MudGrid Spacing="3" AlignItems="AlignItems.Stretch">
        <MudItem xs="12" md="9" Class="d-flex flex-column">
            <HelpDesk.NewWeb.Components.Shared.TicketHeader
                Title="@change.Title"
                Description="@change.Description"
                TrackingId="@change.TrackingId"
                Status="@change.State"
                StatusText="@GetLifecycleLabel(change.LifecycleState)"
                StatusColor="@GetLifecycleColor(change.LifecycleState)"
                Priority="@change.Priority"
                LastUpdated="@(change.UpdatedAt ?? change.CreatedAt)"
                CustomerName="@change.CustomerName"
                CustomerEmail="@change.CustomerEmail"
                CategoryIds="@selectedCategoryIds"
                AllCategories="@categories"
                CategoryRemoved="OnCategoryRemoved" ReadOnly="@(IsChangeLocked || isUpdating)">
                <SecondaryMetadataContent>
                    @if (change.ImplementationStartAt.HasValue)
                    {
                        <MudText Typo="Typo.caption">
                            Starts @change.ImplementationStartAt.Value.ToString("yyyy/MM/dd HH:mm")
                        </MudText>
                    }
                    @if (change.ImplementationEndAt.HasValue)
                    {
                        <MudText Typo="Typo.caption">
                            Ends @change.ImplementationEndAt.Value.ToString("yyyy/MM/dd HH:mm")
                        </MudText>
                    }
                </SecondaryMetadataContent>
            </HelpDesk.NewWeb.Components.Shared.TicketHeader>

            <TicketActivityTabs
                TicketId="@Id"
                TicketType="changes"
                OrganizationId="@change.OrganizationId"
                PublicMode="false" CanContribute="@CanContribute" CanManage="@CanManage"
                OnWorklogAdded="HandleWorklogAdded"
                MessagesTabText="Change Template"
                Class="flex-grow-1">
                <MessagesContent>
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Typo="Typo.h6">Change Enablement Template</MudText>
                            <MudChip T="string"
                                     Color="@(change.IsTemplateComplete ? Color.Success : Color.Warning)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @(change.IsTemplateComplete ? "Template Complete" : "Template Incomplete")
                            </MudChip>
                        </MudStack>

                        @if (IsChangeLocked)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Change details are read-only outside Draft. Move the change back to Draft to edit and resubmit approvals.
                            </MudAlert>
                        }
                        <div class="@(IsChangeLocked || isUpdating ? "change-template-locked" : null)">
                            <ChangeTemplateEditor ReadOnly="@(IsChangeLocked || isUpdating)" ChangeType="@(change.ChangeType ?? string.Empty)"
                                                  Model="@(change.ChangeTemplate ??= new ChangeTemplateDto())"
                                                  OnChanged="OnTemplateChanged"
                                                  ValidationErrors="@templateErrors" />
                        </div>
                    </MudStack>
                </MessagesContent>
            </TicketActivityTabs>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex flex-column">
            <TicketDetailsPanel>
                <ChildContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="12" xl="6">
                                <MudSelect T="ChangeLifecycleState" Value="@change.LifecycleState" ValueChanged="OnLifecycleStateChanged"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Label="Change Status"
                                           Variant="Variant.Outlined"
                                           Disabled="@(!CanManage || isUpdating)">
                                    @foreach (var state in Enum.GetValues<ChangeLifecycleState>().Where(state => state != ChangeLifecycleState.ApprovedForImplementation || accessProfile?.CanApproveChange(change.OrganizationId) == true || state == change.LifecycleState))
                                    {
                                        <MudSelectItem T="ChangeLifecycleState" Value="@state">@GetLifecycleLabel(state)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="12" xl="6">
                                <MudSelect T="TicketPriority" Value="@change.Priority" ValueChanged="OnPriorityChanged"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Label="Priority"
                                           Variant="Variant.Outlined"
                                           Disabled="@(isUpdating || IsChangeLocked)">
                                    @foreach (TicketPriority priority in Enum.GetValues(typeof(TicketPriority)))
                                    {
                                        <MudSelectItem T="TicketPriority" Value="@priority">@priority.ToString()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudSelect T="string"
                                           Label="Organization"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Value="@change.OrganizationId"
                                           ValueChanged="OnOrganizationChanged"
                                           Disabled="@(isUpdating || IsChangeLocked)">
                                    @foreach (var organization in organizations)
                                    {
                                        <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <AssigneeSelector Module="change" OrganizationId="@change.OrganizationId" TicketId="@change.Id"
                                                  Value="@change.ImplementorUserId" SelectedName="@change.ImplementorUserName" SelectedEmail="@change.ImplementorUserEmail"
                                                  Label="Implementor" AllowUnassigned="false" ReadOnly="IsChangeLocked" Busy="isUpdating"
                                                  SelectionChanged="OnImplementorChanged" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudSelect T="string" Label="Change Type" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Value="@change.ChangeType" ValueChanged="OnChangeTypeChanged" Disabled="@(isUpdating || IsChangeLocked)">
                                    <MudSelectItem T="string" Value="@StandardChangeType">Standard</MudSelectItem>
                                    <MudSelectItem T="string" Value="@NormalChangeType">Normal</MudSelectItem>
                                    <MudSelectItem T="string" Value="@EmergencyChangeType">Emergency</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudDatePicker Label="Implementation Start Date"
                                               Date="@implementationStartDate"
                                               DateChanged="OnImplementationStartDateChanged"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Disabled="@(isUpdating || IsChangeLocked)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTimePicker Label="Implementation Start Time"
                                               Time="@implementationStartTime"
                                               TimeChanged="OnImplementationStartTimeChanged"
                                               AmPm="false"
                                               Disabled="@(isUpdating || IsChangeLocked)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudDatePicker Label="Implementation End Date"
                                               Date="@implementationEndDate"
                                               DateChanged="OnImplementationEndDateChanged"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Disabled="@(isUpdating || IsChangeLocked)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTimePicker Label="Implementation End Time"
                                               Time="@implementationEndTime"
                                               TimeChanged="OnImplementationEndTimeChanged"
                                               AmPm="false"
                                               Disabled="@(isUpdating || IsChangeLocked)" />
                            </MudItem>
                            <MudItem xs="12">
                                <ServiceCategoryPicker RequestedType="TicketCategoryType.Change" OrganizationId="@change.OrganizationId" ScopeKey="@change.Id"
                                    SelectedCategoryIds="@selectedCategoryIds" SelectedCategoryIdsChanged="OnCategorySelectionChanged"
                                    ReadOnly="@(IsChangeLocked || isUpdating)" Dense="true" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12">
                                <p class="details-metadata">Created: @(change.CreatedAt.ToString("g"))</p>
                            </MudItem>
                            @if (change.Approvals.Count > 0)
                            {
                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">Approvals</MudText>
                                    <MudStack Spacing="1">
                                        @foreach (var approval in change.Approvals.OrderBy(x => x.ApproverName))
                                        {
                                            <MudPaper Outlined="true" Class="pa-2">
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2">@DisplayApprovalName(approval)</MudText>
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="@(approval.Status == ChangeApprovalStatus.Reviewed ? Color.Success : Color.Warning)"
                                                             Variant="Variant.Outlined">
                                                        @(approval.Status == ChangeApprovalStatus.Reviewed ? "Reviewed" : "Pending")
                                                    </MudChip>
                                                    @if (approval.ReviewedAtUtc.HasValue)
                                                    {
                                                        <MudText Typo="Typo.caption">
                                                            @approval.ReviewedAtUtc.Value.ToLocalTime().ToString("g")
                                                        </MudText>
                                                    }
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                </MudItem>
                            }
                            @if (change.Sla is not null)
                            {
                                <MudItem xs="12">
                                    <TicketSlaSummary Sla="@change.Sla" CanManage="@CanManage" Busy="@isUpdating"
                                                      OnPause="PauseSlaAsync" OnResume="ResumeSlaAsync" />
                                </MudItem>
                            }
                        </MudGrid>
                    </ChildContent>

                    <Actions>
                        <MudButton OnClick="RevertChanges"
                                   Disabled="!CanManage || !hasChanges || isUpdating">Revert</MudButton>
                        <MudButton OnClick="SaveChangesAsync"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="!CanManage || !hasChanges || isUpdating">
                            @if (isUpdating)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            }
                            Save Changes
                        </MudButton>
                    </Actions>
            <LifecycleActions>
@if (accessProfile?.CanApproveChange(change.OrganizationId) == true && change.LifecycleState == ChangeLifecycleState.PendingApproval)
                        {
                            var approvalLifetime = ticketLifetime;
                            <ChangeLifecycleStatePicker @key="approvalLifetime" ChangeId="@change.Id" LifecycleState="@change.LifecycleState"
                                                        CanApprove="@(!isUpdating && !hasChanges)" ChangeUpdated="@(updated => OnApprovalUpdated(updated, approvalLifetime))" />
                        }
                </LifecycleActions>
            </TicketDetailsPanel>
        </MudItem>
    </MudGrid>
        }
    </ChildContent>
    <ErrorContent Context="exception">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-2">
            Unable to render this change right now. The error has been logged; please refresh after the fix is deployed.
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if (hasChanges && await DialogService.ShowMessageBoxAsync("Unsaved changes", "Leave this ticket and discard unsaved changes?", yesText: "Discard changes", cancelText: "Keep editing") != true)
            context.PreventNavigation();
    }

    private CurrentUserAccessProfile? accessProfile;
    private bool CanManage => accessProfile?.CanManageChange(change?.OrganizationId) == true;
    private bool CanContribute => change is not null && accessProfile?.CanContributeChange(change.OrganizationId, change.CustomerId, change.CustomerEmail) == true;

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    [Parameter] public string Id { get; set; } = string.Empty;
    private const string StandardChangeType = "Standard";
    private const string NormalChangeType = "Normal";
    private const string EmergencyChangeType = "Emergency";

    private ChangeDto? change;
    private ChangeDto? originalChange;
    private ErrorBoundary? renderBoundary;
    private List<OrganizationDto> organizations = new();
    private List<TicketCategoryDto> categories = new();
    private HashSet<Guid> selectedCategoryIds = new();
    private bool loading = true;
    private string? loadedChangeId;
    private CancellationTokenSource loadCancellation = new();
    private long ticketLifetime, refreshVersion;
    private bool disposed;
    private bool IsCurrent(long lifetime) => !disposed && lifetime == ticketLifetime;
    private bool isUpdating;
    private bool hasChanges;
    private string? loadError;
    private List<string> templateErrors = new();
    private DateTime? implementationStartDate;
    private TimeSpan? implementationStartTime;
    private DateTime? implementationEndDate;
    private TimeSpan? implementationEndTime;
    private bool IsChangeLocked => !CanManage || (change is not null && change.LifecycleState != ChangeLifecycleState.Draft);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedChangeId == Id) return;
        loadedChangeId = Id;
        change = null; originalChange = null; selectedCategoryIds = new();
        ticketLifetime++;
        refreshVersion++;
        hasChanges = false;
        isUpdating = false;
        loading = true;
        renderBoundary?.Recover();
        await LoadChangeAsync();
    }

    public void Dispose() { disposed = true; ticketLifetime++; refreshVersion++; loadCancellation.Cancel(); loadCancellation.Dispose(); }

    private async Task LoadChangeAsync()
    {
        loadCancellation.Cancel(); loadCancellation.Dispose(); loadCancellation = new();
        var token = loadCancellation.Token;
        var lifetime = ticketLifetime;
        Logger.LogInformation(
            "Loading change detail. ChangeId={ChangeId} Route={Route} TraceId={TraceId}",
            Id,
            NavigationManager.Uri,
            Activity.Current?.TraceId.ToString());

        try
        {
            var changeTask = HelpdeskApi.GetFromJsonAsync<ChangeDto>($"api/v1/changes/{Id}", token);
            var categoriesTask = HelpdeskApi.GetFromJsonAsync<List<TicketCategoryDto>>($"api/v1/categories?type={(int)TicketCategoryType.Change}", token);
            accessProfile = CurrentUserAccessProfile.FromClaims((await AccessAuthenticationState.GetAuthenticationStateAsync()).User);
            await Task.WhenAll(changeTask, categoriesTask);
            token.ThrowIfCancellationRequested();

            originalChange = await changeTask;
            categories = await categoriesTask ?? new();

            categories = categories
                .GroupBy(x => x.Id)
                .Select(x => x.First())
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.Name)
                .ToList();

            if (originalChange != null)
            {
                change = CloneChange(originalChange);
                organizations = CanManage
                    ? await HelpdeskApi.GetFromJsonAsync<List<OrganizationDto>>("api/v1/ticketing/organizations?module=change", token) ?? new()
                    : new();
                token.ThrowIfCancellationRequested();
                change.ChangeTemplate ??= new ChangeTemplateDto();
                SyncImplementationWindowEditors(change);
                selectedCategoryIds = change.CategoryIds.ToHashSet();
                templateErrors = change.TemplateValidationErrors.ToList();
            }

            loadError = originalChange is null
                ? "Could not load the change. It may not exist or you may not have access."
                : null;
            Logger.LogInformation(
                "Loaded change detail. ChangeId={ChangeId} TrackingId={TrackingId} Route={Route} TraceId={TraceId}",
                Id,
                change?.TrackingId,
                NavigationManager.Uri,
                Activity.Current?.TraceId.ToString());
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (!IsCurrent(lifetime) || token.IsCancellationRequested) return;
            Logger.LogError(
                ex,
                "Failed to load change detail. ChangeId={ChangeId} Route={Route} TraceId={TraceId}",
                Id,
                NavigationManager.Uri,
                Activity.Current?.TraceId.ToString());
            await SafeLogWebErrorAsync(
                ex,
                $"{nameof(ChangeDetail)}:{Id}:{NavigationManager.ToBaseRelativePath(NavigationManager.Uri)}");
            if (!IsCurrent(lifetime) || token.IsCancellationRequested) return;
            loadError = "Unable to load this change right now. The error has been logged.";
            TryShowSnackbar($"Error loading data: {ex.Message}", Severity.Error);
            change = null;
        }
        finally
        {
            if (IsCurrent(lifetime) && !token.IsCancellationRequested) loading = false;
        }
    }

    private async Task HandleRenderError(Exception ex)
    {
        Logger.LogError(
            ex,
            "Failed to render change detail. ChangeId={ChangeId} Route={Route} TraceId={TraceId}",
            Id,
            NavigationManager.Uri,
            Activity.Current?.TraceId.ToString());
        await SafeLogWebErrorAsync(
            ex,
            $"{nameof(ChangeDetail)}:render:{Id}:{NavigationManager.ToBaseRelativePath(NavigationManager.Uri)}");
    }

    private async Task SafeLogWebErrorAsync(Exception ex, string page)
    {
        try
        {
            await ErrorLogger.LogAsync(ex, page);
        }
        catch (Exception logException)
        {
            Logger.LogWarning(
                logException,
                "Failed to send web error log. OriginalPage={OriginalPage} OriginalMessage={OriginalMessage}",
                page,
                ex.Message);
        }
    }

    private void TryShowSnackbar(string message, Severity severity)
    {
        try
        {
            Snackbar.Add(message, severity);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to show snackbar on change detail.");
        }
    }

    private static ChangeDto CloneChange(ChangeDto source)
    {
        return new ChangeDto
        {
            Id = source.Id,
            OrganizationId = source.OrganizationId,
            Title = source.Title,
            Description = source.Description,
            State = source.State,
            LifecycleState = source.LifecycleState,
            Priority = source.Priority,
            CreatedAt = source.CreatedAt,
            UpdatedAt = source.UpdatedAt,
            TrackingId = source.TrackingId,
            OrganizationName = source.OrganizationName,
            CustomerId = source.CustomerId,
            CustomerName = source.CustomerName,
            CustomerEmail = source.CustomerEmail,
            ChangeType = source.ChangeType,
            RequestedForUserId = source.RequestedForUserId,
            RequestedForUserName = source.RequestedForUserName,
            RequestedForUserEmail = source.RequestedForUserEmail,
            AssignedToId = source.AssignedToId,
            ImplementorUserId = source.ImplementorUserId,
            ImplementorUserName = source.ImplementorUserName,
            ImplementorUserEmail = source.ImplementorUserEmail,
            ApproverUserIds = (source.ApproverUserIds ?? new()).ToList(),
            Approvers = (source.Approvers ?? new()).ToList(),
            Approvals = (source.Approvals ?? new()).Select(x => new ChangeApprovalDto
            {
                Id = x.Id,
                ChangeId = x.ChangeId,
                ApproverId = x.ApproverId,
                ApproverName = x.ApproverName,
                ApproverEmail = x.ApproverEmail,
                Status = x.Status,
                CreatedAtUtc = x.CreatedAtUtc,
                ReviewedAtUtc = x.ReviewedAtUtc,
                ViewedAtUtc = x.ViewedAtUtc,
                TokenSentAtUtc = x.TokenSentAtUtc
            }).ToList(),
            CcRecipients = (source.CcRecipients ?? new()).ToList(),
            ImplementationStartAt = source.ImplementationStartAt,
            ImplementationEndAt = source.ImplementationEndAt,
            ChangeTemplate = source.ChangeTemplate is null
                ? new ChangeTemplateDto()
                : JsonSerializer.Deserialize<ChangeTemplateDto>(JsonSerializer.Serialize(source.ChangeTemplate)) ?? new ChangeTemplateDto(),
            IsTemplateComplete = source.IsTemplateComplete,
            TemplateValidationErrors = (source.TemplateValidationErrors ?? new()).ToList(),
            CategoryIds = (source.CategoryIds ?? new()).ToList(),
            Sla = source.Sla is null ? null : new TicketSlaDto
            {
                StartedAt = source.Sla.StartedAt,
                ResponseDueAt = source.Sla.ResponseDueAt,
                ResolutionDueAt = source.Sla.ResolutionDueAt,
                Status = source.Sla.Status,
                PausedAt = source.Sla.PausedAt,
                ResumeAt = source.Sla.ResumeAt,
                PauseReason = source.Sla.PauseReason,
                ResponseBreached = source.Sla.ResponseBreached,
                ResolutionBreached = source.Sla.ResolutionBreached,
                ResponseRemainingSeconds = source.Sla.ResponseRemainingSeconds,
                ResolutionRemainingSeconds = source.Sla.ResolutionRemainingSeconds,
                ResponsePercentUsed = source.Sla.ResponsePercentUsed,
                ResolutionPercentUsed = source.Sla.ResolutionPercentUsed
            }
        };
    }

    private void OnStateChanged(TicketState newState)
    {
        if (change is null) return;
        change.State = newState;
        hasChanges = true;
    }

    private void OnLifecycleStateChanged(ChangeLifecycleState newState)
    {
        if (change is null) return;
        change.LifecycleState = newState;
        hasChanges = true;
    }

    private void OnPriorityChanged(TicketPriority newPriority)
    {
        if (IsChangeLocked) return;
        if (change is null) return;
        change.Priority = newPriority;
        hasChanges = true;
    }

    private void OnImplementorChanged(UserDto? user)
    {
        if (IsChangeLocked || change is null || user is null) return;
        change.ImplementorUserId = change.AssignedToId = user.Id;
        change.ImplementorUserName = user.Name;
        change.ImplementorUserEmail = user.Email;
        hasChanges = true;
    }

    private void OnChangeTypeChanged(string? newType)
    {
        if (IsChangeLocked) return;
        if (change is null) return;
        change.ChangeType = string.IsNullOrWhiteSpace(newType) ? null : newType;
        change.ChangeTemplate ??= new ChangeTemplateDto();
        hasChanges = true;
    }

    private void OnOrganizationChanged(string? organizationId)
    {
        if (IsChangeLocked) return;
        if (change is null)
        {
            return;
        }

        var selectedOrganization = organizations.FirstOrDefault(x => x.Id == organizationId);
        change.OrganizationId = string.IsNullOrWhiteSpace(organizationId) ? null : organizationId;
        change.OrganizationName = selectedOrganization?.Name;
        change.CustomerOrgName = selectedOrganization?.Name;
        hasChanges = true;
    }

    private void OnImplementationStartDateChanged(DateTime? value)
    {
        if (IsChangeLocked) return;
        implementationStartDate = value;
        SyncImplementationStart();
    }

    private void OnImplementationStartTimeChanged(TimeSpan? value)
    {
        if (IsChangeLocked) return;
        implementationStartTime = value;
        SyncImplementationStart();
    }

    private void OnImplementationEndDateChanged(DateTime? value)
    {
        if (IsChangeLocked) return;
        implementationEndDate = value;
        SyncImplementationEnd();
    }

    private void OnImplementationEndTimeChanged(TimeSpan? value)
    {
        if (IsChangeLocked) return;
        implementationEndTime = value;
        SyncImplementationEnd();
    }

    private Task OnTemplateChanged()
    {
        if (IsChangeLocked) return Task.CompletedTask;
        if (change is null) return Task.CompletedTask;
        change.IsTemplateComplete = false;
        change.TemplateValidationErrors = new List<string>();
        templateErrors = new List<string>();
        hasChanges = true;
        return Task.CompletedTask;
    }

    private void OnCategorySelectionChanged(HashSet<Guid> categoryIds)
    {
        if (IsChangeLocked) return;
        if (change is null) return;
        selectedCategoryIds = categoryIds;
        change.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = true;
    }

    private void OnCategoryRemoved(Guid id)
    {
        if (IsChangeLocked) return;
        if (change is null) return;

        selectedCategoryIds.Remove(id);
        change.CategoryIds = selectedCategoryIds.ToList();
        hasChanges = true;

    }

    private void RevertChanges()
    {
        if (originalChange is null || change is null) return;

        change.State = originalChange.State;
        change.LifecycleState = originalChange.LifecycleState;
        change.Priority = originalChange.Priority;
        change.ImplementorUserId = originalChange.ImplementorUserId;
        change.AssignedToId = originalChange.AssignedToId;
        change.ImplementorUserName = originalChange.ImplementorUserName;
        change.ImplementorUserEmail = originalChange.ImplementorUserEmail;
        change.OrganizationId = originalChange.OrganizationId;
        change.OrganizationName = originalChange.OrganizationName;
        change.CustomerOrgName = originalChange.CustomerOrgName;
        change.CustomerId = originalChange.CustomerId;
        change.CustomerName = originalChange.CustomerName;
        change.CustomerEmail = originalChange.CustomerEmail;
        change.ChangeType = originalChange.ChangeType;
        change.ImplementationStartAt = originalChange.ImplementationStartAt;
        change.ImplementationEndAt = originalChange.ImplementationEndAt;
        change.ChangeTemplate = originalChange.ChangeTemplate is null
            ? new ChangeTemplateDto()
            : JsonSerializer.Deserialize<ChangeTemplateDto>(JsonSerializer.Serialize(originalChange.ChangeTemplate)) ?? new ChangeTemplateDto();
        change.IsTemplateComplete = originalChange.IsTemplateComplete;
        change.TemplateValidationErrors = originalChange.TemplateValidationErrors.ToList();
        selectedCategoryIds = originalChange.CategoryIds.ToHashSet();
        change.CategoryIds = selectedCategoryIds.ToList();
        templateErrors = change.TemplateValidationErrors.ToList();
        SyncImplementationWindowEditors(change);
        hasChanges = false;
    }

    private async Task SaveChangesAsync()
    {
        if (!CanManage || isUpdating || change is null || !hasChanges) return;

        var savingTicketId = Id;
        var lifetime = ticketLifetime;
        refreshVersion++;
        isUpdating = true;

        try
        {
            var updateDto = BuildUpdateDto();

            var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/changes/{savingTicketId}", updateDto);

            if (!IsCurrent(lifetime)) return;
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<ChangeDto>();
                if (!IsCurrent(lifetime)) return;
                if (updated is not null)
                {
                    originalChange = CloneChange(updated);
                    change = CloneChange(updated);
                    change.ChangeTemplate ??= new ChangeTemplateDto();
                    SyncImplementationWindowEditors(change);
                    selectedCategoryIds = updated.CategoryIds.ToHashSet();
                    templateErrors = updated.TemplateValidationErrors.ToList();
                    hasChanges = false;
                }
                Snackbar.Add("Change saved successfully!", Severity.Success);
            }
            else
            {
                var errors = await ReadErrorsAsync(response);
                var error = await response.Content.ReadAsStringAsync();
                if (!IsCurrent(lifetime)) return;
                templateErrors = errors;
                Snackbar.Add(
                    templateErrors.Count > 0 ? "Complete the required template fields or AI-review requirements before saving." : $"Error saving change: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            if (IsCurrent(lifetime)) Snackbar.Add($"A client-side error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (IsCurrent(lifetime)) { isUpdating = false; refreshVersion++; }
        }
    }

    private Task OnApprovalUpdated(ChangeDto updated, long lifetime) =>
        IsCurrent(lifetime) && updated.Id == Id ? HandleWorklogAdded() : Task.CompletedTask;

    private async Task HandleWorklogAdded()
    {
        var lifetime = ticketLifetime;
        var version = ++refreshVersion;
        var ticketId = Id;
        try
        {
            var updated = await HelpdeskApi.GetFromJsonAsync<ChangeDto>($"api/v1/changes/{ticketId}");
            if (!IsCurrent(lifetime) || version != refreshVersion || updated is null) return;
            if (hasChanges || isUpdating)
            {
                // Preserve the template, assignment and category draft while refreshing metadata.
                if (change is not null) { change.Sla = CloneChange(updated).Sla; change.UpdatedAt = updated.UpdatedAt; change.Approvals = updated.Approvals; }
                if (originalChange is not null) { originalChange.Sla = CloneChange(updated).Sla; originalChange.UpdatedAt = updated.UpdatedAt; originalChange.Approvals = updated.Approvals; }
                return;
            }
            originalChange = CloneChange(updated);
            change = CloneChange(updated);
            change.ChangeTemplate ??= new ChangeTemplateDto();
            SyncImplementationWindowEditors(change);
            selectedCategoryIds = updated.CategoryIds.ToHashSet();
            templateErrors = updated.TemplateValidationErrors.ToList();
        }
        catch (Exception ex)
        {
            if (IsCurrent(lifetime) && version == refreshVersion) Snackbar.Add($"Error refreshing change: {ex.Message}", Severity.Error);
        }
    }

    private UpdateChangeDto BuildUpdateDto()
    {
        if (change is null)
        {
            return new UpdateChangeDto();
        }

        if (originalChange is not null &&
            IsChangeLocked &&
            change.LifecycleState != originalChange.LifecycleState &&
            change.State == originalChange.State &&
            change.Priority == originalChange.Priority &&
            string.Equals(change.OrganizationId, originalChange.OrganizationId, StringComparison.Ordinal) &&
            string.Equals(change.ImplementorUserId, originalChange.ImplementorUserId, StringComparison.Ordinal) &&
            Nullable.Compare(change.ImplementationStartAt, originalChange.ImplementationStartAt) == 0 &&
            Nullable.Compare(change.ImplementationEndAt, originalChange.ImplementationEndAt) == 0 &&
            string.Equals(change.ChangeType, originalChange.ChangeType, StringComparison.Ordinal) &&
            selectedCategoryIds.SetEquals(originalChange.CategoryIds))
        {
            return new UpdateChangeDto
            {
                State = originalChange.State,
                Priority = originalChange.Priority,
                LifecycleState = change.LifecycleState
            };
        }

        return new UpdateChangeDto
        {
            State = change.State,
            LifecycleState = change.LifecycleState,
            Priority = change.Priority,
            OrganizationId = change.OrganizationId,
            ImplementorUserId = change.ImplementorUserId,
            ImplementationStartAt = change.ImplementationStartAt,
            ImplementationEndAt = change.ImplementationEndAt,
            ChangeType = change.ChangeType,
            ChangeTemplate = change.ChangeTemplate,
            CategoryIds = selectedCategoryIds.ToList()
        };
    }

    private async Task PauseSlaAsync()
    {
        if (!CanManage || isUpdating || change is null) return;
        var lifetime = ticketLifetime;
        var ticketId = change.Id;
        var dialog = await DialogService.ShowAsync<HelpDesk.NewWeb.Components.Shared.SlaPauseDialog>(
            "Pause SLA", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (!IsCurrent(lifetime) || !CanManage || isUpdating || result.Canceled || result.Data is not PauseSlaRequest requestBody) return;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{ticketId}/sla/pause", requestBody);
            if (!IsCurrent(lifetime)) return;
            if (!response.IsSuccessStatusCode) { Snackbar.Add("Failed to pause SLA.", Severity.Error); return; }
            await HandleWorklogAdded();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            if (IsCurrent(lifetime)) Snackbar.Add("Failed to pause SLA.", Severity.Error);
        }
    }

    private async Task ResumeSlaAsync()
    {
        if (!CanManage || isUpdating || change is null) return;
        var lifetime = ticketLifetime;
        var ticketId = change.Id;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/tickets/{ticketId}/sla/resume", new ResumeSlaRequest());
            if (!IsCurrent(lifetime)) return;
            if (!response.IsSuccessStatusCode) { Snackbar.Add("Failed to resume SLA.", Severity.Error); return; }
            await HandleWorklogAdded();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            if (IsCurrent(lifetime)) Snackbar.Add("Failed to resume SLA.", Severity.Error);
        }
    }

    private static string FormatRemaining(long totalSeconds)
    {
        if (totalSeconds <= 0) return "0m";
        var span = TimeSpan.FromSeconds(totalSeconds);
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{Math.Max(1, span.Minutes)}m";
    }

    private static async Task<List<string>> ReadErrorsAsync(HttpResponseMessage response)
    {
        try
        {
            var payload = await response.Content.ReadFromJsonAsync<TemplateErrorResponseDto>();
            return payload?.Errors ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private static Color GetSlaStatusColor(SlaStatus status) => status switch
    {
        SlaStatus.InProgress => Color.Info,
        SlaStatus.Paused => Color.Warning,
        SlaStatus.Breached => Color.Error,
        SlaStatus.Completed => Color.Success,
        _ => Color.Default
    };

    private static string GetLifecycleLabel(ChangeLifecycleState state) => state switch
    {
        ChangeLifecycleState.Draft => "Draft",
        ChangeLifecycleState.Submitted => "Submitted",
        ChangeLifecycleState.PendingApproval => "Pending Approval",
        ChangeLifecycleState.ApprovedForImplementation => "Approved For Implementation",
        ChangeLifecycleState.ImplementationInProgress => "Implementation In Progress",
        ChangeLifecycleState.ImplementedSuccess => "Implemented - Success",
        ChangeLifecycleState.ImplementedBackedOut => "Implemented - Backed Out",
        _ => state.ToString()
    };

    private static Color GetLifecycleColor(ChangeLifecycleState state) => state switch
    {
        ChangeLifecycleState.Submitted => Color.Info,
        ChangeLifecycleState.PendingApproval => Color.Warning,
        ChangeLifecycleState.ApprovedForImplementation => Color.Primary,
        ChangeLifecycleState.ImplementationInProgress => Color.Secondary,
        ChangeLifecycleState.ImplementedSuccess => Color.Success,
        ChangeLifecycleState.ImplementedBackedOut => Color.Warning,
        _ => Color.Default
    };

    private static string DisplayApprovalName(ChangeApprovalDto approval)
    {
        if (string.IsNullOrWhiteSpace(approval.ApproverEmail))
        {
            return approval.ApproverName;
        }

        return string.IsNullOrWhiteSpace(approval.ApproverName)
            ? approval.ApproverEmail
            : $"{approval.ApproverName} ({approval.ApproverEmail})";
    }

    private sealed class TemplateErrorResponseDto
    {
        public string? Message { get; set; }
        public List<string> Errors { get; set; } = new();
    }

    private void SyncImplementationStart()
    {
        if (change is null)
        {
            return;
        }

        change.ImplementationStartAt = CombineDateTime(implementationStartDate, implementationStartTime);
        hasChanges = true;
    }

    private void SyncImplementationEnd()
    {
        if (change is null)
        {
            return;
        }

        change.ImplementationEndAt = CombineDateTime(implementationEndDate, implementationEndTime);
        hasChanges = true;
    }

    private void SyncImplementationWindowEditors(ChangeDto source)
    {
        implementationStartDate = source.ImplementationStartAt?.Date;
        implementationStartTime = source.ImplementationStartAt?.TimeOfDay;
        implementationEndDate = source.ImplementationEndAt?.Date;
        implementationEndTime = source.ImplementationEndAt?.TimeOfDay;
    }

    private static DateTime? CombineDateTime(DateTime? date, TimeSpan? time)
    {
        if (!date.HasValue || !time.HasValue)
        {
            return null;
        }

        return date.Value.Date.Add(time.Value);
    }

}
