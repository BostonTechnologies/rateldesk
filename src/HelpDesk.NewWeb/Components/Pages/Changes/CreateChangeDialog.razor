@using Helpdesk.Shared.DTOs.Change
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.Models
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@inject IJSRuntime JS
@inject IDialogService Dialogs
@attribute [Authorize(Roles = "Change.User,Change.Read,Change.Write,Change.Manager,HelpdeskAdmin")]

@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@inject IErrorLoggingService ErrorLogger
@inject ILogger<CreateChangeDialog> Logger
@using HelpDesk.NewWeb.Services

<MudDialog Class="change-create-dialog premium-workspace">
    <TitleContent><MudText Typo="Typo.h6">Create change draft</MudText></TitleContent>
    <DialogContent>
        <NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="ConfirmNavigation" />
        <nav class="change-step-nav" aria-label="Change creation steps">
            @for (var i = 0; i < Steps.Length; i++)
            {
                var index = i;
                <MudButton Size="Size.Small" Variant="@(step == index ? Variant.Outlined : Variant.Text)" aria-current="@(step == index ? "step" : null)"
                           OnClick="() => GoToStepAsync(index)" Disabled="isSubmitting">@(index + 1). @Steps[index]</MudButton>
            }
        </nav>
        <div class="change-create-dialog-content">
            @if (draftErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">
                    <MudText Typo="Typo.subtitle2">Review the draft</MudText>
                    @foreach (var error in draftErrors) { <MudButton Class="change-error-link" OnClick="() => FocusErrorAsync(error)">@error.Message</MudButton> }
                </MudAlert>
            }
            <MudForm Model="model" @ref="form">
                <section class="change-step" hidden="@(step != 0)" aria-label="Overview">
                    <MudGrid Spacing="2">
                        <MudItem xs="12"><div id="change-title"><MudTextField T="string" @bind-Value="model.Title" Label="Title" Required="true" For="@(() => model.Title)" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></div></MudItem>
                        <MudItem xs="12" sm="6"><div id="change-organization"><OrganizationSearchPicker Module="change" Value="@model.OrganizationId" SelectionChanged="OnOrganizationSelected" Disabled="isSubmitting" /></div></MudItem>
                        <MudItem xs="12" sm="6"><MudSelect T="string" Label="Change type" Value="@model.ChangeType" ValueChanged="OnChangeTypeChanged" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value='@("Standard")'>Standard</MudSelectItem><MudSelectItem Value='@("Normal")'>Normal</MudSelectItem><MudSelectItem Value='@("Emergency")'>Emergency</MudSelectItem></MudSelect></MudItem>
                        <MudItem xs="12" sm="6"><MudSelect T="TicketPriority" Label="Priority" @bind-Value="model.Priority" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach (var priority in Enum.GetValues<TicketPriority>()) { <MudSelectItem Value="priority">@priority</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12" sm="6"><div id="change-requested-for"><ChangeParticipantSearchPicker OrganizationId="@model.OrganizationId" Label="Requested for" @bind-Value="model.RequestedForUserId" Disabled="isSubmitting" /></div></MudItem>
                        <MudItem xs="12"><div id="change-description"><MudTextField T="string" @bind-Value="model.Description" Label="Description" Required="true" For="@(() => model.Description)" Lines="3" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></div></MudItem>
                    </MudGrid>
                </section>
                <section class="change-step" hidden="@(step != 1)" aria-label="Plan">
                    <ChangeTemplateEditor ChangeType="@model.ChangeType" Model="model.ChangeTemplate" OnChanged="HandleTemplateChanged" ValidationErrors="templateErrors" />
                </section>
                <section class="change-step" hidden="@(step != 2)" aria-label="Schedule and people">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Implementation window · UTC</MudText>
                    <MudText Typo="Typo.caption">Enter all dates and times in UTC. Start and end are required to create the draft.</MudText>
                    <div id="change-window"><MudGrid Spacing="2">
                        <MudItem xs="12" sm="6"><MudDatePicker Editable="true" DateFormat="yyyy-MM-dd" Label="Start date (UTC)" Date="implementationStartDate" DateChanged="OnImplementationStartDateChanged" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudTimePicker Editable="true" Label="Start time (UTC)" Time="implementationStartTime" TimeChanged="OnImplementationStartTimeChanged" AmPm="false" /></MudItem>
                        <MudItem xs="12" sm="6"><MudDatePicker Editable="true" DateFormat="yyyy-MM-dd" Label="End date (UTC)" Date="implementationEndDate" DateChanged="OnImplementationEndDateChanged" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudTimePicker Editable="true" Label="End time (UTC)" Time="implementationEndTime" TimeChanged="OnImplementationEndTimeChanged" AmPm="false" /></MudItem>
                        <MudItem xs="12" sm="6"><div id="change-implementor"><AssigneeSelector Module="change" OrganizationId="@model.OrganizationId" Value="@model.ImplementorUserId" Label="Implementor" AllowUnassigned="false" Busy="isSubmitting" SelectionChanged="user => model.ImplementorUserId = user?.Id" /></div></MudItem>
                        <MudItem xs="12" sm="6"><ChangeParticipantSearchPicker OrganizationId="@model.OrganizationId" Label="Approvers" Multiple="true" Required="false" SelectedIds="selectedApproverIds" SelectedIdsChanged="OnApproversChanged" Disabled="isSubmitting" /></MudItem>
                        <MudItem xs="12"><ServiceCategoryPicker RequestedType="TicketCategoryType.Change" OrganizationId="@model.OrganizationId" SelectedCategoryIds="@((model.CategoryIds ?? new()).ToHashSet())" SelectedCategoryIdsChanged="ids => model.CategoryIds = ids.ToList()" /></MudItem>
                    </MudGrid></div>
                </section>
                <section class="change-step" hidden="@(step != 3)" aria-label="Review">
                    <MudText Typo="Typo.h6">@model.Title</MudText>
                    <MudText Typo="Typo.body2">@model.ChangeType · @model.Priority · @model.Description</MudText>
                    <MudText Typo="Typo.body2">Implementation (UTC): @CombineDateTime(implementationStartDate, implementationStartTime) → @CombineDateTime(implementationEndDate, implementationEndTime)</MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">Create draft saves this record in Draft. Approval and lifecycle changes remain separate actions.</MudAlert>
                    @if (completenessError is not null) { <MudAlert Severity="Severity.Warning">@completenessError</MudAlert> }
                    @if (templateErrors.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2">Incomplete plan · optional for saving this draft</MudText>
                        @foreach (var missing in templateErrors) { <MudButton Class="change-error-link" OnClick="() => GoToPlanErrorAsync(missing)">@missing</MudButton> }
                    }
                    <ChangePlanSummary Model="model.ChangeTemplate" ChangeType="@model.ChangeType" />
                </section>
            </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="isSubmitting">Cancel</MudButton>
        <MudText Typo="Typo.caption">@(step + 1) / 4</MudText>
        <MudSpacer />
        <MudButton OnClick="() => GoToStepAsync(step - 1)" Disabled="@(isSubmitting || step == 0)">Back</MudButton>
        @if (step < 3) { <MudButton OnClick="() => GoToStepAsync(step + 1)" Variant="Variant.Filled" Color="Color.Primary" Disabled="isSubmitting">Next</MudButton> }
        else { <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="isSubmitting">Create draft</MudButton> }
    </DialogActions>
</MudDialog>

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm form = default!;
    private CreateChangeDto model = new()
    {
        ChangeType = "Standard", SaveAsDraft = true
    };
    private HashSet<string> selectedApproverIds = new(StringComparer.OrdinalIgnoreCase);
    private List<string> templateErrors = new();
    private DateTime? implementationStartDate;
    private TimeSpan? implementationStartTime;
    private DateTime? implementationEndDate;
    private TimeSpan? implementationEndTime;
    private bool isSubmitting;

    private Task OnChangeTypeChanged(string value)
    {
        reviewGeneration++;
        model.ChangeType = value;
        templateErrors.Clear();
        return Task.CompletedTask;
    }

    private Task OnOrganizationSelected(OrganizationDto? organization)
    {
        if (model.OrganizationId == organization?.Id) return Task.CompletedTask;
        model.OrganizationId = organization?.Id;
        model.RequestedForUserId = null;
        model.CategoryIds = new();
        model.ImplementorUserId = null;
        model.ApproverUserIds = new();
        selectedApproverIds = new(StringComparer.OrdinalIgnoreCase);
        return Task.CompletedTask;
    }

    private Task OnApproversChanged(HashSet<string>? values)
    {
        selectedApproverIds = values?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new(StringComparer.OrdinalIgnoreCase);
        model.ApproverUserIds = selectedApproverIds.ToList();
        return Task.CompletedTask;
    }

    private Task OnImplementationStartDateChanged(DateTime? value)
    {
        implementationStartDate = value;
        return Task.CompletedTask;
    }

    private Task OnImplementationStartTimeChanged(TimeSpan? value)
    {
        implementationStartTime = value;
        return Task.CompletedTask;
    }

    private Task OnImplementationEndDateChanged(DateTime? value)
    {
        implementationEndDate = value;
        return Task.CompletedTask;
    }

    private Task OnImplementationEndTimeChanged(TimeSpan? value)
    {
        implementationEndTime = value;
        return Task.CompletedTask;
    }

    private Task HandleTemplateChanged()
    {
        reviewGeneration++;
        templateErrors.Clear();
        return Task.CompletedTask;
    }

    private async Task Submit()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        try
        {
            draftErrors = ValidateDraft();
            await form.ValidateAsync();
            if (draftErrors.Count > 0) { await FocusErrorAsync(draftErrors[0]); return; }
            model.ApproverUserIds = selectedApproverIds.ToList();
            model.ImplementationStartAt = CombineDateTime(implementationStartDate, implementationStartTime);
            model.ImplementationEndAt = CombineDateTime(implementationEndDate, implementationEndTime);
            using var response = await HelpdeskApi.PostAsJsonAsync("api/v1/changes", model);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<ChangeDto>();
                Logger.LogInformation(
                    "Change create dialog received successful create response. ChangeId={ChangeId} TrackingId={TrackingId} OrganizationId={OrganizationId} RequestedForUserId={RequestedForUserId} ImplementorUserId={ImplementorUserId}",
                    created?.Id,
                    created?.TrackingId,
                    created?.OrganizationId,
                    created?.RequestedForUserId,
                    created?.ImplementorUserId);
                if (created is not null && !created.IsTemplateComplete)
                {
                    Snackbar.Add("Change logged. Finish the missing template fields on the change detail page before review or resolution.", Severity.Warning);
                }

                allowClose = true;
                Dialog.Close(DialogResult.Ok<object?>(created is not null ? created : true));
                return;
            }

            templateErrors = await ReadErrorsAsync(response);
            var error = await response.Content.ReadAsStringAsync();
            step = templateErrors.Count > 0 ? 1 : 3;
            Snackbar.Add(
                templateErrors.Count > 0 ? "The draft could not be saved. Review the returned errors; entered values are retained." : $"Error creating change: {error}",
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Unexpected error", Severity.Error);
            await ErrorLogger.LogAsync(ex, nameof(CreateChangeDialog));
        }
        finally { isSubmitting = false; }
    }

    private static async Task<List<string>> ReadErrorsAsync(HttpResponseMessage response)
    {
        try
        {
            var payload = await response.Content.ReadFromJsonAsync<TemplateErrorResponseDto>();
            return payload?.Errors ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private static readonly string[] Steps = ["Overview", "Plan", "Schedule & people", "Review"];
    private int step, reviewGeneration;
    private string? pendingFocus, completenessError;
    private bool allowClose;
    private List<DraftError> draftErrors = [];
    private static readonly string EmptyDraft = JsonSerializer.Serialize(new CreateChangeDto { ChangeType = "Standard", SaveAsDraft = true });
    private bool IsDirty => !allowClose && (JsonSerializer.Serialize(model) != EmptyDraft ||
        implementationStartDate.HasValue || implementationStartTime.HasValue || implementationEndDate.HasValue || implementationEndTime.HasValue);

    protected override async Task OnInitializedAsync() => await Dialog.SetOptionsAsync(Dialog.Options with
        { BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocus is not { } target) return;
        pendingFocus = null;
        await JS.InvokeVoidAsync("scrollToChangeTemplateField", target);
    }

    private List<DraftError> ValidateDraft()
    {
        var errors = new List<DraftError>();
        if (string.IsNullOrWhiteSpace(model.Title)) errors.Add(new(0, "change-title", "Title is required."));
        if (string.IsNullOrWhiteSpace(model.Description)) errors.Add(new(0, "change-description", "Description is required."));
        if (string.IsNullOrWhiteSpace(model.OrganizationId)) errors.Add(new(0, "change-organization", "Organization is required."));
        if (string.IsNullOrWhiteSpace(model.RequestedForUserId)) errors.Add(new(0, "change-requested-for", "Requested for is required."));
        if (string.IsNullOrWhiteSpace(model.ImplementorUserId)) errors.Add(new(2, "change-implementor", "Implementor is required."));
        var start = CombineDateTime(implementationStartDate, implementationStartTime);
        var end = CombineDateTime(implementationEndDate, implementationEndTime);
        if (start is null || end is null) errors.Add(new(2, "change-window", "Implementation start and end date/time are required."));
        else if (end <= start) errors.Add(new(2, "change-window", "Implementation end must be later than start."));
        return errors;
    }

    private Task FocusErrorAsync(DraftError error)
    {
        step = error.Step; pendingFocus = error.Target;
        return InvokeAsync(StateHasChanged);
    }

    private async Task GoToStepAsync(int next)
    {
        var revision = ++reviewGeneration;
        step = Math.Clamp(next, 0, 3);
        if (step != 3) return;
        draftErrors = ValidateDraft();
        completenessError = null;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync("api/v1/changes/template-validation",
                new ChangeTemplateValidationRequest(model.ChangeType, model.ChangeTemplate));
            response.EnsureSuccessStatusCode();
            var validation = await response.Content.ReadFromJsonAsync<ChangeTemplateValidationDto>();
            if (revision == reviewGeneration) templateErrors = validation?.Errors ?? [];
        }
        catch (HttpRequestException) { if (revision == reviewGeneration) completenessError = "Plan completeness is unavailable. Your draft is retained and can still be saved."; }
    }

    private Task GoToPlanErrorAsync(string error)
    {
        step = 1; pendingFocus = ChangeTemplateEditor.TargetForError(error);
        return InvokeAsync(StateHasChanged);
    }

    private async Task Cancel()
    {
        if (isSubmitting) return;
        if (IsDirty && await Dialogs.ShowMessageBoxAsync("Discard change draft?", "Unsaved values will be discarded.", yesText: "Discard draft", cancelText: "Keep editing") != true) return;
        allowClose = true; Dialog.Cancel();
    }

    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if (IsDirty && await Dialogs.ShowMessageBoxAsync("Discard change draft?", "Unsaved values will be discarded.", yesText: "Discard draft", cancelText: "Keep editing") != true) context.PreventNavigation();
    }

    private sealed record DraftError(int Step, string Target, string Message);

    private static DateTime? CombineDateTime(DateTime? date, TimeSpan? time)
    {
        if (!date.HasValue || !time.HasValue)
        {
            return null;
        }

        return DateTime.SpecifyKind(date.Value.Date.Add(time.Value), DateTimeKind.Utc);
    }

    private sealed class TemplateErrorResponseDto
    {
        public string? Message { get; set; }
        public List<string> Errors { get; set; } = new();
    }
}

<style>
    .change-create-dialog { width: min(96vw, 1040px); max-height: calc(100dvh - 24px); }
    .change-create-dialog .mud-dialog-content { overflow: hidden; display: flex; flex-direction: column; min-height: 0; padding-top: 0; }
    .change-step-nav { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--mud-palette-divider); padding-bottom: 8px; }
    .change-create-dialog-content { overflow-y: auto; max-height: calc(100dvh - 260px); min-height: 12rem; padding: 16px 4px 8px; }
    .change-step[hidden] { display: none !important; }
    .change-error-link { display: block; text-align: left; text-transform: none; white-space: normal; }
    .change-create-dialog .mud-dialog-actions { border-top: 1px solid var(--mud-palette-divider); background: var(--mud-palette-surface); flex-shrink: 0; flex-wrap: wrap; }
    @@media (max-width:600px) { .change-create-dialog-content { max-height: calc(100dvh - 285px); } .change-step-nav .mud-button-root { padding: 4px 8px; } }
</style>
