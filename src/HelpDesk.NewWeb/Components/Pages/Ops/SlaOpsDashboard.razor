@attribute [Authorize(Roles = "Incident.Write,Incident.Manager,Request.Write,Request.Manager,Change.Write,Change.Manager,HelpdeskAdmin")]
@using System.Security.Claims
@using Helpdesk.Shared.DTOs
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.Enums
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

@implements IDisposable

<div class="sla-operations">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.subtitle1">SLA overview</MudText>
            <MudText Typo="Typo.caption">@(lastRefreshed is null ? "Not yet refreshed" : $"Refreshed {lastRefreshed.Value.ToLocalTime():g}")</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@loading" OnClick="RefreshAsync">Refresh</MudButton>
        </MudStack>

        <MudGrid>
            @if (isHelpdeskAdmin)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Tenant" Value="selectedTenantId" ValueChanged="OnTenantChanged" Clearable="true" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@((string?)null)">All Tenants</MudSelectItem>
                        @foreach (var tenant in tenants)
                        {
                            <MudSelectItem T="string" Value="@tenant.Id">@tenant.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="TicketType?" Label="Ticket Type" Value="selectedTicketType" ValueChanged="OnTicketTypeChanged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="TicketType?" Value="@(null)">All Types</MudSelectItem>
                    <MudSelectItem T="TicketType?" Value="TicketType.Incident">Incident</MudSelectItem>
                    <MudSelectItem T="TicketType?" Value="TicketType.Request">Request</MudSelectItem>
                    <MudSelectItem T="TicketType?" Value="TicketType.Change">Change</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int" Label="Near-Breach Threshold" Value="selectedThreshold" ValueChanged="OnThresholdChanged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="int" Value="80">80%</MudSelectItem>
                    <MudSelectItem T="int" Value="90">90%</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="SlaMetricType" Label="Metric" Value="selectedMetric" ValueChanged="OnMetricChanged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="SlaMetricType" Value="SlaMetricType.Response">Response</MudSelectItem>
                    <MudSelectItem T="SlaMetricType" Value="SlaMetricType.Resolution">Resolution</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <MudAlert Severity="Severity.Error">@loadError Refresh to retry.</MudAlert>
        }
        else if (loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (lastRefreshed is not null)
        {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Resolution Compliance (Last 7 days)</MudText>
                    <MudText Typo="Typo.h6">@summary.ResolutionCompliancePercent.ToString("0.##")%</MudText>
                    <MudText Typo="Typo.caption">@summary.CompletedWithinResolutionSla / @summary.CompletedTotal</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Response Compliance (Last 7 days)</MudText>
                    <MudText Typo="Typo.h6">@summary.ResponseCompliancePercent.ToString("0.##")%</MudText>
                    <MudText Typo="Typo.caption">@summary.CompletedWithinResponseSla / @summary.CompletedTotal</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Breached (Open)</MudText>
                    <MudText Typo="Typo.h6">@breached.Total</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Near Breach >= 90% (Open)</MudText>
                    <MudText Typo="Typo.h6">@nearNinetyCount</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <div class="sla-result-selection" role="group" aria-label="SLA ticket view">
            <MudButton Variant="@(!showBreached ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => showBreached = false)">Near breach (@nearBreach.Total)</MudButton>
            <MudButton Variant="@(showBreached ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => showBreached = true)">Breached (@breached.Total)</MudButton>
        </div>
        @if (!showBreached)
        {
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Near Breach (@($">= {selectedThreshold}%"))</MudText>
            <MudTable T="SlaTicketRowDto" Items="nearBreach.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching tickets.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>Ticket</MudTh>
                    <MudTh>Title</MudTh>
                    @if (isHelpdeskAdmin)
                    {
                        <MudTh>Tenant</MudTh>
                    }
                    <MudTh>% Used</MudTh>
                    <MudTh>Remaining</MudTh>
                    <MudTh>Due At</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Ticket">@(context.TicketNumber ?? context.TicketId)</MudTd>
                    <MudTd DataLabel="Title"><span class="truncate-title">@context.Title</span></MudTd>
                    @if (isHelpdeskAdmin)
                    {
                        <MudTd DataLabel="Tenant">@context.TenantId</MudTd>
                    }
                    <MudTd DataLabel="% Used">@(selectedMetric == SlaMetricType.Response ? context.ResponsePercentUsed : context.ResolutionPercentUsed)%</MudTd>
                    <MudTd DataLabel="Remaining">@FormatRemaining(selectedMetric == SlaMetricType.Response ? context.ResponseRemainingSeconds : context.ResolutionRemainingSeconds)</MudTd>
                    <MudTd DataLabel="Due At">@(selectedMetric == SlaMetricType.Response ? context.ResponseDueAt.ToLocalTime().ToString("g") : context.ResolutionDueAt.ToLocalTime().ToString("g"))</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@BuildTicketLink(context)">Open</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
        }

        @if (showBreached)
        {
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Breached Tickets</MudText>
            <MudTable T="SlaTicketRowDto" Items="breached.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching tickets.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>Ticket</MudTh>
                    <MudTh>Title</MudTh>
                    @if (isHelpdeskAdmin)
                    {
                        <MudTh>Tenant</MudTh>
                    }
                    <MudTh>Status</MudTh>
                    <MudTh>Due At</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Ticket">@(context.TicketNumber ?? context.TicketId)</MudTd>
                    <MudTd DataLabel="Title"><span class="truncate-title">@context.Title</span></MudTd>
                    @if (isHelpdeskAdmin)
                    {
                        <MudTd DataLabel="Tenant">@context.TenantId</MudTd>
                    }
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Breached</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Due At">@context.ResolutionDueAt.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@BuildTicketLink(context)">Open</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
        }
        }
    </MudStack>
</div>



@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    [Parameter] public string? TenantId { get; set; }
    [Parameter] public int? TicketTypeFilter { get; set; }
    [Parameter] public int? Threshold { get; set; }
    [Parameter] public int? Metric { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource? refresh;
    private DateTimeOffset? lastRefreshed;
    private string? loadError;
    private string? appliedQuery;
    private bool showBreached;
    private bool loading;
    private bool isHelpdeskAdmin;
    private string? selectedTenantId;
    private TicketType? selectedTicketType;
    private int selectedThreshold = 90;
    private SlaMetricType selectedMetric = SlaMetricType.Resolution;

    private List<TenantLookupDto> tenants = new();
    private SlaComplianceSummaryDto summary = new();
    private PagedResult<SlaTicketRowDto> nearBreach = new();
    private PagedResult<SlaTicketRowDto> breached = new();
    private int nearNinetyCount;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask!).User;
        isHelpdeskAdmin = user.IsInRole("HelpdeskAdmin") ||
            user.Claims.Any(c => (c.Type == ClaimTypes.Role || c.Type == "roles") &&
                string.Equals(c.Value, "HelpdeskAdmin", StringComparison.OrdinalIgnoreCase));

        if (isHelpdeskAdmin)
        {
            try { tenants = await HelpdeskApi.GetFromJsonAsync<List<TenantLookupDto>>("api/v1/admin/tenants/lookup", lifetime.Token) ?? new(); }
            catch (HttpRequestException) { loadError = "Tenant lookup is unavailable."; }
        }
        else
        {
            selectedTenantId = user.FindFirstValue("organization_id");
        }

    }

    protected override async Task OnParametersSetAsync()
    {
        var query = $"{TenantId}|{TicketTypeFilter}|{Threshold}|{Metric}";
        if (query == appliedQuery) return;
        appliedQuery = query;
        if (isHelpdeskAdmin) selectedTenantId = TenantId;
        selectedTicketType = TicketTypeFilter.HasValue && Enum.IsDefined(typeof(TicketType), TicketTypeFilter.Value) ? (TicketType)TicketTypeFilter.Value : null;
        selectedThreshold = Threshold is 80 or 90 ? Threshold.Value : 90;
        selectedMetric = Metric.HasValue && Enum.IsDefined(typeof(SlaMetricType), Metric.Value) ? (SlaMetricType)Metric.Value : SlaMetricType.Resolution;
        await RefreshAsync();
    }

    private Task OnTenantChanged(string? tenantId)
    {
        selectedTenantId = tenantId;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["tenantId"] = selectedTenantId, ["ticketType"] = (int?)selectedTicketType,
            ["thresholdPercent"] = selectedThreshold, ["metric"] = (int)selectedMetric }));
        return Task.CompletedTask;
    }

    private Task OnTicketTypeChanged(TicketType? ticketType)
    {
        selectedTicketType = ticketType;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["tenantId"] = selectedTenantId, ["ticketType"] = (int?)selectedTicketType,
            ["thresholdPercent"] = selectedThreshold, ["metric"] = (int)selectedMetric }));
        return Task.CompletedTask;
    }

    private Task OnThresholdChanged(int threshold)
    {
        selectedThreshold = threshold;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["tenantId"] = selectedTenantId, ["ticketType"] = (int?)selectedTicketType,
            ["thresholdPercent"] = selectedThreshold, ["metric"] = (int)selectedMetric }));
        return Task.CompletedTask;
    }

    private Task OnMetricChanged(SlaMetricType metric)
    {
        selectedMetric = metric;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["tenantId"] = selectedTenantId, ["ticketType"] = (int?)selectedTicketType,
            ["thresholdPercent"] = selectedThreshold, ["metric"] = (int)selectedMetric }));
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        refresh?.Cancel();
        refresh?.Dispose();
        var current = refresh = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        loading = true;
        loadError = null;
        try
        {
            var now = DateTimeOffset.UtcNow;
            var from = now.AddDays(-7);

            var nextSummary = await HelpdeskApi.GetFromJsonAsync<SlaComplianceSummaryDto>(
                BuildComplianceUrl(from, now), current.Token) ?? new SlaComplianceSummaryDto();

            var nextBreached = await HelpdeskApi.GetFromJsonAsync<PagedResult<SlaTicketRowDto>>(
                BuildBreachedUrl(), current.Token) ?? new PagedResult<SlaTicketRowDto>();

            var nextNearBreach = await HelpdeskApi.GetFromJsonAsync<PagedResult<SlaTicketRowDto>>(
                BuildNearBreachUrl(selectedThreshold, selectedMetric), current.Token) ?? new PagedResult<SlaTicketRowDto>();

            var nearNinety = await HelpdeskApi.GetFromJsonAsync<PagedResult<SlaTicketRowDto>>(
                BuildNearBreachUrl(90, SlaMetricType.Resolution, 1), current.Token) ?? new PagedResult<SlaTicketRowDto>();
            current.Token.ThrowIfCancellationRequested();
            summary = nextSummary;
            breached = nextBreached;
            nearBreach = nextNearBreach;
            nearNinetyCount = nearNinety.Total;
            lastRefreshed = DateTimeOffset.UtcNow;
        }
        catch (OperationCanceledException) when (current.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { if (current == refresh) loadError = "SLA data is unavailable."; }
        finally
        {
            if (current == refresh) loading = false;
        }
    }

    private string BuildComplianceUrl(DateTimeOffset from, DateTimeOffset to)
    {
        var query = new List<string>
        {
            $"fromUtc={Uri.EscapeDataString(from.ToString("O"))}",
            $"toUtc={Uri.EscapeDataString(to.ToString("O"))}"
        };

        if (!string.IsNullOrWhiteSpace(selectedTenantId))
        {
            query.Add($"tenantId={Uri.EscapeDataString(selectedTenantId)}");
        }

        if (selectedTicketType.HasValue)
        {
            query.Add($"ticketType={(int)selectedTicketType.Value}");
        }

        return $"api/v1/reports/sla/compliance?{string.Join("&", query)}";
    }

    private string BuildBreachedUrl()
    {
        var query = new List<string>
        {
            "page=1",
            "pageSize=25"
        };

        if (!string.IsNullOrWhiteSpace(selectedTenantId))
        {
            query.Add($"tenantId={Uri.EscapeDataString(selectedTenantId)}");
        }

        if (selectedTicketType.HasValue)
        {
            query.Add($"ticketType={(int)selectedTicketType.Value}");
        }

        return $"api/v1/reports/sla/breached?{string.Join("&", query)}";
    }

    private string BuildNearBreachUrl(int threshold, SlaMetricType metric, int pageSize = 25)
    {
        var query = new List<string>
        {
            "page=1",
            $"pageSize={pageSize}",
            $"thresholdPercent={threshold}",
            $"metric={(int)metric}"
        };

        if (!string.IsNullOrWhiteSpace(selectedTenantId))
        {
            query.Add($"tenantId={Uri.EscapeDataString(selectedTenantId)}");
        }

        if (selectedTicketType.HasValue)
        {
            query.Add($"ticketType={(int)selectedTicketType.Value}");
        }

        return $"api/v1/reports/sla/near-breach?{string.Join("&", query)}";
    }

    private string BuildTicketLink(SlaTicketRowDto row)
    {
        return row.TicketType switch
        {
            TicketType.Request => $"/requests/{row.TicketId}",
            TicketType.Change => $"/changes/{row.TicketId}",
            _ => $"/incidents/{row.TicketId}"
        };
    }

    public void Dispose() { lifetime.Cancel(); refresh?.Dispose(); lifetime.Dispose(); }

    private static string FormatRemaining(long seconds)
    {
        if (seconds <= 0)
        {
            return "Due";
        }

        var span = TimeSpan.FromSeconds(seconds);
        if (span.TotalDays >= 1)
        {
            return $"{(int)span.TotalDays}d {span.Hours}h";
        }

        if (span.TotalHours >= 1)
        {
            return $"{(int)span.TotalHours}h {span.Minutes}m";
        }

        return $"{Math.Max(0, span.Minutes)}m";
    }
}
