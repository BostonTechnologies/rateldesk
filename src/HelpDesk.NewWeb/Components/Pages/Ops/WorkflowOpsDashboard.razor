@attribute [Authorize(Roles = "Request.Read,Request.Write,Request.Execute,Request.Manager,HelpdeskAdmin")]

@using System.Net.Http.Json
@using System.Security.Claims
@using Helpdesk.Shared.DTOs
@using Helpdesk.Shared.DTOs.Orchestration
@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable



<div class="workflow-operations">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.subtitle1">Workflow diagnostics</MudText>
            <MudText Typo="Typo.caption">@(lastRefreshed is null ? "Not yet refreshed" : $"Refreshed {lastRefreshed.Value.ToLocalTime():g}")</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@loading" OnClick="LoadAllAsync">Refresh</MudButton>
        </MudStack>

        <div class="workflow-categories" role="group" aria-label="Workflow issue categories">
            @foreach (var category in Categories.Where(c => isAdmin || c.Key != "retries"))
            {
                <MudButton Variant="@(SelectedCategory == category.Key ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" Size="Size.Small" aria-pressed="@(SelectedCategory == category.Key ? "true" : "false")"
                           OnClick="@(() => SelectCategory(category.Key))">@category.Label <span class="workflow-count">@CountLabel(category.Key)</span></MudButton>
            }
        </div>
        @if (errors.TryGetValue(SelectedCategory, out var selectedError))
        {
            <MudAlert Severity="Severity.Warning">@selectedError Refresh to retry.</MudAlert>
        }
        else
        {
        @if (SelectedCategory == "overdue")
            {
            <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Overdue</MudText>
            <MudTable T="TaskOpsRowDto" Items="overdue.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching issues.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>Request</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>Assignee</MudTh>
                    <MudTh>Due At</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request">@context.RequestTrackingId</MudTd>
                    <MudTd DataLabel="Task">@context.TaskName</MudTd>
                    <MudTd DataLabel="Assignee">@(context.AssignedToDisplayName ?? context.AssignedToId ?? "-")</MudTd>
                    <MudTd DataLabel="Due At">@context.DueAt?.LocalDateTime.ToString("g")</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
            }

        @if (SelectedCategory == "escalated")
            {
            <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Escalated</MudText>
            <MudTable T="TaskOpsRowDto" Items="escalated.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching issues.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>Request</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>Assignee</MudTh>
                    <MudTh>Due At</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request">@context.RequestTrackingId</MudTd>
                    <MudTd DataLabel="Task">@context.TaskName</MudTd>
                    <MudTd DataLabel="Assignee">@(context.AssignedToDisplayName ?? context.AssignedToId ?? "-")</MudTd>
                    <MudTd DataLabel="Due At">@context.DueAt?.LocalDateTime.ToString("g")</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
            }

        @if (isAdmin)
        {
            @if (SelectedCategory == "retries")
            {
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.h6" Class="mb-2">Retries Pending</MudText>
                <MudTable T="TaskOpsRowDto" Items="retriesPending.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching issues.</MudText></NoRecordsContent>
                    <HeaderContent>
                        <MudTh>Request</MudTh>
                        <MudTh>Task</MudTh>
                        <MudTh>Next Retry</MudTh>
                        <MudTh>Retry Count</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Request">@context.RequestTrackingId</MudTd>
                        <MudTd DataLabel="Task">@context.TaskName</MudTd>
                        <MudTd DataLabel="Next Retry">@context.NextRetryAt?.LocalDateTime.ToString("g")</MudTd>
                        <MudTd DataLabel="Retry Count">@context.RetryCount</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(async () => await RetryNowAsync(context.TaskId))">Retry now</MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
            }
        }

        @if (SelectedCategory == "critical")
            {
            <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Critical Failures (24h)</MudText>
            <MudTable T="TaskOpsRowDto" Items="criticalFailures.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching issues.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>Request</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>Failure Policy</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request">@context.RequestTrackingId</MudTd>
                    <MudTd DataLabel="Task">@context.TaskName</MudTd>
                    <MudTd DataLabel="Failure Policy">@context.FailurePolicy</MudTd>
                    <MudTd DataLabel="Reason">@context.FailureReason</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Actions"><MudButton Variant="Variant.Text" Href="@($"/requests/{context.RequestId}")">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
            }

        @if (SelectedCategory == "callbacks")
            {
            <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">External orchestration Callback Rejections (7d)</MudText>
            <MudTable T="OrchestrationCallbackRejectionOpsDto" Items="callbackRejections.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching issues.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>When</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Caller</MudTh>
                    <MudTh>Correlation</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="When">@context.CreatedUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Reason">@context.ReasonCode</MudTd>
                    <MudTd DataLabel="Caller">@(context.CallerClientId ?? "-")</MudTd>
                    <MudTd DataLabel="Correlation">@(context.CorrelationId ?? "-")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Variant="Variant.Text" Href="@BuildNotificationsLink(context.CorrelationId)">Notifications</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
            }

        @if (SelectedCategory == "bindings")
            {
            <MudPaper Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-2">Binding Issues</MudText>
            <MudTable T="AutomationBindingIssueOpsDto" Items="bindingIssues.Items" Dense="true" Hover="true" Loading="@loading">
                <NoRecordsContent><MudText Typo="Typo.body2">No matching issues.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>Service</MudTh>
                    <MudTh>Request Form</MudTh>
                    <MudTh>Task</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>External orchestration Target</MudTh>
                    <MudTh>Last Sync</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Service">@(context.ServiceName ?? context.ServiceId)</MudTd>
                    <MudTd DataLabel="Request Form">@context.RequestFormTitle</MudTd>
                    <MudTd DataLabel="Task">@(context.TaskName ?? context.TaskTemplateId.ToString())</MudTd>
                    <MudTd DataLabel="State">
                        <MudChip T="string" Size="Size.Small" Color="@GetBindingIssueColor(context)">
                            @(context.Enabled ? context.SyncState.ToString() : "Disabled")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="External orchestration Target">@(context.OrchestrationRequestDefinitionName ?? context.OrchestrationRequestDefinitionId)</MudTd>
                    <MudTd DataLabel="Last Sync">@context.LastSyncedAtUtc?.LocalDateTime.ToString("g")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
            }
        }
    </MudStack>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    [Parameter] public string? Category { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private readonly Dictionary<string, string> errors = new();
    private DateTimeOffset? lastRefreshed;
    private bool disposed;
    private string selectedCategory = "critical";
    private string SelectedCategory => Categories.Any(c => c.Key == Category && (isAdmin || c.Key != "retries")) ? Category! : selectedCategory;
    private static readonly (string Key, string Label)[] Categories = [
        ("critical", "Critical failures (24h)"), ("overdue", "Overdue"), ("escalated", "Escalated"),
        ("retries", "Retries pending"), ("callbacks", "Callback rejections (7d)"), ("bindings", "Binding issues") ];
    private void SelectCategory(string key) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("category", key));
    private int Count(string key) => key switch {
        "overdue" => overdue.TotalCount, "escalated" => escalated.TotalCount, "retries" => retriesPending.TotalCount,
        "critical" => criticalFailures.TotalCount, "callbacks" => callbackRejections.TotalCount, _ => bindingIssues.TotalCount };
    private string CountLabel(string key) => errors.ContainsKey(key) ? "Unavailable" : loading ? "…" : Count(key).ToString();
    private bool loading;
    private bool isAdmin;
    private PagedResponse<TaskOpsRowDto> overdue = new();
    private PagedResponse<TaskOpsRowDto> escalated = new();
    private PagedResponse<TaskOpsRowDto> retriesPending = new();
    private PagedResponse<TaskOpsRowDto> criticalFailures = new();
    private PagedResponse<OrchestrationCallbackRejectionOpsDto> callbackRejections = new();
    private PagedResponse<AutomationBindingIssueOpsDto> bindingIssues = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            isAdmin = user.IsInRole("HelpdeskAdmin")
                || user.Claims.Any(c =>
                    (c.Type == ClaimTypes.Role || c.Type == "roles")
                    && string.Equals(c.Value, "HelpdeskAdmin", StringComparison.OrdinalIgnoreCase));
        }

        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        loading = true;
        errors.Clear();
        try
        {
            var overdueTask = LoadPagedOrEmptyAsync<TaskOpsRowDto>("api/v1/ops/tasks/overdue?page=1&pageSize=25", "overdue");
            var escalatedTask = LoadPagedOrEmptyAsync<TaskOpsRowDto>("api/v1/ops/tasks/escalated?page=1&pageSize=25", "escalated");
            var criticalTask = LoadPagedOrEmptyAsync<TaskOpsRowDto>(
                $"api/v1/ops/tasks/critical-failures?sinceUtc={Uri.EscapeDataString(DateTimeOffset.UtcNow.AddDays(-1).ToString("O"))}&page=1&pageSize=25",
                "critical");
            var callbackRejectionsTask = LoadPagedOrEmptyAsync<OrchestrationCallbackRejectionOpsDto>(
                "api/v1/ops/tasks/orchestration/callback-rejections?page=1&pageSize=25&lookbackDays=7",
                "callbacks");
            var bindingIssuesTask = LoadPagedOrEmptyAsync<AutomationBindingIssueOpsDto>(
                "api/v1/ops/tasks/orchestration/binding-issues?page=1&pageSize=25",
                "bindings");

            var retriesTask = isAdmin
                ? LoadPagedOrEmptyAsync<TaskOpsRowDto>("api/v1/ops/tasks/retries-pending?page=1&pageSize=25", "retries")
                : Task.FromResult(new PagedResponse<TaskOpsRowDto>());

            await Task.WhenAll(overdueTask, escalatedTask, retriesTask, criticalTask, callbackRejectionsTask, bindingIssuesTask);

            overdue = await overdueTask;
            escalated = await escalatedTask;
            retriesPending = await retriesTask;
            criticalFailures = await criticalTask;
            callbackRejections = await callbackRejectionsTask;
            bindingIssues = await bindingIssuesTask;
            if (disposed) return;
            lastRefreshed = DateTimeOffset.UtcNow;
            if (Category is null) selectedCategory = Categories.FirstOrDefault(c => (isAdmin || c.Key != "retries") && Count(c.Key) > 0).Key ?? "critical";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally
        {
            loading = false;
        }
    }

    private async Task<PagedResponse<T>> LoadPagedOrEmptyAsync<T>(string url, string label)
    {
        try
        {
            return await HelpdeskApi.GetFromJsonAsync<PagedResponse<T>>(url, lifetime.Token) ?? new PagedResponse<T>();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { throw; }
        catch (HttpRequestException ex)
        {
            errors[label] = ex.StatusCode is null ? "These diagnostics could not be loaded right now." : $"These diagnostics could not be loaded right now ({(int)ex.StatusCode}).";
        }
        catch
        {
            errors[label] = "These diagnostics could not be loaded right now.";
        }

        return new PagedResponse<T>();
    }

    private async Task RetryNowAsync(string taskId)
    {
        try
        {
            var response = await HelpdeskApi.PostAsJsonAsync($"api/v1/request-tasks/{taskId}/retry", new { });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Retry failed." : error, Severity.Error);
                return;
            }

            Snackbar.Add("Retry requested.", Severity.Success);
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Retry failed: {ex.Message}", Severity.Error);
        }
    }

    private static string BuildNotificationsLink(string? correlationId)
        => string.IsNullOrWhiteSpace(correlationId)
            ? "/notifications?category=DomainEvent.Orchestration"
            : $"/notifications?category=DomainEvent.Orchestration&correlationId={Uri.EscapeDataString(correlationId)}";

    public void Dispose() { disposed = true; lifetime.Cancel(); lifetime.Dispose(); }

    private static Color GetBindingIssueColor(AutomationBindingIssueOpsDto binding)
    {
        if (!binding.Enabled)
        {
            return Color.Default;
        }

        return binding.SyncState switch
        {
            AutomationBindingSyncState.Broken => Color.Error,
            AutomationBindingSyncState.ImportPending => Color.Warning,
            AutomationBindingSyncState.Drifted => Color.Info,
            _ => Color.Success
        };
    }
}
