
@inject IHttpClientFactory HttpClientFactory
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Class="mr-2 mb-n1" />
            Create Automation Rule
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs @bind-ActivePanelIndex="activeIndex" Rounded="true" Class="mb-2 compact-tabs">
            <MudTabPanel Text="Trigger">
                <MudForm @ref="form" Model="model">
                    <MudTextField @bind-Value="model.Name" Label="Name" Required="true" />
                    <MudTextField @bind-Value="model.Trigger" Label="Trigger" Required="true" Class="mt-2" />
                </MudForm>
            </MudTabPanel>
            <MudTabPanel Text="Conditions">
                <MudTextField @bind-Value="model.Conditions" Label="Conditions" Lines="4" />
            </MudTabPanel>
            <MudTabPanel Text="Actions">
                <MudTextField @bind-Value="model.Actions" Label="Actions" Lines="4" />
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@(activeIndex==0)" OnClick="Back">Back</MudButton>
        @if (activeIndex < 2)
        {
            <MudButton OnClick="Next" Color="Color.Primary" Variant="Variant.Filled">Next</MudButton>
        }
        else
        {
            <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm form = default!;
    private AutomationRule model = new();
    private int activeIndex = 0;

    private void Next() => activeIndex++;
    private void Back() => activeIndex--;

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            var response = await HelpdeskApi.PostAsJsonAsync("api/v1/automation/rules", model);
            if (response.IsSuccessStatusCode)
            {
                Dialog.Close(DialogResult.Ok(true));
            }
        }
    }
}
