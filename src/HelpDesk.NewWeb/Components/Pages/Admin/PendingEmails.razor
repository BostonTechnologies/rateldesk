@page "/admin/pending-emails"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@using Helpdesk.Shared.DTOs.Worklog
@using Helpdesk.Shared.Enums
@using Helpdesk.Shared.Models
@using HelpDesk.NewWeb.Services
@using Microsoft.JSInterop
@inject ITimelineApiClient TimelineClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudPaper Class="pa-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h5">Pending Email Deliveries</MudText>
        <MudButton
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Refresh"
            OnClick="RetryAll"
            Disabled="@loading">
            Retry All
        </MudButton>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mb-2">Failed deliveries: @failed.Count</MudText>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (failed.Count == 0)
    {
        <MudAlert Severity="Severity.Success">No failed email deliveries.</MudAlert>
    }
    else
    {
        <MudTable Items="@failed" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Created</MudTh>
                <MudTh>Ticket</MudTh>
                <MudTh>Recipient</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Retries</MudTh>
                <MudTh>Message</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Created">@context.CreatedUtc.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Ticket">@context.TicketId</MudTd>
                <MudTd DataLabel="Recipient">@context.EmailRecipient</MudTd>
                <MudTd DataLabel="Status">@context.EmailStatus</MudTd>
                <MudTd DataLabel="Retries">@context.RetryCount</MudTd>
                <MudTd DataLabel="Message">
                    <div>@context.MessageText</div>
                    @if (!string.IsNullOrWhiteSpace(context.DeliveryErrorCode))
                    {
                        <div>Reason: @context.DeliveryErrorCode</div>
                    }
                    @if (context.AcceptedRecipients?.Length > 0)
                    {
                        <div>Accepted: @string.Join(", ", context.AcceptedRecipients)</div>
                    }
                    @if (context.RejectedRecipients?.Length > 0)
                    {
                        <div>Rejected: @string.Join(", ", context.RejectedRecipients)</div>
                    }
                    @if (context.RecipientOutcomeUnavailable)
                    {
                        <div>Recipient details unavailable; check the provider before retrying.</div>
                    }
                </MudTd>
                <MudTd DataLabel="Action">
                    @if (context.DeliveryErrorCode == "SenderRouteChanged")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@loading"
                                   OnClick="() => RetryWithCurrentRouteAsync(context.Id)">
                            Review new sender
                        </MudButton>
                    }
                    else if (context.DeliveryErrorCode is "DispatchOutcomeUnknown" or "SubmissionOutcomeUnknown")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@loading"
                                   OnClick="() => RetryConfirmedUndeliveredAsync(context.Id)">
                            Verify non-delivery
                        </MudButton>
                    }
                    else if (context.DeliveryErrorCode == "SmtpPartialRecipientAcceptance" ||
                             context.AcceptedRecipients?.Length > 0 || context.RecipientOutcomeUnavailable)
                    {
                        <MudText Typo="Typo.caption">Recipient review required</MudText>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@loading"
                                   OnClick="() => RetryWithCurrentOutgoingAsync(context.Id)">
                            Review sender and retry
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<TicketTimelineEventDto> failed = new();
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            failed = await TimelineClient.GetFailedAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load pending emails: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RetryAll()
    {
        loading = true;
        try
        {
            await TimelineClient.RetryAllAsync();
            Snackbar.Add("Bulk retry completed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bulk retry failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }

        await LoadAsync();
    }

    private async Task RetryWithCurrentOutgoingAsync(Guid timelineId)
    {
        loading = true;
        try
        {
            var preview = await TimelineClient.PreviewOutgoingRetryAsync(timelineId);
            if (preview?.CanRetry != true || preview.CurrentOutgoingVersion is null)
            {
                Snackbar.Add($"This delivery cannot adopt current outgoing settings: {preview?.Status ?? "Preview unavailable"}.", Severity.Warning);
                return;
            }

            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Retry this delivery using {preview.MailboxAddress} ({preview.Transport}), outgoing revision {preview.CurrentOutgoingVersion}? The ticket, tenant and mailbox stay bound to the original delivery.");
            if (!confirmed) return;
            await TimelineClient.RetryWithCurrentOutgoingAsync(timelineId, preview.CurrentOutgoingVersion.Value);
            Snackbar.Add("Delivery queued with the confirmed outgoing revision.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Delivery retry could not be queued: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            await LoadAsync();
        }
    }

    private async Task RetryConfirmedUndeliveredAsync(Guid timelineId)
    {
        loading = true;
        try
        {
            var preview = await TimelineClient.PreviewUncertainRetryAsync(timelineId);
            if (preview?.CanRetry != true || preview.Fence is null || preview.CurrentOutgoingVersion is null)
            {
                Snackbar.Add($"This delivery cannot be retried: {preview?.Status ?? "Preview unavailable"}.", Severity.Warning);
                return;
            }

            var evidence = await JS.InvokeAsync<string?>("prompt",
                $"Confirm with the provider and recipients that no delivery occurred to: {string.Join(", ", preview.Recipients)}. Enter a non-sensitive evidence reference (8–128 characters, letters, digits, . _ : / -).", "");
            if (string.IsNullOrWhiteSpace(evidence)) return;
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"I verified non-delivery for every listed recipient. Retry through {preview.MailboxAddress} ({preview.Transport}), outgoing revision {preview.CurrentOutgoingVersion}? Evidence: {evidence}");
            if (!confirmed) return;
            await TimelineClient.RetryConfirmedUndeliveredAsync(timelineId,
                new(preview.Fence.Value, preview.CurrentOutgoingVersion.Value, evidence, true));
            Snackbar.Add("Delivery queued after confirmed non-delivery.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Delivery retry could not be queued: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            await LoadAsync();
        }
    }

    private async Task RetryWithCurrentRouteAsync(Guid timelineId)
    {
        loading = true;
        try
        {
            var preview = await TimelineClient.PreviewChangedRouteAsync(timelineId);
            if (preview?.CanRetry != true || preview.Fence is null || preview.OriginalMailboxId is null ||
                preview.CurrentMailboxId is null || preview.CurrentMailboxVersion is null ||
                preview.CurrentOutgoingVersion is null)
            {
                Snackbar.Add($"This delivery cannot use the current route: {preview?.Status ?? "Preview unavailable"}.", Severity.Warning);
                return;
            }

            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"The original sender was {preview.OriginalMailboxAddress}. The current ticket route is {preview.CurrentMailboxAddress} ({preview.CurrentTransport}). Send the original delivery to {string.Join(", ", preview.Recipients)} using the current mailbox? Verify the tenant assignment and recipients before confirming.");
            if (!confirmed) return;
            await TimelineClient.RetryWithCurrentRouteAsync(timelineId,
                new(preview.Fence.Value, preview.OriginalMailboxId.Value, preview.CurrentMailboxId.Value,
                    preview.CurrentMailboxVersion.Value, preview.CurrentOutgoingVersion.Value, true));
            Snackbar.Add("Delivery queued with the confirmed current sender.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Delivery retry could not be queued: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            await LoadAsync();
        }
    }
}
