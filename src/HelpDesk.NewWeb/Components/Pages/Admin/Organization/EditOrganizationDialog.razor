@using System.ComponentModel.DataAnnotations
@using Helpdesk.Shared.DTOs.Orchestration
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.Models
@using HelpDesk.NewWeb.Components.Pages.Admin.User
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Edit Organization</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="model" Class="mt-2">
            <MudTabs>
                <MudTabPanel Text="General">
                    <MudTextField @bind-Value="model.Name" Label="Name" Required="true" />
                    <MudTextField @bind-Value="model.DnsName" Label="DNS Name" />
                    <MudTextField @bind-Value="model.ContactInfo" Label="Contact Info" />
                    <MudSelect T="string" @bind-Value="model.ItSupportOrganizationId" Label="ITIL/MSP manager organization" Clearable="true">
                        @foreach (var organization in ManagerOrganizationOptions)
                        {
                            <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="model.Enabled" Label="Enable organization" />
                </MudTabPanel>
                <MudTabPanel Text="External orchestration Tenant">
                    @if (!string.IsNullOrWhiteSpace(orchestrationTenantsError))
                    {
                        <MudAlert Severity="Severity.Warning">@orchestrationTenantsError</MudAlert>
                    }
                    <MudSelect T="int?" @bind-Value="model.OrchestrationTenantId" Label="External orchestration Tenant" Clearable="true" Disabled="orchestrationTenantsLoading">
                        @foreach (var tenant in orchestrationTenants)
                        {
                            <MudSelectItem T="int?" Value="@tenant.TenantId">@tenant.Name (@tenant.TenantId)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTabPanel>
                <MudTabPanel Text="Members &amp; access">
                    <TenantAdministration IsCanonical="true" OrganizationId="@Organization.Id" />
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Dialog.Cancel">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public OrganizationDto Organization { get; set; } = default!;
    [Parameter] public List<OrganizationDto> Organizations { get; set; } = new();

    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    private MudForm form = default!;
    private EditOrganizationModel model = new();
    private List<OrchestrationCatalogTenantDto> orchestrationTenants = new();
    private bool orchestrationTenantsLoading;
    private string? orchestrationTenantsError;
    private IEnumerable<OrganizationDto> ManagerOrganizationOptions => Organizations.Where(x => x.IsEnabled && !string.Equals(x.Id, Organization.Id, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        model = new EditOrganizationModel
        {
            Name = Organization.Name, DnsName = Organization.DnsName, ContactInfo = Organization.ContactInfo,
            ItSupportOrganizationId = Organization.ItSupportOrganizationId, OrchestrationTenantId = Organization.OrchestrationTenantId,
            OrchestrationTenantLinkedAtUtc = Organization.OrchestrationTenantLinkedAtUtc, State = Organization.State,
            Enabled = Organization.State == EntityState.Enabled
        };
        await LoadOrchestrationTenantsAsync();
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;
        model.State = model.Enabled ? EntityState.Enabled : EntityState.Blocked;
        var response = await Api.PutAsJsonAsync($"api/v1/organizations/{Organization.Id}", new
        {
            model.Name, model.DnsName, model.ContactInfo,
            ItSupportOrganizationId = string.IsNullOrWhiteSpace(model.ItSupportOrganizationId) ? null : model.ItSupportOrganizationId,
            model.State, model.OrchestrationTenantId,
            OrchestrationTenantName = orchestrationTenants.FirstOrDefault(x => x.TenantId == model.OrchestrationTenantId)?.Name,
            OrchestrationTenantLinkedAtUtc = model.OrchestrationTenantId.HasValue ? (DateTimeOffset?)(model.OrchestrationTenantLinkedAtUtc ?? DateTimeOffset.UtcNow) : null
        });
        if (response.IsSuccessStatusCode) { Dialog.Close(DialogResult.Ok(true)); return; }
        Snackbar.Add(await response.Content.ReadAsStringAsync(), Severity.Error);
    }

    private async Task LoadOrchestrationTenantsAsync()
    {
        orchestrationTenantsLoading = true;
        try { orchestrationTenants = await Api.GetFromJsonAsync<List<OrchestrationCatalogTenantDto>>("api/v1/admin/orchestration/catalog/tenants") ?? new(); }
        catch (Exception ex) { orchestrationTenantsError = $"External orchestration tenant catalog could not be loaded: {ex.Message}"; }
        finally { orchestrationTenantsLoading = false; }
    }

    private sealed class EditOrganizationModel
    {
        [Required] public string Name { get; set; } = string.Empty;
        public string? DnsName { get; set; }
        public string? ContactInfo { get; set; }
        public string? ItSupportOrganizationId { get; set; }
        public int? OrchestrationTenantId { get; set; }
        public DateTimeOffset? OrchestrationTenantLinkedAtUtc { get; set; }
        public EntityState State { get; set; }
        public bool Enabled { get; set; }
    }
}
