@page "/admin/organizations"
@attribute [Authorize(Roles = "Tenant.Roles.Assign,Tenant.Settings.Manage,HelpdeskAdmin")]
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationState
@using HelpDesk.NewWeb.Models
@using HelpDesk.NewWeb.Components.Pages.Admin.User

<PageTitle>Organizations</PageTitle>

<AuthorizeView Roles="HelpdeskAdmin" Context="instanceAdmin">
<Authorized Context="instanceAdministrator">
<AdminDirectoryWorkspace Title="Organizations" Subtitle="Review customer organizations, support routing and saved orchestration mappings."
                         TotalCount="source.TotalCount" Loaded="source.HasLoaded" Refreshing="source.IsLoading" Error="@source.Error" OnRefresh="ReloadAsync">
    <PrimaryAction><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Create organization</MudButton></PrimaryAction>
    <ToolbarContent>
        <MudTextField T="string" Value="query.Search" ValueChanged="SearchChangedAsync" Label="Search name, DNS or contact"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" MaxLength="120" />
        <MudSelect T="string" Value="@(query.Get("enabled") ?? string.Empty)" ValueChanged="@(value => FilterChangedAsync("enabled", value))" Label="State" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@(string.Empty)">All states</MudSelectItem><MudSelectItem Value="@("true")">Enabled</MudSelectItem><MudSelectItem Value="@("false")">Disabled</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Value="@(query.Get("linked") ?? string.Empty)" ValueChanged="@(value => FilterChangedAsync("linked", value))" Label="Orchestration mapping" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@(string.Empty)">All mappings</MudSelectItem><MudSelectItem Value="@("true")">Linked</MudSelectItem><MudSelectItem Value="@("false")">Not linked</MudSelectItem>
        </MudSelect>
        @if (query.Get("supportOrganizationId") != "self")
        { <OrganizationDirectorySelector Label="Support organization" Value="@query.Get("supportOrganizationId")" ValueChanged="@(value => FilterChangedAsync("supportOrganizationId", value))" /> }
        <MudCheckBox T="bool" Value="@(query.Get("supportOrganizationId") == "self")" ValueChanged="@(value => FilterChangedAsync("supportOrganizationId", value ? "self" : null))" Label="Self-managed only" />
        <MudButton OnClick="ClearAsync" Disabled="@(!query.HasFilters)" StartIcon="@Icons.Material.Outlined.FilterAltOff">Clear filters</MudButton>
    </ToolbarContent>
    <ChildContent>
        <MudTable T="OrganizationDto" @ref="table" ServerData="LoadAsync" Dense="true" Hover="true" AllowUnsorted="false" FixedHeader="true" FixedFooter="true"
                  RowsPerPage="query.PageSize" @bind-CurrentPage="query.Page" Height="clamp(16rem, calc(100dvh - 24rem), 44rem)" Breakpoint="Breakpoint.None" Class="compact-table" data-table-surface="pages-admin-organization-organizationmanagement-1">
            <HeaderContent>
                <DirectorySortHeader Column="name" Label="Organization" Sort="@query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="contact" Label="Contact" Sort="@query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="support" Label="Support organization" Sort="@query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="state" Label="State" Sort="@query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="orchestration" Label="Orchestration" Sort="@query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <MudTh Class="directory-action-column">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Organization"><span class="directory-primary">@context.Name</span><span class="directory-secondary">@context.DnsName</span></MudTd>
                <MudTd DataLabel="Contact"><span class="directory-description">@(context.ContactInfo ?? "—")</span></MudTd>
                <MudTd DataLabel="Support organization">@(string.IsNullOrWhiteSpace(context.ItSupportOrganizationId) ? "Self-managed" : context.SupportOrganizationName ?? "Saved support organization (unavailable)")</MudTd>
                <MudTd DataLabel="State">@(context.IsEnabled ? "Enabled" : "Disabled")</MudTd>
                <MudTd DataLabel="Orchestration">
                    @if (context.OrchestrationTenantId is { } tenantId)
                    { <span title="@($"Saved tenant {tenantId}; linked {context.OrchestrationTenantLinkedAtUtc:O}")">@(context.OrchestrationTenantName ?? "Saved tenant (name unavailable)")</span><span class="directory-secondary">Saved mapping · tenant @tenantId</span> }
                    else { <span>Not linked</span> }
                </MudTd>
                <MudTd DataLabel="Actions"><div class="workspace-actions"><div class="directory-actions">
                    <WorkspaceAction Label="Edit organization" Icon="@Icons.Material.Outlined.Edit" OnClick="() => OpenEditDialog(context)" />
                    <WorkspaceAction Label="Support routing" Icon="@Icons.Material.Outlined.SupportAgent" OnClick="() => OpenSupportRouting(context)" />
                    <WorkspaceAction Label="Delete organization" Icon="@Icons.Material.Outlined.Delete" OnClick="() => OpenDeleteDialog(context)" />
                </div></div></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>@(source.Error is not null ? "The directory is unavailable." : query.HasFilters ? "No organizations match these filters." : "No organizations yet. Create an organization to begin.")</MudText></NoRecordsContent>
            <LoadingContent><MudText>Loading organizations…</MudText></LoadingContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" ShowFirstLast="true" /></PagerContent>
        </MudTable>
    </ChildContent>
</AdminDirectoryWorkspace>
</Authorized>
<NotAuthorized Context="delegatedAdministrator">
    <MudTabs ActivePanelIndex="@DelegatedTabIndex" Class="compact-tabs">
        <MudTabPanel Text="General &amp; settings"><TenantSettings IsCanonical="true" OrganizationId="@OrganizationId" /></MudTabPanel>
        <MudTabPanel Text="Members &amp; access"><TenantAdministration IsCanonical="true" OrganizationId="@OrganizationId" /></MudTabPanel>
    </MudTabs>
</NotAuthorized>
</AuthorizeView>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "enabled")] public string? QueryEnabled { get; set; }
    [SupplyParameterFromQuery(Name = "linked")] public string? QueryLinked { get; set; }
    [SupplyParameterFromQuery(Name = "supportOrganizationId")] public string? QuerySupportOrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public string? QueryPageSize { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
    [SupplyParameterFromQuery(Name = "descending")] public string? QueryDescending { get; set; }
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "organizationId")] public string? OrganizationId { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private readonly AdminDirectoryQueryState query = new("enabled", "linked", "supportOrganizationId");
    private readonly AdminDirectoryDataSource<OrganizationDto> source = new();
    private MudTable<OrganizationDto>? table;
    private bool canAssignTenantRoles;
    private int DelegatedTabIndex => string.Equals(Section, "settings", StringComparison.OrdinalIgnoreCase) ? 0 : string.Equals(Section, "members", StringComparison.OrdinalIgnoreCase) || canAssignTenantRoles ? 1 : 0;
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        canAssignTenantRoles = user.IsInRole("Tenant.Roles.Assign") || user.IsInRole("HelpdeskAdmin");
    }
    protected override void OnParametersSet() { if (query.Read(NavigationManager.Uri) && table is not null) _ = table.ReloadServerData(); }
    private async Task<TableData<OrganizationDto>> LoadAsync(TableState state, CancellationToken ct)
    {
        var loading = source.LoadAsync(HelpdeskApi, query.ApiUrl("api/v1/admin/directories/organizations", state), ct);
        await InvokeAsync(StateHasChanged);
        var data = await loading;
        if (source.HasLoaded) query.Page = source.Page;
        query.Remember(NavigationManager); await InvokeAsync(StateHasChanged); return data;
    }
    private Task ReloadAsync() => table?.ReloadServerData() ?? Task.CompletedTask;
    private async Task ResetPageAsync() { query.Page = 0; query.Remember(NavigationManager); if (table is not null) { table.NavigateTo(0); await table.ReloadServerData(); } }
    private Task SortChangedAsync(string column) { query.Descending = query.Sort == column && !query.Descending; query.Sort = column; return ResetPageAsync(); }
    private Task SearchChangedAsync(string? value) { query.Search = value; return ResetPageAsync(); }
    private Task FilterChangedAsync(string name, string? value) { query.Set(name, value); return ResetPageAsync(); }
    private Task ClearAsync() { query.Clear(); return ResetPageAsync(); }
    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateOrganizationDialog>("Create Organization", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
    private async Task OpenEditDialog(OrganizationDto organization)
    {
        var organizations = await HelpdeskApi.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations") ?? [];
        var dialog = await DialogService.ShowAsync<EditOrganizationDialog>("Edit Organization", new DialogParameters { ["Organization"] = organization, ["Organizations"] = organizations }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
    private async Task OpenDeleteDialog(OrganizationDto organization)
    {
        var dialog = await DialogService.ShowAsync<DeleteOrganizationDialog>("Delete Organization", new DialogParameters { ["Organization"] = organization }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
    private void OpenSupportRouting(OrganizationDto organization) => NavigationManager.NavigateTo($"/admin/support-routing?organizationId={Uri.EscapeDataString(organization.Id)}");
    public void Dispose() => source.Dispose();
}
