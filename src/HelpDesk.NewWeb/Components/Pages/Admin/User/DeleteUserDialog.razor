@using HelpDesk.NewWeb.Services
@inject IHttpClientFactory HttpClientFactory
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">Delete application access for <strong>@User.Name</strong> (@User.Email)?</MudText>
        <MudText Typo="Typo.body2" Class="mt-3">This permanently retires the user from active directories and revokes application sign-in, sessions, integration credentials and role grants. Ticket, worklog and audit attribution remains readable.</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">Enable cannot restore a deleted user. An external identity provider account is retained and cannot automatically regain this application's access.</MudText>
        @if (error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3" role="alert">@error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="busy">Cancel</MudButton>
        <MudButton OnClick="Delete" Disabled="busy" Color="Color.Error" Variant="Variant.Filled">@(busy ? "Deleting…" : "Delete user")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? error;
    private bool busy;
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Helpdesk.Shared.DTOs.User.UserDto User { get; set; } = default!;

    private async Task Delete()
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            using var response = await HttpClientFactory.CreateClient("HelpdeskApi").DeleteAsync($"api/v1/users/{Uri.EscapeDataString(User.Id)}");
            if (response.IsSuccessStatusCode) Dialog.Close(DialogResult.Ok(true));
            else error = await UserLifecycleErrors.ReadAsync(response, "The user could not be deleted. Refresh and retry. Their application access has not been reported as deleted.");
        }
        catch (Exception exception) when (UserLifecycleErrors.IsUnavailable(exception)) { error = "The account service is unavailable. Keep this dialog open and retry; repeated deletion is safe."; }
        finally { busy = false; }
    }

    private void Cancel() => Dialog.Cancel();
}
