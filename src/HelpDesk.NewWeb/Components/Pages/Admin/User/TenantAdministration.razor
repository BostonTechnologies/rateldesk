@page "/tenant-administration"
@attribute [Authorize(Roles = "Tenant.Users.Manage,Tenant.Roles.Assign,HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

@if (!IsCanonical)
{
    <PageTitle>Tenant members</PageTitle>
}

<div class="helpdesk-page">
    <MudPaper Class="helpdesk-content-surface pa-4" Elevation="0">
        @if (!IsCanonical)
        {
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-page-title">Tenant members</MudText>
        }
        <MudText Typo="Typo.body2" Class="mb-4">
            Manage delegable tenant roles for local accounts in a tenant you administer. Account credentials and instance-administrator access remain instance-administrator actions.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert>
        }
        else if (organizations.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">You do not have permission to manage tenant memberships.</MudAlert>
        }
        else
        {
            @if (string.IsNullOrWhiteSpace(OrganizationId))
            {
                <MudSelect T="string" Label="Tenant" Value="selectedOrganizationId" ValueChanged="SelectOrganization" Class="mb-4">
                    @foreach (var organization in organizations)
                    {
                        <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (canInvite)
            {
                <MudExpansionPanels Class="mb-3" Elevation="0">
                    <MudExpansionPanel Text="Invite a local account">
                        <MudText Typo="Typo.body2" Class="mb-2">The account is created only in the selected tenant with self-service access. Share its one-time activation token through an approved secure channel.</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="inviteName" Label="Display name" Required="true" /></MudItem>
                            <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="inviteEmail" Label="Email" InputType="InputType.Email" Required="true" /></MudItem>
                            <MudItem xs="12" sm="2" Class="d-flex align-center"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@inviting" OnClick="InviteAccount">@(inviting ? "Creating" : "Create")</MudButton></MudItem>
                        </MudGrid>
                        @if (invitation is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">Copy this activation token now. It is shown only once.</MudAlert>
                            <MudTextField T="string" Value="@invitation.Email" Label="Account email" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" />
                            <MudTextField T="string" Value="@invitation.ActivationToken" Label="Activation token" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" />
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            @if (loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudTextField T="string" @bind-Value="memberSearch" Label="Search members" Immediate="true" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="helpdesk-list-search mb-3" />
                <MudTable Items="FilteredMembers" Hover="true" Dense="true" T="TenantMember" Breakpoint="Breakpoint.Sm" RowsPerPage="25" Class="helpdesk-table compact-table" FixedHeader="true" FixedFooter="true" data-table-surface="pages-admin-user-tenantadministration-1">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Delegable roles</MudTh>
                        <MudTh class="text-end">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Delegable roles">
                            @if (context.RoleKeys.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">No delegable roles assigned</MudText>
                            }
                            else
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var roleKey in context.RoleKeys.Take(3))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@RoleLabel(roleKey)</MudChip>
                                    }
                                    @if (context.RoleKeys.Count > 3)
                                    {
                                        <MudTooltip Text="@string.Join(", ", context.RoleKeys.Skip(3).Select(RoleLabel))"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">+@(context.RoleKeys.Count - 3) more</MudChip></MudTooltip>
                                    }
                                </MudStack>
                            }
                        </MudTd>
                        <MudTd Class="text-end"><div class="workspace-actions">
                            @if (canAssignRoles)
                            {
                                <WorkspaceAction OnClick="() => OpenRoleDialogAsync(context)" Label="Edit roles" Icon="@Icons.Material.Outlined.ManageAccounts" />
                            }
                        </div></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>No members match this tenant and search.</MudText>
                    </NoRecordsContent>

<PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
</MudTable>
            }
        }
    </MudPaper>
</div>

@code {
    [Parameter] public bool IsCanonical { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "organizationId")] public string? OrganizationId { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private List<TenantOrganization> organizations = new();
    private List<TenantMember> members = new();
    private List<TenantDelegableRole> availableRoles = new();
    private readonly TenantOrganizationSelection organizationSelection = new();
    private string? selectedOrganizationId => organizationSelection.SelectedOrganizationId;
    private string? error;
    private bool loading;
    private bool inviting;
    private bool organizationsLoaded;
    private bool hasAppliedOrganizationParameter;
    private string? appliedOrganizationId;
    private string inviteName = string.Empty;
    private string inviteEmail = string.Empty;
    private TenantLocalAccountInvitation? invitation;
    private string memberSearch = string.Empty;
    private bool canAssignRoles;
    private HashSet<string> inviteOrganizationIds = new(StringComparer.OrdinalIgnoreCase);
    private bool canInvite => !string.IsNullOrWhiteSpace(selectedOrganizationId) && inviteOrganizationIds.Contains(selectedOrganizationId);
    private IEnumerable<TenantMember> FilteredMembers => string.IsNullOrWhiteSpace(memberSearch)
        ? members
        : members.Where(member => member.Name.Contains(memberSearch, StringComparison.OrdinalIgnoreCase) || member.Email.Contains(memberSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var rolesResponse = await HelpdeskApi.GetAsync("api/v1/tenant-admin/organizations");
        var usersResponse = await HelpdeskApi.GetAsync("api/v1/tenant-admin/organizations?permission=Tenant.Users.Manage");
        if (!rolesResponse.IsSuccessStatusCode && !usersResponse.IsSuccessStatusCode)
        {
            error = "Tenant memberships could not be loaded. Refresh the page and try again.";
            return;
        }

        var roleOrganizations = rolesResponse.IsSuccessStatusCode
            ? await rolesResponse.Content.ReadFromJsonAsync<List<TenantOrganization>>() ?? new()
            : new();
        var userOrganizations = usersResponse.IsSuccessStatusCode
            ? await usersResponse.Content.ReadFromJsonAsync<List<TenantOrganization>>() ?? new()
            : new();
        organizations = roleOrganizations.Concat(userOrganizations)
            .DistinctBy(organization => organization.Id, StringComparer.OrdinalIgnoreCase)
            .OrderBy(organization => organization.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        inviteOrganizationIds = roleOrganizations.Select(organization => organization.Id)
            .Intersect(userOrganizations.Select(organization => organization.Id), StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        organizationsLoaded = true;
        await ApplyOrganizationParameterAsync();
    }

    protected override Task OnParametersSetAsync()
    {
        if (!organizationsLoaded ||
            (hasAppliedOrganizationParameter && string.Equals(appliedOrganizationId, OrganizationId, StringComparison.OrdinalIgnoreCase)))
        {
            return Task.CompletedTask;
        }

        return ApplyOrganizationParameterAsync();
    }

    private async Task ApplyOrganizationParameterAsync()
    {
        error = null;
        hasAppliedOrganizationParameter = true;
        appliedOrganizationId = OrganizationId;
        if (!organizationSelection.ApplyRouteParameter(OrganizationId, organizations.Select(organization => organization.Id)))
        {
            members = new();
            availableRoles = new();
            canAssignRoles = false;
            error = "The requested organization is unavailable or you do not have permission to manage its members.";
            return;
        }

        invitation = null;
        if (!string.IsNullOrWhiteSpace(selectedOrganizationId) && !IsCanonical)
        {
            NavigationManager.NavigateTo($"/admin/organizations?section=members&organizationId={Uri.EscapeDataString(selectedOrganizationId)}", replace: true);
        }
        else if (!string.IsNullOrWhiteSpace(selectedOrganizationId))
        {
            await LoadMembers();
        }
    }

    private async Task SelectOrganization(string organizationId)
    {
        organizationSelection.Select(organizationId);
        invitation = null;
        await LoadMembers();
    }

    private async Task InviteAccount()
    {
        if (string.IsNullOrWhiteSpace(selectedOrganizationId) ||
            string.IsNullOrWhiteSpace(inviteName) ||
            string.IsNullOrWhiteSpace(inviteEmail))
        {
            error = "Enter a display name and email before creating the local account.";
            return;
        }

        inviting = true;
        error = null;
        invitation = null;
        try
        {
            var response = await HelpdeskApi.PostAsJsonAsync(
                organizationSelection.Path("users/"),
                new CreateTenantLocalAccountRequest(inviteName, inviteEmail));
            if (!response.IsSuccessStatusCode)
            {
                error = "The local account could not be created. Confirm that the email is not already in use and try again.";
                return;
            }

            invitation = await response.Content.ReadFromJsonAsync<TenantLocalAccountInvitation>();
            inviteName = string.Empty;
            inviteEmail = string.Empty;
            await LoadMembers();
        }
        finally
        {
            inviting = false;
        }
    }

    private async Task LoadMembers()
    {
        if (string.IsNullOrWhiteSpace(selectedOrganizationId))
        {
            return;
        }

        loading = true;
        error = null;
        try
        {
            var response = await HelpdeskApi.GetAsync(organizationSelection.Path("users/"));
            if (!response.IsSuccessStatusCode)
            {
                error = "Tenant members could not be loaded. Refresh the page and try again.";
                return;
            }

            members = await response.Content.ReadFromJsonAsync<List<TenantMember>>() ?? new();
            var rolesResponse = await HelpdeskApi.GetAsync(organizationSelection.Path("users/roles"));
            canAssignRoles = rolesResponse.IsSuccessStatusCode;
            if (canAssignRoles)
            {
                availableRoles = await rolesResponse.Content.ReadFromJsonAsync<List<TenantDelegableRole>>() ?? new();
            }
            else
            {
                availableRoles = new();
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenRoleDialogAsync(TenantMember member)
    {
        var organization = organizations.FirstOrDefault(candidate => string.Equals(candidate.Id, selectedOrganizationId, StringComparison.OrdinalIgnoreCase));
        if (organization is null || !canAssignRoles)
        {
            return;
        }
        var dialog = await DialogService.ShowAsync<TenantRoleAssignmentDialog>("Edit member roles", new DialogParameters
        {
            ["OrganizationId"] = organization.Id, ["OrganizationName"] = organization.Name,
            ["MemberId"] = member.UserId, ["MemberName"] = member.Name, ["MemberEmail"] = member.Email,
            ["Roles"] = availableRoles.Select(role => new TenantRoleAssignmentDialog.RoleOption(role.Key, role.Name)).ToArray(),
            ["AssignedRoleKeys"] = member.RoleKeys.ToArray()
        }, new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadMembers();
        }
    }

    private string RoleLabel(string key) => availableRoles.FirstOrDefault(role => string.Equals(role.Key, key, StringComparison.OrdinalIgnoreCase))?.Name ?? key;

    private sealed record TenantOrganization(string Id, string Name);
    private sealed record TenantMember(string UserId, string Name, string Email, IReadOnlyList<string> RoleKeys);
    private sealed record TenantDelegableRole(string Key, string Name);
    private sealed record CreateTenantLocalAccountRequest(string DisplayName, string Email);
    private sealed record TenantLocalAccountInvitation(string UserId, string Email, string ActivationToken);
}
