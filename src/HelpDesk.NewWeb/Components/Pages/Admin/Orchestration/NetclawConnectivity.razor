@page "/admin/automation/integration/netclaw"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@using System.Net.Http.Json
@using Helpdesk.Shared.DTOs.Orchestration

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Netclaw AI harness</PageTitle>
<NavigationLock ConfirmExternalNavigation="@isDirty" OnBeforeInternalNavigation="ConfirmInternalNavigationAsync" />

<div class="netclaw-page" data-testid="netclaw-settings-page">
<MudPaper Class="helpdesk-content-surface pa-4 netclaw-card" Outlined="true">
    <div class="netclaw-page-navigation">
        <MudButton Href="/admin/automation/integration" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Integration hub</MudButton>
    </div>

    @if (loading)
    {
        <div class="netclaw-loading" role="status" aria-live="polite" aria-label="Loading Netclaw settings">
            <MudProgressLinear Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="netclaw-muted-copy">Loading saved connection…</MudText>
        </div>
    }
    else if (settings is null)
    {
        <MudStack Spacing="2" AlignItems="AlignItems.Start">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Netclaw settings could not be loaded. Check the connection and try again.</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@loading">Try again</MudButton>
        </MudStack>
    }
    else
    {
            <article aria-labelledby="netclaw-title">
                <header class="netclaw-card-header">
                    <div class="netclaw-card-heading">
                        <MudText Typo="Typo.h5" HtmlTag="h1" id="netclaw-title">Netclaw AI harness</MudText>
                        <MudText Typo="Typo.body2" Class="netclaw-muted-copy">Connect the daemon used by the ticket AI Assistant.</MudText>
                    </div>
                    <MudChip T="string" Color="@ConnectionStatusColor" Variant="Variant.Outlined" data-testid="netclaw-connection-status" role="status" aria-live="polite">
                        @ConnectionStatusLabel
                    </MudChip>
                </header>

                @if (settings.ManagedByDeployment)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="netclaw-state-message">
                        This connection is managed by deployment configuration. Update its Netclaw values in the deployment environment.
                    </MudAlert>
                }

                @if (requiresSavedStateInspection)
                {
                    <section class="netclaw-state-review" aria-labelledby="netclaw-review-heading" data-testid="netclaw-saved-state-review">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="netclaw-pairing-status">
                            @pairingStatusMessage
                        </MudAlert>
                        <MudText Typo="Typo.h6" HtmlTag="h2" id="netclaw-review-heading">Review the saved connection</MudText>
                        <MudText Typo="Typo.body2" Class="netclaw-muted-copy">Check the current saved state before requesting another one-time code.</MudText>
                        <dl class="netclaw-review-details">
                            <div><dt>Netclaw address</dt><dd>@Display(DaemonAddress(settings))</dd></div>
                            <div><dt>Saved revision</dt><dd>@settings.Revision</dd></div>
                            <div><dt>Protected token</dt><dd>@(settings.HasDeviceToken ? "Configured" : "Not configured")</dd></div>
                            <div><dt>Authenticated check</dt><dd>@LastTestSummary</dd></div>
                        </dl>
                        @if (testResult is not null)
                        {
                            <div role="status" aria-live="polite" aria-atomic="true">
                                <MudAlert Severity="@(testResult.Success ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" data-testid="netclaw-test-status">@testResult.Message</MudAlert>
                            </div>
                        }
                        @if (savedStateReloaded)
                        {
                            <MudStack Row="true" Spacing="2" Class="netclaw-connection-actions">
                                @if (settings.HasDeviceToken)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(testing || pairing || saving)" OnClick="TestAsync" data-testid="test-netclaw-saved-state">
                                        @(testing ? "Testing…" : "Test saved connection")
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@(testing || pairing || saving || settings.ManagedByDeployment)" OnClick="ContinueAfterSavedStateReview" data-testid="continue-after-saved-state-review">Edit / Re-pair</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueAfterSavedStateReview" data-testid="continue-after-saved-state-review">Continue to pairing</MudButton>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshSavedStateAsync" Disabled="@(loading || pairing || saving || testing)" StartIcon="@Icons.Material.Filled.Refresh">Refresh saved profile</MudButton>
                        }
                    </section>
                }
                else if (pairingNeedsLegacyConfirmation)
                {
                    <section class="netclaw-legacy-confirmation" aria-labelledby="netclaw-legacy-confirmation-heading" role="group" data-testid="netclaw-legacy-confirmation">
                        @if (!string.IsNullOrWhiteSpace(pairingStatusMessage))
                        {
                            <div role="status" aria-live="polite" aria-atomic="true">
                                <MudAlert Severity="@pairingStatusSeverity" Variant="Variant.Outlined" Dense="true" data-testid="netclaw-pairing-status">@pairingStatusMessage</MudAlert>
                            </div>
                        }
                        <MudText Typo="Typo.body1" HtmlTag="h2" id="netclaw-legacy-confirmation-heading">
                            @LegacyConversationCountText before Netclaw provider tracking was added.
                        </MudText>
                        <MudText Typo="Typo.body2">Did those conversations use this same Netclaw server?</MudText>
                        <code class="netclaw-daemon-address">@Display(legacyDaemonAddress ?? DaemonAddress(legacyCanonicalEndpoint))</code>
                        <MudStack Row="true" Spacing="2" Class="netclaw-confirmation-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(pairing || saving || testing || confirmingLegacyOwnership || string.IsNullOrWhiteSpace(legacyOwnershipReviewToken))" OnClick="ContinuePairingAfterLegacyReviewAsync" data-testid="confirm-same-netclaw-server">
                                @(pairing ? "Connecting…" : "Yes — use this server and continue")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(pairing || saving || testing || confirmingLegacyOwnership)" OnClick="ReviewLegacySessionsSeparately" data-testid="review-legacy-sessions-separately">No — review them separately</MudButton>
                        </MudStack>
                    </section>
                }
                else if (ShowSavedConnection && !isEditingConnection)
                {
                    <section class="netclaw-connection-summary" aria-labelledby="netclaw-summary-heading" data-testid="netclaw-connected-summary">
                        <MudText Typo="Typo.h6" HtmlTag="h2" id="netclaw-summary-heading">@(IsConnected ? "Connected to Netclaw" : "Saved Netclaw connection needs attention")</MudText>
                        <code class="netclaw-daemon-address">@DaemonAddress(settings)</code>
                        @if (IsConnected)
                        {
                            <MudText Typo="Typo.body2" Class="netclaw-muted-copy">Authenticated SignalR verified @DisplayTimestamp(settings.LastTestedAtUtc, "recently").</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="netclaw-muted-copy">The authenticated SignalR check has not passed for this saved profile.</MudText>
                        }
                        <MudStack Row="true" Spacing="2" Class="netclaw-connection-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(testing || pairing || saving)" OnClick="TestAsync" data-testid="test-netclaw-connection">
                                @(testing ? "Testing…" : "Test connection")
                            </MudButton>
                            @if (!settings.ManagedByDeployment)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(testing || pairing || saving || confirmingLegacyOwnership)" OnClick="EditConnection" data-testid="edit-netclaw-connection">Edit / Re-pair</MudButton>
                            }
                        </MudStack>
                        @if (testResult is not null)
                        {
                            <div role="status" aria-live="polite" aria-atomic="true">
                                <MudAlert Severity="@(testResult.Success ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" data-testid="netclaw-test-status">@testResult.Message</MudAlert>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(pairingStatusMessage))
                        {
                            <div role="status" aria-live="polite" aria-atomic="true">
                                <MudAlert Severity="@pairingStatusSeverity" Variant="Variant.Outlined" data-testid="netclaw-pairing-status">@pairingStatusMessage</MudAlert>
                            </div>
                        }
                    </section>
                }
                else
                {
                    <form class="netclaw-pair-form" @onsubmit="PairAndSaveAsync" @onsubmit:preventDefault="true" data-testid="netclaw-pair-form">
                        <MudTextField @bind-Value="pairingAddress" @bind-Value:after="PairingAddressChanged" Label="Netclaw address" Placeholder="http://192.168.1.20:5199" HelperText="Paste the address printed by netclaw daemon pair." Required="true" Immediate="true" Disabled="@(settings.ManagedByDeployment || saving || pairing || confirmingLegacyOwnership)" data-testid="netclaw-daemon-address" />
                        <MudTextField @bind-Value="pairingCode" Label="Pairing code" Placeholder="XXXX-XXXX" InputType="InputType.Password" autocomplete="off" HelperText="Paste the one-time code from netclaw daemon pair." MaxLength="128" Immediate="true" Disabled="@(settings.ManagedByDeployment || pairing || saving || confirmingLegacyOwnership)" data-testid="netclaw-pairing-code" />
                        <div class="netclaw-primary-action">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@(!CanPairAndSave)" StartIcon="@Icons.Material.Filled.Link" data-testid="pair-and-connect-netclaw">
                                @(pairing ? "Connecting…" : "Pair & connect")
                            </MudButton>
                            @if (isEditingConnection)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@(pairing || saving || testing)" OnClick="CancelConnectionEdit">Cancel</MudButton>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(pairingStatusMessage))
                        {
                            <div role="status" aria-live="polite" aria-atomic="true">
                                <MudAlert Severity="@pairingStatusSeverity" Variant="Variant.Outlined" data-testid="netclaw-pairing-status">@pairingStatusMessage</MudAlert>
                            </div>
                        }
                        @if (!settings.RuntimeSupported && settings.Enabled)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@settings.RuntimeIssue</MudAlert>
                        }
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(legacyOwnershipStatusMessage))
                {
                    <div class="netclaw-state-message" role="status" aria-live="polite" aria-atomic="true">
                        <MudAlert Severity="@legacyOwnershipStatusSeverity" Variant="Variant.Outlined" data-testid="netclaw-legacy-ownership-status">@legacyOwnershipStatusMessage</MudAlert>
                    </div>
                }

                @if (showDetailedLegacyReview)
                {
                    <MudPaper Class="netclaw-history-panel pa-4" Outlined="true" id="netclaw-legacy-ownership" data-testid="netclaw-legacy-ownership">
                        <MudStack Spacing="2">
                            <div class="netclaw-history-heading">
                                <div>
                                    <MudText Typo="Typo.h6" HtmlTag="h2">Historical session ownership</MudText>
                                    <MudText Typo="Typo.body2" Class="netclaw-muted-copy">Select only conversations that used the same historical Netclaw provider.</MudText>
                                </div>
                                @if (!loadingLegacySessions && !legacySessionsUnavailable)
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@unboundLegacySessions.Count need review</MudChip>
                                }
                            </div>

                            @if (loadingLegacySessions)
                            {
                                <div role="status" aria-live="polite" aria-label="Checking historical session ownership">
                                    <MudProgressLinear Indeterminate="true" />
                                    <MudText Typo="Typo.caption" Class="netclaw-muted-copy">Checking older conversations…</MudText>
                                </div>
                            }
                            else if (legacySessionsUnavailable)
                            {
                                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Unbound sessions could not be loaded. Refresh before confirming ownership.</MudAlert>
                            }
                            else if (unboundLegacySessions.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">No unbound historical Netclaw sessions.</MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                    Existing chat transcripts and remote session identifiers are preserved. Provider ownership changes only for the sessions you select.
                                </MudAlert>
                                <MudTable Items="unboundLegacySessions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" data-testid="unbound-netclaw-sessions" Class="netclaw-legacy-table">
                                    <HeaderContent>
                                        <MudTh>Select</MudTh><MudTh>Conversation</MudTh><MudTh>Organization</MudTh><MudTh>Ticket</MudTh><MudTh>Type</MudTh><MudTh>Last activity</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Select">
                                            <input type="checkbox"
                                                   data-testid="legacy-session-select-@context.ConversationId"
                                                   class="netclaw-legacy-select"
                                                   aria-label="@($"Select conversation {context.ConversationId} for ticket {context.TicketId} historical ownership confirmation")"
                                                   checked="@selectedLegacySessionIds.Contains(context.ConversationId)"
                                                   disabled="@(confirmingLegacyOwnership || pairing || saving || testing)"
                                                   @onchange="args => SetLegacySessionSelection(context.ConversationId, args.Value is true)" />
                                        </MudTd>
                                        <MudTd DataLabel="Conversation">@context.ConversationId</MudTd>
                                        <MudTd DataLabel="Organization">@context.OrganizationId</MudTd>
                                        <MudTd DataLabel="Ticket">@context.TicketId</MudTd>
                                        <MudTd DataLabel="Type">@context.TicketType</MudTd>
                                        <MudTd DataLabel="Last activity">@DisplayTimestamp(context.LastActivityUtc, "Unknown")</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }

                            <MudText Typo="Typo.body2" Class="netclaw-muted-copy">These values describe the selected sessions' historical provider. They do not change the current profile or token.</MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="historicalInstance" @bind-Value:after="HistoricalProviderChanged" Label="Historical instance" Placeholder="dev" Disabled="@(confirmingLegacyOwnership || pairing || saving || testing)" data-testid="historical-netclaw-instance" />
                                </MudItem>
                                <MudItem xs="12" sm="8">
                                    <MudTextField @bind-Value="historicalEndpoint" @bind-Value:after="HistoricalProviderChanged" Label="Historical Netclaw session endpoint" Placeholder="https://old-netclaw.example/hub/session" Disabled="@(confirmingLegacyOwnership || pairing || saving || testing)" data-testid="historical-netclaw-endpoint" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudCheckBox @bind-Value="historicalAllowPrivateHttp" @bind-Value:after="HistoricalProviderChanged" Label="Allow private HTTP for this historical endpoint" Color="Color.Warning" Disabled="@(confirmingLegacyOwnership || pairing || saving || testing)" data-testid="historical-netclaw-private-http" />
                                    <MudCheckBox @bind-Value="historicalOwnershipAcknowledged" Label="I confirm the selected sessions used this historical endpoint and instance and should be assigned to that provider." Color="Color.Warning" Disabled="@(confirmingLegacyOwnership || pairing || saving || testing)" data-testid="historical-netclaw-owner-acknowledgement" />
                                </MudItem>
                            </MudGrid>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(!CanConfirmLegacyOwnership)" OnClick="ConfirmLegacySessionOwnersAsync" data-testid="confirm-netclaw-legacy-ownership">
                                @(confirmingLegacyOwnership ? "Confirming…" : $"Confirm ownership for {selectedLegacySessionIds.Count} selected")
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }

                <MudExpansionPanels Class="netclaw-advanced-settings" MultiExpansion="true">
                    <MudExpansionPanel Text="Advanced diagnostics" Expanded="@diagnosticsExpanded" ExpandedChanged="SetDiagnosticsExpanded">
                        <MudStack Spacing="2">
                            <dl class="netclaw-profile-grid" data-testid="netclaw-runtime-profile">
                                @foreach (var setting in ResolvedSettings)
                                {
                                    <div class="@(setting.Name == "Endpoint" ? "netclaw-profile-item netclaw-profile-item-wide" : "netclaw-profile-item")">
                                        <dt>@setting.Name</dt>
                                        <dd>@setting.Value</dd>
                                    </div>
                                }
                            </dl>
                            @if (testResult is not null && testResult.Probes.Count > 0)
                            {
                                <MudTable Items="testResult.Probes" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="netclaw-probe-table">
                                    <HeaderContent><MudTh>Probe</MudTh><MudTh>Success</MudTh><MudTh>HTTP</MudTh><MudTh>Message</MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Probe">@context.ProbeName</MudTd>
                                        <MudTd DataLabel="Success">@(context.Success ? "Yes" : "No")</MudTd>
                                        <MudTd DataLabel="HTTP">@context.StatusCode</MudTd>
                                        <MudTd DataLabel="Message">@context.Message</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@(loading || saving || testing || pairing || confirmingLegacyOwnership)" OnClick="RefreshAsync" StartIcon="@Icons.Material.Filled.Refresh">Refresh saved profile</MudButton>
                        </MudStack>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Manual token / recovery">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" Class="netclaw-muted-copy">Use this recovery path only when pairing is unavailable or you already manage a protected token.</MudText>
                            <MudSwitch @bind-Value="draft.Enabled" @bind-Value:after="MarkDirty" Color="Color.Primary" Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" Label="Enable native Netclaw chat" />
                            <MudTextField @bind-Value="draft.Endpoint" @bind-Value:after="MarkDirty" Label="Session endpoint" Placeholder="https://netclaw.example.com/hub/session" HelperText="The session endpoint used by manual configuration." Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" data-testid="netclaw-manual-endpoint" />
                            <MudTextField @bind-Value="draft.Instance" @bind-Value:after="MarkDirty" Label="Instance" HelperText="The native adapter currently uses the dev contract." Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" />
                            <MudCheckBox @bind-Value="draft.AllowPrivateHttp" @bind-Value:after="MarkDirty" Label="Allow private HTTP (manual configuration)" Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" />
                            <MudTextField @bind-Value="draft.DeviceToken" @bind-Value:after="MarkDirty" Label="Paired-device token" InputType="InputType.Password" HelperText="The API protects this token and never sends it back. Leave blank to keep the saved token." Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" />
                            @if (settings.HasDeviceToken && !settings.ManagedByDeployment)
                            {
                                <MudCheckBox @bind-Value="draft.ClearDeviceToken" @bind-Value:after="MarkDirty" Color="Color.Warning" Label="Clear the saved paired-device token" Disabled="@(saving || pairing || testing || confirmingLegacyOwnership)" />
                            }
                            <MudStack Row="true" Spacing="2" Class="netclaw-action-row">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(saving || testing || pairing || confirmingLegacyOwnership || settings.ManagedByDeployment)" OnClick="SaveAsync">@(saving ? "Saving…" : "Save settings")</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Session limits">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="draft.IdleMinutes" @bind-Value:after="MarkDirty" Label="Idle minutes" Min="1" Max="1440" Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" /></MudItem>
                            <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="draft.ConnectionCapacity" @bind-Value:after="MarkDirty" Label="Connection capacity" Min="1" Max="1000" Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" /></MudItem>
                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="turnTimeoutText" @bind-Value:after="MarkDirty" Label="Turn inactivity timeout" HelperText="hh:mm:ss" Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" /></MudItem>
                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="heartbeatText" @bind-Value:after="MarkDirty" Label="Activity heartbeat interval" HelperText="hh:mm:ss" Disabled="@(settings.ManagedByDeployment || saving || pairing || testing || confirmingLegacyOwnership)" /></MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </article>
    }
</MudPaper>
</div>

@code {
    private const string UnboundLegacySessionsPath = "/api/v1/admin/netclaw/legacy-sessions/unbound";
    private const string ConfirmLegacySessionOwnerPath = "/api/v1/admin/netclaw/legacy-sessions/confirm-owner";
    private const string PairAndSavePath = "/api/v1/admin/netclaw/pair-and-save";

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private HttpClient NetclawPairingApi => HttpClientFactory.CreateClient("NetclawPairingApi");
    private NetclawConnectivitySettingsDto? settings;
    private UpdateNetclawConnectivitySettingsDto draft = new();
    private NetclawConnectivityTestResultDto? testResult;
    private IReadOnlyList<NetclawUnboundLegacySessionDto> unboundLegacySessions = [];
    private readonly HashSet<Guid> selectedLegacySessionIds = [];
    private bool loading = true;
    private bool loadingLegacySessions;
    private bool legacySessionsUnavailable;
    private bool saving;
    private bool testing;
    private bool pairing;
    private bool confirmingLegacyOwnership;
    private bool isDirty;
    private bool isEditingConnection;
    private bool pairingNeedsLegacyConfirmation;
    private bool showDetailedLegacyReview;
    private bool requiresSavedStateInspection;
    private bool savedStateReloaded;
    private int? savedStateInspectionBaseRevision;
    private bool diagnosticsExpanded;
    private string? legacyOwnershipStatusMessage;
    private Severity legacyOwnershipStatusSeverity = Severity.Info;
    private long testGeneration;
    private string turnTimeoutText = "00:05:00";
    private string heartbeatText = "00:00:15";
    private string historicalInstance = string.Empty;
    private string historicalEndpoint = string.Empty;
    private string pairingCode = string.Empty;
    private string pairingAddress = string.Empty;
    private string? legacyCanonicalEndpoint;
    private string? legacyDaemonAddress;
    private string? legacyOwnershipReviewToken;
    private int legacyConversationCount;
    private string? pairingStatusMessage;
    private Severity pairingStatusSeverity = Severity.Info;
    private bool historicalAllowPrivateHttp;
    private bool historicalOwnershipAcknowledged;

    private bool IsConnected => settings is
    {
        Enabled: true,
        RuntimeSupported: true,
        HasDeviceToken: true,
        SecretUnavailable: false,
        LastTestSucceeded: true
    } && testResult?.Success != false;

    private bool ShowSavedConnection => settings is { Enabled: true, HasDeviceToken: true };

    private string ConnectionStatusLabel =>
        pairing || confirmingLegacyOwnership ? "Connecting…" :
        requiresSavedStateInspection ? "Needs attention" :
        IsConnected ? "Connected" :
        settings is { Enabled: true } or { HasDeviceToken: true } ? "Needs attention" :
        "Not connected";

    private Color ConnectionStatusColor => ConnectionStatusLabel switch
    {
        "Connected" => Color.Success,
        "Connecting…" => Color.Info,
        "Needs attention" => Color.Warning,
        _ => Color.Default
    };

    private string LegacyConversationCountText => legacyConversationCount == 1
        ? "1 previous AI Assistant conversation"
        : $"{legacyConversationCount} previous AI Assistant conversations";

    private string LastTestSummary => settings?.LastTestedAtUtc is null
        ? "Not verified"
        : $"{DisplayTimestamp(settings.LastTestedAtUtc, "Not verified")} ({(settings.LastTestSucceeded == true ? "passed" : "not passed")})";

    private bool CanConfirmLegacyOwnership =>
        !loadingLegacySessions &&
        !legacySessionsUnavailable &&
        !saving &&
        !testing &&
        !pairing &&
        !confirmingLegacyOwnership &&
        selectedLegacySessionIds.Count > 0 &&
        historicalOwnershipAcknowledged &&
        !string.IsNullOrWhiteSpace(historicalInstance) &&
        !string.IsNullOrWhiteSpace(historicalEndpoint);

    private bool CanPairAndSave =>
        settings is not null &&
        !settings.ManagedByDeployment &&
        !pairingNeedsLegacyConfirmation &&
        !requiresSavedStateInspection &&
        !string.IsNullOrWhiteSpace(pairingAddress) &&
        !string.IsNullOrWhiteSpace(pairingCode) &&
        !saving &&
        !testing &&
        !pairing &&
        !confirmingLegacyOwnership;

    private IReadOnlyList<SettingRow> ResolvedSettings => settings is null ? [] :
    [
        new("Source", settings.ManagedByDeployment ? "Deployment" : "Saved administrator profile"),
        new("Revision", settings.Revision.ToString()),
        new("Enabled", settings.Enabled ? "Yes" : "No"),
        new("Endpoint", Display(settings.Endpoint)),
        new("Paired token", settings.HasDeviceToken ? "Configured (protected)" : "Not configured"),
        new("Token state", settings.SecretState),
        new("Runtime", settings.RuntimeSupported ? "Available" : "Unavailable"),
        new("Last saved", DisplayTimestamp(settings.UpdatedAtUtc, "Not saved")),
        new("Last applied", DisplayTimestamp(settings.LastAppliedAtUtc, "Not applied")),
        new("Last tested", settings.LastTestedAtUtc is null ? "Not tested" : $"{DisplayTimestamp(settings.LastTestedAtUtc, "Not tested")} ({(settings.LastTestSucceeded == true ? "passed" : "failed")})")
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            settings = await HelpdeskApi.GetFromJsonAsync<NetclawConnectivitySettingsDto>("/api/v1/admin/netclaw");
            if (settings is not null) SyncDraft();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            Snackbar.Add("Netclaw settings could not be loaded.", Severity.Error);
        }
        finally { loading = false; }

        await LoadUnboundLegacySessionsAsync(clearSelection: true);
    }

    private async Task LoadUnboundLegacySessionsAsync(bool clearSelection = false)
    {
        legacyOwnershipStatusMessage = null;
        historicalOwnershipAcknowledged = false;
        loadingLegacySessions = true;
        legacySessionsUnavailable = false;
        try
        {
            unboundLegacySessions = await HelpdeskApi.GetFromJsonAsync<List<NetclawUnboundLegacySessionDto>>(UnboundLegacySessionsPath) ?? [];
            var currentIds = unboundLegacySessions.Select(session => session.ConversationId).ToHashSet();
            selectedLegacySessionIds.RemoveWhere(id => !currentIds.Contains(id));
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            unboundLegacySessions = [];
            selectedLegacySessionIds.Clear();
            legacySessionsUnavailable = true;
        }
        finally
        {
            loadingLegacySessions = false;
        }

        if (clearSelection) selectedLegacySessionIds.Clear();
    }

    private void SetLegacySessionSelection(Guid conversationId, bool selected)
    {
        if (confirmingLegacyOwnership || pairing) return;
        if (selected) selectedLegacySessionIds.Add(conversationId);
        else selectedLegacySessionIds.Remove(conversationId);
        historicalOwnershipAcknowledged = false;
    }

    private void HistoricalProviderChanged() => historicalOwnershipAcknowledged = false;

    private void SetDiagnosticsExpanded(bool expanded) => diagnosticsExpanded = expanded;

    private void SyncDraft()
    {
        if (settings is null) return;
        pairingAddress = DaemonAddress(settings) ?? string.Empty;
        draft = new UpdateNetclawConnectivitySettingsDto
        {
            ExpectedRevision = settings.Revision,
            Enabled = settings.Enabled,
            Instance = settings.Instance,
            Endpoint = settings.Endpoint,
            AllowPrivateHttp = settings.AllowPrivateHttp,
            IdleMinutes = settings.IdleMinutes,
            ConnectionCapacity = settings.ConnectionCapacity,
            TurnInactivityTimeout = settings.TurnInactivityTimeout,
            ActivityHeartbeatInterval = settings.ActivityHeartbeatInterval
        };
        turnTimeoutText = settings.TurnInactivityTimeout.ToString("c");
        heartbeatText = settings.ActivityHeartbeatInterval.ToString("c");
        pairingCode = string.Empty;
        isDirty = false;
    }

    private void PairingAddressChanged()
    {
        if (settings?.ManagedByDeployment == true) return;
        ++testGeneration;
        isDirty = true;
        testResult = null;
    }

    private void EditConnection()
    {
        if (settings is null || settings.ManagedByDeployment || pairing || testing || saving) return;
        isEditingConnection = true;
        pairingAddress = DaemonAddress(settings) ?? string.Empty;
        pairingCode = string.Empty;
        pairingStatusMessage = null;
        isDirty = false;
    }

    private void CancelConnectionEdit()
    {
        if (settings is null || pairing || testing || saving) return;
        isEditingConnection = false;
        pairingStatusMessage = null;
        SyncDraft();
    }

    private void ContinueAfterSavedStateReview()
    {
        if (settings is null || settings.ManagedByDeployment || !savedStateReloaded) return;
        CompleteSavedStateInspection();
        isEditingConnection = true;
        pairingAddress = DaemonAddress(settings) ?? string.Empty;
        pairingCode = string.Empty;
        pairingStatusMessage = null;
        isDirty = false;
    }

    private async Task RefreshSavedStateAsync()
    {
        if (loading || pairing || saving || testing) return;
        savedStateReloaded = await ReloadSavedProfileAfterPairAsync();
        if (savedStateReloaded)
        {
            if (HasNewerVerifiedSavedProfile())
            {
                CompleteSavedStateInspection();
                isEditingConnection = false;
                pairingStatusMessage = null;
            }
        }
        else
        {
            pairingStatusMessage = "The saved profile could not be reloaded. Refresh it before requesting another code.";
            pairingStatusSeverity = Severity.Warning;
        }
    }

    private Task ReviewLegacySessionsSeparately()
    {
        if (pairing || saving || testing || confirmingLegacyOwnership) return Task.CompletedTask;
        pairingNeedsLegacyConfirmation = false;
        legacyOwnershipReviewToken = null;
        showDetailedLegacyReview = true;
        legacyOwnershipStatusMessage = null;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (settings is null || settings.ManagedByDeployment || saving || testing || pairing || confirmingLegacyOwnership) return;
        ++testGeneration;
        testResult = null;
        if (!TimeSpan.TryParse(turnTimeoutText, out var turnTimeout) || !TimeSpan.TryParse(heartbeatText, out var heartbeat))
        {
            Snackbar.Add("Use valid hh:mm:ss timeout values.", Severity.Error);
            return;
        }
        draft.TurnInactivityTimeout = turnTimeout;
        draft.ActivityHeartbeatInterval = heartbeat;
        saving = true;
        try
        {
            using var response = await HelpdeskApi.PutAsJsonAsync("/api/v1/admin/netclaw", draft);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    var code = await ReadApiErrorCodeAsync(response);
                    if (code == "unbound_legacy_sessions")
                    {
                        await LoadUnboundLegacySessionsAsync();
                        Snackbar.Add("Unbound legacy sessions need explicit ownership confirmation before this profile can be saved. Review the historical ownership section below.", Severity.Error);
                    }
                    else if (code == "legacy_session_conflict")
                    {
                        await LoadUnboundLegacySessionsAsync(clearSelection: true);
                        Snackbar.Add("The legacy session list changed. Review it again and select the sessions to confirm.", Severity.Error);
                    }
                    else
                    {
                        Snackbar.Add(SaveConflictMessage(code), Severity.Error);
                    }
                }
                else
                {
                    Snackbar.Add("Netclaw settings could not be saved.", Severity.Error);
                }
                return;
            }
            settings = await response.Content.ReadFromJsonAsync<NetclawConnectivitySettingsDto>();
            if (settings is not null) SyncDraft();
            Snackbar.Add("Netclaw settings saved and applied to new chat connections.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Netclaw settings could not be saved.", Severity.Error);
        }
        finally { saving = false; }
    }

    private Task PairAndSaveAsync() => PairAndSaveCoreAsync(legacyReviewToken: null);

    private Task ContinuePairingAfterLegacyReviewAsync()
        => PairAndSaveCoreAsync(legacyOwnershipReviewToken);

    private async Task PairAndSaveCoreAsync(string? legacyReviewToken)
    {
        var continuingAfterReview = !string.IsNullOrWhiteSpace(legacyReviewToken);
        if (settings is null || settings.ManagedByDeployment || pairingAddress.Length == 0 || string.IsNullOrWhiteSpace(pairingCode) ||
            saving || testing || pairing || confirmingLegacyOwnership ||
            (pairingNeedsLegacyConfirmation != continuingAfterReview) ||
            (!continuingAfterReview && !CanPairAndSave))
            return;

        var profileRevisionBeforePairing = settings.Revision;

        if (!TimeSpan.TryParse(turnTimeoutText, out var turnTimeout) || turnTimeout <= TimeSpan.Zero ||
            !TimeSpan.TryParse(heartbeatText, out var heartbeat) || heartbeat <= TimeSpan.Zero ||
            draft.IdleMinutes is < 1 or > 1440 || draft.ConnectionCapacity is < 1 or > 1000)
        {
            pairingStatusMessage = "Review the session limits in Advanced settings. Enter valid positive timeout values, idle minutes from 1 to 1440, and connection capacity from 1 to 1000.";
            pairingStatusSeverity = Severity.Error;
            return;
        }

        pairing = true;
        pairingStatusMessage = null;
        ++testGeneration;
        testResult = null;
        try
        {
            using var response = await NetclawPairingApi.PostAsJsonAsync(PairAndSavePath, new PairNetclawDeviceDto
            {
                PairingCode = pairingCode.Trim(),
                ExpectedRevision = profileRevisionBeforePairing,
                Endpoint = pairingAddress.Trim(),
                LegacyOwnershipReviewToken = legacyReviewToken,
                IdleMinutes = draft.IdleMinutes,
                ConnectionCapacity = draft.ConnectionCapacity,
                TurnInactivityTimeout = turnTimeout,
                ActivityHeartbeatInterval = heartbeat
            });

            if (!response.IsSuccessStatusCode)
            {
                var error = await ReadPairingConflictAsync(response);
                var code = error?.Code;
                if (code is "legacy_ownership_confirmation_required" or "legacy_session_conflict")
                {
                    pairingStatusSeverity = Severity.Warning;
                    if (code == "legacy_session_conflict" && error is { LegacyConversationCount: <= 0 })
                    {
                        pairingNeedsLegacyConfirmation = false;
                        legacyCanonicalEndpoint = null;
                        legacyDaemonAddress = null;
                        legacyConversationCount = 0;
                        legacyOwnershipReviewToken = null;
                        pairingStatusMessage = "No older conversations remain unbound. Your pairing code was not used; Pair & connect to continue.";
                    }
                    else
                    {
                        pairingNeedsLegacyConfirmation = true;
                        legacyCanonicalEndpoint = error?.CanonicalEndpoint;
                        legacyDaemonAddress = error?.DaemonAddress;
                        legacyConversationCount = error?.LegacyConversationCount ?? 0;
                        legacyOwnershipReviewToken = error?.LegacyOwnershipReviewToken;
                        pairingStatusMessage = code == "legacy_session_conflict"
                            ? "The older-conversation list changed. Review the updated count; your pairing code was not used."
                            : null;
                    }
                    return;
                }

                var profileReloaded = true;
                var explicitRuntimePreflight = response.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable && code == "netclaw_runtime_unavailable";
                var ambiguousServerFailure = response.StatusCode == System.Net.HttpStatusCode.RequestTimeout ||
                    (int)response.StatusCode >= 500 && !explicitRuntimePreflight;
                var knownInspectionCode = code is "pairing_saved_runtime_conflict" or "pairing_saved_verification_failed" or "pairing_saved_verification_uncertain" or "pairing_verification_superseded" or
                    "pairing_code_consumed" or "pairing_outcome_uncertain" or "pairing_service_error" or "pairing_timeout" or "invalid_pairing_response";
                var codeRequiresInspection = ambiguousServerFailure || knownInspectionCode;
                if (codeRequiresInspection)
                {
                    pairingCode = string.Empty;
                    RequireSavedStateInspection(profileRevisionBeforePairing);
                    savedStateReloaded = await ReloadSavedProfileAfterPairAsync();
                    profileReloaded = savedStateReloaded;
                    if (profileReloaded && HasNewerVerifiedSavedProfile())
                    {
                        CompleteSavedStateInspection();
                        isEditingConnection = false;
                    }
                }
                else if (code is "pairing_code_rejected" or "pairing_code_not_found")
                {
                    pairingCode = string.Empty;
                }
                else if (code == "configuration_revision_conflict")
                {
                    profileReloaded = await ReloadSavedProfileAfterPairAsync();
                }

                pairingStatusMessage = codeRequiresInspection && !requiresSavedStateInspection
                    ? null
                    : profileReloaded
                        ? PairingErrorMessage(ambiguousServerFailure && !knownInspectionCode ? "pairing_service_error" : code)
                        : "Pairing outcome may have changed the saved profile, but RatelDesk could not reload it. Refresh the saved profile before another attempt.";
                pairingStatusSeverity = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                    ? Severity.Warning
                    : Severity.Error;
                if (!string.IsNullOrWhiteSpace(pairingStatusMessage))
                    Snackbar.Add(pairingStatusMessage, pairingStatusSeverity);
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<NetclawConnectivitySettingsDto>();
            if (saved is null || !saved.Enabled || !saved.RuntimeSupported || !saved.HasDeviceToken || saved.SecretUnavailable ||
                saved.LastTestSucceeded != true || saved.LastTestedAtUtc is null)
            {
                pairingCode = string.Empty;
                pairingStatusMessage = "Pairing may have saved a token, but authenticated SignalR verification was not confirmed. Review the saved connection and test it before requesting another code.";
                pairingStatusSeverity = Severity.Warning;
                RequireSavedStateInspection(profileRevisionBeforePairing);
                savedStateReloaded = await ReloadSavedProfileAfterPairAsync();
                if (savedStateReloaded && HasNewerVerifiedSavedProfile())
                {
                    CompleteSavedStateInspection();
                    isEditingConnection = false;
                    pairingStatusMessage = null;
                }
                return;
            }

            settings = saved;
            pairingCode = string.Empty;
            pairingNeedsLegacyConfirmation = false;
            legacyOwnershipReviewToken = null;
            requiresSavedStateInspection = false;
            savedStateReloaded = false;
            isEditingConnection = false;
            showDetailedLegacyReview = false;
            pairingStatusMessage = null;
            SyncDraft();
            Snackbar.Add("Connected to Netclaw. Authenticated SignalR was verified.", Severity.Success);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            pairingCode = string.Empty;
            pairingStatusMessage = "Pairing outcome is uncertain. Review and test the saved connection before requesting another code.";
            pairingStatusSeverity = Severity.Warning;
            RequireSavedStateInspection(profileRevisionBeforePairing);
            savedStateReloaded = await ReloadSavedProfileAfterPairAsync();
            if (savedStateReloaded && HasNewerVerifiedSavedProfile())
            {
                CompleteSavedStateInspection();
                isEditingConnection = false;
                pairingStatusMessage = null;
            }
            if (!string.IsNullOrWhiteSpace(pairingStatusMessage))
                Snackbar.Add(pairingStatusMessage, Severity.Warning);
        }
        finally { pairing = false; }
    }

    private async Task<bool> ReloadSavedProfileAfterPairAsync(bool syncDraft = false)
    {
        try
        {
            var current = await HelpdeskApi.GetFromJsonAsync<NetclawConnectivitySettingsDto>("/api/v1/admin/netclaw");
            if (current is not null)
            {
                settings = current;
                if (syncDraft) SyncDraft();
                return true;
            }
        }
        catch (HttpRequestException)
        {
            return false;
        }
        catch (System.Text.Json.JsonException)
        {
            return false;
        }

        return false;
    }

    private void RequireSavedStateInspection(int baseRevision)
    {
        requiresSavedStateInspection = true;
        savedStateInspectionBaseRevision = baseRevision;
    }

    private void CompleteSavedStateInspection()
    {
        requiresSavedStateInspection = false;
        savedStateInspectionBaseRevision = null;
    }

    private bool HasNewerVerifiedSavedProfile()
        => IsConnected && settings is not null && savedStateInspectionBaseRevision is int baseRevision && settings.Revision > baseRevision;

    private async Task RefreshAsync()
    {
        if (pairing || confirmingLegacyOwnership) return;
        if (isDirty && !await JS.InvokeAsync<bool>("confirm", "Discard unsaved Netclaw changes?")) return;
        ++testGeneration;
        await LoadAsync();
    }

    private void MarkDirty()
    {
        if (settings?.ManagedByDeployment == true) return;
        ++testGeneration;
        isDirty = true;
        testResult = null;
    }

    private async Task ConfirmInternalNavigationAsync(LocationChangingContext context)
    {
        if (!isDirty) return;
        if (saving || testing || pairing || confirmingLegacyOwnership || !await JS.InvokeAsync<bool>("confirm", "Discard unsaved Netclaw changes?"))
            context.PreventNavigation();
    }

    private async Task TestAsync()
    {
        if (settings is null || testing || saving || pairing || confirmingLegacyOwnership) return;
        var requestGeneration = testGeneration;
        testing = true;
        try
        {
            using var response = await HelpdeskApi.PostAsync("/api/v1/admin/netclaw/test", null);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var code = await ReadApiErrorCodeAsync(response);
                var message = code == "diagnostic_superseded"
                    ? "Netclaw settings changed while the test was running. Refresh and test the current saved profile."
                    : "Netclaw test conflicted with a newer configuration. Refresh before testing again.";
                if (requestGeneration == testGeneration)
                {
                    testResult = new() { Message = message };
                    Snackbar.Add(message, Severity.Warning);
                }
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<NetclawConnectivityTestResultDto>()
                         ?? new() { Message = "Unknown validation result." };
            if (requestGeneration == testGeneration)
            {
                testResult = result;
                var profileReloaded = await ReloadSavedProfileAfterPairAsync();
                if (requiresSavedStateInspection && result.Success && profileReloaded && IsConnected)
                {
                    CompleteSavedStateInspection();
                    isEditingConnection = false;
                    pairingStatusMessage = null;
                }
                Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            if (requestGeneration == testGeneration)
            {
                testResult = new() { Message = "The authenticated Netclaw validation request failed." };
                Snackbar.Add(testResult.Message, Severity.Error);
            }
        }
        finally { testing = false; }
    }

    private async Task ConfirmLegacySessionOwnersAsync()
    {
        if (!CanConfirmLegacyOwnership) return;
        var selectedIds = selectedLegacySessionIds.ToArray();
        confirmingLegacyOwnership = true;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync(ConfirmLegacySessionOwnerPath, new ConfirmNetclawLegacySessionsDto
            {
                HistoricalInstance = historicalInstance,
                HistoricalEndpoint = historicalEndpoint,
                AllowPrivateHttp = historicalAllowPrivateHttp,
                ExpectedEligibleConversations = selectedIds.Length,
                ConversationIds = selectedIds
            });

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var code = await ReadApiErrorCodeAsync(response);
                await LoadUnboundLegacySessionsAsync(clearSelection: true);
                var message = code == "legacy_session_conflict"
                    ? "The legacy session list changed. Review it again and select the sessions to confirm. Your Netclaw draft is unchanged."
                    : "Legacy session ownership could not be confirmed. Review the refreshed list and try again. Your Netclaw draft is unchanged.";
                legacyOwnershipStatusMessage = message;
                legacyOwnershipStatusSeverity = Severity.Warning;
                Snackbar.Add(message, Severity.Warning);
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var message = "Historical provider details were not accepted. Check the endpoint, instance, and private HTTP setting.";
                legacyOwnershipStatusMessage = message;
                legacyOwnershipStatusSeverity = Severity.Error;
                Snackbar.Add(message, Severity.Error);
                return;
            }

            await LoadUnboundLegacySessionsAsync(clearSelection: true);
            var successMessage = $"Ownership confirmed for {selectedIds.Length} selected legacy session(s). Existing chat transcripts were preserved; your Netclaw draft is unchanged.";
            legacyOwnershipStatusMessage = successMessage;
            legacyOwnershipStatusSeverity = Severity.Success;
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (HttpRequestException)
        {
            await LoadUnboundLegacySessionsAsync(clearSelection: true);
            var message = "Legacy session ownership could not be confirmed. The refreshed list shows which sessions remain unbound. Your Netclaw draft is unchanged.";
            legacyOwnershipStatusMessage = message;
            legacyOwnershipStatusSeverity = Severity.Error;
            Snackbar.Add(message, Severity.Error);
        }
        finally
        {
            confirmingLegacyOwnership = false;
        }
    }

    private static async Task<string?> ReadApiErrorCodeAsync(HttpResponseMessage response)
    {
        try
        {
            await using var stream = await response.Content.ReadAsStreamAsync();
            using var document = await System.Text.Json.JsonDocument.ParseAsync(stream);
            return document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object &&
                   document.RootElement.TryGetProperty("code", out var code) &&
                   code.ValueKind == System.Text.Json.JsonValueKind.String
                ? code.GetString()
                : null;
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            return null;
        }
    }

    private static async Task<NetclawLegacySessionReviewConflictDto?> ReadPairingConflictAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<NetclawLegacySessionReviewConflictDto>();
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            return null;
        }
    }

    private static string SaveConflictMessage(string? code) => code switch
    {
        "configuration_revision_conflict" => "Another administrator saved Netclaw settings. Keep a copy of your draft, then refresh before saving.",
        "runtime_revision_conflict" => "The Netclaw runtime has a newer profile revision. Refresh and compare the saved profile before retrying.",
        "configuration_conflict" => "Netclaw settings conflicted with another update. Refresh and try again.",
        _ => "Netclaw settings could not be saved because of a configuration conflict. Refresh and try again."
    };

    private static string PairingErrorMessage(string? code) => code switch
    {
        "invalid_pairing_code" => "Enter the one-time code from Netclaw.",
        "invalid_pairing_draft" => "Enter the Netclaw daemon address shown by \"netclaw daemon pair\".",
        "invalid_session_limits" => "Review the session limits in Advanced settings and enter values supported by Netclaw.",
        "netclaw_runtime_unavailable" => "The Netclaw runtime is not available on this server. No pairing code was used; contact your administrator before pairing.",
        "private_http_not_allowed" or "netclaw_private_http_not_allowed" => "This address is HTTP but is not a permitted private Netclaw address.",
        "configuration_revision_conflict" => "The saved Netclaw revision changed before pairing. Keep the draft, refresh, and request a code after reviewing the current profile.",
        "unbound_legacy_sessions" => "Unbound legacy sessions need explicit historical ownership confirmation before pairing. No code was sent to Netclaw.",
        "legacy_ownership_confirmation_required" => "Older conversations need provider confirmation before pairing. Review the same-server question below; your code was not used.",
        "legacy_session_conflict" => "The older-conversation list changed. Review it again; your pairing code was not used.",
        "pairing_code_rejected" => "Netclaw rejected the code. It may be expired or already used; generate a fresh code.",
        "pairing_code_not_found" => "Netclaw has no active code. Generate a fresh code and try again.",
        "pairing_rate_limited" => "Netclaw is rate limiting pairing. Wait before trying again.",
        "pairing_device_name_conflict" => "Netclaw rejected the generated device names. The current pairing code remains usable; retry the pairing action.",
        "pairing_timeout" => "Pairing timed out. Review and test the saved connection before requesting another code.",
        "invalid_pairing_response" => "Netclaw may have accepted the code, but its response could not be confirmed. Review the saved connection before requesting another code.",
        "pairing_saved_runtime_conflict" => "Pairing succeeded and was saved, but the runtime could not apply it. Review and test the saved connection before requesting another code.",
        "pairing_saved_verification_failed" => "Pairing succeeded and was saved, but authenticated SignalR verification failed. Test the saved connection before requesting another code.",
        "pairing_saved_verification_uncertain" => "Pairing may have been saved, but authenticated SignalR verification is uncertain. Review and test the saved connection before requesting another code.",
        "pairing_verification_superseded" => "The saved profile changed before authenticated SignalR verification completed. Review and test the current saved connection before requesting another code.",
        "pairing_code_consumed" => "Netclaw accepted the code, but RatelDesk could not confirm the saved connection. Review it before requesting another code.",
        "pairing_outcome_uncertain" => "Pairing outcome is uncertain. Review and test the saved connection before requesting another code.",
        "pairing_service_error" => "The pairing response is uncertain. Review and test the saved connection before requesting another code.",
        "pairing_not_available" => "Pairing is unavailable while Netclaw is managed by deployment configuration.",
        _ => "Netclaw could not complete pairing. Check the daemon address and current saved profile, then try again."
    };

    private static string? DaemonAddress(NetclawConnectivitySettingsDto? profile)
        => profile is null
            ? null
            : !string.IsNullOrWhiteSpace(profile.DaemonAddress)
                ? profile.DaemonAddress.Trim()
                : DaemonAddress(profile.Endpoint);

    private static string? DaemonAddress(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (!Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri) ||
            uri.Scheme is not ("http" or "https") ||
            !string.IsNullOrEmpty(uri.UserInfo))
            return null;
        return uri.GetLeftPart(UriPartial.Authority);
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "(not configured)" : value;
    private static string DisplayTimestamp(DateTimeOffset? value, string emptyText) => value?.ToLocalTime().ToString("g") ?? emptyText;
    private sealed record SettingRow(string Name, string Value);
}
