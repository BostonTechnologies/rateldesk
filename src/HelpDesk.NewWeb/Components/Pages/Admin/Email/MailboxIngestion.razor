@page "/admin/email-settings/{MailboxId:guid}/ingestion"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@using System.Net.Http.Json
@using Helpdesk.Shared.Models
@implements IDisposable
@inject IHttpClientFactory Clients
@inject ISnackbar Snackbar

<PageTitle>Inbound mailbox diagnostics</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h4" HtmlTag="h1">Inbound mailbox diagnostics</MudText>
    <MudButton Href="/admin/email-settings">Mailbox settings</MudButton>
    <MudButton OnClick="LoadAsync" Disabled="loading">Refresh</MudButton>
    <MudButton OnClick="SyncNowAsync" Disabled="@(loading || syncing || diagnostics?.EffectiveStatus is not { InstanceRunning: true, MailboxEnabled: true, IncomingEnabled: true })"
               Variant="Variant.Filled" Color="Color.Primary">@(syncing ? "Syncing…" : "Sync now")</MudButton>
    <MudText>Held messages remain on their source server. Retry applies current tenant routing and rule guards.</MudText>
    @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    @if (syncFeedback is not null) { <MudAlert Severity="@(syncFailed ? Severity.Warning : Severity.Info)" Variant="Variant.Outlined">@syncFeedback</MudAlert> }
    @if (loading) { <MudProgressLinear Indeterminate="true" /> }
    @if (diagnostics is not null)
    {
        @if (diagnostics.EffectiveStatus is { } effective)
        {
            <MudAlert Severity="@(effective.State == "Running" || effective.State == "Waiting for next poll" ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined">
                @effective.State@if (effective.BlockedBy is not null) { <span> — @effective.BlockedBy</span> }
            </MudAlert>
            <MudText>Baseline: @(effective.BaselineComplete ? "Complete" : "Not complete") · Captured: @effective.CapturedCount · Initial baseline skipped: @effective.SkippedInitialCount · Held: @effective.HeldCount</MudText>
        }
        <MudText>Last successful sync: @Format(diagnostics.State?.LastSyncUnixMilliseconds)</MudText>
        <MudText>Last successful saved-configuration test: @Format(diagnostics.State?.LastTestUnixMilliseconds) (version @diagnostics.State?.TestedVersion)</MudText>
        <MudText>Operational error: @(diagnostics.State?.ErrorCode ?? "None")</MudText>
        <MudText>Last Sync now: @Format(diagnostics.State?.LastSyncCommandUnixMilliseconds) · Result: @(diagnostics.State?.LastSyncCommandErrorCode ?? "No recorded error")</MudText>
        <MudTable Items="diagnostics.Receipts" Breakpoint="Breakpoint.Md" Class="ingress-receipts">
            <HeaderContent><MudTh>Received</MudTh><MudTh>Outcome</MudTh><MudTh>Reason</MudTh><MudTh>Organization</MudTh><MudTh>Ticket</MudTh><MudTh>Action</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Received">@Format(context.CreatedUnixMilliseconds)</MudTd>
                <MudTd DataLabel="Outcome">@context.Outcome</MudTd>
                <MudTd DataLabel="Reason">@context.Reason</MudTd>
                <MudTd DataLabel="Organization">@context.OrganizationId</MudTd>
                <MudTd DataLabel="Ticket">@context.TicketId</MudTd>
                <MudTd DataLabel="Action">
                    @if (context.Outcome is InboundReceiptOutcome.NeedsReview or InboundReceiptOutcome.RetryableFailure)
                    { <MudButton OnClick="() => RetryAsync(context.Id)" Disabled="loading">Retry</MudButton> }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>
@code {
    [Parameter] public Guid MailboxId { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private bool loading;
    private bool syncing;
    private bool syncFailed;
    private string? syncFeedback;
    private string? error;
    private MailboxDiagnosticsResponse? diagnostics;
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try { diagnostics = await Clients.CreateClient("HelpdeskApi").GetFromJsonAsync<MailboxDiagnosticsResponse>($"/api/v1/email-settings/{MailboxId}/diagnostics", cancellation.Token); }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return; }
        catch (HttpRequestException) { error = "Inbound diagnostics could not be loaded."; }
        finally { loading = false; }
    }
    private async Task RetryAsync(Guid id)
    {
        using var response = await Clients.CreateClient("HelpdeskApi").PostAsync($"/api/v1/email-settings/{MailboxId}/receipts/{id}/retry", null, cancellation.Token);
        Snackbar.Add(response.IsSuccessStatusCode ? "Receipt queued for guarded retry." : "Receipt is no longer eligible for retry.", response.IsSuccessStatusCode ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }
    private async Task SyncNowAsync()
    {
        syncing = true;
        syncFailed = false;
        syncFeedback = "Submitting sync request…";
        try
        {
            using var response = await Clients.CreateClient("HelpdeskApi")
                .PostAsync($"/api/v1/email-settings/{MailboxId}/sync", null, cancellation.Token);
            if (!response.IsSuccessStatusCode)
            {
                syncFeedback = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "Sync is unavailable because the instance or mailbox is paused. Refresh the status before retrying."
                    : "The sync request could not be queued.";
                syncFailed = true;
                await LoadAsync();
                return;
            }
            var command = await response.Content.ReadFromJsonAsync<MailboxSyncRequestResult>(cancellation.Token);
            if (command is null) { syncFeedback = "Sync response was incomplete."; syncFailed = true; return; }
            syncFeedback = "Sync queued for this mailbox.";
            var deadline = DateTimeOffset.UtcNow.AddSeconds(90);
            while (DateTimeOffset.UtcNow < deadline)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellation.Token);
                await LoadAsync();
                if (error is not null) continue;
                if (diagnostics?.State is not { } state || state.SyncCompletedVersion < command.RequestVersion) continue;
                syncFailed = diagnostics?.State?.LastSyncCommandErrorCode is not null;
                syncFeedback = syncFailed
                    ? $"Sync finished with {diagnostics!.State!.LastSyncCommandErrorCode}. Review the mailbox status and retry after correcting it."
                    : "Sync completed for this mailbox.";
                return;
            }
            syncFeedback = "Sync is still queued or running. Refresh to check its result.";
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (HttpRequestException)
        {
            syncFeedback = "The sync status could not be checked. Refresh to see whether it completed.";
            syncFailed = true;
        }
        finally { syncing = false; }
    }
    private static string Format(long? timestamp) => timestamp.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(timestamp.Value).ToLocalTime().ToString("g") : "Never";
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
