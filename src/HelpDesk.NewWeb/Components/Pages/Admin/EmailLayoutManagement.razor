@page "/admin/layouts"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using Helpdesk.Shared.Models

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Email Layout Management</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateLayout">New Layout</MudButton>
    </MudStack>

    @if (loadError is not null) { <MudAlert Severity="Severity.Error" role="alert">@loadError <MudButton OnClick="LoadLayouts">Retry</MudButton></MudAlert> }
    <MudTable Loading="loading" Items="_layouts" Hover="true" RowsPerPage="25" Class="compact-table" FixedHeader="true" FixedFooter="true" Dense="true" data-table-surface="pages-admin-emaillayoutmanagement-1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Scope</MudTh>
            <MudTh>Version</MudTh>
            <MudTh Style="text-align: right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Scope">@(context.IsSystem ? "System" : "Tenant")</MudTd>
            <MudTd DataLabel="Version">@context.Version</MudTd>
            <MudTd DataLabel="Actions"><div class="workspace-actions">
                <WorkspaceAction Icon="@Icons.Material.Filled.Edit" Label="Edit layout" OnClick="@(() => OpenEditDialog(context))" />
                <WorkspaceAction Icon="@Icons.Material.Filled.Preview" Label="Preview layout" OnClick="@(() => OpenPreviewDialog(context))" />
                <WorkspaceAction Icon="@Icons.Material.Filled.DeleteOutline" Label="Delete layout" Disabled="context.IsSystem" DisabledReason="System layouts are protected" OnClick="@(() => DeleteLayout(context))" />
            </div></MudTd>
        </RowTemplate>
<NoRecordsContent><MudText>@(loadError is null ? "No layouts." : "Layouts unavailable. Retry the query.")</MudText></NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private bool loading;
    private string? loadError;
    private List<EmailLayout> _layouts = new();
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    protected override async Task OnInitializedAsync()
    {
        await LoadLayouts();
    }

    private async Task LoadLayouts()
    {
        loading = true; loadError = null;
        try { _layouts = await HelpdeskApi.GetFromJsonAsync<List<EmailLayout>>("api/v1/email-layouts") ?? new(); }
        catch (Exception failure) when (failure is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        { loadError = "The layouts could not be loaded. Retry when the service is available."; }
        finally { loading = false; }
    }

    private async Task CreateLayout()
    {
        var parameters = new DialogParameters<EmailLayoutDialog> { { x => x.Model, new EmailLayout() } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<EmailLayoutDialog>("Create Layout", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
            await LoadLayouts();
    }

    private async Task OpenEditDialog(EmailLayout layout)
    {
        var parameters = new DialogParameters<EmailLayoutDialog> { { x => x.Model, layout } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<EmailLayoutDialog>("Edit Layout", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
            await LoadLayouts();
    }

    private async Task OpenPreviewDialog(EmailLayout layout)
    {
        var parameters = new DialogParameters<EmailTemplatePreviewDialog>
        {
            { x => x.RenderedHtml, layout.HtmlContent ?? string.Empty }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<EmailTemplatePreviewDialog>("Layout Html", parameters, options);
    }

    private async Task DeleteLayout(EmailLayout layout)
    {
        if (layout.IsSystem || await DialogService.ShowMessageBoxAsync("Delete layout?", $"Delete {layout.Name}?", yesText: "Delete", cancelText: "Cancel") != true) return;
        var response = await HelpdeskApi.DeleteAsync($"api/v1/email-layouts/{layout.Id}");
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Layout deleted.", Severity.Success);
            await LoadLayouts();
        }
        else
        {
            Snackbar.Add("Failed to delete layout.", Severity.Error);
        }
    }
}
