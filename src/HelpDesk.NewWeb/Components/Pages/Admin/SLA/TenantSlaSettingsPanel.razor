@inherits HelpDesk.NewWeb.Components.Shared.Admin.AdminActionPanelBase
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.Enums

<MudPaper Class="pa-2 mb-3" Elevation="0">
    <MudText Typo="Typo.subtitle2">Calendar association</MudText>
    @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    @if (model is null)
    {
        @if (error is null) { <MudProgressLinear Indeterminate="true" /> }
    }
    else
    {
        <fieldset disabled="@IsBusy" class="sla-editor-controls">
            <MudSwitch T="bool" @bind-Value="model.UseBusinessHours" @bind-Value:after="NotifyChanged" Label="Use business hours" />
            <MudSelect T="string" Label="Explicit calendar (optional)" @bind-Value="model.CalendarId" @bind-Value:after="NotifyChanged" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var calendar in FilteredCalendars)
                {
                    <MudSelectItem T="string" Value="@calendar.Id">@calendar.Name (@calendar.TimeZoneId)@(calendar.IsActive ? "" : " · inactive")</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption">@AssociationSummary</MudText>
            <MudStack Row="true" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!HasUnsavedChanges || IsBusy)" OnClick="@(() => RunActionAsync(SaveAsync))">Save settings</MudButton>
                <MudButton Disabled="@(!HasUnsavedChanges || IsBusy)" OnClick="Revert">Revert</MudButton>
            </MudStack>
        </fieldset>
    }
</MudPaper>

@code {
    [Parameter] public EventCallback DraftChanged { get; set; }
    private Task NotifyChanged() => DraftChanged.InvokeAsync();
    [Parameter] public string? TenantId { get; set; }
    [Parameter] public EventCallback<string?> TenantIdChanged { get; set; }
    [Parameter] public List<TenantLookupDto> Tenants { get; set; } = new();
    [Parameter] public List<WorkingCalendarDto> Calendars { get; set; } = new();
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private TenantSlaSettingsDto? model;
    private TenantSlaSettingsDto? lastSaved;
    private string? loadedTenantId;
    private string? error;
    private int loadVersion;
    public bool HasUnsavedChanges => model is not null && lastSaved is not null &&
        (model.UseBusinessHours != lastSaved.UseBusinessHours || model.CalendarId != lastSaved.CalendarId);
    private IEnumerable<WorkingCalendarDto> FilteredCalendars => Calendars
        .Where(x => x.ScopeType == CalendarScopeType.SystemDefault || string.Equals(x.TenantId, TenantId, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.ScopeType).ThenBy(x => x.Name);
    private string AssociationSummary => string.IsNullOrWhiteSpace(model?.CalendarId)
        ? "Inherited: the active tenant calendar, then the active system calendar."
        : FilteredCalendars.FirstOrDefault(x => x.Id == model.CalendarId)?.IsActive == true
            ? "Explicit calendar selection overrides the tenant and system defaults."
            : "The selected calendar is inactive or unavailable; the active tenant or system calendar is used.";

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTenantId == TenantId) return;
        loadedTenantId = TenantId;
        var tenant = TenantId;
        var version = ++loadVersion;
        model = lastSaved = null;
        error = null;
        if (string.IsNullOrWhiteSpace(tenant)) return;
        try
        {
            var result = await HelpdeskApi.GetFromJsonAsync<TenantSlaSettingsDto>($"api/v1/tenant-sla-settings/{Uri.EscapeDataString(tenant)}");
            if (IsDisposed || version != loadVersion || tenant != TenantId) return;
            model = result;
            lastSaved = Clone(model);
        }
        catch { if (!IsDisposed && version == loadVersion) error = "Calendar settings could not be loaded."; }
    }

    private async Task Revert() { model = Clone(lastSaved); await NotifyChanged(); }

    private async Task SaveAsync()
    {
        var tenant = TenantId;
        if (model is null || string.IsNullOrWhiteSpace(tenant) || model.TenantId != tenant || IsDisposed) return;
        var payload = Clone(model)!;
        try
        {
            using var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/tenant-sla-settings/{Uri.EscapeDataString(tenant)}", payload);
            if (IsDisposed || tenant != TenantId) return;
            if (!response.IsSuccessStatusCode) { error = "Calendar settings could not be saved. Your edits are retained."; return; }
            lastSaved = payload;
            await NotifyChanged();
            error = null;
            Snackbar.Add("Tenant SLA settings saved.", Severity.Success);
        }
        catch { if (!IsDisposed && tenant == TenantId) error = "Calendar settings could not be saved. Your edits are retained."; }
    }

    private static TenantSlaSettingsDto? Clone(TenantSlaSettingsDto? source) => source is null ? null : new()
    { TenantId = source.TenantId, UseBusinessHours = source.UseBusinessHours, CalendarId = source.CalendarId };
}
