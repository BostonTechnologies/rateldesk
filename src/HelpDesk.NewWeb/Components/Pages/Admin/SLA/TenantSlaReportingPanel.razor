@inherits HelpDesk.NewWeb.Components.Shared.Admin.AdminActionPanelBase
@inject IDialogService DialogService
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@using Helpdesk.Shared.DTOs.Customer
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Sla
@using Helpdesk.Shared.DTOs.SlaPolicy
@using Helpdesk.Shared.DTOs.User
@using Helpdesk.Shared.Enums


<MudPaper Class="pa-2" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.subtitle2">Report subscriptions</MudText>
        <MudSpacer />
        <MudButton OnClick="LoadAsync" Disabled="@(IsBusy || loading)" Variant="Variant.Outlined" Size="Size.Small">Refresh</MudButton>
        <MudButton OnClick="StartCreate" Disabled="@(IsBusy || showEditor || string.IsNullOrWhiteSpace(TenantId))" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Create subscription</MudButton>
    </MudStack>
    @if (error is not null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
    @if (loading) { <MudProgressLinear Indeterminate="true" /> }
    @if (showEditor)
    {
        <fieldset disabled="@IsBusy" class="sla-editor-controls">
        <MudText Typo="Typo.subtitle2">@(string.IsNullOrEmpty(draft.Id) ? "New subscription" : "Edit subscription")</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudSelect T="ReportFrequency" Label="Frequency" @bind-Value="draft.Frequency" Dense="true" Margin="Margin.Dense">
                    <MudSelectItem T="ReportFrequency" Value="ReportFrequency.Daily">Daily</MudSelectItem>
                    <MudSelectItem T="ReportFrequency" Value="ReportFrequency.Weekly">Weekly</MudSelectItem>
                    <MudSelectItem T="ReportFrequency" Value="ReportFrequency.Monthly">Monthly</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="DayOfWeek?" Label="Weekly Day" @bind-Value="draft.WeeklyDay" Dense="true" Margin="Margin.Dense" Disabled="draft.Frequency != ReportFrequency.Weekly">
                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                    {
                        <MudSelectItem T="DayOfWeek?" Value="@day">@day</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTimePicker Label="Send Time"
                               Time="draft.SendTimeLocal"
                               TimeChanged="OnDraftSendTimeChanged"
                               PickerVariant="PickerVariant.Dialog"
                               Dense="true"
                               Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="draft.TimeZoneId" Label="Timezone" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" @bind-Value="draft.LookbackDays" Label="Lookback Days" Min="1" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string"
                           Label="Recipients"
                           MultiSelection="true"
                           Dense="true"
                           Margin="Margin.Dense"
                           SelectedValues="@draftRecipientEmails"
                           SelectedValuesChanged="OnDraftRecipientsChanged">
                    @foreach (var recipient in GetRecipientOptions(TenantId, draftRecipientEmails))
                    {
                        <MudSelectItem T="string" Value="@recipient.Email">@recipient.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>


        <MudSwitch T="bool" @bind-Value="draft.IsActive" Label="Active" />
        <MudStack Row="true" Class="my-3">
            <MudButton OnClick="@(() => RunActionAsync(SaveDraftAsync))" Disabled="IsBusy" Color="Color.Primary" Variant="Variant.Filled">Save subscription</MudButton>
            <MudButton OnClick="CancelEdit" Disabled="IsBusy">Cancel</MudButton>
        </MudStack>
        </fieldset>
    }
    <div class="sla-table-wrap">
        <MudTable Items="FilteredSubscriptions" Dense="true" Hover="true" RowsPerPage="25" Breakpoint="Breakpoint.Sm" Class="sla-compact-table">
            <HeaderContent><MudTh>Schedule</MudTh><MudTh>Recipients</MudTh><MudTh>Lookback</MudTh><MudTh>Active</MudTh><MudTh>Actions</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Schedule">@context.Frequency @(context.Frequency == ReportFrequency.Weekly ? context.WeeklyDay?.ToString() : "") · @context.SendTimeLocal.ToString(@"hh\:mm")<MudText Typo="Typo.caption">@context.TimeZoneId</MudText></MudTd>
                <MudTd DataLabel="Recipients">@string.Join(", ", context.Targets.Select(x => x.Value))</MudTd>
                <MudTd DataLabel="Lookback">@context.LookbackDays days</MudTd>
                <MudTd DataLabel="Active">@(context.IsActive ? "Yes" : "No")</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Size="Size.Small" OnClick="() => StartEdit(context)" Disabled="@(IsBusy || showEditor)">Edit</MudButton>
                    <MudButton Size="Size.Small" OnClick="@(() => RunActionAsync(() => ToggleAsync(context)))" Disabled="@(IsBusy || showEditor)">@(context.IsActive ? "Disable" : "Enable")</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => RunActionAsync(() => DeleteAsync(context)))" Disabled="@(IsBusy || showEditor)">Delete</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-2">No report subscriptions for this tenant.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" /></PagerContent>
        </MudTable>
    </div>
</MudPaper>

@code {
    [Parameter] public EventCallback DraftChanged { get; set; }
    [Parameter] public string? TenantId { get; set; }
    [Parameter] public List<TenantLookupDto> Tenants { get; set; } = new();
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private List<SlaReportSubscriptionDto> subscriptions = new();
    private List<UserDto> users = new();
    private List<CustomerDto> customers = new();
    private HashSet<string> draftRecipientEmails = new(StringComparer.OrdinalIgnoreCase);
    private SlaReportSubscriptionDto draft = NewDraft();
    private bool showEditor;
    private bool loading;
    private string? error;
    private int loadVersion;
    public bool HasUnsavedChanges => showEditor;
    private IEnumerable<SlaReportSubscriptionDto> FilteredSubscriptions => subscriptions
        .Where(x => string.Equals(x.TenantId, TenantId, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.Frequency).ThenBy(x => x.SendTimeLocal);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await HelpdeskApi.GetFromJsonAsync<List<UserDto>>("api/v1/users") ?? new();
            customers = await HelpdeskApi.GetFromJsonAsync<List<CustomerDto>>("api/v1/customers") ?? new();
            if (!IsDisposed) await LoadAsync();
        }
        catch { error = "Report recipients could not be loaded. Reload to try again."; }
    }

    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        loading = true;
        try
        {
            var result = await HelpdeskApi.GetFromJsonAsync<List<SlaReportSubscriptionDto>>("api/v1/sla-report-subscriptions") ?? new();
            if (!IsDisposed && version == loadVersion) { subscriptions = result; error = null; }
        }
        catch { if (!IsDisposed && version == loadVersion) error = "Report subscriptions could not be loaded."; }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task StartCreate()
    {
        draft = NewDraft();
        draft.Id = string.Empty;
        draft.TenantId = TenantId ?? string.Empty;
        draftRecipientEmails.Clear();
        showEditor = true;
        error = null;
        await DraftChanged.InvokeAsync();
    }
    private async Task StartEdit(SlaReportSubscriptionDto subscription)
    {
        if (subscription.TenantId != TenantId || IsBusy || showEditor) return;
        draft = Clone(subscription);
        draftRecipientEmails = GetRecipientEmails(draft);
        showEditor = true;
        error = null;
        await DraftChanged.InvokeAsync();
    }
    private async Task CancelEdit() { showEditor = false; error = null; await DraftChanged.InvokeAsync(); }
    private void OnDraftSendTimeChanged(TimeSpan? value) { if (value.HasValue) draft.SendTimeLocal = value.Value; }
    private void OnDraftRecipientsChanged(IEnumerable<string>? values) => draftRecipientEmails = ToEmailSet(values);

    private async Task SaveDraftAsync()
    {
        var tenant = TenantId;
        if (IsDisposed || string.IsNullOrWhiteSpace(tenant) || draft.TenantId != tenant) return;
        var payload = Clone(draft);
        payload.Targets = payload.Targets.Where(x => x.Type != RecipientTargetType.Email).Concat(ToEmailTargets(draftRecipientEmails)).ToList();
        if (payload.Targets.Count == 0) { error = "At least one recipient is required."; return; }
        if (payload.LookbackDays < 1 || payload.SendTimeLocal < TimeSpan.Zero || payload.SendTimeLocal >= TimeSpan.FromDays(1))
        { error = "Choose a valid send time and a lookback of at least one day."; return; }
        try { TimeZoneInfo.FindSystemTimeZoneById(payload.TimeZoneId); }
        catch { error = "Enter a valid timezone identifier."; return; }
        try
        {
            using var response = string.IsNullOrEmpty(payload.Id)
                ? await HelpdeskApi.PostAsJsonAsync("api/v1/sla-report-subscriptions", payload)
                : await HelpdeskApi.PutAsJsonAsync($"api/v1/sla-report-subscriptions/{Uri.EscapeDataString(payload.Id)}", payload);
            if (IsDisposed || tenant != TenantId) return;
            if (!response.IsSuccessStatusCode) { error = "Subscription could not be saved. Your edits are retained."; return; }
            showEditor = false;
            await DraftChanged.InvokeAsync();
            Snackbar.Add("Subscription saved.", Severity.Success);
            await LoadAsync();
        }
        catch { if (!IsDisposed) error = "Subscription could not be saved. Your edits are retained."; }
    }

    private async Task ToggleAsync(SlaReportSubscriptionDto subscription)
    {
        if (IsDisposed || subscription.TenantId != TenantId) return;
        var payload = Clone(subscription);
        payload.IsActive = !payload.IsActive;
        try
        {
            using var response = await HelpdeskApi.PutAsJsonAsync($"api/v1/sla-report-subscriptions/{Uri.EscapeDataString(payload.Id)}", payload);
            if (!response.IsSuccessStatusCode) { error = "Subscription could not be updated."; return; }
            if (!IsDisposed) await LoadAsync();
        }
        catch { if (!IsDisposed) error = "Subscription could not be updated."; }
    }

    private async Task DeleteAsync(SlaReportSubscriptionDto subscription)
    {
        if (subscription.TenantId != TenantId || await DialogService.ShowMessageBoxAsync("Delete subscription?", "Delete this report schedule?", yesText: "Delete", cancelText: "Cancel") != true || IsDisposed) return;
        try
        {
            using var response = await HelpdeskApi.DeleteAsync($"api/v1/sla-report-subscriptions/{Uri.EscapeDataString(subscription.Id)}");
            if (!response.IsSuccessStatusCode) { error = "Subscription could not be deleted."; return; }
            if (!IsDisposed) await LoadAsync();
        }
        catch { if (!IsDisposed) error = "Subscription could not be deleted."; }
    }

    private static SlaReportSubscriptionDto Clone(SlaReportSubscriptionDto value) =>
        System.Text.Json.JsonSerializer.Deserialize<SlaReportSubscriptionDto>(System.Text.Json.JsonSerializer.Serialize(value))!;

    private IEnumerable<RecipientOption> GetRecipientOptions(string? tenantId, IEnumerable<string>? selectedEmails = null)
    {
        var selected = ToEmailSet(selectedEmails);
        if (string.IsNullOrWhiteSpace(tenantId))
        {
            return selected
                .OrderBy(x => x)
                .Select(x => new RecipientOption(x, x));
        }

        var options = users
            .Where(x => string.Equals(x.OrganizationId, tenantId, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(x.Email))
            .Select(x => new RecipientOption(x.Email.Trim(), FormatUser(x)))
            .Concat(customers
                .Where(x => x.IsEnabled && string.Equals(x.OrganizationId, tenantId, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(x.Email))
                .Select(x => new RecipientOption(x.Email.Trim(), FormatCustomer(x))))
            .GroupBy(x => x.Email, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .ToList();

        foreach (var email in selected)
        {
            if (!options.Any(x => string.Equals(x.Email, email, StringComparison.OrdinalIgnoreCase)))
            {
                options.Add(new RecipientOption(email, email));
            }
        }

        return options
            .OrderBy(x => x.Label)
            .ThenBy(x => x.Email);
    }

    private static HashSet<string> GetRecipientEmails(SlaReportSubscriptionDto dto)
    {
        return ToEmailSet(dto.Targets
            .Where(x => x.Type == RecipientTargetType.Email)
            .Select(x => x.Value));
    }

    private static HashSet<string> ToEmailSet(IEnumerable<string>? values)
    {
        return (values ?? Enumerable.Empty<string>())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private static List<RecipientTargetDto> ToEmailTargets(IEnumerable<string> emails)
    {
        return emails
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(x => new RecipientTargetDto { Type = RecipientTargetType.Email, Value = x.Trim() })
            .ToList();
    }

    private static string FormatUser(UserDto user)
    {
        return string.IsNullOrWhiteSpace(user.Name)
            ? user.Email
            : $"{user.Name} ({user.Email})";
    }

    private static string FormatCustomer(CustomerDto customer)
    {
        return string.IsNullOrWhiteSpace(customer.Name)
            ? customer.Email
            : $"{customer.Name} ({customer.Email})";
    }

    private static SlaReportSubscriptionDto NewDraft()
    {
        return new SlaReportSubscriptionDto
        {
            Frequency = ReportFrequency.Weekly,
            WeeklyDay = DayOfWeek.Monday,
            SendTimeLocal = TimeSpan.FromHours(8),
            TimeZoneId = "Africa/Johannesburg",
            IsActive = true,
            IncludeCsvAttachment = true,
            Targets = new List<RecipientTargetDto>()
        };
    }

    private sealed record RecipientOption(string Email, string Label);
}
