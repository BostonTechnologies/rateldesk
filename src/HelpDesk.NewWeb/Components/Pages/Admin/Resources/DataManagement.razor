@page "/admin/resources/data-management"
@attribute [Authorize(Roles = "HelpdeskAdmin,DataManagement.Admin")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Routing
@using System.Net.Http.Json
@using System.Text.Json.Nodes
@using BlazorMonaco.Editor
@using HelpDesk.NewWeb.Components.Dialogs.Settings
@using HelpDesk.NewWeb.Services
@using HelpDesk.NewWeb.Models.Resources
@using Helpdesk.Shared.Auth
@using Helpdesk.Shared.DTOs
@using Helpdesk.Shared.DTOs.Auth
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Resources
@using Helpdesk.Shared.Enums

@inject IHttpClientFactory HttpClientFactory
@inject IResourceDatasetService DatasetService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ILogger<DataManagement> Logger

<PageTitle>Data Management</PageTitle>

<NavigationLock ConfirmExternalNavigation="@(busy || HasUnsavedChanges)" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
<div class="data-management-page">
<MudContainer MaxWidth="MaxWidth.False" Class="py-3">

    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="data-management-header">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" HtmlTag="h1">Data Management</MudText>
                <MudText Typo="Typo.body2">Custom datasets and Microsoft Graph integrations, with explicit creation and import.</MudText>
            </MudStack>

        </MudStack>

        @if (busy || loading) { <MudProgressLinear Indeterminate="true" /> }
        @if (loadError is not null) { <MudAlert Severity="Severity.Error" role="alert">@loadError @if (!organizationLoaded) { <MudButton OnClick="@(() => RunActionAsync(LoadOrganizationAsync))" Disabled="@(busy || loading)">Retry loading</MudButton> }</MudAlert> }
        <div class="data-management-context">
            <OrganizationSearchPicker @key="organizationSelectorVersion" Module="data-management" Value="@selectedOrganizationId" SelectionChanged="OnOrganizationSelected" SelectedItemLoaded="OnOrganizationHydrated" Disabled="busy" />
        </div>
        <fieldset disabled="@(busy || loading || datasetLoading || !organizationLoaded)" class="data-editor-controls">
        @if (!string.IsNullOrWhiteSpace(selectedOrganizationId))
        {
            <section class="data-management-builtins" aria-labelledby="built-in-integrations-title">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="data-management-actions">
                    <div><MudText Typo="Typo.h6" HtmlTag="h2" id="built-in-integrations-title">Built-in integrations</MudText><MudText Typo="Typo.body2">Microsoft Graph · @(!organizationLoaded ? "Connection status unavailable" : graphSettings.HasStoredSecret ? "Connection configured" : "Connection not configured")</MudText></div>
                    <MudStack Row="true" Spacing="1" Class="data-management-source-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenGraphWizardAsync">@(graphSettings.HasStoredSecret ? "Manage connection" : "Set up Microsoft Graph")</MudButton>
                        @if (graphSettings.HasStoredSecret) { <MudButton Variant="Variant.Outlined" OnClick="OpenGraphWizardAsync">Import now</MudButton> }
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => RunActionAsync(OpenGraphSyncSettingsAsync))">Schedule</MudButton>
                        <MudButton OnClick="@(() => RunActionAsync(RefreshGraphAsync))">Refresh results</MudButton>
                        @if (graphImportStatus is not null) { <MudButton OnClick="OpenGraphResultsAsync">View import results</MudButton> }
                    </MudStack>
                </MudStack>
                <MudText Typo="Typo.body2" Class="mt-2">Last import: @(!organizationLoaded ? "Status unavailable" : graphSettings.LastSyncStatus ?? "Never imported"). @graphSettings.LastSyncMessage</MudText>
                @if (graphImportStatus is not null)
                {
                    <MudText Typo="Typo.caption" Class="d-block">Configuration @(graphImportStatus.ConfigurationSaved ? "saved" : "not confirmed saved") · Run @graphImportStatus.Status · @(graphImportStatus.CompletedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Completion pending")</MudText>
                    @foreach (var result in graphImportStatus.Sources) { <MudText Typo="Typo.caption" Class="d-block">@GraphSetupWizard.SourceName(result.SourceType): @result.Status · @(result.RowCount?.ToString() ?? "unknown") rows · @result.Message</MudText> }
                }
                <div class="data-management-source-catalog">
                    @foreach (var source in BuiltInSources)
                    {
                        var definition = datasets.FirstOrDefault(x => x.SourceType == source);
                        <MudPaper Outlined="true" Class="pa-3 graph-source-card" Elevation="0">
                            <MudText Typo="Typo.subtitle2">@GraphSetupWizard.SourceName(source)</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(!organizationLoaded ? "Unknown" : IsBuiltInEnabled(source) ? "Enabled" : "Disabled")</MudChip>
                            <MudText Typo="Typo.body2">@(!organizationLoaded ? loading ? "Loading source status…" : "Source status unavailable" : definition is null ? "Not imported" : datasetRowCounts.TryGetValue(definition.Id, out var count) ? $"{count} row(s)" : "Row count unavailable")</MudText>
                            <MudText Typo="Typo.caption" Class="d-block">Last import: @(organizationLoaded ? FormatSyncStamp(SourceSyncStamp(source)) : "Unknown")</MudText>
                            <MudButton Variant="Variant.Text" Disabled="@(definition is null)" OnClick="@(() => SelectDataset(definition!.Id))">View data</MudButton>
                        </MudPaper>
                    }
                </div>
                <MudExpansionPanels Elevation="0" Class="mt-2"><MudExpansionPanel Text="Advanced diagnostics">
                    <MudButton OnClick="OpenGraphSettingsEditorAsync">Edit connection without importing</MudButton>
                    <MudText Typo="Typo.body2">Recurring schedule: @(graphSettings.BackgroundSyncEnabled ? "Enabled" : "Disabled") · Cron (UTC): @graphSettings.BackgroundSyncCronExpression</MudText>
                    <MudText Typo="Typo.body2">Runtime: @(graphSettings.HangfireEnabled ? "Available" : "Unavailable") · Registered: @(graphSettings.BackgroundSyncRegistered ? "Yes" : "No")</MudText>
                    <MudText Typo="Typo.caption" Class="d-block">Job: @(graphSettings.BackgroundSyncJobId ?? "None") · Queue: @(graphSettings.BackgroundSyncQueueName ?? "None") · Storage: @graphSettings.HangfireStorageProvider</MudText>
                    <MudText Typo="Typo.caption" Class="d-block">Last scheduled run: @FormatSyncStamp(graphSettings.BackgroundSyncLastExecutionUtc) · Next run: @FormatSyncStamp(graphSettings.BackgroundSyncNextExecutionUtc)</MudText>
                    @if (!graphSettings.HangfireEnabled && graphSettings.BackgroundSyncEnabled) { <MudAlert Severity="Severity.Warning" Dense="true">The saved schedule will not run until the global runtime is available.</MudAlert> }
                    @if (isHelpdeskAdmin) { <MudButton Href="/ops/hangfire">Hangfire Ops</MudButton><MudButton Href="@HangfireDashboardUrl" Target="_blank">Hangfire Dashboard</MudButton> }
                </MudExpansionPanel></MudExpansionPanels>
            </section>
        }
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-2 data-management-rail" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                        <MudText Typo="Typo.h6" HtmlTag="h2">Custom datasets</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="PrepareNewDataset" Disabled="@string.IsNullOrWhiteSpace(selectedOrganizationId)">New dataset</MudButton>
                    </MudStack>
                    <MudTextField T="string" Value="@datasetSearch" ValueChanged="OnDatasetSearchChanged" Label="Search datasets" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />

                    <MudStack Spacing="2" Class="mt-2">

                        @if (!FilteredCustomDatasets.Any())
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary px-2">@(!organizationLoaded ? loading ? "Loading datasets…" : "Select an available organization or retry loading datasets." : CustomDatasets.Any() ? "No custom datasets match this search." : "No custom datasets yet. Create a dataset to define its schema.")</MudText>
                        }
                        else
                        {
                            <MudList T="string" Dense="true" Class="data-management-list">
                                @foreach (var dataset in FilteredCustomDatasets)
                                {
                                    <MudListItem T="string" OnClick="@(() => SelectDataset(dataset.Id))" Class="@GetDatasetListItemClass(dataset)">
                                        <MudStack Spacing="1" Class="py-1 dataset-list-item">
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.subtitle2">@dataset.Name</MudText>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Custom</MudChip>
                                                @if (!dataset.IsActive)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Disabled</MudChip>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption">@dataset.Columns.Count field(s) · @(datasetRowCounts.TryGetValue(dataset.Id, out var customCount) ? $"{customCount} row(s)" : "Rows not loaded")</MudText>
                                            @if (dataset.UpdatedAtUtc != default) { <MudText Typo="Typo.caption">Updated @dataset.UpdatedAtUtc.ToLocalTime().ToString("g")</MudText> }
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        }

                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="9">
                <MudPaper Class="pa-2 data-management-workspace" Elevation="0">
                    @if (string.IsNullOrWhiteSpace(selectedOrganizationId))
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Select an organization to manage datasets.</MudAlert>
                    }
                    else if (datasetLoading) { <MudText>Loading dataset…</MudText> }
                    else if (string.IsNullOrWhiteSpace(editor.Id))
                    {
                        <MudText Typo="Typo.h6">Choose a dataset</MudText>
                        <MudText Typo="Typo.body2">Browse a custom dataset from the list, create one explicitly, or choose View data for a built-in source. Setup does not start automatically.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@editor.Name</MudText>
                        <MudTabs MinimumTabWidth="128px" @bind-ActivePanelIndex="primaryTabIndex" KeepPanelsAlive="true" Rounded="false" Elevation="0" PanelClass="pt-2" Class="data-management-tabs compact-tabs">
                            <MudTabPanel Text="Rows">
                                @if (string.IsNullOrWhiteSpace(editor.Id))
                                {
                                    <MudText>Select a dataset or save a new schema to browse rows.</MudText>
                                }
                                else { @RowsBrowser() }
                            </MudTabPanel>
                            <MudTabPanel Text="Schema">

                                        @if (SelectedDatasetIsBuiltIn)
                                        {
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                                This managed schema is maintained by Microsoft Graph. Connection and import actions are in Built-in integrations.
                                            </MudAlert>
                                            <MudSimpleTable Dense="true" Class="mt-3 compact-content-table dataset-managed-schema" data-table-surface="pages-admin-resources-datamanagement-1"><thead><tr><th>Field</th><th>Type</th><th>Key</th><th>Display</th><th>Searchable</th></tr></thead><tbody>
                                                @foreach (var field in editor.Columns.OrderBy(x => x.SortOrder)) { <tr><td>@field.Name</td><td>@field.DataType</td><td>@(field.IsKey ? "Yes" : "No")</td><td>@(field.IsDisplay ? "Yes" : "No")</td><td>@(field.IsSearchable ? "Yes" : "No")</td></tr> }
                                            </tbody></MudSimpleTable>
                                        }
                                        else
                                        {
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="editor.Name" Label="Dataset Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                            </MudGrid>

                                            <DatasetSchemaDesigner Columns="editor.Columns" Errors="schemaErrors" Changed="OnEditorSchemaChanged" />
                                            <MudSwitch @bind-Value="editor.IsActive" Label="Active" Class="mt-3" />

                                            <MudStack Row="true" Spacing="2" Class="mt-4">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RunActionAsync(SaveDatasetAsync))">Save Dataset</MudButton>
                                                <MudButton OnClick="RevertDataset">Revert</MudButton>
                                                @if (!string.IsNullOrWhiteSpace(editor.Id))
                                                {
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => RunActionAsync(DeleteDatasetAsync))">Delete</MudButton>
                                                }
                                            </MudStack>
                                        }
                            </MudTabPanel>
                            @if (!SelectedDatasetIsBuiltIn)
                            {
                            <MudTabPanel Text="API access">

                                        @if (SelectedDatasetIsBuiltIn)
                                        {
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                                Built-in ingestion is managed by Built-in integrations. API keys are only available for custom datasets.
                                            </MudAlert>
                                        }
                                        else if (string.IsNullOrWhiteSpace(editor.Id))
                                        {
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Save the dataset before creating API keys.</MudAlert>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Filled" OnClick="OpenKeyDialogAsync">Create ingestion API key</MudButton>
                                            <MudList T="string" Dense="true">
                                                @foreach (var credential in credentials)
                                                {
                                                    <MudListItem T="string">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                                                            <MudStack Spacing="0">
                                                                <MudText Typo="Typo.subtitle2">@credential.Name</MudText>
                                                                <MudText Typo="Typo.caption">@(credential.IsActive ? "Active" : "Revoked") · Created @credential.CreatedAtUtc.ToLocalTime().ToString("g") · Last used @(credential.LastUsedAtUtc?.ToLocalTime().ToString("g") ?? "never")</MudText>
                                                            </MudStack>
                                                            @if (credential.IsActive)
                                                            {
                                                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RunActionAsync(() => RevokeCredentialAsync(credential.Id)))">Revoke</MudButton>
                                                            }
                                                        </MudStack>
                                                    </MudListItem>
                                                }
                                            </MudList>

                                            <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="Ingest script examples">
                                            <MudText Typo="Typo.subtitle2">Ingest Samples</MudText>
                                            <MudText Typo="Typo.body2" Class="mb-2">Samples update from the selected custom dataset columns.</MudText>

                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                                Examples use a placeholder. Create a named key only when needed and keep its one-time secret in your own secret store.
                                            </MudAlert>

                                            <MudStack Row="true" AlignItems="AlignItems.Center"><MudText Typo="Typo.caption">Bash / curl</MudText><MudButton OnClick="@(() => CopyExampleAsync(BashSample))">Copy curl example</MudButton></MudStack>
                                            @if (monacoAssetsReady && !usePlainTextFallback)
                                            {
                                                <StandaloneCodeEditor @key="BashSample"
                                                                      @ref="bashEditor"
                                                                      Id="@bashEditorId"
                                                                      CssClass="data-management-monaco"
                                                                      ConstructionOptions="@(_ => BuildCodeSampleOptions("shell", BashSample))" />
                                            }
                                            else if (usePlainTextFallback)
                                            {
                                                <MudTextField T="string"
                                                              Value="@BashSample"
                                                              ReadOnly="true"
                                                              Lines="14"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                            }
                                            else
                                            {
                                                <div class="data-management-monaco d-flex align-center justify-center">
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                </div>
                                            }

                                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3"><MudText Typo="Typo.caption">PowerShell</MudText><MudButton OnClick="@(() => CopyExampleAsync(PowerShellSample))">Copy PowerShell example</MudButton></MudStack><div role="status">@exampleCopyStatus</div>
                                            @if (monacoAssetsReady && !usePlainTextFallback)
                                            {
                                                <StandaloneCodeEditor @key="PowerShellSample"
                                                                      @ref="powershellEditor"
                                                                      Id="@powershellEditorId"
                                                                      CssClass="data-management-monaco"
                                                                      ConstructionOptions="@(_ => BuildCodeSampleOptions("powershell", PowerShellSample))" />
                                            }
                                            else if (usePlainTextFallback)
                                            {
                                                <MudTextField T="string"
                                                              Value="@PowerShellSample"
                                                              ReadOnly="true"
                                                              Lines="16"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                            }
                                            else
                                            {
                                                <div class="data-management-monaco d-flex align-center justify-center">
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                </div>
                                            }
                                            </MudExpansionPanel></MudExpansionPanels>
                                        }
                            </MudTabPanel>
                            }
                        </MudTabs>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
        </fieldset>
    </MudStack>
</MudContainer>
</div>



@code {
    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");

    private string selectedOrganizationName = "Current organization";
    private GraphDatasetImportStatusDto? graphImportStatus;
    private Dictionary<string, string> schemaErrors = [];
    private string? exampleCopyStatus;
    private static readonly DatasetSourceType[] BuiltInSources = [DatasetSourceType.GraphUsers, DatasetSourceType.GraphDevices, DatasetSourceType.GraphGroups, DatasetSourceType.GraphSharePointSites];
    private List<DatasetDefinitionDto> datasets = new();
    private PagedResult<DatasetRowDto> rows = new();
    private List<DatasetIngestCredentialDto> credentials = new();
    private readonly Dictionary<string, int> datasetRowCounts = new(StringComparer.OrdinalIgnoreCase);
    private CurrentUserAccessDto? access;
    private string? selectedOrganizationId;
    private string? selectedDatasetId;
    private string datasetSearch = string.Empty;
    private string rowSearch = string.Empty;
    private string? selectedRowPreviewId;
    private TenantGraphDatasetSettingsDto graphSettings = new();
    private DatasetEditorModel editor = DatasetEditorModel.New();
    private int primaryTabIndex;
    private bool busy;
    private bool loading;
    private bool datasetLoading;
    private bool rowsLoading;
    private bool organizationLoaded;
    private string? rowsError;
    private bool disposed;
    private string? loadError;
    private int organizationVersion;
    private int organizationSelectorVersion;
    private int datasetVersion;
    private int rowPage = 1;
    private CancellationTokenSource? rowSearchCancellation;
    private string editorSnapshot = "";
    private bool DatasetDirty => editorSnapshot.Length > 0 && Serialize(editor) != editorSnapshot;
    private bool HasUnsavedChanges => DatasetDirty;
    private static string Serialize<T>(T value) => System.Text.Json.JsonSerializer.Serialize(value);
    private void RevertDataset() { if (editorSnapshot.Length > 0) editor = System.Text.Json.JsonSerializer.Deserialize<DatasetEditorModel>(editorSnapshot)!; }
    private async Task<bool> CanLeaveAsync()
    {
        if (busy) return false;
        if (!DatasetDirty) return true;
        return await DialogService.ShowMessageBoxAsync("Discard dataset edits?", "Unsaved changes in this context will be lost.", yesText: "Discard", cancelText: "Keep editing") == true;
    }
    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!await CanLeaveAsync()) context.PreventNavigation();
    }
    private async Task RunActionAsync(Func<Task> action)
    {
        if (busy || disposed || loading || datasetLoading) return;
        busy = true;
        loadError = null;
        try { await action(); }
        catch { if (!disposed) loadError = "The operation failed. Your edits are retained; try again."; }
        finally { busy = false; }
    }

    private bool isHelpdeskAdmin;
    private readonly string bashEditorId = $"data-management-bash-sample-{Guid.NewGuid():N}";
    private readonly string powershellEditorId = $"data-management-powershell-sample-{Guid.NewGuid():N}";
    private StandaloneCodeEditor? bashEditor;
    private StandaloneCodeEditor? powershellEditor;
    private bool monacoAssetsReady;
    private bool usePlainTextFallback;
    private IJSObjectReference? monacoLoaderModule;

    private IEnumerable<DatasetDefinitionDto> CustomDatasets => datasets.Where(x => x.SourceType == DatasetSourceType.Custom);
    private IEnumerable<DatasetDefinitionDto> FilteredCustomDatasets => CustomDatasets.Where(MatchesDatasetSearch);
    private bool SelectedDatasetIsBuiltIn => editor.SourceType != DatasetSourceType.Custom;
    private string SelectedOrganizationName => selectedOrganizationName;
    private string IngestUrl => string.IsNullOrWhiteSpace(editor.Id)
        ? $"{Api.BaseAddress}api/v1/resources/datasets/{{datasetId}}/rows:upsert"
        : $"{Api.BaseAddress}api/v1/resources/datasets/{editor.Id}/rows:upsert";
    private string SampleApiKey => "<PASTE_DATASET_API_KEY>";
    private string BashSample => BuildBashSample();
    private string PowerShellSample => BuildPowerShellSample();
    private string HangfireDashboardUrl => "/hangfire";
    private IReadOnlyList<DatasetColumnDto> DisplayColumns => editor.Columns
        .OrderBy(x => x.SortOrder)
        .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
        .Where(x => !string.Equals(x.Name, editor.KeyColumn, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        access = await Api.GetFromJsonAsync<CurrentUserAccessDto>("api/v1/auth/me");
        isHelpdeskAdmin = access?.IsHelpdeskAdmin == true;
        selectedOrganizationId = access?.PrimaryOrganizationId;
        selectedOrganizationName = access?.PrimaryOrganizationName ?? "Current organization";
    }

    private async Task OnOrganizationHydrated(OrganizationDto? organization)
    {
        if (organization is null) return;
        if (organization.Id == selectedOrganizationId)
        {
            selectedOrganizationName = organization.Name;
            if (organizationVersion == 0) await LoadOrganizationAsync();
        }
    }

    private async Task OnOrganizationSelected(OrganizationDto? organization)
    {
        if (organization?.Id == selectedOrganizationId) return;
        if (!await CanLeaveAsync()) { organizationSelectorVersion++; return; }
        selectedOrganizationId = organization?.Id; selectedOrganizationName = organization?.Name ?? "Current organization";
        selectedDatasetId = null;
        await LoadOrganizationAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                monacoLoaderModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/helpdesk-monaco-loader.js");
                await monacoLoaderModule.InvokeVoidAsync("ensureBlazorMonaco");
                monacoAssetsReady = true;
            }
            catch (Exception ex)
            {
                usePlainTextFallback = true;
                Snackbar.Add("Code editor failed to load. Using plain sample viewers instead.", Severity.Warning);
                Logger.LogWarning("Data Management sample viewer assets could not be loaded ({ExceptionType}); using plain sample viewers.", ex.GetType().Name);
            }

            StateHasChanged();
        }
    }

    private Task OnDatasetSearchChanged(string value)
    {
        datasetSearch = value;
        return Task.CompletedTask;
    }

    private async Task OnRowSearchChanged(string value)
    {
        rowSearch = value;
        rowPage = 1;
        await LoadRowsAsync();
    }
    private async Task OnRowPageChanged(int page) { rowPage = page; await LoadRowsAsync(); }
    private async Task LoadRowsAsync()
    {
        rowSearchCancellation?.Cancel();
        rowSearchCancellation?.Dispose();
        using var cancellation = new CancellationTokenSource();
        rowSearchCancellation = cancellation;
        var datasetId = editor.Id;
        var version = datasetVersion;
        if (string.IsNullOrEmpty(datasetId)) return;
        rowsLoading = true; rowsError = null;
        try
        {
            await Task.Delay(200, cancellation.Token);
            var result = await DatasetService.GetRowsAsync(datasetId, rowSearch, rowPage, 50, cancellation.Token);
            if (disposed || cancellation.IsCancellationRequested || version != datasetVersion || datasetId != editor.Id) return;
            rows = result;
            if (string.IsNullOrWhiteSpace(rowSearch)) datasetRowCounts[datasetId] = rows.Total;
            selectedRowPreviewId = null;
        }
        catch (OperationCanceledException) { }
        catch { if (!disposed && version == datasetVersion) rowsError = "Rows could not be loaded. Your search is retained."; }
        finally { if (ReferenceEquals(rowSearchCancellation, cancellation)) { rowSearchCancellation = null; rowsLoading = false; } }
    }

    private async Task LoadOrganizationAsync()
    {
        var organization = selectedOrganizationId;
        var version = ++organizationVersion;
        datasetVersion++;
        rowSearchCancellation?.Cancel();
        loading = false; datasetLoading = false; rowsLoading = false; rowsError = null; organizationLoaded = false;
        datasets = new(); credentials = new(); rows = new();
        editor = DatasetEditorModel.New(organization); editorSnapshot = Serialize(editor); schemaErrors.Clear(); graphImportStatus = null;
        graphSettings = new() { OrganizationId = organization ?? string.Empty };
        if (string.IsNullOrWhiteSpace(organization)) return;
        loading = true;
        loadError = null;
        try
        {
            var definitions = await DatasetService.ListAsync(organization);
            var settings = await DatasetService.GetGraphSettingsAsync(organization) ?? new TenantGraphDatasetSettingsDto { OrganizationId = organization };
            if (disposed || version != organizationVersion || organization != selectedOrganizationId) return;
            datasets = definitions.ToList();
            graphSettings = settings;
            var importStatus = await DatasetService.GetGraphImportStatusAsync(organization);
            if (disposed || version != organizationVersion || organization != selectedOrganizationId) return;
            graphImportStatus = importStatus;
            organizationLoaded = true;
            await RefreshBuiltInRowCountsAsync();
            if (disposed || version != organizationVersion) return;
            var initial = datasets.FirstOrDefault(x => x.Id == selectedDatasetId) ?? CustomDatasets.FirstOrDefault();
            if (initial is not null) await SelectDataset(initial.Id, false);
            else { editor = DatasetEditorModel.New(organization); editorSnapshot = Serialize(editor); primaryTabIndex = 0; }
        }
        catch { if (!disposed && version == organizationVersion) loadError = "Datasets could not be loaded. Select the organization again or reload to retry."; }
        finally { if (version == organizationVersion) loading = false; }
    }

    private async Task PrepareNewDataset()
    {
        if (string.IsNullOrWhiteSpace(selectedOrganizationId) || busy || !await CanLeaveAsync()) return;
        if (DatasetDirty) RevertDataset();
        var organization = selectedOrganizationId;
        var dialog = await DialogService.ShowAsync<CreateDatasetWizard>("New custom dataset", new DialogParameters
        {
            [nameof(CreateDatasetWizard.OrganizationId)] = organization,
            [nameof(CreateDatasetWizard.OrganizationName)] = SelectedOrganizationName
        }, WizardOptions());
        var result = await dialog.Result;
        if (disposed || selectedOrganizationId != organization) return;
        if (result?.Data is DatasetDefinitionDto saved)
        {
            var version = organizationVersion;
            var selectionVersion = datasetVersion;
            datasets = datasets.Where(x => x.Id != saved.Id).Append(saved).ToList();
            try
            {
                var refreshed = await DatasetService.ListAsync(organization);
                if (disposed || version != organizationVersion || selectedOrganizationId != organization) return;
                datasets = refreshed.ToList();
            }
            catch
            {
                if (disposed || version != organizationVersion || selectedOrganizationId != organization) return;
                loadError = "The dataset was created, but the dataset list could not be refreshed. Reload this page to refresh the list.";
            }
            if (selectionVersion == datasetVersion) await SelectDataset(saved.Id, false);
        }
    }

    private static DialogOptions WizardOptions() => new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
    private async Task OpenKeyDialogAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(editor.Id) || SelectedDatasetIsBuiltIn) return;
        var dataset = editor.Id; var version = datasetVersion;
        var dialog = await DialogService.ShowAsync<DatasetIngestionKeyDialog>("Create ingestion API key", new DialogParameters
        {
            [nameof(DatasetIngestionKeyDialog.DatasetId)] = dataset,
            [nameof(DatasetIngestionKeyDialog.DatasetName)] = editor.Name,
            [nameof(DatasetIngestionKeyDialog.OrganizationName)] = SelectedOrganizationName
        }, new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        await dialog.Result;
        if (disposed || version != datasetVersion || dataset != editor.Id) return;
        try
        {
            var refreshed = await DatasetService.GetCredentialsAsync(dataset);
            if (!disposed && version == datasetVersion && dataset == editor.Id) credentials = refreshed.ToList();
        }
        catch
        {
            if (!disposed && version == datasetVersion && dataset == editor.Id) loadError = "API key metadata could not be refreshed. Reload this page to check key metadata before creating another key; a key may have been created.";
        }
    }
    private async Task OpenGraphWizardAsync()
        => await OpenGraphDialogAsync(false);
    private async Task OpenGraphSettingsEditorAsync()
        => await OpenGraphDialogAsync(true);
    private async Task OpenGraphResultsAsync()
        => await OpenGraphDialogAsync(false, true);
    private async Task OpenGraphDialogAsync(bool saveWithoutImport, bool viewResults = false)
    {
        if (busy || string.IsNullOrWhiteSpace(selectedOrganizationId)) return;
        var organization = selectedOrganizationId;
        var dialog = await DialogService.ShowAsync<GraphSetupWizard>("Microsoft Graph setup", new DialogParameters
        {
            [nameof(GraphSetupWizard.Settings)] = graphSettings,
            [nameof(GraphSetupWizard.OrganizationName)] = SelectedOrganizationName,
            [nameof(GraphSetupWizard.SaveWithoutImport)] = saveWithoutImport,
            [nameof(GraphSetupWizard.InitialImportStatus)] = graphImportStatus,
            [nameof(GraphSetupWizard.ViewResults)] = viewResults
        }, WizardOptions());
        await dialog.Result;
        if (!disposed && selectedOrganizationId == organization) await RunActionAsync(RefreshGraphAsync);
    }
    private async Task RefreshGraphAsync()
    {
        var organization = selectedOrganizationId; var version = organizationVersion;
        if (string.IsNullOrWhiteSpace(organization)) return;
        var settings = await DatasetService.GetGraphSettingsAsync(organization);
        var definitions = await DatasetService.ListAsync(organization);
        var status = await DatasetService.GetGraphImportStatusAsync(organization);
        if (disposed || organization != selectedOrganizationId || version != organizationVersion) return;
        graphSettings = settings ?? new() { OrganizationId = organization };
        graphImportStatus = status; datasets = definitions.ToList();
        await RefreshBuiltInRowCountsAsync();
    }
    private DateTimeOffset? SourceSyncStamp(DatasetSourceType type) => type switch
    {
        DatasetSourceType.GraphUsers => graphSettings.LastUsersSyncUtc,
        DatasetSourceType.GraphDevices => graphSettings.LastDevicesSyncUtc,
        DatasetSourceType.GraphGroups => graphSettings.LastGroupsSyncUtc,
        DatasetSourceType.GraphSharePointSites => graphSettings.LastSharePointSitesSyncUtc,
        _ => null
    };
    private void OnEditorSchemaChanged()
    {
        editor.KeyColumn = editor.Columns.FirstOrDefault(x => x.IsKey)?.Name ?? string.Empty;
        editor.DisplayColumn = editor.Columns.FirstOrDefault(x => x.IsDisplay)?.Name ?? string.Empty;
        if (schemaErrors.Count > 0) schemaErrors = DatasetSchemaDraft.ValidateColumns(editor.Columns);
    }
    private async Task CopyExampleAsync(string sample)
    {
        try { await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sample); exampleCopyStatus = "Example copied."; }
        catch (JSException) { exampleCopyStatus = "Clipboard unavailable. Select and copy the example manually."; }
    }

    private async Task SelectDataset(string datasetId, bool confirm = true)
    {
        if (confirm && (datasetId == selectedDatasetId || !await CanLeaveAsync())) return;
        var version = ++datasetVersion;
        var organization = selectedOrganizationId;
        selectedDatasetId = datasetId;
        datasetLoading = true;
        editor = DatasetEditorModel.New(organization); editorSnapshot = Serialize(editor); schemaErrors.Clear(); exampleCopyStatus = null;
        credentials = new(); rows = new();
        rowSearch = string.Empty; rowPage = 1;
        try
        {
            var dataset = await DatasetService.GetAsync(datasetId);
            if (dataset is null || disposed || version != datasetVersion || organization != selectedOrganizationId) return;
            var result = await DatasetService.GetRowsAsync(datasetId, null, 1, 50);
            var keys = dataset.SourceType == DatasetSourceType.Custom ? await DatasetService.GetCredentialsAsync(datasetId) : Array.Empty<DatasetIngestCredentialDto>();
            if (disposed || version != datasetVersion || organization != selectedOrganizationId) return;
            editor = DatasetEditorModel.FromDto(dataset);
            editorSnapshot = Serialize(editor);
            rows = result;
            datasetRowCounts[datasetId] = rows.Total;
            credentials = keys.ToList();
            selectedRowPreviewId = null;
            primaryTabIndex = 0;
        }
        catch { if (!disposed && version == datasetVersion) { loadError = "The dataset could not be loaded. Select it again to retry."; selectedDatasetId = null; } }
        finally { if (version == datasetVersion) datasetLoading = false; }
    }

    private async Task SaveDatasetAsync()
    {
        if (SelectedDatasetIsBuiltIn)
        {
            Snackbar.Add("Built-in datasets are managed from Built-in integrations.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedOrganizationId) || string.IsNullOrWhiteSpace(editor.Name))
        {
            Snackbar.Add("Organization and dataset name are required.", Severity.Error);
            return;
        }

        schemaErrors = DatasetSchemaDraft.ValidateColumns(editor.Columns);
        if (schemaErrors.Count > 0) { loadError = "Correct the highlighted schema fields before saving."; return; }
        OnEditorSchemaChanged();
        editor.SourceType = DatasetSourceType.Custom;

        if (string.IsNullOrWhiteSpace(editor.Id)) return;
        var saved = await DatasetService.UpdateAsync(editor.Id, new UpdateDatasetDefinitionDto
        {
            Name = editor.Name, SourceType = DatasetSourceType.Custom,
            KeyColumn = editor.KeyColumn, DisplayColumn = editor.DisplayColumn,
            SearchColumns = editor.Columns.Where(x => x.IsSearchable).Select(x => x.Name).ToList(),
            IsActive = editor.IsActive, Columns = editor.Columns
        });

        if (saved is null)
        {
            Snackbar.Add("Dataset save failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Dataset saved.", Severity.Success);
        if (disposed) return;
        datasets = (await DatasetService.ListAsync(selectedOrganizationId!)).ToList();
        await SelectDataset(saved.Id, false);
    }

    private async Task DeleteDatasetAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.Id) || SelectedDatasetIsBuiltIn)
        {
            return;
        }

        var total = (await DatasetService.GetRowsAsync(editor.Id, null, 1, 1)).Total;
        if (await DialogService.ShowMessageBoxAsync("Delete dataset?", $"Delete '{editor.Name}' and its {total} row(s) in {SelectedOrganizationName}? Ingest credentials will no longer work.", yesText: "Delete", cancelText: "Cancel") != true || disposed) return;

        if (await DatasetService.DeleteAsync(editor.Id))
        {
            Snackbar.Add("Dataset deleted.", Severity.Success);
            selectedDatasetId = null;
            await LoadOrganizationAsync();
        }
    }

    private async Task RevokeCredentialAsync(string credentialId)
    {
        if (string.IsNullOrWhiteSpace(editor.Id) || SelectedDatasetIsBuiltIn)
        {
            return;
        }

        if (await DialogService.ShowMessageBoxAsync("Revoke ingest key?", "Scripts using this key will no longer be able to ingest rows.", yesText: "Revoke", cancelText: "Cancel") != true || disposed) return;
        if (await DatasetService.RevokeCredentialAsync(editor.Id, credentialId))
        {
            credentials = (await DatasetService.GetCredentialsAsync(editor.Id)).ToList();
        }
    }

    private async Task SaveGraphSettingsAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedOrganizationId))
        {
            return;
        }

        graphSettings.OrganizationId = selectedOrganizationId;
        var saved = await DatasetService.SaveGraphSettingsAsync(graphSettings);
        if (saved is null) { loadError = "The save was not confirmed. Reload the actual saved connection before retrying; your edits are retained."; return; }
        if (saved is not null)
        {
            if (disposed) return;
            graphSettings = saved;
            Snackbar.Add("Graph settings saved.", Severity.Success);
            datasets = (await DatasetService.ListAsync(selectedOrganizationId!)).ToList();
            await RefreshBuiltInRowCountsAsync();
        }
    }

    private async Task OpenGraphSyncSettingsAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(GraphDatasetSyncSettingsDialog.Settings)] = graphSettings,
            [nameof(GraphDatasetSyncSettingsDialog.HangfireEnabled)] = graphSettings.HangfireEnabled,
            [nameof(GraphDatasetSyncSettingsDialog.RuntimeSource)] = graphSettings.HangfireRuntimeSource,
            [nameof(GraphDatasetSyncSettingsDialog.StorageProvider)] = graphSettings.HangfireStorageProvider
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<GraphDatasetSyncSettingsDialog>("Graph Sync Schedule", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not TenantGraphDatasetSettingsDto updated)
        {
            return;
        }

        if (disposed) return;
        graphSettings.BackgroundSyncEnabled = updated.BackgroundSyncEnabled;
        graphSettings.BackgroundSyncCronExpression = updated.BackgroundSyncCronExpression;
        await SaveGraphSettingsAsync();
    }

    private async Task RefreshBuiltInRowCountsAsync()
    {
        var version = organizationVersion;
        datasetRowCounts.Clear();
        foreach (var dataset in datasets.Where(x => x.SourceType != DatasetSourceType.Custom).ToList())
        {
            try
            {
                var result = await DatasetService.GetRowsAsync(dataset.Id, null, 1, 1);
                if (disposed || version != organizationVersion) return;
                datasetRowCounts[dataset.Id] = result.Total;
            }
            catch (HttpRequestException)
            {
                if (!disposed && version == organizationVersion) loadError = "Some built-in row counts are unavailable. Refresh results to retry.";
            }
        }
    }

    private bool MatchesDatasetSearch(DatasetDefinitionDto dataset) =>
        string.IsNullOrWhiteSpace(datasetSearch)
        || dataset.Name.Contains(datasetSearch, StringComparison.OrdinalIgnoreCase)
        || dataset.Slug.Contains(datasetSearch, StringComparison.OrdinalIgnoreCase)
        || FormatSourceType(dataset.SourceType).Contains(datasetSearch, StringComparison.OrdinalIgnoreCase);

