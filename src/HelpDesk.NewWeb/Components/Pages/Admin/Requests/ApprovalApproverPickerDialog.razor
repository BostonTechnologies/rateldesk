@using Helpdesk.Shared.DTOs.RequestForm

@inject IHttpClientFactory HttpClientFactory

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Select Approvers</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <CreationSearchPicker TItem="RequestTaskApprovalApproverModel" LookupUrl="@LookupUrl" Label="Add approver"
                                  Kind="approvers" Placeholder="Search users and customers" ClearAfterSelection="true"
                                  ItemId="row => row.Source + row.Id" ItemLabel="row => Format(row)" SelectionChanged="Add">
                <ItemTemplate Context="row">@Format(row)<small class="d-block">@row.OrganizationName · @row.Source</small></ItemTemplate>
            </CreationSearchPicker>

            <MudTable T="RequestTaskApprovalApproverModel" Items="selected" Dense="true" Hover="true" RowsPerPage="25"
                      Height="min(36dvh, 22rem)" Class="compact-table" FixedHeader="true" FixedFooter="true" data-table-surface="pages-admin-requests-approvalapproverpickerdialog-1">
                <HeaderContent><MudTh>Name</MudTh><MudTh>Email</MudTh><MudTh>Organization</MudTh><MudTh>Source</MudTh><MudTh>Remove</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd><MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Organization">@context.OrganizationName</MudTd><MudTd DataLabel="Source">@context.Source</MudTd>
                    <MudTd DataLabel="Remove"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" aria-label="@($"Remove {context.Name}")" OnClick="@(() => selected.Remove(context))" /></MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
                <NoRecordsContent><MudText Class="pa-2">No approvers selected.</MudText></NoRecordsContent>
            </MudTable>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Select</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? OrganizationId { get; set; }
    [Parameter] public List<RequestTaskApprovalApproverModel> SelectedApprovers { get; set; } = new();

    private string LookupUrl => "api/v1/request-task-approvers/search" + (string.IsNullOrWhiteSpace(OrganizationId)
        ? "" : $"?organizationId={Uri.EscapeDataString(OrganizationId)}");
    private static string Format(RequestTaskApprovalApproverModel row) => $"{row.Name} ({row.Email})";
    private List<RequestTaskApprovalApproverModel> selected = new();

    protected override void OnInitialized()
    {
        selected = SelectedApprovers
            .Where(x => !string.IsNullOrWhiteSpace(x.Email))
            .DistinctBy(x => x.Email, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void Add(RequestTaskApprovalApproverModel? row)
    {
        if (row is not null && !IsSelected(row)) selected.Add(row);
    }

    private bool IsSelected(RequestTaskApprovalApproverModel approver)
        => selected.Any(x => string.Equals(x.Email, approver.Email, StringComparison.OrdinalIgnoreCase));

    private void Save() => MudDialog.Close(DialogResult.Ok(selected));

    private void Cancel() => MudDialog.Cancel();
}
