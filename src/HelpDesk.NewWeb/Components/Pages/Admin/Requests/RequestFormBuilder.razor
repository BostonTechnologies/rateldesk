    {
        if (selectedTask is not null && !string.IsNullOrWhiteSpace(selectedTask.Description))
        {
            return selectedTask.Description;
        }

        return model.Description;
    }

    private static string GetOrchestrationRequestDefinitionLabel(OrchestrationCatalogRequestDefinitionDto definition)
    {
        var baseLabel = OrchestrationCatalogInputResolver.JoinTargetLabel(definition.FolderPath, GetOrchestrationDisplayName(definition));
        return string.IsNullOrWhiteSpace(definition.OrchestrationJobDefinitionName)
            ? baseLabel
            : $"{baseLabel} ({definition.OrchestrationJobDefinitionName})";
    }

    private static string GetOrchestrationInputLabel(OrchestrationCatalogInputDefinitionDto input)
        => string.IsNullOrWhiteSpace(input.Label) || string.Equals(input.Label, input.Key, StringComparison.OrdinalIgnoreCase)
            ? input.Key
            : $"{input.Label} ({input.Key})";

    private static string GetOrchestrationDisplayName(OrchestrationCatalogRequestDefinitionDto definition)
        => OrchestrationCatalogInputResolver.FirstReadableName(definition.DisplayName, definition.OrchestrationJobDefinitionName, definition.RequestDefinitionName) ?? "External orchestration target";

    private static string? FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private static string Truncate(string value, int maxLength)
        => string.IsNullOrWhiteSpace(value) || value.Length <= maxLength
            ? value
            : value[..maxLength];

    private static string? FirstReadableName(params string?[] values)
        => OrchestrationCatalogInputResolver.FirstReadableName(values) ?? FirstNonEmpty(values);

    private static bool LooksLikeOpaqueIdentifier(string value)
        => OrchestrationCatalogInputResolver.IsOpaqueIdentifier(value);

