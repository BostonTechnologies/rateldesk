        public string? OrchestrationJobDefinitionId { get; set; }
        public string? OrchestrationJobDefinitionName { get; set; }
        public AutomationBindingSyncState SyncState { get; set; } = AutomationBindingSyncState.InSync;
        public bool Enabled { get; set; } = true;

        public static AutomationBindingEditorModel FromDto(AutomationBindingDto dto) => new()
        {
            BindingId = dto.Id,
            OrchestrationRequestDefinitionId = dto.OrchestrationRequestDefinitionId,
            OrchestrationRequestDefinitionName = dto.OrchestrationRequestDefinitionName,
            OrchestrationJobDefinitionId = dto.OrchestrationJobDefinitionId,
            OrchestrationJobDefinitionName = dto.OrchestrationJobDefinitionName,
            SyncState = dto.SyncState,
            Enabled = dto.Enabled
        };

        public AutomationBindingEditorModel CloneForTask() => new()
        {
            OrchestrationRequestDefinitionId = OrchestrationRequestDefinitionId,
            OrchestrationRequestDefinitionName = OrchestrationRequestDefinitionName,
            OrchestrationJobDefinitionId = OrchestrationJobDefinitionId,
            OrchestrationJobDefinitionName = OrchestrationJobDefinitionName,
            SyncState = SyncState,
            Enabled = Enabled
        };

        public void ClearForDelete()
        {
            BindingId = null;
            OrchestrationRequestDefinitionId = null;
            OrchestrationRequestDefinitionName = null;
            OrchestrationJobDefinitionId = null;
            OrchestrationJobDefinitionName = null;
            SyncState = AutomationBindingSyncState.InSync;
            Enabled = true;
        }
    }

    private enum VisitState
    {
        Visiting = 1,
        Visited = 2
    }

    private static readonly JsonSerializerOptions JsonOptions = RequestFormTaskEditorState.CreateJsonOptions();

    private static readonly JsonSerializerOptions JsonOptionsIndented = RequestFormTaskEditorState.CreateJsonOptions(writeIndented: true);
}
