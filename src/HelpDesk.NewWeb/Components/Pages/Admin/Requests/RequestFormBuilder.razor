    private async Task OpenOrchestrationScriptLibraryDialogAsync()
    {
        if (SelectedBinding is null || orchestrationCatalogLoading || !CanCreateTenantScopedOrchestrationTarget)
        {
            return;
        }
        var originalBinding = SelectedBinding;
        var originalConnection = SelectedAutomationConnection!;

        var parameters = new DialogParameters
        {
            [nameof(OrchestrationScriptLibraryDialog.Definitions)] = FilteredOrchestrationRequestDefinitions.ToList(),
            [nameof(OrchestrationScriptLibraryDialog.Refresh)] = (Func<Task<IReadOnlyList<OrchestrationCatalogRequestDefinitionDto>>>)(async () =>
            {
                if (SelectedAutomationConnection?.ConnectionId != originalConnection.ConnectionId || model.OrganizationId != originalConnection.OrganizationId)
                    throw new InvalidOperationException("The selected connection changed. Reopen Browse jobs for the current connection.");
                await LoadOrchestrationCatalogAsync();
                if (!string.IsNullOrWhiteSpace(orchestrationCatalogError)) throw new InvalidOperationException(orchestrationCatalogError);
                if (SelectedAutomationConnection?.ConnectionId != originalConnection.ConnectionId ||
                    SelectedAutomationConnection.PeerTenantId != originalConnection.PeerTenantId || model.OrganizationId != originalConnection.OrganizationId)
                    throw new InvalidOperationException("The automation connection changed while refreshing. Reopen Browse jobs.");
                return FilteredOrchestrationRequestDefinitions;
            }),
            [nameof(OrchestrationScriptLibraryDialog.SelectedRequestDefinitionId)] = SelectedBinding.OrchestrationRequestDefinitionId,
            [nameof(OrchestrationScriptLibraryDialog.OrganizationDisplayName)] = SelectedOrganization?.Name,
            [nameof(OrchestrationScriptLibraryDialog.TenantMetadataUnavailable)] = OrchestrationCatalogTenantMetadataUnavailable
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<OrchestrationScriptLibraryDialog>("NetRatel jobs", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not OrchestrationCatalogRequestDefinitionDto selectedDefinition)
        {
            return;
        }
        var currentConnection = SelectedAutomationConnection;
        if (!ReferenceEquals(SelectedBinding, originalBinding) || currentConnection is null || currentConnection.ConnectionId != originalConnection.ConnectionId
            || currentConnection.PeerTenantId != originalConnection.PeerTenantId
            || !string.Equals(model.OrganizationId, originalConnection.OrganizationId, StringComparison.Ordinal))
        {
            Snackbar.Add("The task or automation connection changed while the library was open. Choose the target again.", Severity.Warning);
            return;
        }

        OnSelectedCatalogRequestDefinitionChanged(selectedDefinition.RequestDefinitionId);
    }

    private async Task OpenCreateOrchestrationTargetDialogAsync()
    {
        if (!CanCreateOrchestrationRequestDefinition || SelectedBinding is null)
        {
            if (!CanCreateTenantScopedOrchestrationTarget)
            {
                Snackbar.Add(OrchestrationTargetCreationReadinessMessage, Severity.Warning);
            }
            return;
        }
        var originalBinding = SelectedBinding;
        var originalConnection = SelectedAutomationConnection!;

        var parameters = new DialogParameters
        {
            [nameof(CreateOrchestrationAutomationTargetDialog.InitialJobName)] = GetDefaultOrchestrationTargetName(),
            [nameof(CreateOrchestrationAutomationTargetDialog.InitialFolderPath)] = DefaultOrchestrationTargetFolderPath,
            [nameof(CreateOrchestrationAutomationTargetDialog.InitialDescription)] = GetDefaultOrchestrationTargetDescription(),
            [nameof(CreateOrchestrationAutomationTargetDialog.TenantId)] = SelectedAutomationConnection!.PeerTenantId,
            [nameof(CreateOrchestrationAutomationTargetDialog.OrganizationId)] = model.OrganizationId,
            [nameof(CreateOrchestrationAutomationTargetDialog.SystemConnectionId)] = SelectedAutomationConnection.ConnectionId
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateOrchestrationAutomationTargetDialog>("Create NetRatel job", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not OrchestrationCatalogRequestDefinitionDto created)
        {
            return;
        }

        var currentConnection = SelectedAutomationConnection;
        if (!ReferenceEquals(SelectedBinding, originalBinding)
            || currentConnection is null || currentConnection.ConnectionId != originalConnection.ConnectionId
            || currentConnection.PeerTenantId != originalConnection.PeerTenantId
            || !string.Equals(model.OrganizationId, originalConnection.OrganizationId, StringComparison.Ordinal)
            || !CanCreateTenantScopedOrchestrationTarget || created.TenantId != originalConnection.PeerTenantId)
        {
            Snackbar.Add("The target was created for the original connection, but the current task or connection no longer matches. Refresh and review it before binding.", Severity.Warning);
            return;
        }

        await LoadOrchestrationCatalogAsync();
        if (!ReferenceEquals(SelectedBinding, originalBinding) || SelectedAutomationConnection?.ConnectionId != originalConnection.ConnectionId ||
            SelectedAutomationConnection.PeerTenantId != originalConnection.PeerTenantId || model.OrganizationId != originalConnection.OrganizationId || !FilteredOrchestrationRequestDefinitions.Any(item => item.RequestDefinitionId == created.RequestDefinitionId))
        {
            Snackbar.Add("The NetRatel job was created. Refresh this exact connection and review its catalogue before binding.", Severity.Warning);
            return;
        }

        SelectedBinding.SystemConnectionId = SelectedAutomationConnection.ConnectionId;
        SelectedBinding.OrchestrationRequestDefinitionId = created.RequestDefinitionId;
        SelectedBinding.OrchestrationRequestDefinitionName = created.RequestDefinitionName;
        SelectedBinding.OrchestrationJobDefinitionId = Normalize(created.OrchestrationJobDefinitionId);
        SelectedBinding.OrchestrationJobDefinitionName = Normalize(created.OrchestrationJobDefinitionName);
        SelectedBinding.Enabled = true;
        ApplySelectedRuntimeDefaults();
        ResetSelectedPayloadMappingJobParamDraft();
        ClearSelectedBindingDriftPreview();

        Snackbar.Add($"Created External orchestration automation target '{GetOrchestrationDisplayName(created)}'.", Severity.Success);
    }

