    private void OnSelectedCatalogRequestDefinitionChanged(string? value)
    {
        if (SelectedBinding is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            SelectedBinding.OrchestrationRequestDefinitionId = null;
            SelectedBinding.OrchestrationRequestDefinitionName = null;
            SelectedBinding.OrchestrationJobDefinitionId = null;
            SelectedBinding.OrchestrationJobDefinitionName = null;
            ResetSelectedPayloadMappingJobParamDraft();
            return;
        }

        var selectedDefinition = FilteredOrchestrationRequestDefinitions.FirstOrDefault(x =>
            string.Equals(x.RequestDefinitionId, value, StringComparison.OrdinalIgnoreCase));
        if (selectedDefinition is null || !CanCreateTenantScopedOrchestrationTarget)
        {
            Snackbar.Add("Select a target from the verified connection tenant.", Severity.Warning);
            return;
        }

        SelectedBinding.SystemConnectionId = SelectedAutomationConnection!.ConnectionId;
        SelectedBinding.OrchestrationRequestDefinitionId = selectedDefinition.RequestDefinitionId;
        SelectedBinding.OrchestrationRequestDefinitionName = selectedDefinition.RequestDefinitionName;
        SelectedBinding.OrchestrationJobDefinitionId = Normalize(selectedDefinition.OrchestrationJobDefinitionId);
        SelectedBinding.OrchestrationJobDefinitionName = Normalize(selectedDefinition.OrchestrationJobDefinitionName);
        ApplySelectedRuntimeDefaults();
        ResetSelectedPayloadMappingJobParamDraft();
        ClearSelectedBindingDriftPreview();
    }

