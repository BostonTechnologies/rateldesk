    private void ApplyRuntimeDefaultsToAutomationTasks()
    {
        foreach (var task in Tasks.Where(x => string.Equals(x.Type, "automation", StringComparison.OrdinalIgnoreCase)))
        {
            var binding = GetBindingModel(task, createIfMissing: false);
