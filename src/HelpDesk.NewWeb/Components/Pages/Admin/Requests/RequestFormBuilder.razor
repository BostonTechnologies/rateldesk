    private async Task SyncBindingsAsync(string requestFormId)
    {
        if (string.IsNullOrWhiteSpace(requestFormId))
        {
            return;
        }

        var currentBindings = await Api.GetFromJsonAsync<List<AutomationBindingDto>>(
            $"api/v1/admin/orchestration/bindings?requestFormId={Uri.EscapeDataString(requestFormId)}") ?? new();
        var bindingsByTask = currentBindings.ToDictionary(x => x.TaskTemplateId);
        var automationTaskIds = Tasks
            .Where(x => string.Equals(x.Type, "automation", StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Id)
            .ToHashSet();

        foreach (var task in Tasks)
        {
            var existingBinding = bindingsByTask.TryGetValue(task.Id, out var found) ? found : null;

            if (!string.Equals(task.Type, "automation", StringComparison.OrdinalIgnoreCase))
            {
                if (existingBinding is not null)
                {
                    await Api.DeleteAsync($"api/v1/admin/orchestration/bindings/{existingBinding.Id}");
                }

                automationBindings.Remove(task.Id);
                continue;
            }

            var editor = GetBindingModel(task);
            if (string.IsNullOrWhiteSpace(editor.OrchestrationRequestDefinitionId))
            {
                if (!string.IsNullOrWhiteSpace(editor.BindingId))
                {
                    await Api.DeleteAsync($"api/v1/admin/orchestration/bindings/{editor.BindingId}");
                }
                else if (existingBinding is not null)
                {
                    await Api.DeleteAsync($"api/v1/admin/orchestration/bindings/{existingBinding.Id}");
                }

                editor.ClearForDelete();
                continue;
            }

            if (string.IsNullOrWhiteSpace(editor.BindingId))
            {
                if (existingBinding is null)
                {
                    var createDto = new CreateAutomationBindingDto
                    {
                        SystemConnectionId = editor.SystemConnectionId,
                        RequestFormId = requestFormId,
                        TaskTemplateId = task.Id,
                        OrchestrationRequestDefinitionId = editor.OrchestrationRequestDefinitionId.Trim(),
                        OrchestrationRequestDefinitionName = Normalize(editor.OrchestrationRequestDefinitionName),
                        OrchestrationJobDefinitionId = Normalize(editor.OrchestrationJobDefinitionId),
                        OrchestrationJobDefinitionName = Normalize(editor.OrchestrationJobDefinitionName)
                    };

                    using var createResponse = await Api.PostAsJsonAsync("api/v1/admin/orchestration/bindings", createDto);
                    if (!createResponse.IsSuccessStatusCode)
                    {
                        throw new InvalidOperationException($"Creating the automation binding failed (HTTP {(int)createResponse.StatusCode}). Check the selected connection and automation target.");
                    }

                    var created = await createResponse.Content.ReadFromJsonAsync<AutomationBindingDto>();
                    if (created is not null)
                    {
                        // Retain the editor's requested Enabled/SyncState values so
                        // the update below also applies them to a newly created binding.
                        editor.BindingId = created.Id;
                        automationBindings[task.Id] = editor;
                    }
                }
                else
                {
                    editor.BindingId = existingBinding.Id;
                }
            }

            if (!string.IsNullOrWhiteSpace(editor.BindingId))
            {
                var updateDto = new UpdateAutomationBindingDto
                {
                    SystemConnectionId = editor.SystemConnectionId,
                    OrchestrationRequestDefinitionId = editor.OrchestrationRequestDefinitionId.Trim(),
                    OrchestrationRequestDefinitionName = Normalize(editor.OrchestrationRequestDefinitionName),
                    ClearOrchestrationRequestDefinitionName = string.IsNullOrWhiteSpace(editor.OrchestrationRequestDefinitionName),
                    OrchestrationJobDefinitionId = Normalize(editor.OrchestrationJobDefinitionId),
                    ClearOrchestrationJobDefinitionId = string.IsNullOrWhiteSpace(editor.OrchestrationJobDefinitionId),
                    OrchestrationJobDefinitionName = Normalize(editor.OrchestrationJobDefinitionName),
                    ClearOrchestrationJobDefinitionName = string.IsNullOrWhiteSpace(editor.OrchestrationJobDefinitionName),
                    SyncState = editor.SyncState,
                    Enabled = editor.Enabled
                };

                using var updateResponse = await Api.PutAsJsonAsync(
                    $"api/v1/admin/orchestration/bindings/{editor.BindingId}",
                    updateDto);
                if (!updateResponse.IsSuccessStatusCode)
                {
                    throw new InvalidOperationException($"Updating the automation binding failed (HTTP {(int)updateResponse.StatusCode}). Check the selected connection and automation target.");
                }

                var updated = await updateResponse.Content.ReadFromJsonAsync<AutomationBindingDto>();
                if (updated is not null)
                {
                    automationBindings[task.Id] = AutomationBindingEditorModel.FromDto(updated);
                }
            }
        }

        foreach (var staleBinding in currentBindings.Where(x => !automationTaskIds.Contains(x.TaskTemplateId)))
        {
            await Api.DeleteAsync($"api/v1/admin/orchestration/bindings/{staleBinding.Id}");
        }
    }

    private async Task<string?> TrySyncBindingSchemasAsync(string requestFormId)
    {
        if (string.IsNullOrWhiteSpace(requestFormId))
        {
            return null;
        }

        var bindings = await Api.GetFromJsonAsync<List<AutomationBindingDto>>(
            $"api/v1/admin/orchestration/bindings?requestFormId={Uri.EscapeDataString(requestFormId)}") ?? new();

        var failures = new List<string>();
        foreach (var binding in bindings.Where(x => x.Enabled))
        {
            try
            {
                using var response = await Api.PostAsync(
            $"api/v1/admin/orchestration/bindings/{binding.Id}/sync-inputs",
                    content: null);

                if (!response.IsSuccessStatusCode)
                {
                    failures.Add(await response.Content.ReadAsStringAsync());
                    continue;
                }

                var updated = await response.Content.ReadFromJsonAsync<AutomationBindingDto>();
                if (updated is not null)
                {
                    automationBindings[updated.TaskTemplateId] = AutomationBindingEditorModel.FromDto(updated);
                }
            }
            catch (Exception ex)
            {
                failures.Add(ex.Message);
            }
        }

        return failures.Count switch
        {
            0 => null,
            1 => $"Saved, but External orchestration input sync failed: {Truncate(failures[0], 180)}",
            _ => $"Saved, but {failures.Count} External orchestration input syncs failed. Refresh drift after External orchestration connectivity is healthy."
        };
    }

