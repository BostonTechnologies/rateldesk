@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Helpdesk.Shared.DTOs.Orchestration
@using Helpdesk.Shared.DTOs.RequestForm
@using Helpdesk.Shared.DTOs.Resources
@using Helpdesk.Shared.DTOs.User
@using Helpdesk.Shared.Models
@using Helpdesk.Shared.Pairing
@using HelpDesk.NewWeb.Services

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Class="request-form-builder-dialog">
    <TitleContent>
        <div class="request-form-builder-title">
            <MudText Typo="Typo.h6" Class="request-form-title-text" Title="@model.Title">@(string.IsNullOrWhiteSpace(model.Title) ? "New request form" : model.Title)</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(model.ReleaseStatus == RequestFormReleaseStatus.Production ? Color.Success : Color.Default)">@(model.ReleaseStatus == RequestFormReleaseStatus.Production ? "Production" : "In testing")</MudChip>
            <MudText Typo="Typo.caption" aria-live="polite">@(IsDirty ? "Unsaved changes" : "Request form")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Class="request-form-builder-form">
            <nav class="request-form-tabs" role="tablist" aria-label="Request form sections">
                @for (var index = 0; index < WorkspaceTabs.Length; index++)
                {
                    var tab = index;
                    <button type="button" id="@($"request-form-tab-{tab}")" role="tab" aria-selected="@((activeWorkspaceTab == tab).ToString().ToLowerInvariant())"
                            aria-controls="@($"request-form-panel-{tab}")" tabindex="@(activeWorkspaceTab == tab ? 0 : -1)" @ref="workspaceTabElements[tab]" @onkeydown="@((KeyboardEventArgs args) => OnWorkspaceTabKeyDown(args, tab))" class="@(activeWorkspaceTab == tab ? "request-form-tab request-form-tab-active" : "request-form-tab")"
                            @onclick="@(() => SetWorkspaceTab(tab))">@(tab == SetupTab ? "Form setup" : tab == FieldsTab ? $"Form fields ({FormFields.Count})" : $"Workflow ({Tasks.Count})")</button>
                }
            </nav>
            <section id="request-form-panel-0" role="tabpanel" aria-labelledby="request-form-tab-0" hidden="@(activeWorkspaceTab != SetupTab)" class="request-form-tab-content request-form-setup" data-testid="request-form-setup">
                <div class="request-form-setup-grid">
                    <section class="request-authoring-card"><div class="request-authoring-card-heading"><span>01</span><div><MudText Typo="Typo.subtitle1">Form details</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Give people a clear title and explain what they can request.</MudText></div></div>
                        <MudStack Spacing="2">
                            <MudTextField @ref="formTitleInput" @bind-Value="model.Title" Immediate="true"
                                          Label="Form Title"
                                          Required="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="model.Description"
                                          Label="Description"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3" />

                        </MudStack>
                    </section>
                    <section class="request-authoring-card"><div class="request-authoring-card-heading"><span>02</span><div><MudText Typo="Typo.subtitle1">Publication &amp; access</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Choose where this form is available.</MudText></div></div>
                        <MudStack Spacing="2">
                            <MudSelect T="RequestFormReleaseStatus"
                                       @bind-Value="model.ReleaseStatus"
                                       Label="Self-Service Release Status"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                <MudSelectItem T="RequestFormReleaseStatus" Value="@RequestFormReleaseStatus.InTesting">In Testing</MudSelectItem>
                                <MudSelectItem T="RequestFormReleaseStatus" Value="@RequestFormReleaseStatus.Production">Production</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="string"
                                       Value="model.OrganizationId"
                                       ValueChanged="OnOrganizationChanged"
                                       Label="Primary Organization"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       HelperText="Automation uses a saved system connection for this primary organization.">
                                @foreach (var organization in organizations.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem>
                                }
                            </MudSelect>

                            @if (SelectedOrganization is not null)
                            {
                                <MudText Typo="Typo.caption" Class="request-form-builder-subtitle">
                                    @AutomationConnectionChoices.Count saved automation connection(s) available. Configure connections on each automation task.
                                </MudText>
                            }


                        </MudStack>
                    </section>
                </div>
            </section>
            <section id="request-form-panel-1" role="tabpanel" aria-labelledby="request-form-tab-1" hidden="@(activeWorkspaceTab != FieldsTab)" class="request-form-tab-content" data-testid="request-form-fields">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1">Form fields</MudText>
                                <MudText Typo="Typo.body2" Class="request-form-builder-subtitle">
                                    Define the request payload captured from the form.
                                </MudText>
                            </MudStack>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddField">Add Field</MudButton>
                        </MudStack>

                        @if (!FormFields.Any())
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">No form fields yet. Add a field to start.</MudText>
                        }

                        <MudTable Items="FormFields" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Label</MudTh>
                                <MudTh>Type</MudTh>
                                <MudTh>Required</MudTh>
                                <MudTh>Data Binding</MudTh>
                                <MudTh>Predefined</MudTh>
                                <MudTh Style="width: 1%;"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Label">
                                    <MudTextField @ref="fieldLabelInputs[context]" @bind-Value="context.Label" Label="Field label" Required="true" Margin="Margin.Dense" Immediate="true" />
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" Label="Field type" Value="context.Type" ValueChanged="@((string value) => OnFieldTypeChanged(context, value))" Margin="Margin.Dense" Dense="true">
                                        @foreach (var t in FieldTypes)
                                        {
                                            <MudSelectItem Value="@t.Value">@t.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSwitch @bind-Value="context.Required" Color="Color.Primary" aria-label="Field required" />
                                </MudTd>
                                <MudTd>
                                    <MudStack Spacing="1">
                                        <MudSelect T="string"
                                                   Label="Dataset binding" Value="context.DataBinding?.DatasetId"
                                                   ValueChanged="@((string? value) => OnFieldDatasetChanged(context, value))"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Clearable="true"
                                                   Disabled="@(!IsHelpdeskDataField(context))">
                                            @foreach (var dataset in availableDatasets)
                                            {
                                                <MudSelectItem T="string" Value="@dataset.Id">@dataset.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                        @if (context.DataBinding is not null && IsHelpdeskDataField(context))
                                        {
                                            <MudTextField T="string"
                                                          Value="context.DataBinding.Placeholder"
                                                          ValueChanged="@((string? value) => OnFieldBindingPlaceholderChanged(context, value))"
                                                          Margin="Margin.Dense"
                                                          Dense="true"
                                                          Placeholder="Search placeholder" />
                                        }
                                    </MudStack>
                                </MudTd>
                                <MudTd>
                                    <MudTooltip Text="@GetPredefinedOptionsTooltip(context)">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="@(IsPredefinedField(context) ? Color.Primary : Color.Default)"
                                                       Disabled="@(!IsPredefinedField(context))"
                                                       OnClick="@(() => OpenPredefinedOptionsDialogAsync(context))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="Move field up" Disabled="@(FormFields.IndexOf(context) == 0)" OnClick="@(() => MoveField(context, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="Move field down" Disabled="@(FormFields.IndexOf(context) == FormFields.Count - 1)" OnClick="@(() => MoveField(context, 1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Delete field" OnClick="@(() => RemoveField(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>

            </section>
            <div id="request-form-panel-2" role="tabpanel" aria-labelledby="request-form-tab-2" hidden="@(activeWorkspaceTab != WorkflowTab)"
                 class="@(showMobileTaskEditor ? "request-form-workflow show-task-editor" : "request-form-workflow")" data-testid="request-workflow">
                <aside class="request-form-task-list-panel" aria-label="Ordered workflow tasks">
                    <div class="request-form-pane-toolbar">
                        <MudText Typo="Typo.subtitle2">Tasks</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddTask">Add task</MudButton>
                    </div>
                    <div class="request-form-task-list">
                        <MudDropContainer T="RequestTaskTemplateModel" @key="taskDropRenderVersion" @ref="taskDropContainer" Items="@Tasks"
                                          ItemsSelector="@((task, zone) => zone == TaskDropZoneId)" ItemDropped="OnTaskDropped"
                                          ApplyDropClassesOnDragStarted="true" Class="request-form-task-list-inner">
                            <ChildContent><MudDropZone T="RequestTaskTemplateModel" Identifier="@TaskDropZoneId" AllowReorder="true" Class="request-form-task-drop-zone" /></ChildContent>
                            <ItemRenderer Context="task">
                                <button type="button" @key="task.Id" data-task-id="@task.Id" aria-pressed="@((selectedTask?.Id == task.Id).ToString().ToLowerInvariant())"
                                        class="@(selectedTask?.Id == task.Id ? "request-form-task-item request-form-task-item-active" : "request-form-task-item")"
                                        @onclick="@(() => SelectTask(task.Id))">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="request-form-task-drag-handle" />
                                    <span class="request-form-task-label"><strong>@task.Order. @(string.IsNullOrWhiteSpace(task.Name) ? "Unnamed task" : task.Name)</strong><span>@task.Type</span></span>
                                    @if (invalidTaskId == task.Id) { <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" /> }
                                </button>
                            </ItemRenderer>
                        </MudDropContainer>
                        @if (!Tasks.Any()) { <MudText Typo="Typo.body2" Class="pa-3">No workflow tasks yet. Add a task to start.</MudText> }
                    </div>
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="ToggleWorkflowPreview" Disabled="@(!Tasks.Any())">@(_showWorkflowPreview ? "Hide preview" : "Preview workflow")</MudButton>
                </aside>
                <section class="request-form-task-config-panel" aria-label="Selected task editor" data-testid="selected-task-editor">
                    <div class="request-form-pane-toolbar">
                        <MudButton Class="request-form-back-to-tasks" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => showMobileTaskEditor = false)">Back to tasks</MudButton>
                        @if (selectedTask is not null)
                        {
                            <MudText Typo="Typo.subtitle2" Class="request-form-selected-title" Title="@selectedTask.Name">@selectedTask.Name</MudText>
                            <div class="request-form-task-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="Move task up" OnClick="MoveTaskUp" Disabled="@(!CanMoveSelectedTaskUp)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="Move task down" OnClick="MoveTaskDown" Disabled="@(!CanMoveSelectedTaskDown)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Duplicate task" OnClick="DuplicateSelectedTask" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Delete task" Color="Color.Error" OnClick="DeleteSelectedTask" />
                            </div>
                        }
                    </div>
                    <div class="request-form-task-editor-content" @key="selectedTask?.Id">
                        @if (selectedTask is null)
                        {
                            <MudText Typo="Typo.body2" Class="pa-4">Select or add a task to configure its workflow.</MudText>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(validationError) && invalidTaskId == selectedTask.Id)
                            { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" role="alert">@validationError</MudAlert> }
                            <MudStack Spacing="2" Class="request-task-settings">
                                    <section class="request-authoring-card request-task-basics">
                                        <div class="request-authoring-card-heading"><span>01</span><div><MudText Typo="Typo.subtitle1">Task details</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Name this step and choose how it starts.</MudText></div></div>

                                        <MudTextField @ref="taskNameInput" @bind-Value="selectedTask.Name" @bind-Value:after="@(() => RequestTaskDropContainerRefresh())" Immediate="true" Label="Task Name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />
                                        <MudTextField @bind-Value="selectedTask.Description" Label="Task Description" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />

                                        <MudGrid Spacing="1">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Value="selectedTask.Type" ValueChanged="OnSelectedTaskTypeChanged" Label="Task Type" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                    <MudSelectItem T="string" Value="@("manual")">Manual</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("automation")">Automation</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("approval")">Get Approval</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" Class="d-flex align-center">
                                                <MudSwitch @bind-Value="selectedTask.AutoStart" Color="Color.Primary" Label="Auto Start" Size="Size.Small" Class="mt-1" />
                                            </MudItem>
                                        </MudGrid>

                                    </section>
                                        @if (selectedTask.Type == "manual")
                                        {
                                            <MudDivider Class="my-2" />
                                            <MudText Typo="Typo.subtitle2">Manual Configuration</MudText>

                                            <MudSelect T="string" @bind-Value="selectedTask.DefaultAssigneeId" Label="Default Assignee" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                                                @foreach (var user in users)
                                                {
                                                    <MudSelectItem Value="@user.Id">@user.Name (@user.Email)</MudSelectItem>
                                                }
                                            </MudSelect>

                                            <MudTextField @bind-Value="selectedTask.TeamOrRole" Label="Team/Role (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />
                                        }
                                        else if (selectedTask.Type == "approval")
                                        {
                                            <MudDivider Class="my-2" />
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.subtitle2">Approval Configuration</MudText>
                                                <MudButton Variant="Variant.Outlined"
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.PersonSearch"
                                                           @ref="approvalBrowseButton" OnClick="OpenApprovalApproverDialogAsync">
                                                    Browse
                                                </MudButton>
                                            </MudStack>

                                            <MudSelect T="int?"
                                                       @bind-Value="selectedTask.ApprovalAllowedDays"
                                                       Label="Approval time allowed"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Dense="true">
                                                @foreach (var day in Enumerable.Range(1, 14))
                                                {
                                                    <MudSelectItem T="int?" Value="@day">@($"{day} day{(day == 1 ? string.Empty : "s")}")</MudSelectItem>
                                                }
                                            </MudSelect>

                                            @if (selectedTask.ApprovalApprovers.Count == 0)
                                            {
                                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                                    Select at least one approver.
                                                </MudAlert>
                                            }
                                            else
                                            {
                                                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                                    @foreach (var approver in selectedTask.ApprovalApprovers)
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Info"
                                                                 Variant="Variant.Outlined"
                                                                 OnClose="@(() => RemoveApprovalApprover(approver))">
                                                            @($"{approver.Name} ({approver.Email})")
                                                        </MudChip>
                                                    }
                                                </MudStack>
                                            }
                                        }

                                        <MudDivider Class="my-2" />


                                            @if (selectedTask.Type == "automation")
                                            {
                                                <div class="request-form-step-automation-panel" data-testid="task-automation" @onclick:stopPropagation="true">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="request-form-section-header">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                            <MudText Typo="Typo.subtitle1">Automation</MudText>
                                                            <MudTooltip Text="Automation targets must belong to the peer tenant on the selected saved system connection.">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                                               Size="Size.Small"
                                                                               Color="Color.Info"
                                                                               Class="request-form-info-icon" />
                                                            </MudTooltip>
                                                        </MudStack>

                                                        @if (selectedTask.Type == "automation")
                                                        {
                                                            <MudButton Variant="Variant.Outlined"
                                                                       Size="Size.Small"
                                                                       StartIcon="@Icons.Material.Filled.Add"
                                                                       Disabled="@(!CanCreateOrchestrationRequestDefinition)"
                                                                       OnClick="OpenCreateOrchestrationTargetDialogAsync">
                                                                Create job
                                                            </MudButton>
                                                        }
                                                    </MudStack>

                                                    @if (selectedTask.Type != "automation")
                                                    {
                                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                                            Switch this task to Automation to configure an External orchestration binding.
                                                        </MudAlert>
                                                    }
                                                    else
                                                    {
                                                        <MudSelect @ref="automationConnectionInput" T="Guid?" Value="@(SelectedBinding?.SystemConnectionId ?? SelectedAutomationConnection?.ConnectionId)"
                                                                   ValueChanged="OnAutomationConnectionChangedAsync" Label="Automation system connection"
                                                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                   HelperText="Choose the saved connection for this task and organization.">
                                                            @foreach (var connection in AutomationConnectionChoices)
                                                            {
                                                                <MudSelectItem T="Guid?" Value="@((Guid?)connection.ConnectionId)">@($"{connection.Name} · {connection.PeerName} · tenant {connection.PeerTenantId}")</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                        <MudButton Class="request-form-refresh-connections" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAutomationConnectionsAsync" Disabled="@orchestrationCatalogLoading">Refresh system connections</MudButton>
                                                        @if (!CanCreateTenantScopedOrchestrationTarget)
                                                        {
                                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                                                                @OrchestrationTargetCreationReadinessMessage
                                                            </MudAlert>
                                                        }

                                                        @if (SelectedBinding is not null && !string.IsNullOrWhiteSpace(SelectedBinding.BindingId))
                                                        {
                                                            <MudStack Row="true" Spacing="1" Class="request-form-chip-row">
                                                                <MudChip T="string" Size="Size.Small" Color="@GetBindingStateColor(SelectedBinding.SyncState)">
                                                                    @SelectedBinding.SyncState
                                                                </MudChip>
                                                                <MudChip T="string"
                                                                         Size="Size.Small"
                                                                         Color="@(SelectedBinding.Enabled ? Color.Success : Color.Default)">
                                                                    @(SelectedBinding.Enabled ? "Binding Enabled" : "Binding Disabled")
                                                                </MudChip>
                                                            </MudStack>
                                                        }

                                                        @if (orchestrationCatalogLoading)
                                                        {
                                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                                                                Loading External orchestration automation catalog...
                                                            </MudAlert>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(orchestrationCatalogError))
                                                        {
                                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                                                                External orchestration catalog could not be loaded. Existing bindings can still be reviewed, but new bindings will need valid External orchestration connectivity first.
                                                                <div>@orchestrationCatalogError</div>
                                                            </MudAlert>
                                                        }
                                                        else if (!FilteredOrchestrationRequestDefinitions.Any())
                                                        {
                                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                                                                No NetRatel jobs are available for this connection. Browse jobs to inspect or refresh the catalogue, or create a job.
                                                            </MudAlert>
                                                        }

                                                        @if (automationCapabilities is { } capabilities)
                                                        {
                                                            <MudText Typo="Typo.caption">@(capabilities.ContractVersion == 2
                                                                ? "Authenticated mapping · target-aware catalogue, authoring and aggregate invocation supported"
                                                                : capabilities.Message ?? "Authenticated mapping · older peer supports fixed-agent jobs; upgrade NetRatel for modern targets")</MudText>
                                                        }
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="request-form-script-picker">
                                                            <MudTextField T="string"
                                                                          Value="@SelectedOrchestrationTargetLabel"
                                                                          Label="NetRatel job"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          Dense="true"
                                                                          ReadOnly="true"
                                                                          HelperText="Select a NetRatel job from this saved connection." />
                                                            <MudButton Variant="Variant.Outlined"
                                                                       Size="Size.Small"
                                                                       StartIcon="@Icons.Material.Filled.LibraryBooks"
                                                                       Disabled="@(orchestrationCatalogLoading || !CanCreateTenantScopedOrchestrationTarget)"
                                                                       @ref="automationBrowseButton" OnClick="OpenOrchestrationScriptLibraryDialogAsync">
                                                                Browse jobs
                                                            </MudButton>
                                                            <MudTooltip Text="Clear selected External orchestration target">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                                                               Size="Size.Small"
                                                                               Color="Color.Warning"
                                                                               Variant="Variant.Outlined"
                                                                               Disabled="@(SelectedBinding is null || string.IsNullOrWhiteSpace(SelectedBinding.OrchestrationRequestDefinitionId))"
                                                                               OnClick="@(() => OnSelectedCatalogRequestDefinitionChanged(null))" />
                                                            </MudTooltip>
                                                        </MudStack>

                                                        @if (SelectedBinding is not null
                                                            && !string.IsNullOrWhiteSpace(SelectedBinding.OrchestrationRequestDefinitionId)
                                                            && !SelectedBindingTargetIsVisible)
                                                        {
                                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                                                                The stored External orchestration binding target is not present for the selected External orchestration tenant. Review the binding before saving.
                                                            </MudAlert>
                                                        }
                                                        else if (SelectedBindingTargetHasTenantMismatch)
                                                        {
                                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-1">
                                                                The stored External orchestration binding target has different tenant metadata from the selected organization. Review the job before saving.
                                                            </MudAlert>
                                                        }

                                                        @if (SelectedCatalogRequestDefinition?.Target is { } target)
                                                        {
                                                            <MudText Typo="Typo.body2">Execution target: @target.Summary</MudText>
                                                            <MudText Typo="Typo.caption">@OrchestrationCatalogInputResolver.ReadinessLabel(target) · Required inputs: @string.Join(", ", target.RequiredInputs)</MudText>
                                                        }
                                                        @if (SelectedCatalogRequestDefinition is not null)
                                                        {
                                                            <MudStack Row="true" Spacing="1" Class="request-form-chip-row">
                                                                @if (!string.IsNullOrWhiteSpace(SelectedCatalogRequestDefinition.TenantName))
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@SelectedCatalogRequestDefinition.TenantName</MudChip>
                                                                }
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@($"{SelectedOrchestrationInputs.Count} input{(SelectedOrchestrationInputs.Count == 1 ? string.Empty : "s")}")</MudChip>
                                                            </MudStack>
                                                        }

                                                        <MudTextField T="string"
                                                                      Value="@SelectedJobName"
                                                                      Label="Job Name"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense"
                                                                      Dense="true"
                                                                      ReadOnly="true" />

                                                        <MudGrid Spacing="1">
                                                            <MudItem xs="12" sm="6">
                                                                <MudNumericField @ref="expectedRuntimeInput" T="int?"
                                                                                 Value="@SelectedExpectedRuntimeMinutes"
                                                                                 ValueChanged="OnSelectedExpectedRuntimeMinutesChanged"
                                                                                 Label="Expected Runtime (minutes)"
                                                                                 HelperText="External orchestration tested job runtime."
                                                                                 Variant="Variant.Outlined"
                                                                                 Margin="Margin.Dense"
                                                                                 Dense="true"
                                                                                 Min="1" />
                                                            </MudItem>
                                                            <MudItem xs="12" sm="6">
                                                                <MudNumericField @ref="graceRuntimeInput" T="int?"
                                                                                 Value="@SelectedGraceRuntimeMinutes"
                                                                                 ValueChanged="OnSelectedGraceRuntimeMinutesChanged"
                                                                                 Label="Grace Runtime (minutes)"
                                                                                 HelperText="Helpdesk allowance after expected runtime."
                                                                                 Variant="Variant.Outlined"
                                                                                 Margin="Margin.Dense"
                                                                                 Dense="true"
                                                                                 Min="0" />
                                                            </MudItem>
                                                        </MudGrid>

                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="request-form-task-actions">
                                                            <MudSwitch T="bool"
                                                                       Value="@(SelectedBinding?.Enabled ?? true)"
                                                                       ValueChanged="OnSelectedBindingEnabledChanged"
                                                                       Color="Color.Primary"
                                                                       Size="Size.Small"
                                                                       Label="Binding Enabled" />

                                                            <MudButton Variant="Variant.Text"
                                                                       Color="Color.Warning"
                                                                       Size="Size.Small"
                                                                       StartIcon="@Icons.Material.Filled.LinkOff"
                                                                       OnClick="ClearSelectedTaskBinding">
                                                                Clear
                                                            </MudButton>

                                                            @if (SelectedBinding is not null && !string.IsNullOrWhiteSpace(SelectedBinding.BindingId))
                                                            {
                                                                <MudButton Variant="Variant.Text"
                                                                           Size="Size.Small"
                                                                           StartIcon="@Icons.Material.Filled.Sync"
                                                                           OnClick="RefreshSelectedBindingDriftAsync">
                                                                    Refresh
                                                                </MudButton>

                                                                <MudButton Variant="Variant.Text"
                                                                           Size="Size.Small"
                                                                           StartIcon="@Icons.Material.Filled.CompareArrows"
                                                                           OnClick="LoadSelectedBindingDriftPreviewAsync">
                                                                    Drift
                                                                </MudButton>

                                                                @if (SelectedBinding.SyncState == AutomationBindingSyncState.Drifted)
                                                                {
                                                                    <MudButton Variant="Variant.Text"
                                                                               Color="Color.Info"
                                                                               Size="Size.Small"
                                                                               StartIcon="@Icons.Material.Filled.PendingActions"
                                                                               OnClick="MarkSelectedBindingImportPendingAsync">
                                                                        Mark Import
                                                                    </MudButton>
                                                                }

                                                                @if (SelectedBinding.SyncState == AutomationBindingSyncState.ImportPending)
                                                                {
                                                                    <MudButton Variant="Variant.Text"
                                                                               Color="Color.Success"
                                                                               Size="Size.Small"
                                                                               StartIcon="@Icons.Material.Filled.Download"
                                                                               OnClick="ImportSelectedBindingInputsAsync">
                                                                        Import
                                                                    </MudButton>
                                                                }
                                                            }
                                                        </MudStack>

                                                        @if (selectedBindingDriftPreviewLoading)
                                                        {
                                                            <MudProgressLinear Indeterminate="true" Class="mt-1 mb-1" />
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(selectedBindingDriftPreviewError))
                                                        {
                                                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-1 mb-1">
                                                                @selectedBindingDriftPreviewError
                                                            </MudAlert>
                                                        }
                                                        else if (selectedBindingDriftPreview is not null
                                                            && SelectedBinding is not null
                                                            && string.Equals(selectedBindingDriftPreview.BindingId, SelectedBinding.BindingId, StringComparison.Ordinal))
                                                        {
                                                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-1 mb-1">
                                                                Review the mapped Helpdesk inputs against the External orchestration request definition before importing External orchestration-side changes.
                                                            </MudAlert>

                                                            <MudTable Items="VisibleDriftDifferences"
                                                                      Dense="true"
                                                                      Hover="true"
                                                                      Breakpoint="Breakpoint.Sm">
                                                                <HeaderContent>
                                                                    <MudTh>Input Key</MudTh>
                                                                    <MudTh>Change</MudTh>
                                                                    <MudTh>Helpdesk</MudTh>
                                                                    <MudTh>External orchestration</MudTh>
                                                                </HeaderContent>
                                                                <RowTemplate>
                                                                    <MudTd DataLabel="Input Key">@context.Key</MudTd>
                                                                    <MudTd DataLabel="Change">
                                                                        <MudChip T="string" Size="Size.Small" Color="@GetDriftChangeColor(context.ChangeType)">
                                                                            @context.ChangeType
                                                                        </MudChip>
                                                                    </MudTd>
                                                                    <MudTd DataLabel="Helpdesk">@FormatInputSnapshot(context.Helpdesk)</MudTd>
                                                                    <MudTd DataLabel="External orchestration">@FormatInputSnapshot(context.Orchestration)</MudTd>
                                                                </RowTemplate>
                                                                <NoRecordsContent>
                                                                    <MudText Typo="Typo.body2">No schema differences detected.</MudText>
                                                                </NoRecordsContent>
                                                            </MudTable>
                                                        }

                                                        <MudDivider Class="my-2" />
                                                        <MudText Typo="Typo.subtitle2">Payload Mapping</MudText>
                                                        <MudGrid Spacing="1">
                                                            <MudItem xs="12" sm="5">
                                                                <MudSelect T="string"
                                                                           @bind-Value="SelectedDraftFieldKey"
                                                                           Label="Helpdesk Field"
                                                                           HelperText="Source field from Helpdesk."
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           Dense="true">
                                                                    @foreach (var option in FieldOptions)
                                                                    {
                                                                        <MudSelectItem Value="@option.Key">@option.Label (@option.Key)</MudSelectItem>
                                                                    }
                                                                </MudSelect>
                                                            </MudItem>
                                                            <MudItem xs="12" sm="5">
                                                                <MudSelect T="string"
                                                                           @bind-Value="SelectedDraftJobParamKey"
                                                                           Label="Job Param"
                                                                           HelperText="Destination parameter on the External orchestration job."
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           Dense="true"
                                                                           Disabled="@(!SelectedOrchestrationInputs.Any())">
                                                                    @foreach (var input in SelectedOrchestrationInputs.OrderBy(x => x.Order).ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
                                                                    {
                                                                        <MudSelectItem Value="@input.Key">@GetOrchestrationInputLabel(input)</MudSelectItem>
                                                                    }
                                                                </MudSelect>
                                                            </MudItem>
                                                            <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="AddPayloadMapping" Disabled="@(!CanAddPayloadMapping)" />
                                                            </MudItem>
                                                        </MudGrid>

                                                        @if (VisiblePayloadMappingRows.Count > 0)
                                                        {
                                                            <MudTable Items="VisiblePayloadMappingRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                                                <HeaderContent>
                                                                    <MudTh>Job Param</MudTh>
                                                                    <MudTh>Helpdesk Field</MudTh>
                                                                    <MudTh Style="width: 1%;"></MudTh>
                                                                </HeaderContent>
                                                                <RowTemplate>
                                                                    <MudTd DataLabel="Job Param">
                                                                        <MudText Typo="Typo.body2">@context.Label</MudText>
                                                                        <MudText Typo="Typo.caption">@context.JobParamKey</MudText>
                                                                    </MudTd>
                                                                    <MudTd DataLabel="Helpdesk Field">
                                                                        <MudSelect T="string"
                                                                                   Value="@context.HelpdeskFieldKey"
                                                                                   ValueChanged="@((string? value) => OnPayloadMappingFieldChanged(context.JobParamKey, value))"
                                                                                   Margin="Margin.Dense"
                                                                                   Dense="true"
                                                                                   Clearable="true">
                                                                            @foreach (var option in FieldOptions)
                                                                            {
                                                                                <MudSelectItem Value="@option.Key">@option.Label (@option.Key)</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudTd>
                                                                    <MudTd>
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemovePayloadMapping(context.JobParamKey))" />
                                                                    </MudTd>
                                                                </RowTemplate>
                                                            </MudTable>
                                                        }
                                                    }
                                                </div>
                                            }

                                        <MudExpansionPanels Class="request-form-advanced-panel" Dense="true">
                                            <MudExpansionPanel Text="Advanced workflow" @bind-Expanded="advancedExpanded">
                                                <MudText Typo="Typo.subtitle2" Class="mb-1">Dependencies</MudText>
                                                <MudSelect @ref="dependenciesInput" T="Guid"
                                                           Label="Depends On"
                                                           MultiSelection="true"
                                                           Dense="true"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           SelectedValues="@SelectedDependencyIds"
                                                           SelectedValuesChanged="OnSelectedTaskDependenciesChanged">
                                                    @foreach (var option in DependencyOptions)
                                                    {
                                                        <MudSelectItem T="Guid" Value="@option.Id">@option.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <MudText Typo="Typo.caption" Class="mb-2">
                                                    Depends on: @GetDependencySummary(selectedTask)
                                                </MudText>

                                                <MudTextField @bind-Value="selectedTask.ConditionExpression"
                                                              Label="Condition (optional)"
                                                              Placeholder="payload.userType == &quot;external&quot;"
                                                              HelperText="Expression evaluated against request payload. Leave empty for always execute."
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Dense="true" />

                                                <MudGrid Spacing="1">
                                                    <MudItem xs="12" sm="6">
                                                        <MudNumericField @ref="taskSlaInput" T="int?"
                                                                         @bind-Value="selectedTask.TaskSlaMinutes"
                                                                         Label="Task SLA (minutes)" Min="0"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6">
                                                        <MudNumericField @ref="escalationInput" T="int?"
                                                                         @bind-Value="selectedTask.EscalateAfterMinutes"
                                                                         Label="Escalate After (minutes)" Min="0"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense" />
                                                    </MudItem>
                                                </MudGrid>

                                                <MudText Typo="Typo.subtitle2" Class="mt-2">Escalation Target</MudText>
                                                <MudGrid Spacing="1">
                                                    <MudItem xs="12" sm="6">
                                                        <MudSelect @ref="escalationUserInput" T="string"
                                                                   Label="Escalation User"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   Dense="true"
                                                                   Clearable="true"
                                                                   Value="selectedTask.EscalationUserId"
                                                                   ValueChanged="OnEscalationUserChanged">
                                                            @foreach (var user in users)
                                                            {
                                                                <MudSelectItem T="string" Value="@user.Id">@user.Name (@user.Email)</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6">
                                                        <MudSelect T="string"
                                                                   Label="Escalation Role"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   Dense="true"
                                                                   Clearable="true"
                                                                   Value="selectedTask.EscalationRole"
                                                                   ValueChanged="OnEscalationRoleChanged">
                                                            @foreach (var role in AvailableRoles)
                                                            {
                                                                <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                </MudGrid>

                                                <MudTooltip Text="If this task fails, the request may be marked as failed (Phase 6G).">
                                                    <MudSwitch @bind-Value="selectedTask.IsCritical"
                                                               Color="Color.Warning"
                                                               Label="Critical Task"
                                                               Size="Size.Small"
                                                               Class="mt-1" />
                                                </MudTooltip>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>

                            </MudStack>
                        }
            @if (_showWorkflowPreview)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3 request-form-preview-panel">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Workflow Preview</MudText>
                    @if (!Tasks.Any())
                    {
                        <MudText Typo="Typo.body2">No tasks configured.</MudText>
                    }
                    else
                    {
                        @foreach (var node in BuildWorkflowPreview())
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="@($"margin-left:{node.Depth * 18}px")">
                                <MudText Typo="Typo.body2">@node.TaskName</MudText>
                                @if (node.IsConditional)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">conditional</MudChip>
                                }
                                @if (node.IsCritical)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">critical</MudChip>
                                }
                            </MudStack>
                        }
                    }
                </MudPaper>
            }

                    </div>
                </section>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="request-form-save-state" role="status">@(saveError ?? validationError ?? (saving ? "Saving…" : IsDirty ? "Changes are kept across tabs until you save." : string.Empty))</MudText>
        <MudButton Variant="Variant.Text" Disabled="@saving" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@saving" OnClick="Save">@(saving ? "Saving…" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

<style>
