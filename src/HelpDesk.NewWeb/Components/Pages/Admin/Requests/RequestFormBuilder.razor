    private IReadOnlyList<PayloadMappingRow> GetVisiblePayloadMappingRows()
    {
        if (selectedTask is null)
        {
            return [];
        }

        var mappings = selectedTask.PayloadMapping ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var rows = new Dictionary<string, PayloadMappingRow>(StringComparer.OrdinalIgnoreCase);

        if (SelectedCatalogRequestDefinition is not null)
        {
            foreach (var input in SelectedOrchestrationInputs
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
            {
                var key = input.Key.Trim();
                if (string.IsNullOrWhiteSpace(key))
                {
                    continue;
                }

                mappings.TryGetValue(key, out var helpdeskFieldKey);
                rows[key] = new PayloadMappingRow(key, GetOrchestrationInputLabel(input), Normalize(helpdeskFieldKey));
            }
        }

        foreach (var mapping in mappings.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
        {
            var key = mapping.Key.Trim();
            if (string.IsNullOrWhiteSpace(key) || rows.ContainsKey(key))
            {
                continue;
            }

            rows[key] = new PayloadMappingRow(key, key, Normalize(mapping.Value));
        }

        return rows.Values.ToList();
    }

    private IReadOnlyList<OrchestrationCatalogInputDefinitionDto> GetSelectedOrchestrationInputs()
    {
        var resolved = OrchestrationCatalogInputResolver.ResolveInputs(SelectedCatalogRequestDefinition, orchestrationJobs);
        if (resolved.Count > 0)
        {
            return resolved;
        }

        var selectedRequestDefinitionId = SelectedBinding?.OrchestrationRequestDefinitionId;
        if (string.IsNullOrWhiteSpace(selectedRequestDefinitionId))
        {
            return [];
        }

        var inferred = new List<OrchestrationCatalogInputDefinitionDto>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var task in Tasks.OrderBy(x => x.Order))
        {
            var binding = GetBindingModel(task, createIfMissing: false);
            if (binding is null
                || !string.Equals(binding.OrchestrationRequestDefinitionId, selectedRequestDefinitionId, StringComparison.OrdinalIgnoreCase)
                || task.PayloadMapping is null)
            {
                continue;
            }

            foreach (var mapping in task.PayloadMapping.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
            {
                var key = mapping.Key?.Trim();
                if (string.IsNullOrWhiteSpace(key) || !seen.Add(key))
                {
                    continue;
                }

                inferred.Add(new OrchestrationCatalogInputDefinitionDto
                {
                    Key = key,
                    Label = key,
                    Type = "text",
                    Order = inferred.Count
                });
            }
        }

        return inferred;
    }

