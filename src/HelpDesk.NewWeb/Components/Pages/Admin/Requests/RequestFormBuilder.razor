    private string GetDependencySummary(RequestTaskTemplateModel task)
    {
        if (task.DependsOn.Count == 0)
        {
            return "None";
        }

        var lookup = Tasks.ToDictionary(x => x.Id, x => x.Name);
        var names = task.DependsOn
            .Where(x => lookup.ContainsKey(x))
            .Select(x => lookup[x])
            .ToList();
