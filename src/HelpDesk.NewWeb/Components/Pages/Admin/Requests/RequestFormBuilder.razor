    private RequestTaskTemplateModel? FindCircularDependencyTask()
    {
        var graph = Tasks.ToDictionary(
            x => x.Id,
            x => x.DependsOn.Where(dep => dep != Guid.Empty).ToList());
        var states = new Dictionary<Guid, VisitState>();

        foreach (var node in graph.Keys)
        {
            if (HasCycle(node, graph, states, out var cycleNode))
                return Tasks.First(x => x.Id == cycleNode);
        }

        return null;
    }

    private static bool HasCycle(Guid node, IReadOnlyDictionary<Guid, List<Guid>> graph, IDictionary<Guid, VisitState> states, out Guid cycleNode)
    {
        cycleNode = node;
        if (states.TryGetValue(node, out var state))
            return state == VisitState.Visiting;

        states[node] = VisitState.Visiting;

        if (graph.TryGetValue(node, out var deps))
        {
            foreach (var dep in deps)
            {
                if (!graph.ContainsKey(dep))
                {
                    continue;
                }

                if (HasCycle(dep, graph, states, out cycleNode))
                {
                    return true;
                }
            }
        }

        states[node] = VisitState.Visited;
        return false;
    }

