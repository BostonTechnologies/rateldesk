    private void OnPayloadMappingFieldChanged(string jobParamKey, string? helpdeskFieldKey)
    {
        if (selectedTask is null || string.IsNullOrWhiteSpace(jobParamKey))
        {
            return;
        }

        selectedTask.PayloadMapping ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(helpdeskFieldKey))
        {
            selectedTask.PayloadMapping.Remove(jobParamKey);
        }
        else
        {
            selectedTask.PayloadMapping[jobParamKey.Trim()] = helpdeskFieldKey.Trim();
        }

        if (selectedTask.PayloadMapping.Count == 0)
        {
            selectedTask.PayloadMapping = null;
        }

        ClearSelectedBindingDriftPreview();
    }

