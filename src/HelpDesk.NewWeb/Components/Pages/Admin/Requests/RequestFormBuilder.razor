    private static int? SecondsToMinutes(int? seconds)
        => seconds.HasValue && seconds.Value > 0
            ? Math.Max(1, (int)Math.Ceiling(seconds.Value / 60.0))
            : null;

    private static int? NormalizeRuntimeMinutes(int? value, int minimum)
        => value.HasValue ? Math.Max(minimum, value.Value) : null;

    private List<WorkflowPreviewNode> BuildWorkflowPreview()
    {
        var orderedTasks = Tasks.OrderBy(x => x.Order).ToList();
        if (orderedTasks.Count == 0)
        {
            return new List<WorkflowPreviewNode>();
        }

        var lookup = orderedTasks.ToDictionary(x => x.Id);
        var childrenByDependency = orderedTasks
            .SelectMany(task => task.DependsOn.Select(dep => new { Dependency = dep, Task = task }))
            .Where(x => lookup.ContainsKey(x.Dependency))
            .GroupBy(x => x.Dependency)
            .ToDictionary(
                g => g.Key,
                g => g.Select(x => x.Task).OrderBy(x => x.Order).ToList());

        var roots = orderedTasks.Where(x => x.DependsOn.Count == 0).ToList();
        if (roots.Count == 0)
        {
            roots = orderedTasks;
        }

        var result = new List<WorkflowPreviewNode>();
        var appended = new HashSet<Guid>();

        foreach (var root in roots)
        {
            AppendPreviewNode(root, 0, childrenByDependency, appended, new HashSet<Guid>(), result);
        }

        foreach (var remaining in orderedTasks.Where(x => !appended.Contains(x.Id)))
        {
            AppendPreviewNode(remaining, 0, childrenByDependency, appended, new HashSet<Guid>(), result);
        }

        return result;
    }

    private static void AppendPreviewNode(
        RequestTaskTemplateModel task,
        int depth,
        IReadOnlyDictionary<Guid, List<RequestTaskTemplateModel>> childrenByDependency,
        ISet<Guid> appended,
        ISet<Guid> path,
        ICollection<WorkflowPreviewNode> result)
    {
        if (!appended.Add(task.Id))
        {
            return;
        }

        result.Add(new WorkflowPreviewNode(
            task.Name,
            depth,
            !string.IsNullOrWhiteSpace(task.ConditionExpression),
            task.IsCritical));

        if (!path.Add(task.Id))
        {
            return;
        }

        if (childrenByDependency.TryGetValue(task.Id, out var children))
        {
            foreach (var child in children)
            {
                if (path.Contains(child.Id))
                {
                    continue;
                }

                AppendPreviewNode(child, depth + 1, childrenByDependency, appended, new HashSet<Guid>(path), result);
            }
        }
    }

    private async Task Save()
    {
        await form.ValidateAsync();
        if (!form.IsValid)
        {
            return;
        }

        if (!IsTaskConfigurationValid())
        {
            return;
        }

        saving = true;

        if (string.IsNullOrWhiteSpace(ServiceId))
        {
            Snackbar.Add("ServiceId is required to create a request form.", Severity.Error);
            saving = false;
            return;
        }

        try
        {
            ApplyRuntimeDefaultsToAutomationTasks();
            NormalizeTaskOrder();
            FormFieldKeyResolver.EnsureKeys(FormFields);

            var schemaNode = new JsonObject
            {
                ["title"] = model.Title ?? string.Empty,
                ["description"] = model.Description ?? string.Empty,
                ["layout"] = new JsonObject
                {
                    ["width"] = model.Width,
                    ["height"] = model.Height,
                    ["depth"] = model.Depth
                },
                ["fields"] = JsonSerializer.SerializeToNode(FormFields, JsonOptions),
                ["tasks"] = JsonSerializer.SerializeToNode(Tasks, JsonOptions)
            };

            var jsonSchema = schemaNode.ToJsonString(JsonOptionsIndented);

            HttpResponseMessage resp;
            if (_isNew)
            {
                var dto = new CreateRequestFormDto
                {
                    ServiceId = ServiceId!,
                    Title = model.Title ?? string.Empty,
                    Description = model.Description,
                    OrganizationId = model.OrganizationId,
                    AllowedOrganizationIds = selectedOrgIds.ToList(),
                    ReleaseStatus = model.ReleaseStatus,
                    JsonSchema = jsonSchema
                };
                resp = await Api.PostAsJsonAsync("api/v1/request-forms", dto);
            }
            else
            {
                var dto = new UpdateRequestFormDto
                {
                    Title = model.Title,
                    Description = model.Description,
                    OrganizationId = model.OrganizationId,
                    AllowedOrganizationIds = selectedOrgIds.ToList(),
                    ReleaseStatus = model.ReleaseStatus,
                    JsonSchema = jsonSchema,
                    ServiceIdHasValue = false
                };
                resp = await Api.PutAsJsonAsync($"api/v1/request-forms/{RequestFormId}", dto);
            }

        if (resp.IsSuccessStatusCode)
        {
            var savedForm = await resp.Content.ReadFromJsonAsync<RequestFormDto>() ?? new RequestFormDto
            {
                Id = RequestFormId ?? string.Empty
            };

            await SyncBindingsAsync(savedForm.Id);
            var syncWarning = await TrySyncBindingSchemasAsync(savedForm.Id);
            if (!string.IsNullOrWhiteSpace(syncWarning))
            {
                Snackbar.Add(syncWarning, Severity.Warning);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
                Snackbar.Add($"Save failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

