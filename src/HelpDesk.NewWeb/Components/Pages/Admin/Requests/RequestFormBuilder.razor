    private bool IsTaskConfigurationValid()
    {
        foreach (var task in Tasks.OrderBy(x => x.Order))
        {
            if (string.IsNullOrWhiteSpace(task.Name))
                return ShowTaskError(task, "Every task must have a name.");

            if (string.Equals(task.Type, "automation", StringComparison.OrdinalIgnoreCase))
            {
                var binding = GetBindingModel(task, createIfMissing: false);
                if (binding is null || string.IsNullOrWhiteSpace(binding.OrchestrationRequestDefinitionId))
                    return ShowTaskError(task, $"Automation task '{task.Name}' requires an External orchestration binding.", "binding");
                if (binding.Enabled && (binding.SystemConnectionId is null || AutomationConnectionSelection.Resolve(AutomationConnectionChoices, binding.SystemConnectionId) is null))
                    return ShowTaskError(task, $"Automation task '{task.Name}' requires a current saved connection for this organization.", "connection");
            }

            if (string.Equals(task.Type, "approval", StringComparison.OrdinalIgnoreCase) && task.ApprovalApprovers.Count == 0)
                return ShowTaskError(task, $"Approval task '{task.Name}' requires at least one approver.", "approval");

            if (string.Equals(task.Type, "automation", StringComparison.OrdinalIgnoreCase) && task.ExpectedRuntimeMinutes is < 1)
                return ShowTaskError(task, $"Task '{task.Name}' expected runtime must be at least one minute.", "runtime");
            if (string.Equals(task.Type, "automation", StringComparison.OrdinalIgnoreCase) && task.GraceRuntimeMinutes is < 0)
                return ShowTaskError(task, $"Task '{task.Name}' grace runtime cannot be negative.", "grace");
            if (task.TaskSlaMinutes is < 0)
                return ShowTaskError(task, $"Task '{task.Name}' SLA cannot be negative.", "sla", advanced: true);
            if (task.EscalateAfterMinutes is < 0)
                return ShowTaskError(task, $"Task '{task.Name}' escalation threshold cannot be negative.", "escalation", advanced: true);

            if (task.EscalateAfterMinutes.HasValue && task.TaskSlaMinutes.HasValue && task.EscalateAfterMinutes.Value > task.TaskSlaMinutes.Value)
                return ShowTaskError(task, $"Task '{task.Name}' has invalid SLA settings. Escalation threshold cannot exceed task SLA.", "escalation", advanced: true);

            if (!string.IsNullOrWhiteSpace(task.EscalationUserId) && !string.IsNullOrWhiteSpace(task.EscalationRole))
                return ShowTaskError(task, $"Task '{task.Name}' can only target one escalation target (user OR role).", "escalation-user", advanced: true);
        }

        var circularTask = FindCircularDependencyTask();
        if (circularTask is not null)
            return ShowTaskError(circularTask, "Circular dependency detected. Remove a dependency to break the cycle.", "dependencies", advanced: true);

        return true;
    }

