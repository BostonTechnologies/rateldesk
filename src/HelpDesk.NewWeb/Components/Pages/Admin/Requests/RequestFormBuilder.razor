    private void MoveField(FormField field, int offset)
    {
        var index = FormFields.IndexOf(field);
        var destination = index + offset;
        if (index < 0 || destination < 0 || destination >= FormFields.Count) return;
        FormFields.RemoveAt(index);
        FormFields.Insert(destination, field);
    }

