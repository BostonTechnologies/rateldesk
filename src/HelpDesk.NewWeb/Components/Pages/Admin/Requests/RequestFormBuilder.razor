    private void SetWorkspaceTab(int tab) => activeWorkspaceTab = Math.Clamp(tab, 0, WorkspaceTabs.Length - 1);
    private void OnWorkspaceTabKeyDown(KeyboardEventArgs args, int tab)
    {
        var target = args.Key switch
        {
            "ArrowRight" => (tab + 1) % WorkspaceTabs.Length,
            "ArrowLeft" => (tab + WorkspaceTabs.Length - 1) % WorkspaceTabs.Length,
            "Home" => 0,
            "End" => WorkspaceTabs.Length - 1,
            _ => -1
        };
        if (target < 0) return;
        SetWorkspaceTab(target);
        pendingTabFocus = target;
    }

