    private void DuplicateSelectedTask()
    {
        if (selectedTask is null)
        {
            return;
        }

        NormalizeTaskOrder();
        var clone = new RequestTaskTemplateModel
        {
            Id = Guid.NewGuid(),
            Name = $"{selectedTask.Name} (Copy)",
            Description = selectedTask.Description,
            Order = selectedTask.Order + 1,
            Type = selectedTask.Type,
            AutoStart = selectedTask.AutoStart,
            DefaultAssigneeId = selectedTask.DefaultAssigneeId,
            TeamOrRole = selectedTask.TeamOrRole,
            DependsOn = new List<Guid>(selectedTask.DependsOn),
            ConditionExpression = selectedTask.ConditionExpression,
            TaskSlaMinutes = selectedTask.TaskSlaMinutes,
            EscalateAfterMinutes = selectedTask.EscalateAfterMinutes,
            EscalationUserId = selectedTask.EscalationUserId,
            EscalationRole = selectedTask.EscalationRole,
            IsCritical = selectedTask.IsCritical,
            MaxRetries = selectedTask.MaxRetries,
            RetryDelayMinutes = selectedTask.RetryDelayMinutes,
            FailurePolicy = selectedTask.FailurePolicy,
            ExpectedRuntimeMinutes = selectedTask.ExpectedRuntimeMinutes,
            GraceRuntimeMinutes = selectedTask.GraceRuntimeMinutes,
            ApprovalAllowedDays = selectedTask.ApprovalAllowedDays,
            ApprovalApprovers = selectedTask.ApprovalApprovers
                .Select(x => new RequestTaskApprovalApproverModel
                {
                    Source = x.Source,
                    Id = x.Id,
                    Name = x.Name,
                    Email = x.Email,
                    OrganizationId = x.OrganizationId,
                    OrganizationName = x.OrganizationName
                })
                .ToList(),
            PayloadMapping = selectedTask.PayloadMapping is null
                ? new Dictionary<string, string>()
                : new Dictionary<string, string>(selectedTask.PayloadMapping)
        };

        if (automationBindings.TryGetValue(selectedTask.Id, out var binding))
        {
            automationBindings[clone.Id] = binding.CloneForTask();
        }

        var index = Tasks.OrderBy(x => x.Order).ToList().FindIndex(x => x.Id == selectedTask.Id);
        clone.Order = Tasks.Count + 1;
        Tasks = RequestFormTaskEditorState.MoveTaskToIndex(Tasks.Append(clone), clone.Id, index < 0 ? Tasks.Count : index + 1);
        selectedTask = Tasks.FirstOrDefault(x => x.Id == clone.Id);
        showMobileTaskEditor = true;
        ClearSelectedBindingDriftPreview();
        SeedNewOrchestrationRequestDefinitionDefaults();
        RequestTaskDropContainerRefresh(rebuild: true);
    }

    private void DeleteSelectedTask()
    {
        if (selectedTask is null)
        {
            return;
        }

        var selectedId = selectedTask.Id;
        var selectedIndex = Tasks.OrderBy(x => x.Order).ToList().FindIndex(x => x.Id == selectedId);
        var remainingTasks = Tasks.Where(x => x.Id != selectedId).ToList();
        automationBindings.Remove(selectedId);
        payloadMappingDrafts.Remove(selectedId);
        foreach (var task in remainingTasks)
        {
            task.DependsOn.RemoveAll(x => x == selectedId);
        }
        Tasks = RequestFormTaskEditorState.NormalizeTaskOrder(remainingTasks);
        selectedTask = Tasks.Count == 0 ? null : Tasks[Math.Min(selectedIndex, Tasks.Count - 1)];
        showMobileTaskEditor = selectedTask is not null;
        ClearSelectedBindingDriftPreview();
        SeedNewOrchestrationRequestDefinitionDefaults();
        RequestTaskDropContainerRefresh(rebuild: true);
    }

    private void MoveTaskUp()
    {
        if (!CanMoveSelectedTaskUp || selectedTask is null)
        {
            return;
        }

        var index = Tasks.OrderBy(x => x.Order).ToList().FindIndex(x => x.Id == selectedTask.Id);
        ReorderTask(selectedTask.Id, index - 1);
        SeedNewOrchestrationRequestDefinitionDefaults();
    }

    private void MoveTaskDown()
    {
        if (!CanMoveSelectedTaskDown || selectedTask is null)
        {
            return;
        }

        var index = Tasks.OrderBy(x => x.Order).ToList().FindIndex(x => x.Id == selectedTask.Id);
        ReorderTask(selectedTask.Id, index + 1);
        SeedNewOrchestrationRequestDefinitionDefaults();
    }

