    private static string FormatInputSnapshot(AutomationBindingInputSnapshotDto? snapshot)
    {
        if (snapshot is null)
        {
            return "-";
        }

        var fieldPart = string.IsNullOrWhiteSpace(snapshot.FieldKey) ? string.Empty : $" [{snapshot.FieldKey}]";
        var requiredPart = snapshot.Required ? " required" : " optional";
        return $"{snapshot.Label}{fieldPart} | {snapshot.Type}{requiredPart}";
    }

