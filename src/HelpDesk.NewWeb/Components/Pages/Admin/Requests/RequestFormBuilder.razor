    private async Task LoadSelectedBindingDriftPreviewAsync()
    {
        if (SelectedBinding is null || string.IsNullOrWhiteSpace(SelectedBinding.BindingId))
        {
            ClearSelectedBindingDriftPreview();
            return;
        }

        selectedBindingDriftPreviewLoading = true;
        selectedBindingDriftPreviewError = null;

        try
        {
            selectedBindingDriftPreview = await Api.GetFromJsonAsync<AutomationBindingDriftPreviewDto>(
                $"api/v1/admin/orchestration/bindings/{SelectedBinding.BindingId}/drift-preview");
        }
        catch (Exception ex)
        {
            selectedBindingDriftPreview = null;
            selectedBindingDriftPreviewError = $"Could not load drift preview: {ex.Message}";
        }
        finally
        {
            selectedBindingDriftPreviewLoading = false;
        }
    }

    private async Task LoadOrchestrationCatalogAsync()
    {
        var generation = ++orchestrationLoadGeneration;
        var connection = SelectedAutomationConnection;
        loadedOrchestrationSelection = OrchestrationSelectionKey;
        orchestrationCatalogLoading = true;
        orchestrationCatalogError = null;
        automationCapabilities = null;
        selectedOrchestrationSettings = null;
        orchestrationRequestDefinitions = new();
        orchestrationJobs = new();

        try
        {
            if (connection is null) return;
            var query = AutomationConnectionSelection.Query(connection.OrganizationId, connection.ConnectionId);
            var settings = await Api.GetFromJsonAsync<OrchestrationConnectivitySettingsDto>("api/v1/admin/orchestration/" + query);
            if (!AutomationConnectionSelection.IsVerified(connection, settings))
                throw new InvalidOperationException("The saved automation mapping no longer matches this connection and organization.");
            if (generation != orchestrationLoadGeneration || loadedOrchestrationSelection != OrchestrationSelectionKey) return;
            selectedOrchestrationSettings = settings;
            var definitions = await OrchestrationApiErrors.GetAsync<List<OrchestrationCatalogRequestDefinitionDto>>(Api,
                "api/v1/admin/orchestration/catalog/request-definitions" + query) ?? new();
            var jobs = await OrchestrationApiErrors.GetAsync<List<OrchestrationCatalogJobDto>>(Api,
                "api/v1/admin/orchestration/catalog/jobs" + query) ?? new();
            OrchestrationAutomationCapabilitiesDto? capabilities;
            try { capabilities = await OrchestrationApiErrors.GetAsync<OrchestrationAutomationCapabilitiesDto>(Api, "api/v1/admin/orchestration/catalog/capabilities" + query); }
            catch (InvalidOperationException) { capabilities = new() { Message = "Authenticated mapping verified; automation capabilities could not be confirmed. Refresh this connection or upgrade the compatible NetRatel peer." }; }
            if (generation != orchestrationLoadGeneration || loadedOrchestrationSelection != OrchestrationSelectionKey) return;
            automationCapabilities = capabilities;
            selectedOrchestrationSettings = settings;
            orchestrationRequestDefinitions = definitions;
            orchestrationJobs = jobs.Where(x => x.TenantId == connection.PeerTenantId).ToList();
            if (SelectedBinding is not null)
                SelectedBinding.SystemConnectionId = connection.ConnectionId;
            loadedOrchestrationSelection = OrchestrationSelectionKey;
        }
        catch (Exception ex)
        {
            if (generation == orchestrationLoadGeneration)
                orchestrationCatalogError = ex.Message;
        }
        finally
        {
            if (generation == orchestrationLoadGeneration)
                orchestrationCatalogLoading = false;
        }
    }

    private async Task ReloadAutomationConnectionsAsync()
    {
        try
        {
            systemConnections = await Api.GetFromJsonAsync<List<PairingConnectionDto>>("api/v1/admin/system-connections/") ?? new();
            await LoadOrchestrationCatalogAsync();
        }
        catch (Exception ex)
        {
            systemConnections = new();
            await LoadOrchestrationCatalogAsync();
            orchestrationCatalogError = ex.Message;
        }
    }

    private async Task OnAutomationConnectionChangedAsync(Guid? connectionId)
    {
        if (SelectedBinding is null || connectionId == SelectedBinding.SystemConnectionId) return;
        if (connectionId is not null && !AutomationConnectionChoices.Any(x => x.ConnectionId == connectionId))
            return;
        // A definition identifier is only meaningful within its saved peer connection.
        OnSelectedCatalogRequestDefinitionChanged(null);
        SelectedBinding.SystemConnectionId = connectionId;
        ClearSelectedBindingDriftPreview();
        await LoadOrchestrationCatalogAsync();
    }

    private AutomationBindingEditorModel GetBindingModel(RequestTaskTemplateModel task, bool createIfMissing = true)
    {
        if (automationBindings.TryGetValue(task.Id, out var existing))
        {
            return existing;
