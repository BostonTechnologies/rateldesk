            SelectedCatalogRequestDefinition?.OrchestrationJobDefinitionName,
            SelectedCatalogRequestDefinition?.DisplayName,
            SelectedCatalogRequestDefinition?.RequestDefinitionName);
    }

    private string GetDefaultOrchestrationTargetName()
    {
        var formName = string.IsNullOrWhiteSpace(model.Title) ? "request" : model.Title.Trim();
        var taskName = selectedTask is null || string.IsNullOrWhiteSpace(selectedTask.Name)
            ? "task"
            : selectedTask.Name.Trim();
        return $"{formName}-{taskName}".ToLowerInvariant().Replace(' ', '-');
    }

