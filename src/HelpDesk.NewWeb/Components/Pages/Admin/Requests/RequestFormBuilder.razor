    private string GetDependencySummary(RequestTaskTemplateModel task)
    {
        if (task.DependsOn.Count == 0)
        {
            return "None";
        }

        var lookup = Tasks.ToDictionary(x => x.Id, x => x.Name);
        var names = task.DependsOn
            .Where(x => lookup.ContainsKey(x))
            .Select(x => lookup[x])
            .ToList();
        return names.Count == 0 ? "None" : string.Join(", ", names);
    }

    private bool IsTaskConfigurationValid()
    {
        foreach (var task in Tasks)
        {
            if (string.IsNullOrWhiteSpace(task.Name))
            {
                Snackbar.Add("Every task must have a name.", Severity.Error);
                return false;
            }

            if (string.Equals(task.Type, "automation", StringComparison.OrdinalIgnoreCase))
            {
                var binding = GetBindingModel(task, createIfMissing: false);
                var hasBinding = binding is not null
                    && binding.Enabled
                    && !string.IsNullOrWhiteSpace(binding.OrchestrationRequestDefinitionId);
                if (!hasBinding)
                {
                    Snackbar.Add($"Automation task '{task.Name}' requires an enabled External orchestration binding.", Severity.Error);
                    return false;
                }
            }

            if (task.EscalateAfterMinutes.HasValue
                && task.TaskSlaMinutes.HasValue
                && task.EscalateAfterMinutes.Value > task.TaskSlaMinutes.Value)
            {
                Snackbar.Add($"Task '{task.Name}' has invalid SLA settings. Escalation threshold cannot exceed task SLA.", Severity.Error);
                return false;
            }

            if (!string.IsNullOrWhiteSpace(task.EscalationUserId)
                && !string.IsNullOrWhiteSpace(task.EscalationRole))
            {
                Snackbar.Add($"Task '{task.Name}' can only target one escalation target (user OR role).", Severity.Error);
                return false;
            }
        }

        if (HasCircularDependencies())
        {
            Snackbar.Add("Circular dependency detected.", Severity.Error);
            return false;
        }

        return true;
    }

