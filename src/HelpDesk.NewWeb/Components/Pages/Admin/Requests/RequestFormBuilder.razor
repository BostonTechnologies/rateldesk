@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? RequestFormId { get; set; }
    [Parameter] public string? ServiceId { get; set; }

    private MudForm form = default!;
    private readonly RequestFormModel model = new();
    private List<FormField> FormFields = new();
    private List<RequestTaskTemplateModel> Tasks = new();
    private RequestTaskTemplateModel? selectedTask;
    private bool saving;
    private const int SetupTab = 0;
    private const int FieldsTab = 1;
    private const int WorkflowTab = 2;
    private static readonly string[] WorkspaceTabs = ["Form setup", "Form fields", "Workflow"];
    private int activeWorkspaceTab = SetupTab;
    private readonly ElementReference[] workspaceTabElements = new ElementReference[3];
    private int? pendingTabFocus;
    private bool showMobileTaskEditor;
    private bool advancedExpanded;
    private Guid? invalidTaskId;
    private string? validationError;
    private string? saveError;
    private string? pendingFocus;
    private FormField? invalidField;
    private MudTextField<string>? formTitleInput;
    private MudTextField<string>? taskNameInput;
    private MudSelect<Guid?>? automationConnectionInput;
    private MudNumericField<int?>? escalationInput;
    private MudNumericField<int?>? taskSlaInput;
    private MudNumericField<int?>? expectedRuntimeInput;
    private MudNumericField<int?>? graceRuntimeInput;
    private MudSelect<Guid>? dependenciesInput;
    private MudSelect<string>? escalationUserInput;
    private MudButton? approvalBrowseButton;
    private MudButton? automationBrowseButton;
    private readonly Dictionary<FormField, MudTextField<string>> fieldLabelInputs = new();
    private string? initialDraftFingerprint;
    private string? renderedDialogState;
    private bool IsDirty => initialDraftFingerprint is not null && initialDraftFingerprint != DraftFingerprint();
    private string DraftFingerprint() => JsonSerializer.Serialize(new
    {
