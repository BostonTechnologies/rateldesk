        selectedTask.PayloadMapping ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        selectedTask.PayloadMapping[SelectedDraftJobParamKey!.Trim()] = SelectedDraftFieldKey!;
        ResetPayloadMappingDraft(selectedTask.Id);
