@page "/admin/customers"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using HelpDesk.NewWeb.Models

<PageTitle>Customers</PageTitle>

<AdminDirectoryWorkspace Title="Customers" Subtitle="Manage contacts and their application access."
                         TotalCount="source.TotalCount" Loaded="source.HasLoaded" Refreshing="source.IsLoading" Error="source.Error" OnRefresh="ReloadAsync">
    <PrimaryAction><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Create customer</MudButton></PrimaryAction>
    <ToolbarContent>
        <MudTextField T="string" Value="query.Search" ValueChanged="SearchChangedAsync" Label="Search name, email or organization"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" MaxLength="120" />
        <OrganizationDirectorySelector Value="@query.Get("organizationId")" ValueChanged="@(value => FilterChangedAsync("organizationId", value))" />
        <MudSelect T="string" Value="@(query.Get("enabled") ?? string.Empty)" ValueChanged="@(value => FilterChangedAsync("enabled", value))" Label="Customer state" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@(string.Empty)">All states</MudSelectItem><MudSelectItem Value="@("true")">Enabled</MudSelectItem><MudSelectItem Value="@("false")">Disabled</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Value="@(query.Get("access") ?? string.Empty)" ValueChanged="@(value => FilterChangedAsync("access", value))" Label="Access / invitation" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@(string.Empty)">All access states</MudSelectItem><MudSelectItem Value="@("unlinked")">No linked login</MudSelectItem><MudSelectItem Value="@("linked")">Linked login</MudSelectItem>
            <MudSelectItem Value="@("pending")">Pending</MudSelectItem><MudSelectItem Value="@("active")">Active</MudSelectItem><MudSelectItem Value="@("disabled")">Login disabled</MudSelectItem><MudSelectItem Value="@("failed")">Failed / needs review</MudSelectItem><MudSelectItem Value="@("expired")">Expired</MudSelectItem>
        </MudSelect>
        <MudButton OnClick="ClearAsync" Disabled="@(!query.HasFilters)" StartIcon="@Icons.Material.Outlined.FilterAltOff">Clear filters</MudButton>
    </ToolbarContent>
    <ChildContent>
        <MudTable T="CustomerDto" @ref="table" ServerData="LoadAsync" Dense="true" Hover="true" AllowUnsorted="false" FixedHeader="true" FixedFooter="true"
                  RowsPerPage="query.PageSize" @bind-CurrentPage="query.Page" Height="clamp(16rem, calc(100dvh - 24rem), 44rem)" Breakpoint="Breakpoint.None">
            <HeaderContent>
                <DirectorySortHeader Column="name" Label="Customer" Sort="query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="email" Label="Email" Sort="query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="organization" Label="Organization" Sort="query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="state" Label="State" Sort="query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <DirectorySortHeader Column="access" Label="Access" Sort="query.Sort" Descending="query.Descending" OnSort="SortChangedAsync" />
                <MudTh Class="directory-action-column">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Customer"><span class="directory-primary">@context.Name</span></MudTd>
                <MudTd DataLabel="Email"><span class="directory-secondary">@context.Email</span></MudTd>
                <MudTd DataLabel="Organization">@context.OrganizationName</MudTd>
                <MudTd DataLabel="State">@(context.IsEnabled ? "Enabled" : "Disabled")</MudTd>
                <MudTd DataLabel="Access">@(context.AuthStatus?.StatusText ?? "Access unavailable")</MudTd>
                <MudTd DataLabel="Actions"><div class="directory-actions">
                    <WorkspaceAction Label="Edit customer" Icon="@Icons.Material.Outlined.Edit" OnClick="() => OpenEditDialog(context)" />
                    <WorkspaceAction Label="@GetInviteActionLabel(context)" Icon="@GetInviteIcon(context.AuthStatus?.InviteStatus)"
                                     Disabled="@(IsInviteActionDisabled(context) || busyCustomerId == context.Id)" DisabledReason="@GetInviteTooltip(context)" OnClick="() => RunInviteAction(context)" />
                    <WorkspaceAction Label="Delete customer" Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="() => OpenDeleteDialog(context)" />
                </div></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>@(source.Error is not null ? "The directory is unavailable." : query.HasFilters ? "No customers match these filters." : "No customers yet. Create a customer to begin.")</MudText></NoRecordsContent>
            <LoadingContent><MudText>Loading customers…</MudText></LoadingContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" ShowFirstLast="true" /></PagerContent>
        </MudTable>
    </ChildContent>
</AdminDirectoryWorkspace>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "organizationId")] public string? QueryOrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "enabled")] public string? QueryEnabled { get; set; }
    [SupplyParameterFromQuery(Name = "access")] public string? QueryAccess { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public string? QueryPageSize { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
    [SupplyParameterFromQuery(Name = "descending")] public string? QueryDescending { get; set; }
    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private readonly AdminDirectoryQueryState query = new("organizationId", "enabled", "access");
    private readonly AdminDirectoryDataSource<CustomerDto> source = new();
    private MudTable<CustomerDto>? table;
    private string? busyCustomerId;

    protected override void OnParametersSet()
    {
        if (query.Read(NavigationManager.Uri) && table is not null) _ = table.ReloadServerData();
    }
    private async Task<TableData<CustomerDto>> LoadAsync(TableState state, CancellationToken ct)
    {
        var loading = source.LoadAsync(HelpdeskApi, query.ApiUrl("api/v1/admin/directories/customers", state), ct);
        await InvokeAsync(StateHasChanged);
        var data = await loading;
        if (source.Error is null) query.Page = source.Page;
        query.Remember(NavigationManager);
        await InvokeAsync(StateHasChanged);
        return data;
    }
    private Task ReloadAsync() => table?.ReloadServerData() ?? Task.CompletedTask;
    private async Task ResetPageAsync() { query.Page = 0; query.Remember(NavigationManager); if (table is not null) { table.NavigateTo(0); await table.ReloadServerData(); } }
    private Task SortChangedAsync(string column) { query.Descending = query.Sort == column && !query.Descending; query.Sort = column; return ResetPageAsync(); }
    private Task SearchChangedAsync(string? value) { query.Search = value; return ResetPageAsync(); }
    private Task FilterChangedAsync(string name, string? value) { query.Set(name, value); return ResetPageAsync(); }
    private Task ClearAsync() { query.Clear(); return ResetPageAsync(); }

    private async Task<List<OrganizationDto>> DialogOrganizationsAsync() => await HelpdeskApi.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations") ?? [];
    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Create Customer", new DialogParameters { ["Organizations"] = await DialogOrganizationsAsync() }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
    private async Task OpenEditDialog(CustomerDto customer)
    {
        var dialog = await DialogService.ShowAsync<EditCustomerDialog>("Edit Customer", new DialogParameters { ["Customer"] = customer, ["Organizations"] = await DialogOrganizationsAsync() }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
    private async Task OpenDeleteDialog(CustomerDto customer)
    {
        var dialog = await DialogService.ShowAsync<DeleteCustomerDialog>("Delete Customer", new DialogParameters { ["Customer"] = customer }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
    private async Task RunInviteAction(CustomerDto customer)
    {
        if (busyCustomerId is not null || IsInviteActionDisabled(customer)) return;
        busyCustomerId = customer.Id;
        var status = customer.AuthStatus?.InviteStatus ?? CustomerInviteStatus.NotInvited;
        var route = status is CustomerInviteStatus.Pending or CustomerInviteStatus.Failed or CustomerInviteStatus.Expired ? "resend-invite" : "invite";
        try
        {
            using var response = await HelpdeskApi.PostAsync($"api/v1/customers/{customer.Id}/auth/{route}", null);
            if (!response.IsSuccessStatusCode) Snackbar.Add($"Invitation could not be sent (HTTP {(int)response.StatusCode}). Review the customer access state and retry.", Severity.Error);
            else Snackbar.Add(route == "invite" ? "Invite sent." : "Invite resent.", Severity.Success);
            await ReloadAsync();
        }
        catch (HttpRequestException) { Snackbar.Add("Invitation service could not be reached. Review access state before retrying.", Severity.Error); }
        finally { busyCustomerId = null; }
    }
    private static bool IsInviteActionDisabled(CustomerDto customer)
    {
        if (!customer.IsEnabled)
        {
            return true;
        }

        var auth = customer.AuthStatus;
        var status = auth?.InviteStatus ?? CustomerInviteStatus.NotInvited;
        return status switch
        {
            CustomerInviteStatus.Pending or CustomerInviteStatus.Failed or CustomerInviteStatus.Expired => auth?.CanResend != true,
            CustomerInviteStatus.Active or CustomerInviteStatus.Disabled => true,
            _ => auth?.CanInvite != true
        };
    }

    private static string GetInviteActionLabel(CustomerDto customer)
    {
        var status = customer.AuthStatus?.InviteStatus ?? CustomerInviteStatus.NotInvited;
        return status switch
        {
            CustomerInviteStatus.Pending => "Resend invite",
            CustomerInviteStatus.Failed => "Retry invite",
            CustomerInviteStatus.Expired => "Resend invite",
            CustomerInviteStatus.Active => "Login active",
            CustomerInviteStatus.Disabled => "Login disabled",
            _ => "Invite"
        };
    }

    private static string GetInviteTooltip(CustomerDto customer) => !customer.IsEnabled
        ? "Enable the customer before inviting."
        : customer.AuthStatus?.HasMultipleIdentityLinks == true ? "Review the multiple linked identities before changing access."
        : customer.AuthStatus?.AuthProviderType == "Local" ? "Manage local account activation and sign-in in Team."
        : IsInviteActionDisabled(customer) ? customer.AuthStatus?.IdentitySummary ?? "Invitation requires an enabled organization and configured external invitation provider."
        : GetInviteActionLabel(customer);

    private static string GetInviteIcon(CustomerInviteStatus? status) => status switch
    {
        CustomerInviteStatus.Pending => Icons.Material.Filled.MarkEmailUnread,
        CustomerInviteStatus.Active => Icons.Material.Filled.VerifiedUser,
        CustomerInviteStatus.Disabled => Icons.Material.Filled.Block,
        CustomerInviteStatus.Failed => Icons.Material.Filled.Error,
        CustomerInviteStatus.Expired => Icons.Material.Filled.Update,
        _ => Icons.Material.Filled.PersonAdd
    };

    private static Color GetAuthStatusColor(CustomerInviteStatus? status) => status switch
    {
        CustomerInviteStatus.Pending => Color.Info,
        CustomerInviteStatus.Active => Color.Success,
        CustomerInviteStatus.Disabled => Color.Error,
        CustomerInviteStatus.Failed => Color.Error,
        CustomerInviteStatus.Expired => Color.Warning,
        _ => Color.Default
    };

    public void Dispose() => source.Dispose();
}
