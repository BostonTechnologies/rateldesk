@page "/admin/email-rules"
@attribute [Authorize(Roles = "HelpdeskAdmin")]
@using Helpdesk.Shared.DTOs.EmailRules
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.Enums
@inject IInboundEmailRuleAdminClient RulesClient
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Email Rules</PageTitle>

<MudPaper Class="pa-3 premium-workspace email-rules-workspace" data-testid="mailbox-rules" data-interactive="@interactive.ToString().ToLowerInvariant()">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h1">Email Rules</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Enabled rules can affect live inbound email processing.
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@loading"
                   OnClick="RefreshAsync">
            Refresh
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @loadError
        </MudAlert>
    }

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
    }

    <MudSelect T="Guid?" Label="Filter by source mailbox" @bind-Value="MailboxId" @bind-Value:after="LoadAuditAsync" Class="mb-3">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">All mailboxes</MudSelectItem>
        @foreach (var mailbox in mailboxes)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)mailbox.Id)">@mailbox.DisplayName — @mailbox.MailboxAddress @(mailbox.Archived ? "(archived)" : "")</MudSelectItem>
        }
    </MudSelect>
    @if (cloneSource is not null)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudText Typo="Typo.h6">Clone rule</MudText>
            <MudTextField Label="Cloned rule name" @bind-Value="cloneName" Immediate="true" MaxLength="200" />
            <MudTextField Label="Cloned rule description" @bind-Value="cloneDescription" Immediate="true" Lines="3" />
            <MudSelect T="string" Label="Cloned rule organization" @bind-Value="cloneOrganization">
                <MudSelectItem Value="@(string.Empty)">Global rule</MudSelectItem>
                @foreach (var organization in tenantNames)
                {
                    <MudSelectItem Value="organization.Key">@organization.Value</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption">The copy retains conditions and actions and starts disabled. Choose its source mailbox after saving.</MudText>
            <MudButton OnClick="SaveCloneAsync" Disabled="@(loading || string.IsNullOrWhiteSpace(cloneName))">Save disabled copy</MudButton>
            <MudButton OnClick="() => cloneSource = null">Cancel clone</MudButton>
        </MudPaper>
    }
    <MudTabs Rounded="true" Border="true" PanelClass="pt-3">
        <MudTabPanel Text="Rules" Icon="@Icons.Material.Filled.Rule">
            <div class="workspace-toolbar"><MudTextField T="string" Label="Search rules" @bind-Value="ruleSearch" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></div>
            @if (!loading && rules.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No inbound email rules found.</MudAlert>
            }
            else
            {
                <div class="email-rules-table-wrap">
                    <MudTable Items="OrderedRules" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="email-rules-table" RowsPerPage="25" FixedHeader="true" FixedFooter="true" Height="clamp(16rem, calc(100dvh - 23rem), 46rem)">
                        <HeaderContent>
                            <MudTh Class="email-rule-name">Name</MudTh>
                            <MudTh>Scope</MudTh>
                            <MudTh Class="email-rule-mailbox">Mailbox</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Processing</MudTh>
                            <MudTh Class="email-rules-actions"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name" Class="email-rule-name">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@context.Name</MudText>
                                    @if (!string.IsNullOrWhiteSpace(context.Description))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                                    }
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Scope"><MudStack Spacing="0"><MudText Typo="Typo.body2">@InboundEmailRuleLabels.Scope(context.ScopeType)</MudText><MudText Typo="Typo.caption">@TenantDisplay(context.TenantId)</MudText></MudStack></MudTd>
                            <MudTd DataLabel="Mailbox" Class="email-rule-mailbox"><MudSelect T="Guid?" Label="Source mailbox" Value="context.MailboxId" ValueChanged="id => BindMailboxAsync(context, id)" Disabled="@loading">
                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">All eligible mailboxes</MudSelectItem>
                                @foreach (var mailbox in mailboxes.Where(x => !x.Archived && (context.ScopeType == InboundEmailRuleScopeType.Global || x.OrganizationId == null || x.OrganizationId == context.TenantId)))
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)mailbox.Id)">@mailbox.DisplayName — @mailbox.MailboxAddress (@(mailbox.OrganizationId is null ? "Instance-global mailbox" : "Dedicated"))</MudSelectItem>
                                }
                            </MudSelect></MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Default)" Variant="Variant.Text">
                                    @(context.Enabled ? "Enabled" : "Disabled")
                                </MudChip>
                                <MudText Typo="Typo.caption">Updated @context.UpdatedAtUtc.ToLocalTime().ToString("g")</MudText>
                            </MudTd>
                            <MudTd DataLabel="Processing"><MudStack Spacing="0"><MudText Typo="Typo.body2">Priority @context.Priority</MudText><MudText Typo="Typo.caption">@(context.StopProcessing ? "Stop after match" : "Continue after match")</MudText></MudStack></MudTd>
                            <MudTd Class="email-rules-actions">
                                <WorkspaceAction Label="Clone rule" Icon="@Icons.Material.Filled.ContentCopy" OnClick="() => BeginClone(context)" />
                                <MudTooltip Text="Move up">
                                    <MudIconButton aria-label="Move up" Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                   Size="Size.Small"
                                                   Disabled="@(!CanMove(context, -1) || loading)"
                                                   OnClick="() => MoveRuleAsync(context, -1)" />
                                </MudTooltip>
                                <MudTooltip Text="Move down">
                                    <MudIconButton aria-label="Move down" Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                   Size="Size.Small"
                                                   Disabled="@(!CanMove(context, 1) || loading)"
                                                   OnClick="() => MoveRuleAsync(context, 1)" />
                                </MudTooltip>
                                <MudTooltip Text="View details">
                                    <MudIconButton aria-label="View details" Icon="@Icons.Material.Filled.Visibility"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="() => OpenDetailsAsync(context)" />
                                </MudTooltip>
                                @if (context.Enabled)
                                {
                                    <MudTooltip Text="Disable rule">
                                        <MudIconButton aria-label="Disable rule" Icon="@Icons.Material.Filled.ToggleOff"
                                                       Size="Size.Small"
                                                       Color="Color.Warning"
                                                       Disabled="@loading"
                                                       OnClick="() => DisableRuleAsync(context)" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudTooltip Text="Enable rule">
                                        <MudIconButton aria-label="Enable rule" Icon="@Icons.Material.Filled.ToggleOn"
                                                       Size="Size.Small"
                                                       Color="Color.Success"
                                                       Disabled="@loading"
                                                       OnClick="() => EnableRuleAsync(context)" />
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
                    </MudTable>
                </div>
            }
        </MudTabPanel>
        <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.ManageSearch">
            <div class="workspace-toolbar">
                <MudTextField T="string" Label="Search audit" @bind-Value="auditSearch" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="string" @bind-Value="auditStatus" Label="Outcome" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@AllStatusesValue">All outcomes</MudSelectItem>
                    @foreach (var status in Enum.GetValues<InboundEmailProcessingStatus>())
                    { <MudSelectItem Value="@status.ToString()">@InboundEmailRuleLabels.Status(status)</MudSelectItem> }
                </MudSelect>
                <MudSelect T="string" @bind-Value="auditTenantId" Label="Organization" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var org in tenantNames) { <MudSelectItem Value="@org.Key">@org.Value</MudSelectItem> }
                </MudSelect>
                <MudSelect T="string" @bind-Value="auditRuleId" Label="Rule" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var rule in rules) { <MudSelectItem Value="@rule.Id">@rule.Name</MudSelectItem> }
                </MudSelect>
                <MudButton OnClick="LoadAuditAsync" Disabled="auditLoading" Variant="Variant.Outlined">Apply</MudButton>
            </div>
            <details class="mb-2"><summary>Advanced · exact IDs and dates</summary>
                <div class="workspace-toolbar">
                    <MudTextField T="string" Label="Organization ID" @bind-Value="auditTenantId" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" Label="Rule ID" @bind-Value="auditRuleId" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" Label="Message ID" @bind-Value="auditMessageId" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" Label="Ticket ID" @bind-Value="auditTicketId" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" Label="Created from (UTC)" InputType="InputType.DateTimeLocal" @bind-Value="auditFrom" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" Label="Created to (UTC)" InputType="InputType.DateTimeLocal" @bind-Value="auditTo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
            </details>
            @if (auditError is not null) { <MudAlert Severity="Severity.Error">@auditError <MudButton OnClick="LoadAuditAsync">Retry</MudButton></MudAlert> }
            <MudTable T="InboundEmailAuditRow" @ref="auditTable" ServerData="LoadAuditPageAsync" Dense="true" Hover="true"
                      RowsPerPage="25" FixedHeader="true" FixedFooter="true" Breakpoint="Breakpoint.Sm"
                      Height="clamp(16rem, calc(100dvh - 26rem), 46rem)" Class="email-audit-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="InboundEmailAuditRow" SortLabel="created" InitialDirection="SortDirection.Descending">Time</MudTableSortLabel></MudTh>
                    <MudTh>Rule</MudTh><MudTh>Organization / mailbox</MudTh>
                    <MudTh><MudTableSortLabel T="InboundEmailAuditRow" SortLabel="action">Action</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="InboundEmailAuditRow" SortLabel="status">Outcome</MudTableSortLabel></MudTh>
                    <MudTh>Ticket</MudTh><MudTh>Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Time">@context.Event.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Rule"><MudTooltip Text="@context.RuleName"><span class="workspace-primary">@context.RuleName</span></MudTooltip></MudTd>
                    <MudTd DataLabel="Organization / mailbox"><span class="workspace-primary">@context.OrganizationName</span><MudTooltip Text="@context.MailboxName"><span class="workspace-secondary">@context.MailboxName</span></MudTooltip></MudTd>
                    <MudTd DataLabel="Action"><span class="workspace-primary" title="@ActionDisplay(context.Event.ActionKey)">@ActionDisplay(context.Event.ActionKey)</span></MudTd>
                    <MudTd DataLabel="Outcome"><MudText Typo="Typo.body2" Color="@InboundEmailRuleLabels.StatusColor(context.Event.Status)">@InboundEmailRuleLabels.Status(context.Event.Status)</MudText></MudTd>
                    <MudTd DataLabel="Ticket">
                        @if (context.TicketRoute is not null) { <MudLink Href="@context.TicketRoute">@context.TicketTrackingId</MudLink> }
                        else { <span>@(context.Event.TicketId is null ? "—" : "Unavailable ticket")</span> }
                    </MudTd>
                    <MudTd DataLabel="Details"><WorkspaceAction Label="Audit details" Icon="@Icons.Material.Outlined.Info" OnClick="() => auditDetail = context" /></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>@(auditError is null ? "No audit events match these filters." : "Audit history unavailable. Retry the request.")</MudText></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@if (auditDetail is not null)
{
    <MudDrawer Class="premium-workspace" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
               Width="min(560px, 100vw)" Open="true" OpenChanged="open => { if (!open) auditDetail = null; }">
        <div class="pa-4" role="region" aria-label="Audit details">
            <div class="workspace-actions">
                <MudText Typo="Typo.h6">Audit details</MudText><MudSpacer />
                <WorkspaceAction Label="Copy diagnostics" Icon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAuditAsync" />
                <WorkspaceAction Label="Close details" Icon="@Icons.Material.Filled.Close" OnClick="() => auditDetail = null" />
            </div>
            <pre class="workspace-diagnostics">@System.Text.Json.JsonSerializer.Serialize(auditDetail.Event, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
        </div>
    </MudDrawer>
}


@code {
    private bool interactive;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
    }

    [SupplyParameterFromQuery(Name = "mailboxId")] public Guid? MailboxId { get; set; }
    private InboundEmailRuleDto? cloneSource;
    private string cloneName = string.Empty;
    private string? cloneDescription;
    private string cloneOrganization = string.Empty;
    private void BeginClone(InboundEmailRuleDto rule)
    {
        cloneSource = rule;
        cloneName = rule.Name + " (copy)";
        cloneDescription = rule.Description;
        cloneOrganization = rule.TenantId ?? string.Empty;
    }
    private async Task SaveCloneAsync()
    {
        if (cloneSource is null) return;
        loading = true;
        try
        {
            var tenant = string.IsNullOrWhiteSpace(cloneOrganization) ? null : cloneOrganization;
            await RulesClient.CreateAsync(new CreateInboundEmailRuleRequest(
                tenant is null ? InboundEmailRuleScopeType.Global : InboundEmailRuleScopeType.Tenant,
                tenant, null, cloneName, cloneDescription, false, cloneSource.Priority,
                cloneSource.Conditions, cloneSource.Actions, cloneSource.StopProcessing));
            cloneSource = null;
            await RefreshAsync();
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add("The copy could not be saved. Check organization and mailbox conditions.", Severity.Error);
        }
        finally { loading = false; }
    }
    private List<EmailInboxSettingsDto> mailboxes = [];
    private const string AllStatusesValue = "";

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");
    private readonly List<InboundEmailRuleDto> rules = new();
    private MudTable<InboundEmailAuditRow>? auditTable;
    private InboundEmailAuditRow? auditDetail;
    private string? auditError, auditSearch, auditRuleId, auditFrom, auditTo, ruleSearch;
    private async Task BindMailboxAsync(InboundEmailRuleDto rule, Guid? mailboxId)
    {
        var request = new UpdateInboundEmailRuleRequest(rule.ScopeType, rule.TenantId, mailboxId, rule.Name,
            rule.Description, rule.Enabled, rule.Priority, rule.Conditions, rule.Actions, rule.StopProcessing);
        try
        {
            await RulesClient.UpdateAsync(rule.Id, request);
            await RefreshAsync();
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add("Mailbox binding was rejected. Check organization, source status and MailboxEquals conditions.", Severity.Error);
        }
    }

    private readonly Dictionary<string, string> tenantNames = new(StringComparer.OrdinalIgnoreCase);
    private bool loading;
    private bool auditLoading;
    private string? loadError;
    private string? auditMessageId;
    private string? auditTicketId;
    private string? auditTenantId;
    private string auditStatus = AllStatusesValue;

    private List<InboundEmailRuleDto> OrderedRules => rules
        .Where(x => string.IsNullOrWhiteSpace(ruleSearch) ||
            $"{x.Name} {x.Description} {TenantDisplay(x.TenantId)}".Contains(ruleSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(x => !MailboxId.HasValue || x.MailboxId == null || x.MailboxId == MailboxId)
        .OrderByDescending(x => x.ScopeType == InboundEmailRuleScopeType.Tenant)
        .ThenBy(x => x.TenantId)
        .ThenBy(x => x.MailboxId)
        .ThenBy(x => x.Priority)
        .ThenBy(x => x.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        loadError = null;
        try
        {
            mailboxes = await HttpClientFactory.CreateClient("HelpdeskApi").GetFromJsonAsync<List<EmailInboxSettingsDto>>("api/v1/email-settings") ?? [];

            await LoadTenantsAsync();
            rules.Clear();
            rules.AddRange(await RulesClient.GetRulesAsync());
            await LoadAuditAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Snackbar.Add($"Could not load inbound email rules: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            var tenants = await HelpdeskApi.GetFromJsonAsync<List<TenantLookupDto>>("api/v1/admin/tenants/lookup") ?? [];
            tenantNames.Clear();
            foreach (var tenant in tenants)
            {
                tenantNames[tenant.Id] = tenant.Name;
            }
        }
        catch
        {
            tenantNames.Clear();
        }
    }

    private Task LoadAuditAsync()
    {
        auditDetail = null;
        if (auditTable?.CurrentPage > 0) { auditTable.NavigateTo(0); return Task.CompletedTask; }
        return auditTable?.ReloadServerData() ?? Task.CompletedTask;
    }

    private async Task<TableData<InboundEmailAuditRow>> LoadAuditPageAsync(TableState state, CancellationToken ct)
    {
        auditLoading = true; auditError = null;
        try
        {
            var first = ParseUtc(auditFrom); var last = ParseUtc(auditTo);
            var query = new InboundEmailAuditQuery(auditSearch, auditMessageId, auditTicketId, auditTenantId, MailboxId,
                auditRuleId, Enum.TryParse<InboundEmailProcessingStatus>(auditStatus, out var outcome) ? outcome : null,
                first, last, state.SortLabel ?? "created", state.SortDirection != SortDirection.Ascending, state.Page, state.PageSize);
            var page = await RulesClient.SearchAuditAsync(query, ct);
            return new() { Items = page.Items, TotalItems = page.Total };
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
        catch (Exception)
        {
            auditError = "Could not load audit history. Check the filters and retry.";
            return new() { Items = [], TotalItems = 0 };
        }
        finally { auditLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private static DateTimeOffset? ParseUtc(string? value) => string.IsNullOrWhiteSpace(value) ? null :
        DateTimeOffset.Parse(value, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal);

    private async Task CopyAuditAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", System.Text.Json.JsonSerializer.Serialize(auditDetail?.Event)); }
        catch (JSException) { Snackbar.Add("Select and copy the diagnostics; clipboard access is unavailable.", Severity.Info); }
    }

    private async Task EnableRuleAsync(InboundEmailRuleDto rule)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Enable Email Rule",
            $"Enable '{rule.Name}'? Enabled rules can affect live inbound email processing.",
            yesText: "Enable",
            cancelText: "Cancel");
        if (confirm != true)
        {
            return;
        }

        try
        {
            await RulesClient.EnableAsync(rule.Id);
            Snackbar.Add("Email rule enabled.", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Enable failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DisableRuleAsync(InboundEmailRuleDto rule)
    {
        try
        {
            await RulesClient.DisableAsync(rule.Id);
            Snackbar.Add("Email rule disabled.", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Disable failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task MoveRuleAsync(InboundEmailRuleDto rule, int direction)
    {
        var group = ReorderGroup(rule);
        var index = group.FindIndex(x => x.Id == rule.Id);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= group.Count)
        {
            return;
        }

        var currentPriority = group[index].Priority;
        var targetPriority = group[targetIndex].Priority;
        var payload = group
            .Select(x => new InboundEmailRulePriorityDto(
                x.Id,
                x.Id == group[index].Id
                    ? targetPriority
                    : x.Id == group[targetIndex].Id
                        ? currentPriority
                        : x.Priority))
            .ToList();

        try
        {
            await RulesClient.ReorderAsync(payload);
            Snackbar.Add("Email rule order updated.", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Reorder failed: {ex.Message}", Severity.Error);
        }
    }

    private bool CanMove(InboundEmailRuleDto rule, int direction)
    {
        var group = ReorderGroup(rule);
        var index = group.FindIndex(x => x.Id == rule.Id);
        var targetIndex = index + direction;
        return index >= 0 && targetIndex >= 0 && targetIndex < group.Count;
    }

    private List<InboundEmailRuleDto> ReorderGroup(InboundEmailRuleDto rule) => rules
        .Where(x => x.ScopeType == rule.ScopeType &&
                    string.Equals(x.TenantId, rule.TenantId, StringComparison.OrdinalIgnoreCase) &&
                    x.MailboxId == rule.MailboxId)
        .OrderBy(x => x.Priority)
        .ThenBy(x => x.Name)
        .ToList();

    private async Task OpenDetailsAsync(InboundEmailRuleDto rule)
    {
        var latest = await RulesClient.GetRuleAsync(rule.Id) ?? rule;
        var parameters = new DialogParameters<InboundEmailRuleDetailsDialog>
        {
            { x => x.Rule, latest },
            { x => x.TenantDisplay, TenantDisplay(latest.TenantId) }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<InboundEmailRuleDetailsDialog>("Email Rule Details", parameters, options);
    }

    private string TenantDisplay(string? tenantId)
    {
        if (string.IsNullOrWhiteSpace(tenantId))
        {
            return "-";
        }

        return tenantNames.TryGetValue(tenantId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : "Unknown organization";
    }

    private string RuleDisplay(string? ruleId)
    {
        if (string.IsNullOrWhiteSpace(ruleId))
        {
            return "-";
        }

        var rule = rules.FirstOrDefault(x => string.Equals(x.Id, ruleId, StringComparison.OrdinalIgnoreCase));
        return rule is null ? "Deleted rule" : rule.Name;
    }

    private static string ActionDisplay(string actionKey)
    {
        if (Enum.TryParse<InboundEmailRuleActionType>(actionKey, ignoreCase: true, out var parsed))
        {
            return InboundEmailRuleLabels.Action(new InboundEmailRuleActionConfig(parsed, actionKey));
        }

        return HelpDesk.NewWeb.Models.WorkspaceLabels.Readable(actionKey);
    }
}
