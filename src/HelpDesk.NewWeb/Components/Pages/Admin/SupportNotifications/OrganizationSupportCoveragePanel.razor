@inherits HelpDesk.NewWeb.Components.Shared.Admin.AdminActionPanelBase
@using HelpDesk.NewWeb.Services
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.SupportNotifications
@inject ISupportNotificationAdminClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-2" Elevation="0">
<fieldset disabled="@IsBusy" class="routing-editor-controls">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <div>
            <MudText Typo="Typo.h6">Support Coverage</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">Routes tickets for this organization to provider-owned support groups.</MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@string.IsNullOrWhiteSpace(SelectedOrganizationId)"
                   OnClick="@(() => RunActionAsync(OpenCreateDialogAsync))">
            Add Route
        </MudButton>
    </MudStack>

    @if (Rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            No coverage routes are configured for this organization.
        </MudAlert>
    }
    else
    {
        <MudTable Items="Rows.OrderByDescending(x => x.IsEnabled).ThenBy(x => x.Role).ThenBy(x => ProviderName(x.ProviderOrganizationId))" Dense="true" Hover="true" RowsPerPage="25" Breakpoint="Breakpoint.Sm">
            <HeaderContent><MudTh>Coverage role</MudTh><MudTh>Provider</MudTh><MudTh>Support group</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Coverage role">@SupportNotificationLabels.CoverageRole(context.Role)</MudTd>
                <MudTd DataLabel="Provider">@ProviderName(context.ProviderOrganizationId)</MudTd>
                <MudTd DataLabel="Support group">@SupportGroupName(context.SupportGroupId)</MudTd>
                <MudTd DataLabel="Status">@(context.IsEnabled ? "Enabled" : "Disabled")</MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" OnClick="@(() => RunActionAsync(() => OpenEditDialogAsync(context)))">Edit</MudButton>
                        <MudButton Size="Size.Small" OnClick="@(() => RunActionAsync(() => ToggleEnabledAsync(context)))">@(context.IsEnabled ? "Disable" : "Enable")</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => RunActionAsync(() => DeleteAsync(context)))">Delete</MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" /></PagerContent>
        </MudTable>
    }
</fieldset>
</MudPaper>

@code {
    [Parameter] public string? SelectedOrganizationId { get; set; }
    [Parameter] public List<OrganizationSupportCoverageDto> Rows { get; set; } = new();
    [Parameter] public List<OrganizationDto> Organizations { get; set; } = new();
    [Parameter] public List<SupportGroupDto> SupportGroups { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = DialogParameters(null);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<OrganizationSupportCoverageDialog>("Add Coverage Route", parameters, options);
        var result = await dialog.Result;
        if (IsDisposed || result?.Canceled != false || result.Data is not OrganizationSupportCoverageDialog.CoverageFormModel model)
        {
            return;
        }

        try
        {
            await Client.CreateCoverageAsync(new CreateOrganizationSupportCoverageDto
            {
                CustomerOrganizationId = model.CustomerOrganizationId,
                ProviderOrganizationId = model.ProviderOrganizationId,
                SupportGroupId = model.SupportGroupId,
                Role = model.Role,
                IsEnabled = model.IsEnabled
            });
            Snackbar.Add("Coverage route created.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditDialogAsync(OrganizationSupportCoverageDto row)
    {
        var parameters = DialogParameters(row);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<OrganizationSupportCoverageDialog>("Edit Coverage Route", parameters, options);
        var result = await dialog.Result;
        if (IsDisposed || result?.Canceled != false || result.Data is not OrganizationSupportCoverageDialog.CoverageFormModel model)
        {
            return;
        }

        try
        {
            await Client.UpdateCoverageAsync(row.Id, new UpdateOrganizationSupportCoverageDto
            {
                CustomerOrganizationId = model.CustomerOrganizationId,
                ProviderOrganizationId = model.ProviderOrganizationId,
                SupportGroupId = model.SupportGroupId,
                Role = model.Role,
                IsEnabled = model.IsEnabled
            });
            Snackbar.Add("Coverage route saved.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleEnabledAsync(OrganizationSupportCoverageDto row)
    {
        try
        {
            await Client.UpdateCoverageAsync(row.Id, new UpdateOrganizationSupportCoverageDto
            {
                CustomerOrganizationId = row.CustomerOrganizationId,
                ProviderOrganizationId = row.ProviderOrganizationId,
                SupportGroupId = row.SupportGroupId,
                Role = row.Role,
                IsEnabled = !row.IsEnabled
            });
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(OrganizationSupportCoverageDto row)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Coverage Route",
            $"Delete the route to {SupportGroupName(row.SupportGroupId)}?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (IsDisposed || confirm != true)
        {
            return;
        }

        try
        {
            await Client.DeleteCoverageAsync(row.Id);
            Snackbar.Add("Coverage route deleted.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private DialogParameters DialogParameters(OrganizationSupportCoverageDto? row) => new()
    {
        ["Coverage"] = row,
        ["DefaultCustomerOrganizationId"] = SelectedOrganizationId,
        ["Organizations"] = Organizations,
        ["SupportGroups"] = SupportGroups
    };

    private string ProviderName(string? id)
        => Organizations.FirstOrDefault(x => string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase))?.Name
           ?? id
           ?? "-";

    private string SupportGroupName(string? id)
        => SupportGroups.FirstOrDefault(x => string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase))?.Name
           ?? id
           ?? "-";
}
