@inject HelpDesk.NewWeb.Models.WebAuthenticationMode AuthenticationMode
@page "/login"
@page "/login/two-factor"
@attribute [AllowAnonymous]

@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpClientFactory HttpClientFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider Protection
@using System.Net.Http.Json

<PageTitle>@_branding.ApplicationName</PageTitle>
<HeadContent><link rel="icon" href="@_branding.FaviconUrl" /></HeadContent>

<section class="helpdesk-login-page" data-testid="login-page" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <MudPaper Elevation="2" Class="helpdesk-login-panel">
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="helpdesk-login-header">
            <img class="helpdesk-login-logo" src="@_branding.CompactLogoUrl" alt="@_branding.ApplicationName" />
            <MudText Typo="Typo.overline" HtmlTag="p" Class="helpdesk-login-product">Service management</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-login-title">@_branding.ApplicationName</MudText>
            <MudText Typo="Typo.body2" HtmlTag="p" Class="helpdesk-login-environment">@EnvironmentLabel</MudText>
        </MudStack>

        <MudStack Spacing="2" Class="helpdesk-login-actions">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="helpdesk-login-copy">
                Continue to @_branding.ApplicationName using your authorised account.
            </MudText>

            @if (SignInError is not null)
            {
                <MudAlert Severity="Severity.Error" data-testid="local-login-error">@SignInError</MudAlert>
            }

            @if (SupportsLocalAccounts)
            {
                @if (IsSecondFactorStep)
                {
                    <MudText Typo="Typo.h6" HtmlTag="h2">Verify your sign-in</MudText>
                    <MudText Typo="Typo.body2">Enter the code from your authenticator app. You can also use one of the recovery codes saved when you enabled two-factor authentication.</MudText>
                    <form method="post" action="/local-login/two-factor" class="helpdesk-login-local-form" data-testid="local-two-factor-form" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
                        <AntiforgeryToken />
                        <MudTextField T="string" Name="code" Disabled="@(!RendererInfo.IsInteractive)" Label="Verification code" autocomplete="one-time-code" Required="true" Variant="Variant.Outlined" FullWidth="true" />
                        <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!RendererInfo.IsInteractive)" Size="Size.Large" Color="Color.Primary" FullWidth="true" Class="mt-3">Verify and sign in</MudButton>
                    </form>
                    <MudLink Href="/login" Class="align-self-center">Back to sign in</MudLink>
                }
                else
                {
                    <form method="post" action="/local-login" class="helpdesk-login-local-form" data-testid="local-login-form" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
                        <AntiforgeryToken />
                        <MudTextField T="string" Name="email" Disabled="@(!RendererInfo.IsInteractive)" Label="Email" InputType="InputType.Email" autocomplete="username" Required="true" Variant="Variant.Outlined" FullWidth="true" />
                        <MudTextField T="string" Name="password" Disabled="@(!RendererInfo.IsInteractive)" Label="Password" InputType="InputType.Password" autocomplete="current-password" Required="true" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" />
                        <MudCheckBox T="bool" Name="rememberMe" Disabled="@(!RendererInfo.IsInteractive)" Label="Keep me signed in" Color="Color.Primary" Class="mt-2" />
                        <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!RendererInfo.IsInteractive)" Size="Size.Large" Color="Color.Primary" FullWidth="true" Class="mt-3" StartIcon="@Icons.Material.Filled.Login">
                            Sign in to @_branding.ApplicationName
                        </MudButton>
                    </form>
                }
            }

            @if (!IsSecondFactorStep && SupportsLocalAccounts && SupportsOidc)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.body2" Align="Align.Center">or use your organization sign-in</MudText>
            }

            @if (!IsSecondFactorStep && SupportsOidc)
            {
                <nav class="helpdesk-login-providers" aria-label="Organization sign-in">
                    <a class="helpdesk-login-provider-link" href="/login-authentik" data-testid="oidc-login-link">
                        <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" aria-hidden="true" />
                        <span>Sign in with @ProviderDisplayName</span>
                    </a>
                </nav>
            }

            @if (Env.IsDevelopment())
            {
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="helpdesk-login-dev-copy">
                    Local development access is enabled for runtime investigations.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           FullWidth="true"
                           Class="helpdesk-login-dev-action"
                           Href="/auth/development">
                    Sign in as local operator
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? SignInStatus { get; set; }

    private string? SignInError => SignInStatus switch
    {
        "Authentication failed" => "Organization sign-in could not be completed. Please try again or contact your administrator.",
        "Email and password are required" => "Enter your email and password to sign in.",
        "Too many sign-in attempts. Please retry shortly." or "rate-limited" => "Too many sign-in attempts. Please retry shortly.",
        "Sign-in failed" => "Sign-in failed. Check your email and password.",
        "service-unavailable" => "Sign-in is temporarily unavailable. Please try again shortly.",
        "form-expired" => "Your sign-in form expired. Please try again.",
        "service-link-sign-in-required" => "Sign in to review the connection. Approval resumes automatically.",
        "verification-expired" => "Your verification session expired. Enter your email and password to try again.",
        "invalid-code" when IsSecondFactorStep => "That verification code was not accepted. Please try again.",
        "code-required" when IsSecondFactorStep => "Enter your verification code to continue.",
        _ => null
    };

    private bool IsSecondFactorStep => string.Equals(new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'), "/login/two-factor", StringComparison.OrdinalIgnoreCase);

    private BrandingSnapshot _branding = new();
    protected override async Task OnInitializedAsync()
    {
        if (IsSecondFactorStep && (!SupportsLocalAccounts ||
            LocalBrowserLoginEndpoints.ReadChallenge(HttpContextAccessor.HttpContext, Config, Protection) is null))
        {
            Navigation.NavigateTo("/login?status=verification-expired", forceLoad: true, replace: true);
            return;
        }

        try
        {
            _branding = await HttpClientFactory.CreateClient("HelpdeskApi")
                .GetFromJsonAsync<BrandingSnapshot>("api/v1/branding") ?? _branding;
        }
        catch (HttpRequestException exception)
        {
            System.Diagnostics.Debug.WriteLine($"Branding endpoint unavailable while rendering login: {exception.Message}");
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        Navigation.NavigateTo(ServiceLinkBrowserEndpoints.SignInDestination(HttpContextAccessor.HttpContext, Config), forceLoad: true, replace: true);
    }

    private string EnvironmentLabel =>
        Config["LoginUi:EnvironmentLabel"]?.Trim() is { Length: > 0 } label
            ? label
            : "Production system";

    private bool SupportsLocalAccounts => AuthenticationMode.SupportsLocalAccounts;
    private bool SupportsOidc => AuthenticationMode.UsesOidc;
    private string ProviderDisplayName => Config["LoginUi:ProviderDisplayName"]?.Trim() is { Length: > 0 } name
        ? name
        : "Authentik";

    private sealed class BrandingSnapshot
    {
        public string ApplicationName { get; set; } = "RatelDesk";
        public string CompactLogoUrl { get; set; } = "/branding/rateldesk-mark.webp";
        public string FaviconUrl { get; set; } = "/favicon.ico";
    }
}
