@using HelpDesk.NewWeb.Models
@using Helpdesk.Shared.Services
@page "/tasks"
@implements IDisposable
@attribute [Authorize(Roles = "Request.Read,Request.Write,Request.Execute,Request.Manager,HelpdeskAdmin")]

@using System.Net.Http.Json
@using System.Security.Claims
@using Helpdesk.Shared.DTOs
@using Helpdesk.Shared.DTOs.Request
@using Helpdesk.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Tasks</PageTitle>

<MudPaper Class="pa-3 premium-workspace task-workspace">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6" HtmlTag="h1">Tasks</MudText>
        <MudSpacer />
        <MudTooltip Text="Historic">
            <MudIconButton aria-label="Show historic tasks" Icon="@Icons.Material.Filled.History"
                           Color="@(historicOnly ? Color.Primary : Color.Default)"
                           Variant="@(historicOnly ? Variant.Filled : Variant.Outlined)"
                           OnClick="ToggleHistoric" />
        </MudTooltip>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reload">Refresh</MudButton>
    </MudStack>

    <div class="workspace-toolbar">
        <TicketFilterLookup Module="task" Dimension="customer" Label="Tenant" Selected="SelectTenantAsync" />
        <MudSwitch T="bool" Value="assignedToMe" ValueChanged="OnAssignedToMeChanged" Color="Color.Primary" Label="Assigned to me" />
        <MudSelect T="RequestTaskStatus?" Value="statusFilter" ValueChanged="OnStatusChanged" Label="Status" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="RequestTaskStatus?" Value="@((RequestTaskStatus?)null)">All</MudSelectItem>
            @foreach (var status in Enum.GetValues<RequestTaskStatus>()) { <MudSelectItem T="RequestTaskStatus?" Value="status">@WorkspaceLabels.Readable(status.ToString())</MudSelectItem> }
        </MudSelect>
        <MudSelect T="RequestTaskType?" Value="typeFilter" ValueChanged="OnTypeChanged" Label="Type" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="RequestTaskType?" Value="@((RequestTaskType?)null)">All</MudSelectItem>
            @foreach (var type in Enum.GetValues<RequestTaskType>()) { <MudSelectItem T="RequestTaskType?" Value="type">@type</MudSelectItem> }
        </MudSelect>
        <MudTextField T="string" Value="@search" ValueChanged="OnSearchChanged" Label="Search tasks" Immediate="true"
                      OnKeyUp="@(async _ => await DebouncedReload())" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Variant="Variant.Outlined" />
    </div>
    <div class="filter-chips" aria-label="Selected tenants">
        @foreach (var id in organizationIds)
        { <button type="button" class="task-tenant-chip" @onclick="() => RemoveTenantAsync(id)" aria-label="@($"Remove tenant {organizationLabels.GetValueOrDefault(id, id)}")">Tenant: @organizationLabels.GetValueOrDefault(id, id) <span aria-hidden="true">×</span></button> }
    </div>
    <details><summary>Advanced · request and service IDs</summary><MudGrid>        <MudItem xs="12" md="2">
            <MudTextField T="string" Value="@requestIdFilter" ValueChanged="OnRequestIdChanged" Label="Request ID" Dense="true" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudTextField T="string" Value="@serviceIdFilter" ValueChanged="OnServiceIdChanged" Label="Service ID" Dense="true" Variant="Variant.Outlined" />
        </MudItem>
</MudGrid></details>
    @if (loadError is not null) { <MudAlert Severity="Severity.Error">@loadError <MudButton OnClick="Reload">Retry</MudButton></MudAlert> }


    @if (_selected.Count > 0)
    {
        <MudPaper Class="pa-2 mb-2" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.body2">@_selected.Count selected</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(bulkBusy || !CanBulkOperate)" OnClick="BulkStartAsync">Bulk Start</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Disabled="@(bulkBusy || !CanBulkOperate)" OnClick="BulkCompleteAsync">Bulk Complete</MudButton>
                @if (profile?.HasPermission("Request.Execute") == true || isAdmin)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" Disabled="@(bulkBusy || !CanBulkOperate)" OnClick="BulkRetryAsync">Bulk Retry</MudButton>
                }
            </MudStack>
        </MudPaper>
    }

    <MudTable T="RequestTaskListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              MultiSelection="true"
              SelectedItems="_selected"
              SelectedItemsChanged="@(x => _selected = x)"
              Dense="true"
              Hover="true" RowsPerPage="25" FixedHeader="true" FixedFooter="true"
              Height="clamp(16rem, calc(100dvh - 23rem), 46rem)" Breakpoint="Breakpoint.Sm" Class="compact-table" data-table-surface="pages-tasks-taskdashboard-1">
        <ColGroup><col style="width:44px" /><col style="width:40px" /><col /><col /><col style="width:144px" /><col style="width:128px" /><col style="width:132px" /><col style="width:112px" /></ColGroup>
        <HeaderContent>
            <MudTh><span class="task-accessible-label">Details</span></MudTh><MudTh>Request</MudTh><MudTh>Task</MudTh><MudTh>Status</MudTh><MudTh>Assignee</MudTh><MudTh>Created</MudTh><MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Details">
                <MudIconButton Icon="@(expandedTasks.Contains(context.Id) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                    Size="Size.Small" Color="Color.Default" OnClick="() => ToggleDetails(context.Id)"
                    aria-label="@($"{(expandedTasks.Contains(context.Id) ? "Collapse" : "Expand")} details for {context.Name}")"
                    aria-expanded="@expandedTasks.Contains(context.Id).ToString().ToLowerInvariant()" aria-controls="@DetailsId(context)" />
            </MudTd>
            <MudTd DataLabel="Request">
                <MudLink Href="@($"/requests/{context.RequestId}")">@context.RequestTrackingId</MudLink>
                <MudTooltip Text="@context.RequestTitle"><span class="workspace-secondary">@context.RequestTitle</span></MudTooltip>
            </MudTd>
            <MudTd DataLabel="Task">
                <MudTooltip Text="@context.Name"><span class="workspace-primary">@context.Name</span></MudTooltip>
                <div class="workspace-actions">
                    <span class="workspace-secondary">@context.Type</span>
                    @if (context.Type == RequestTaskType.Automation && context.AutomationBindingSyncState is { } binding)
                    {
                        <MudTooltip Text="@($"Binding: {WorkspaceLabels.Readable(binding.ToString())}")">
                            <MudIcon Icon="@(binding == AutomationBindingSyncState.InSync ? Icons.Material.Outlined.Link : Icons.Material.Outlined.LinkOff)"
                                     Size="Size.Small" Color="@(binding == AutomationBindingSyncState.InSync ? Color.Default : GetBindingStateColor(binding))"
                                     aria-label="@($"Binding: {WorkspaceLabels.Readable(binding.ToString())}")" />
                        </MudTooltip>
                    }
                </div>
                @if (context.Type == RequestTaskType.Automation && !string.IsNullOrWhiteSpace(context.AutomationBlockReason))
                { <MudTooltip Text="@context.AutomationBlockReason"><span class="workspace-secondary">@context.AutomationBlockReason</span></MudTooltip> }
            </MudTd>
            <MudTd DataLabel="Status">
                <MudText Typo="Typo.body2" Color="@(RequiresManualReconciliation(context.LastAutomationStatus) ? Color.Warning : GetTaskStatusColor(context.Status))">@(RequiresManualReconciliation(context.LastAutomationStatus) ? (context.AutomationTimedOutAt.HasValue ? "Timed out — outcome unknown" : "Needs reconciliation") : context.Type == RequestTaskType.Automation && context.Status == RequestTaskStatus.InProgress ? "In progress" : WorkspaceLabels.Readable(context.Status.ToString()))</MudText>
                @if (context.Type == RequestTaskType.Automation && !string.IsNullOrWhiteSpace(context.LastAutomationStatus))
                {
                    <MudTooltip Text="@($"External orchestration: {WorkspaceLabels.Readable(context.LastAutomationStatus)}")">
                        <span class="workspace-secondary">External: @(RequiresManualReconciliation(context.LastAutomationStatus) ? "Reconciliation required" : WorkspaceLabels.Readable(context.LastAutomationStatus))</span>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Assignee"><MudTooltip Text="@GetAssigneeDisplay(context)"><span class="workspace-primary">@GetAssigneeDisplay(context)</span></MudTooltip></MudTd>
            <MudTd DataLabel="Created"><span>@context.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")</span><span class="workspace-secondary">@context.CreatedAt.LocalDateTime.ToString("HH:mm")</span></MudTd>
            <MudTd DataLabel="Actions">
                <div class="workspace-actions" @onclick:stopPropagation="true">
                    @if (context.Status == RequestTaskStatus.Pending)
                    {
                        <WorkspaceAction Label="Start task" Icon="@Icons.Material.Filled.PlayArrow" Disabled="@GetStartDisabled(context)" DisabledReason="@(context.AutomationBlockReason ?? "Task permission or readiness is required")" OnClick="() => StartTaskAsync(context.Id)" />
                    }
                    @if (context.Type == RequestTaskType.Manual && context.Status == RequestTaskStatus.InProgress)
                    {
                        <WorkspaceAction Label="Complete task" Icon="@Icons.Material.Outlined.CheckCircle" Disabled="@(rowActionBusy || !CanOperate(context))" DisabledReason="Task permission is required" OnClick="() => CompleteTaskAsync(context.Id)" />
                    }
                    @if (context.Type == RequestTaskType.Automation && context.Status == RequestTaskStatus.Failed && CanOperate(context) && !RequiresManualReconciliation(context.LastAutomationStatus))
                    {
                        <WorkspaceAction Label="Retry task" Icon="@Icons.Material.Filled.Replay" Disabled="@(rowActionBusy || !CanOperate(context))" OnClick="() => RetryTaskAsync(context.Id)" />
                    }
                    @if (context.Type == RequestTaskType.Automation && HasAutomationRecoveryContext(context))
                    {
                        <WorkspaceAction Label="Open recovery" Icon="@Icons.Material.Filled.ManageSearch" Href="@BuildAutomationRecoveryLink(context)" />
                    }
                </div>
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (expandedTasks.Contains(context.Id))
            {
                <tr class="task-detail-row" @key="context.Id">
                    <td colspan="8">
                        <div class="task-detail-pane" id="@DetailsId(context)" data-testid="task-detail-pane">
                            <section aria-label="Task and execution">
                                <h3>Task and execution</h3>
                                <dl><dt>Task</dt><dd>@context.Name</dd><dt>Request</dt><dd>@context.RequestTrackingId · @context.RequestTitle</dd>
                                    <dt>Task ID</dt><dd>@context.Id</dd><dt>Type</dt><dd>@context.Type</dd>
                                    <dt>Due</dt><dd>@(context.DueAt?.LocalDateTime.ToString("g") ?? "Not reported")</dd>
                                    <dt>Expected runtime</dt><dd>@Seconds(context.ExpectedRuntimeSeconds)</dd>
                                    <dt>Grace</dt><dd>@Seconds(context.GraceSeconds)</dd><dt>Hard timeout</dt><dd>@Seconds(context.HardTimeoutSeconds)</dd>
                                    <dt>Retry count</dt><dd>@context.RetryCount</dd><dt>Next retry</dt><dd>@(context.NextRetryAt?.LocalDateTime.ToString("g") ?? "Not scheduled")</dd>
                                </dl>
                            </section>
                @if (context.Type == RequestTaskType.Automation && (context.StartedAt.HasValue || context.AutomationDeadlineUtcTicks.HasValue))
                {
                    <section class="task-execution-timing" aria-label="Execution timing">
                        <h3>Execution timing</h3>
                        @if (context.StartedAt is { } started)
                        { <span>Started: <time datetime="@started.ToString("O")">@started.LocalDateTime.ToString("g")</time></span><span>Time since start at refresh: @FormatElapsed(started)</span> }
                        @if (context.AutomationDeadlineUtcTicks is { } ticks)
                        { <span>Deadline: <time datetime="@(new DateTimeOffset(ticks, TimeSpan.Zero).ToString("O"))">@(new DateTimeOffset(ticks, TimeSpan.Zero).LocalDateTime.ToString("g"))</time></span> }
                        <span>Last provider update: @(context.LastAutomationUpdatedAt?.LocalDateTime.ToString("g") ?? "Not confirmed")</span>
                        @if (context.AutomationTimedOutAt.HasValue && RequiresManualReconciliation(context.LastAutomationStatus))
                        { <span>The remote execution may still be running. Retry is held until its outcome is confirmed.</span> }
                        else if (context.AutomationTimedOutAt.HasValue)
                        { <span>The earlier timeout remains recorded. The provider outcome is now confirmed.</span> }
                        @if (!string.IsNullOrWhiteSpace(context.FailureReason))
                        { <span>@context.FailureReason</span> }
                    </section>
                }

                            <section aria-label="Provider and recovery">
                                <h3>Provider and recovery</h3>
                                <dl><dt>Provider state</dt><dd>@(context.LastAutomationStatus ?? "Not reported")</dd>
                                    <dt>External request</dt><dd>@(context.OrchestrationExternalRequestId ?? "Not reported")</dd>
                                    <dt>External run</dt><dd>@(context.OrchestrationExternalRunId ?? "Not reported")</dd>
                                    <dt>Binding</dt><dd>@(context.AutomationBlockReason ?? context.AutomationBindingSyncState?.ToString() ?? "Not reported")</dd>
                                    <dt>Diagnostics</dt><dd class="workspace-diagnostics">@(context.FailureReason ?? "No diagnostic reported")</dd>
                                </dl>
                                @if (context.Type == RequestTaskType.Automation && HasAutomationRecoveryContext(context))
                                { <MudLink Href="@BuildAutomationRecoveryLink(context)">Review execution recovery</MudLink> }
                            </section>
                        </div>
                    </td>
                </tr>
            }
        </ChildRowContent>
        <NoRecordsContent><MudText>@(loadError is null ? "No tasks match these filters." : "Tasks unavailable. Retry the request.")</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private readonly HashSet<string> expandedTasks = new(StringComparer.Ordinal);
    private static string DetailsId(RequestTaskListItemDto task) => "task-details-" + task.Id;
    private void ToggleDetails(string id) { if (!expandedTasks.Add(id)) expandedTasks.Remove(id); }
    private static string Seconds(int? value) => value is { } seconds ? $"{seconds} seconds" : "Not reported";
    private CurrentUserAccessProfile? profile;
    private bool CanOperate(RequestTaskListItemDto task) => task.Type switch
    {
        RequestTaskType.Automation => profile?.CanExecuteRequest(task.OrganizationId) == true,
        RequestTaskType.Manual => profile?.CanManageRequest(task.OrganizationId) == true,
        _ => false
    };
    private bool CanBulkOperate => _selected.Count > 0 && _selected.All(CanOperate);

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "customerOrgId")] public string[]? QueryOrganizationIds { get; set; }
    private readonly List<string> organizationIds = [];
    private readonly Dictionary<string, string> organizationLabels = new(StringComparer.Ordinal);
    private string? appliedOrganizationKey;
    private CancellationTokenSource? tenantHydration;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private HttpClient HelpdeskApi => HttpClientFactory.CreateClient("HelpdeskApi");

    private MudTable<RequestTaskListItemDto>? _table;
    private HashSet<RequestTaskListItemDto> _selected = new();
    private bool assignedToMe;
    private string? loadError;
    private RequestTaskStatus? statusFilter;
    private RequestTaskType? typeFilter;
    private string? requestIdFilter;
    private string? serviceIdFilter;
    private string? search;
    private bool isAdmin;
    private bool rowActionBusy;
    private bool bulkBusy;
    private bool historicOnly;
    private CancellationTokenSource? _debounceCts;
    private string? appliedQuerySearch;

    protected override async Task OnInitializedAsync()
    {
        await ResolveRolesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var next = (QueryOrganizationIds ?? []).Where(id => !string.IsNullOrWhiteSpace(id)).Distinct().Take(20).ToArray();
        var key = string.Join('|', next);
        if (appliedOrganizationKey != key)
        {
            appliedOrganizationKey = key; organizationIds.Clear(); organizationIds.AddRange(next); expandedTasks.Clear();
            _selected.Clear(); _table?.NavigateTo(0);
            _ = _table?.ReloadServerData();
            tenantHydration?.Cancel(); tenantHydration?.Dispose(); tenantHydration = new();
            if (next.Length > 0)
            {
                var token = tenantHydration.Token;
                try
                {
                    var url = "api/v1/ticketing/filter-options?module=task&dimension=customer&take=20" + string.Concat(next.Select(id => "&selectedId=" + Uri.EscapeDataString(id)));
                    var response = await HelpdeskApi.GetFromJsonAsync<TicketFilterOptionsDto>(url, token);
                    if (token.IsCancellationRequested) return;
                    foreach (var id in next)
                        organizationLabels[id] = response?.Items?.FirstOrDefault(option => option.Id == id)?.Label ?? "Unavailable tenant";
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
                catch (Exception failure) when (failure is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
                { foreach (var id in next) organizationLabels[id] = "Unavailable tenant"; }
            }
        }
        if (!string.Equals(appliedQuerySearch, QuerySearch, StringComparison.Ordinal))
        {
            appliedQuerySearch = QuerySearch;
            search = QuerySearch;
            _ = _table?.ReloadServerData();
        }
    }

    private Task SelectTenantAsync(TicketFilterOptionDto option)
    {
        if (organizationIds.Count >= 20 || organizationIds.Contains(option.Id)) return Task.CompletedTask;
        organizationLabels[option.Id] = option.Label;
        organizationIds.Add(option.Id);
        return RememberTenantsAsync();
    }
    private Task RemoveTenantAsync(string id) { organizationIds.Remove(id); return RememberTenantsAsync(); }
    private Task RememberTenantsAsync()
    {
        expandedTasks.Clear(); _selected.Clear();
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { ["customerOrgId"] = organizationIds.ToArray() }));
        return Task.CompletedTask;
    }

    private async Task<TableData<RequestTaskListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _selected.Clear();
        loadError = null;
        var page = state.Page + 1;
        var pageSize = state.PageSize <= 0 ? 25 : state.PageSize;
        var url = $"api/v1/request-tasks?page={page}&pageSize={pageSize}&assignedToMe={assignedToMe.ToString().ToLowerInvariant()}";
        foreach (var id in organizationIds) url += "&customerOrgId=" + Uri.EscapeDataString(id);

        if (historicOnly)
        {
            url += "&historicOnly=true";
        }

        if (statusFilter is not null)
        {
            url += $"&status={statusFilter}";
        }

        if (typeFilter is not null)
        {
            url += $"&type={typeFilter}";
        }

        if (!string.IsNullOrWhiteSpace(requestIdFilter))
        {
            url += $"&requestId={Uri.EscapeDataString(requestIdFilter.Trim())}";
        }

        if (!string.IsNullOrWhiteSpace(serviceIdFilter))
        {
            url += $"&serviceId={Uri.EscapeDataString(serviceIdFilter.Trim())}";
        }

        if (!string.IsNullOrWhiteSpace(search))
        {
            url += $"&q={Uri.EscapeDataString(search.Trim())}";
        }

        try
        {
            var response = await HelpdeskApi.GetFromJsonAsync<PagedResponse<RequestTaskListItemDto>>(url, cancellationToken) ?? new();
            cancellationToken.ThrowIfCancellationRequested();
            expandedTasks.IntersectWith((response.Items ?? []).Select(task => task.Id));
            return new TableData<RequestTaskListItemDto>
            {
                Items = response.Items ?? new List<RequestTaskListItemDto>(),
                TotalItems = response.TotalCount
            };
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (HttpRequestException ex)
        {
            loadError = "Tasks unavailable. Retry the request.";
            Snackbar.Add(ex.StatusCode is null
                ? "Tasks could not be loaded right now."
                : $"Tasks could not be loaded right now ({(int)ex.StatusCode}).", Severity.Error);
        }
        catch
        {
            loadError = "Tasks unavailable. Retry the request.";
            Snackbar.Add(loadError, Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
        return new TableData<RequestTaskListItemDto>
        {
            Items = new List<RequestTaskListItemDto>(),
            TotalItems = 0
        };
    }

    private async Task ResolveRolesAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var user = (await AuthenticationStateTask).User;
        profile = CurrentUserAccessProfile.FromClaims(user);
        isAdmin = user.IsInRole("HelpdeskAdmin")
            || user.Claims.Any(c =>
                (c.Type == ClaimTypes.Role || c.Type == "roles")
                && string.Equals(c.Value, "HelpdeskAdmin", StringComparison.OrdinalIgnoreCase));
    }

    private string GetAssigneeDisplay(RequestTaskListItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.AssignedToDisplayName))
        {
            return item.AssignedToDisplayName;
        }

        return string.IsNullOrWhiteSpace(item.AssignedToId) ? "-" : item.AssignedToId;
    }

    private bool HasAutomationRecoveryContext(RequestTaskListItemDto task)
        => !string.IsNullOrWhiteSpace(GetAutomationRecoverySearch(task));

    private static bool RequiresManualReconciliation(string? status)
        => string.Equals(status, "SubmitUncertainManualReconcile", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "ExecutionUnknownManualReconcile", StringComparison.OrdinalIgnoreCase);

    private string BuildAutomationRecoveryLink(RequestTaskListItemDto task)
        => $"/notifications?source={Uri.EscapeDataString("Orchestration")}&search={Uri.EscapeDataString(GetAutomationRecoverySearch(task) ?? string.Empty)}";

    private static string? GetAutomationRecoverySearch(RequestTaskListItemDto task)
        => FirstNonEmpty(
            task.OrchestrationExternalRunId,
            task.OrchestrationExternalRequestId,
            task.AutomationAttemptCorrelationId,
            task.Id);

    private Task Reload()
    {
        _selected.Clear();
        if (_table?.CurrentPage > 0) { _table.NavigateTo(0); return Task.CompletedTask; }
        return _table?.ReloadServerData() ?? Task.CompletedTask;
    }

    private async Task ToggleHistoric()
    {
        historicOnly = !historicOnly;
        await Reload();
    }

    private async Task OnAssignedToMeChanged(bool value)
    {
        assignedToMe = value;
        await Reload();
    }

    private async Task OnStatusChanged(RequestTaskStatus? value)
    {
        statusFilter = value;
        await Reload();
    }

    private async Task OnTypeChanged(RequestTaskType? value)
    {
        typeFilter = value;
        await Reload();
    }

    private async Task OnRequestIdChanged(string? value)
    {
        requestIdFilter = value;
        await Reload();
    }

    private async Task OnServiceIdChanged(string? value)
    {
        serviceIdFilter = value;
        await Reload();
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return null;
    }

    private void OnSearchChanged(string? value)
    {
        search = value;
    }

    private async Task DebouncedReload()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _debounceCts.Token);
            await Reload();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task StartTaskAsync(string id) => await ExecuteRowActionAsync(id, "start", "Task started.");
    private async Task CompleteTaskAsync(string id) => await ExecuteRowActionAsync(id, "complete", "Task completed.");
    private async Task RetryTaskAsync(string id) => await ExecuteRowActionAsync(id, "retry", "Task retry requested.");

    private async Task ExecuteRowActionAsync(string id, string action, string successMessage)
    {
        if (rowActionBusy || bulkBusy) return;
        rowActionBusy = true;
        try
        {
            using var response = await HelpdeskApi.PostAsJsonAsync($"/api/v1/request-tasks/{id}/{action}", new { });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? $"Failed to {action} task." : error, Severity.Error);
                return;
            }

            Snackbar.Add(successMessage, Severity.Success);
            await Reload();
        }
        catch (HttpRequestException) { Snackbar.Add("Task outcome could not be confirmed. Refresh before retrying.", Severity.Warning); }
        catch (OperationCanceledException) { Snackbar.Add("Task request was interrupted. Refresh to reconcile its outcome.", Severity.Warning); }
        finally
        {
            rowActionBusy = false;
        }
    }

    private async Task BulkStartAsync() => await ExecuteBulkActionAsync("/api/v1/request-tasks/bulk/start", "Updated {0} tasks.");
    private async Task BulkCompleteAsync() => await ExecuteBulkActionAsync("/api/v1/request-tasks/bulk/complete", "Updated {0} tasks.");
    private async Task BulkRetryAsync() => await ExecuteBulkActionAsync("/api/v1/request-tasks/bulk/retry", "Updated {0} tasks.");

    private async Task ExecuteBulkActionAsync(string endpoint, string successTemplate)
    {
        if (bulkBusy || rowActionBusy || !CanBulkOperate) return;
        bulkBusy = true;
        try
        {
            var ids = _selected.Select(x => x.Id).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            using var response = await HelpdeskApi.PostAsJsonAsync(endpoint, new BulkRequestTaskActionDto { Ids = ids });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Bulk operation failed." : error, Severity.Error);
                return;
            }

            var payload = await response.Content.ReadFromJsonAsync<BulkUpdateResult>() ?? new BulkUpdateResult();
            Snackbar.Add(string.Format(successTemplate, payload.Updated), Severity.Success);
            await Reload();
        }
        catch (HttpRequestException) { Snackbar.Add("Task outcomes could not be confirmed. Selection is retained; refresh before retrying.", Severity.Warning); }
        catch (OperationCanceledException) { Snackbar.Add("Task request was interrupted. Selection is retained; refresh to reconcile.", Severity.Warning); }
        finally
        {
            bulkBusy = false;
        }
    }

    private static Color GetTaskStatusColor(RequestTaskStatus status) => status switch
    {
        RequestTaskStatus.InProgress => Color.Info,
        RequestTaskStatus.Completed => Color.Success,
        RequestTaskStatus.Failed => Color.Error,
        RequestTaskStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static Color GetBindingStateColor(AutomationBindingSyncState state) => state switch
    {
        AutomationBindingSyncState.InSync => Color.Success,
        AutomationBindingSyncState.Drifted => Color.Warning,
        AutomationBindingSyncState.ImportPending => Color.Warning,
        AutomationBindingSyncState.Broken => Color.Error,
        _ => Color.Default
    };

    private bool GetStartDisabled(RequestTaskListItemDto item)
    {
        if (rowActionBusy || !CanOperate(item))
        {
            return true;
        }

        return item.Type == RequestTaskType.Automation && !item.AutomationReadyToStart;
    }

    private sealed class BulkUpdateResult
    {
        public int Updated { get; set; }
    }

    public void Dispose()
    {
        tenantHydration?.Cancel(); tenantHydration?.Dispose();
        _debounceCts?.Cancel(); _debounceCts?.Dispose();
    }

    private static string FormatElapsed(DateTimeOffset started)
    {
        var elapsed = DateTimeOffset.UtcNow - started;
        return elapsed < TimeSpan.Zero ? "0 min" : $"{(int)elapsed.TotalHours} hr {elapsed.Minutes} min";
    }
}
