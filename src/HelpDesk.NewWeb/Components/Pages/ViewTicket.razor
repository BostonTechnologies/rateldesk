@page "/public/access/{AccessId:guid}/ticket"
@layout PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject PublicBrowserAccess PublicAccess

<PageTitle>View My Ticket</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">
    <MudPaper Class="pa-6 pa-md-8" Elevation="2">
        @if (_ticket is null)
        {
            <MudAlert Severity="Severity.Info">This ticket session is unavailable. Open the original email to continue or request a replacement link.</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.h5" HtmlTag="h1">@_ticket.Title</MudText>
            <MudText Typo="Typo.subtitle2">@_ticket.TrackingId · @_ticket.State</MudText>
            <MudText Typo="Typo.body2">Updated @_ticket.LastUpdatedAt?.ToString("g")</MudText>
            <MudDivider Class="my-4" />
            <PublicTicketTimeline Items="_timeline" AccessId="AccessId" />
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid AccessId { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private PublicTicketViewDto? _ticket;
    private PublicTicketTimelineItemDto[]? _timeline;

    protected override async Task OnInitializedAsync()
    {
        _ticket = await PublicAccess.ReadAsync<PublicTicketViewDto>(HttpContext, AccessId, "ticket");
        if (_ticket is not null)
            _timeline = await PublicAccess.ReadAsync<PublicTicketTimelineItemDto[]>(HttpContext, AccessId, "timeline");
    }
}
