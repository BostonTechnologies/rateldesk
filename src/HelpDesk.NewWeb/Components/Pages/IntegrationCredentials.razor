@page "/account/integration-credentials"
@page "/admin/integration"
@using HelpDesk.NewWeb.Components.Pages.Admin.Orchestration
@attribute [Authorize]
@using System.Globalization
@using Helpdesk.Shared.DTOs.McpPolicies
@using Helpdesk.Shared.Auth
@using Helpdesk.Shared.DTOs.Auth
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<PageTitle>Integration</PageTitle>

<MudPaper Class="helpdesk-content-surface pa-4" data-testid="integration-credentials-page" data-interactive="@interactive.ToString().ToLowerInvariant()">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-page-title">Integration</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Manage system connections, account credentials and Netclaw.</MudText>
                @if (SafeReturnUrl is not null) { <MudButton Href="@SafeReturnUrl" Size="Size.Small">Return to setup</MudButton> }
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
        }

        @if (pendingSetup is not null && !showCreate)
        {
            <MudAlert Severity="Severity.Info">An approved setup is awaiting a confirmed delivery. Resume it to recover the same credential.<MudButton OnClick="StartCreate">Resume setup</MudButton></MudAlert>
        }
        @if (creationUncertain)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                <MudText>The last create result could not be confirmed. Refresh the list and revoke any newly created credential whose one-time secret you did not receive before creating a replacement.</MudText>
                <MudButton OnClick="AcknowledgeUncertainCreation" Disabled="@saving">I have reviewed and revoked any unusable credential</MudButton>
            </MudAlert>
        }
        <div class="integration-tabs-shell">
        <MudTabs MinimumTabWidth="0" ActivePanelIndex="@activeTab" ActivePanelIndexChanged="ChangeTab" Rounded="true" PanelClass="pt-4" KeepPanelsAlive="true" data-testid="integration-credential-tabs">
            @if (access?.IsHelpdeskAdmin == true)
            {
                <MudTabPanel Text="System connections" Icon="@Icons.Material.Filled.Link" data-testid="integration-system-connections">
                    <PairingConnectionsPanel OrganizationId="@OrganizationId" />
                </MudTabPanel>
            }
            <MudTabPanel Text="API &amp; MCP credentials" Icon="@Icons.Material.Filled.Key" data-testid="integration-account-credentials">
                <IntegrationCredentialApproval Embedded="true" />
                @if (organizationChoicesUnavailable)
                {
                    <MudAlert Severity="Severity.Info">Organization choices are unavailable. You can still manage your existing credentials.</MudAlert>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudText Typo="Typo.body2">Credentials use your account's permissions. Each new secret is displayed once.</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate" Disabled="@(loading || creationUncertain)" Id="integration-create-button" data-testid="integration-credential-create">Create credential</MudButton>
                </MudStack>

        @if (created is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle2">Copy this credential now</MudText>
                <MudText Typo="Typo.body2">It will not be shown again. Store it in an approved secret manager.</MudText>
                @if (deliveredSetupRequestId is not null)
                {
                    <MudText Typo="Typo.body2">Save the credential and select “I have saved it” within the five-minute delivery window to finish setup.</MudText>
                    @if (deliveryExpiresAtUtc is { } deliveryExpiry)
                    { <MudText Typo="Typo.body2">Complete by @deliveryExpiry.UtcDateTime.ToString("dd MMM yyyy HH:mm:ss 'UTC'").</MudText> }
                }
                @if (created.GrantKind == IntegrationCredentialGrantKinds.OwnerAdministration)
                { <MudText Typo="Typo.body2">Granted: owner administration across all organizations. Expires @created.ExpiresAtUtc.ToString("u").</MudText> }
                <MudTextField Value="@created.Secret" Label="Credential" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" FullWidth="true" />
                @if (string.Equals(created.Purpose, "mcp", StringComparison.OrdinalIgnoreCase) || created.GrantKind == IntegrationCredentialGrantKinds.OwnerAdministration)
                {
                    <MudText Typo="Typo.caption" Class="mt-2">HTTP MCP header: <code>Authorization: Bearer &lt;credential&gt;</code>. Keep the credential bound to the exact configured public /mcp resource.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-2">CLI environment: <code>RATELDESK_CREDENTIAL_MODE=integration</code> and <code>RATELDESK_INTEGRATION_CREDENTIAL=&lt;credential&gt;</code>. Stdio MCP uses an isolated config file via <code>RATELDESK_MCP_CONFIG</code>, plus <code>RATELDESK_MCP_INSTANCE</code> and its pinned <code>RATELDESK_MCP_&lt;INSTANCE&gt;_API_BASE_URL</code>.</MudText>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearCreatedCredential" Disabled="@saving">I have saved it</MudButton>
            </MudAlert>
        }

        @if (showCreate)
        {
            <CredentialReviewSurface Title="Create integration" ExtraWide="true" OpenerId="integration-create-button" OnClose="CancelCreate">
                <header class="setup-heading">
                    <h2>Create integration</h2>
                    <p>Step @createStep of @CreateStepCount · @CreateStepName(createStep)</p>
                </header>
                <div class="review-body setup-body">
                    <ol class="setup-steps" aria-label="Integration setup progress">
                        @for (var step = 1; step <= CreateStepCount; step++)
                        {
                            var index = step;
                            <li class="@(createStep == index ? "current" : createStep > index ? "completed" : "")" aria-current="@(createStep == index ? "step" : null)">
                                <span class="setup-step-number">@index</span><span>@CreateStepName(index)</span>
                            </li>
                        }
                    </ol>
                    @if (!string.IsNullOrWhiteSpace(error))
                    { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">@error</MudAlert> }
                    @if (createStep == 1)
                    {
                        <div class="setup-fields">
                            <label class="setup-select">Connection type
                                <select value="@draft.Purpose" @onchange="args => OnPurposeChanged(args.Value?.ToString() ?? string.Empty)" required disabled="@saving">
                                    <option value="mcp">HTTP MCP gateway</option>
                                    <option value="api">API / CLI / stdio MCP</option>
                                </select>
                            </label>
                            <MudTextField @bind-Value="draft.Name" Label="Integration name" Required="true" Immediate="true" Variant="Variant.Outlined" MaxLength="128" />
                            <div>
                                <MudTextField @bind-Value="draft.ExpiresAtUtcText" Label="Exact expiry (UTC)" Required="true" Immediate="true" Variant="Variant.Outlined" HelperText="Use YYYY-MM-DDTHH:mm:ss.ffffffZ, up to 90 days from now." />
                                <p class="setup-help">30 days means 720 hours from @ExactUtc(createReference).</p>
                                <MudButton Size="Size.Small" OnClick="UseThirtyDays">Use 30 days from this reference</MudButton>
                            </div>
                            @if (IsMcp)
                            {
                                <div class="setup-full-width">
                                    <MudTextField @bind-Value="draft.McpResourceUri" Label="HTTP MCP server URL" Required="true" Immediate="true" Variant="Variant.Outlined" Placeholder="https://desk.example/mcp" />
                                    <p class="setup-help">Enter the public address of your RatelDesk HTTP MCP server. Use the same address in your MCP client. This credential works only with that server.</p>
                                    <details class="setup-explanation"><summary>About this URL</summary><p>Use the canonical HTTPS endpoint ending in /mcp from server setup. Configure and verify the server-to-backend connection first.</p><a href="https://github.com/BostonTechnologies/rateldesk/blob/main/docs/mcp-http/setup.md" target="_blank" rel="noopener noreferrer">Server and client setup guide</a></details>
                                </div>
                            }
                        </div>
                    }
                    else if (createStep == 2)
                    {
                        <div class="setup-section-heading"><h3>Server access</h3><span class="setup-badge">@(IsOwnerAdministration ? "Instance administration selected" : "No server access")</span></div>
                        <p class="setup-help">Choose whether this integration can administer the RatelDesk instance.</p>
                        @if (access?.IsHelpdeskAdmin == true && IsMcp)
                        {
                            <div class="setup-choice-grid">
                                <button type="button" class="setup-scope-choice @(!IsOwnerAdministration ? "selected" : "")" aria-pressed="@((!IsOwnerAdministration).ToString().ToLowerInvariant())" @onclick="() => OnGrantKindChanged(IntegrationCredentialGrantKinds.Ordinary)">
                                    <strong>Tenant access only</strong><span>Choose permissions in one organization in the next step.</span>
                                </button>
                                <button type="button" class="setup-scope-choice @(IsOwnerAdministration ? "selected" : "")" aria-pressed="@(IsOwnerAdministration.ToString().ToLowerInvariant())" @onclick="() => OnGrantKindChanged(IntegrationCredentialGrantKinds.OwnerAdministration)" data-testid="credential-grant-kind">
                                    <strong>Owner administration</strong><span>Administer the instance and all organizations on your behalf.</span>
                                </button>
                            </div>
                            @if (IsOwnerAdministration)
                            {
                                <section class="setup-card mt-4"><h4>Server / instance</h4><p>Includes tickets, requests, changes, automation, settings and accounts across all organizations, including organizations created later. Your current administrator authority remains the upper bound for every request.</p><p class="setup-help">The policy step can further restrict this access. Explicit approval is required before creation.</p></section>
                            }
                        }
                        else
                        {
                            <section class="setup-card"><h4>Tenant access only</h4><p>@(IsMcp ? "Your account can create credentials for its authorized organization permissions." : "API, CLI and stdio credentials use selected permissions in one organization.")</p><p class="setup-help">Continue to choose tenant access.</p></section>
                        }
                    }
                    else if (createStep == 3)
                    {
                        <div class="setup-section-heading"><h3>Tenant access</h3><span class="setup-badge">@(IsOwnerAdministration ? "All organizations · default context below" : $"{draft.Permissions.Count} permissions selected")</span></div>
                        <p class="setup-help">@(IsOwnerAdministration ? "Owner administration covers all organizations. Choose the default organization used when an operation needs a context." : "RatelDesk ordinary credentials are bound to one organization. Select its permissions below.")</p>
                        <div class="setup-tenant-select">
                            <label class="setup-select">@(IsOwnerAdministration ? "Default organization" : "Organization")
                            <select value="@draft.OrganizationId" @onchange="args => OnOrganizationChanged(args.Value?.ToString() ?? string.Empty)" required disabled="@saving">
                                <option value="">Select organization</option>
                                @foreach (var organization in organizations)
                                { <option value="@organization.Id">@organization.Name</option> }
                            </select>
                            </label>
                        </div>
                        @if (IsOwnerAdministration)
                        { <section class="setup-card mt-4"><h4>All organizations</h4><p>Organization permissions are included in the explicit owner-administration grant. Selecting a default context does not limit that grant to this organization.</p></section> }
                        else
                        { <CredentialPermissionSelector EligiblePermissions="@AvailablePermissions" SelectedValues="@draft.Permissions" SelectedValuesChanged="OnPermissionsChanged" Disabled="@saving" /> }
                    }
                    else if (IsMcp && createStep == 4)
                    {
                        <div class="setup-section-heading"><h3>Policies</h3><span class="setup-badge">1 base policy</span></div>
                        <p class="setup-help">Approve a base policy for this integration's selected scope. Policies can only narrow the credential's current grants.</p>
                        @if (basePolicy is not null)
                        { <McpIntegrationPolicyEditor Value="@basePolicy" ValueChanged="BasePolicyChanged" Operations="@setupOperations" EligiblePermissions="@draft.Permissions" ScopeLabel="@(IsOwnerAdministration ? "Server / instance" : OrganizationLabel(draft.OrganizationId))" CredentialExpiry="@(ParsedExpiry?.UtcDateTime ?? DateTime.MinValue)" Disabled="@saving" /> }
                    }
                    else
                    {
                        <section class="setup-card setup-connection-review">
                            <div class="setup-section-heading"><span class="setup-eyebrow">Connection</span><MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="() => EditCreateStep(1)">Edit</MudButton></div>
                            <h3>@draft.Name</h3><span class="setup-badge">@PurposeLabel(draft.Purpose)</span>
                            <p class="setup-destination">@(IsMcp ? draft.McpResourceUri : "RatelDesk API / CLI / stdio MCP")</p>
                            <p>Expires @ParsedExpiry?.ToString("dddd, dd MMM yyyy HH:mm:ss 'UTC'")</p><p class="setup-help">Exact UTC: @draft.ExpiresAtUtcText</p>
                        </section>
                        <div class="setup-review-grid">
                            <section class="setup-card">
                                <div class="setup-section-heading"><h3>Server / instance</h3><MudButton OnClick="() => EditCreateStep(2)">Edit access</MudButton></div>
                                <p>@(IsOwnerAdministration ? "Owner administration across all organizations" : "No server access")</p>
                                @if (IsOwnerAdministration) { <p class="setup-help">Your current instance administrator authority is checked for every request.</p> }
                            </section>
                            <section class="setup-card">
                                <div class="setup-section-heading"><h3>@OrganizationLabel(draft.OrganizationId)</h3><MudButton OnClick="() => EditCreateStep(3)">Edit access</MudButton></div>
                                @if (IsOwnerAdministration) { <p>Default organization context · all organizations authorized</p> }
                                else
                                {
                                    <span class="setup-badge">@draft.Permissions.Count grants</span>
                                    <details><summary>Selected permissions</summary><ul class="setup-permission-list">@foreach (var permission in draft.Permissions.Order(StringComparer.OrdinalIgnoreCase)) { <li>@PermissionLabel(permission)</li> }</ul></details>
                                }
                            </section>
                        </div>
                        @if (IsMcp)
                        {
                            <section class="setup-card">
                                <div class="setup-section-heading"><h3>Base policy</h3><MudButton OnClick="() => EditCreateStep(4)">Edit policy</MudButton></div>
                                @if (basePolicy is not null) { <McpIntegrationPolicySummary Policy="@basePolicy" Operations="@setupOperations" /> }
                            </section>
                        }
                        <div class="setup-consent">
                            @if (IsOwnerAdministration)
                            { <MudCheckBox T="bool" @bind-Value="draft.OwnerAdministrationConsent" Disabled="@(saving || pendingSetup is not null)" Label="I authorize this agent to administer the instance and all organizations on my behalf, within the reviewed policy." /> }
                            <MudCheckBox T="bool" @bind-Value="finalApproval" Disabled="@(saving || pendingSetup is not null)" Label="@(IsMcp ? "I have reviewed this connection, its access and policies, and approve creating the integration." : "I have reviewed this connection and its access, and approve creating the integration.")" />
                        </div>
                    }
                    @if (organizations.Count == 0)
                    { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">No enabled organization is currently available for a credential.</MudAlert> }
                </div>
                <footer class="setup-footer">
                    <MudButton OnClick="CancelCreate" Disabled="@saving">Cancel</MudButton>
                    @if (createStep > 1) { <MudButton OnClick="PreviousCreateStep" Disabled="@(saving || pendingSetup is not null)">Back</MudButton> }
                    @if (createStep < CreateStepCount)
                    { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NextCreateStep" Disabled="@(saving || organizations.Count == 0)">Next</MudButton> }
                    else
                    { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync" Disabled="@(saving || pendingSetup is null && (organizations.Count == 0 || !finalApproval || (IsOwnerAdministration && !draft.OwnerAdministrationConsent)))">@(saving ? "Creating…" : pendingSetup is not null ? "Retry delivery" : "Create integration")</MudButton> }
                </footer>
            </CredentialReviewSurface>
        }

        <div class="credential-filters">
            <label>Search credentials <input type="search" value="@search" @oninput="SearchCredentialsChanged" placeholder="Name, purpose or organization" /></label>
            <label>Status <select value="@statusFilter" @onchange="FilterChanged">
                @foreach (var status in new[] { "All", "Active", "Revoked", "Expired" })
                { <option value="@status">@status (@CountStatus(status))</option> }
            </select></label>
            <MudButton Size="Size.Small" OnClick="ReloadAsync" Disabled="@(loading || saving)">Refresh</MudButton>
        </div>
        @if (selectedInactive.Count > 0)
        {
            <div class="credential-cleanup" role="status">
                <span>@selectedInactive.Count inactive credentials explicitly selected (maximum 50 per operation).</span>
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="BeginCleanup" Disabled="@saving">Delete selected inactive</MudButton>
                <MudButton Size="Size.Small" OnClick="ClearSelection" Disabled="@saving">Clear selection</MudButton>
            </div>
        }
        @if (loading)
        { <MudProgressLinear Indeterminate="true" /> }
        else if (credentials.Count == 0)
        { <MudAlert Severity="Severity.Info">No integration credentials have been created for this account.</MudAlert> }
        else
        {
            <MudTable Items="@VisibleCredentials" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Class="credential-table">
                <HeaderContent><MudTh>Select inactive</MudTh><MudTh>Name</MudTh><MudTh>Purpose / organization</MudTh><MudTh>Status</MudTh><MudTh>Expires / last used</MudTh><MudTh>Actions</MudTh></HeaderContent>
                <RowTemplate Context="credential">
                    <MudTd DataLabel="Select inactive">
                        @if (IsInactive(credential))
                        { <input type="checkbox" checked="@selectedInactive.Contains(credential.Id)" @onchange="args => SelectInactive(credential, args)" aria-label="@($"Select inactive {credential.Name}")" disabled="@saving" /> }
                    </MudTd>
                    <MudTd DataLabel="Name"><MudText Typo="Typo.subtitle2">@credential.Name</MudText><MudText Typo="Typo.caption">@credential.Prefix</MudText></MudTd>
                    <MudTd DataLabel="Purpose / organization"><MudText Typo="Typo.body2">@PurposeLabel(credential.Purpose)</MudText><MudText Typo="Typo.caption">@OrganizationLabel(credential.OrganizationId) · @credential.Permissions.Count permissions</MudText></MudTd>
                    <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(IsInactive(credential) ? Color.Default : Color.Success)">@CredentialStatus(credential)</MudChip></MudTd>
                    <MudTd DataLabel="Expires / last used"><MudText Typo="Typo.caption" HtmlTag="p">Expires @credential.ExpiresAtUtc.LocalDateTime.ToString("g")</MudText><MudText Typo="Typo.caption" HtmlTag="p">Last used: @(credential.LastUsedAtUtc?.LocalDateTime.ToString("g") ?? "Never")</MudText></MudTd>
                    <MudTd DataLabel="Actions"><div class="credential-row-actions">
                        <MudButton Id="@($"credential-details-{credential.Id:N}")" Size="Size.Small" OnClick="() => ReviewDetails(credential)">Details</MudButton>
                        @if (!IsInactive(credential))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => BeginRevoke(credential)" Disabled="@saving">Revoke</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => BeginDelete(credential)" Disabled="@saving">Revoke &amp; delete</MudButton>
                        }
                        else { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => BeginDelete(credential)" Disabled="@saving">Delete</MudButton> }
                    </div></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No credentials match these filters.</MudText></NoRecordsContent>
            </MudTable>
        }
        @if (details is not null)
        {
            <IntegrationCredentialDetails @key="details.Id" Credential="@DetailsModel(details)" OnAccessChanged="AccessChanged" OnClose="CloseDialog" />
        }
        else if (confirmation.Count > 0)
        {
            <CredentialReviewSurface Title="Credential lifecycle" OnClose="CloseDialog">
                <h2 id="credential-dialog-title">@(confirmationAction == "revoke" ? "Revoke credential" : "Delete credentials")</h2>
                <div class="review-body">
                    <p>@(confirmationAction == "revoke" ? "Access will stop. The inactive record will remain." : "These named records and their authentication material will be permanently removed. Active access will stop.")</p>
                    <ul>@foreach (var item in confirmation) { <li>@item.Name — @CredentialStatus(item)</li> }</ul>
                    @if (cleanupFailures.Count > 0) { <p role="alert">@string.Join("; ", cleanupFailures)</p> }
                </div>
                <footer><MudButton OnClick="CloseDialog" Disabled="@saving">Cancel</MudButton>
                    <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmMutationAsync" Disabled="@saving">@(saving ? "Working…" : confirmationAction == "revoke" ? "Confirm revoke" : "Confirm delete")</MudButton>
                </footer>
            </CredentialReviewSurface>
        }
            </MudTabPanel>
            @if (access?.IsHelpdeskAdmin == true)
            {
                <MudTabPanel Text="Netclaw" Icon="@Icons.Material.Filled.SmartToy">
                    @if (netclawLoaded) { <NetclawConnectivity Embedded="true" /> }
                </MudTabPanel>
            }
        </MudTabs>
        </div>
    </MudStack>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }
    [SupplyParameterFromQuery(Name = "organizationId")] public string? OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string? SafeReturnUrl => !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') &&
        !ReturnUrl.StartsWith("//", StringComparison.Ordinal) && !ReturnUrl.Contains('\\') && !ReturnUrl.Any(char.IsControl) ? ReturnUrl : null;
    private void ChangeTab(int index)
    {
        // MudTabs emits registration callbacks during initial rendering. Only a
        // real interactive change should create a history entry or navigation.
        if (!interactive || activeTab == index) return;
        var tab = access?.IsHelpdeskAdmin == true ? index switch { 0 => "connections", 2 => "netclaw", _ => "credentials" } : "credentials";
        var target = Navigation.GetUriWithQueryParameter("tab", tab);
        if (target != Navigation.Uri) Navigation.NavigateTo(target);
    }
    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    // One-time issuance and bounded per-record writes must not be replayed by general HTTP retries.
    private HttpClient MutationApi => HttpClientFactory.CreateClient("SystemPairingApi");
    private CurrentUserAccessProfile? access;
    private List<OrganizationDto> organizations = [];
    private List<CredentialMetadata> credentials = [];
    private CreateCredentialDraft draft = new();
    private bool IsOwnerAdministration => draft.Purpose == "mcp" && draft.GrantKind == IntegrationCredentialGrantKinds.OwnerAdministration;
    private CreatedCredential? created;
    private bool interactive;
    private string? appliedTab;
    protected override void OnParametersSet()
    {
        if (access is null || appliedTab == InitialTab) return;
        ApplyNavigation();
    }
    private void ApplyNavigation()
    {
        appliedTab = InitialTab;
        activeTab = access?.IsHelpdeskAdmin == true ? InitialTab switch { "credentials" => 1, "netclaw" => 2, _ => 0 } : 0;
        netclawLoaded |= activeTab == 2;
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            interactive = true;
            StateHasChanged();
        }
    }

    private bool loading = true;
    private bool organizationChoicesUnavailable;
    private bool saving;
    private bool finalApproval;
    private McpPolicyScopeDraft? basePolicy;
    private McpPolicyOperation[] setupOperations = [];
    private Guid setupRequestId;
    private Guid? deliveredSetupRequestId;
    private DateTimeOffset? deliveryExpiresAtUtc;
    private SetupRequest? pendingSetup;
    private DateTimeOffset createReference;
    private readonly Dictionary<string, HashSet<string>> organizationDrafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, McpPolicyScopeDraft> policyDrafts = new(StringComparer.Ordinal);
    private bool IsMcp => string.Equals(draft.Purpose, "mcp", StringComparison.OrdinalIgnoreCase);
    private int CreateStepCount => IsMcp ? 5 : 4;
    private string CreateStepName(int step) => step switch { 1 => "Connection", 2 => "Server access", 3 => "Tenant access", 4 when IsMcp => "Policies", _ => "Review & create" };
    private DateTimeOffset? ParsedExpiry => DateTimeOffset.TryParseExact(draft.ExpiresAtUtcText,
        ["yyyy-MM-dd'T'HH:mm:ss'Z'", "yyyy-MM-dd'T'HH:mm:ss.FFFFFF'Z'"], CultureInfo.InvariantCulture,
        DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var value) ? value : null;
    private static string ExactUtc(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss.ffffff'Z'", CultureInfo.InvariantCulture);
    private void UseThirtyDays() => draft.ExpiresAtUtcText = ExactUtc(createReference.AddDays(30));
    private void EditCreateStep(int step) { if (saving || pendingSetup is not null) return; finalApproval = false; createStep = Math.Clamp(step, 1, CreateStepCount); error = null; }

    private bool showCreate;
    private bool creationUncertain;
    private readonly HashSet<Guid> acknowledgedDeletes = [];
    private readonly Dictionary<Guid, DateTimeOffset> acknowledgedRevocations = [];
    private int activeTab;
    private bool netclawLoaded;
    private int createStep = 1;
    private string search = "";
    private string statusFilter = "All";
    private HashSet<Guid> selectedInactive = [];
    private CredentialMetadata? details;
    private List<CredentialMetadata> confirmation = [];
    private string confirmationAction = "";
    private List<string> cleanupFailures = [];
    private long listRevision;
    private IEnumerable<CredentialMetadata> VisibleCredentials => credentials.Where(c =>
        (statusFilter == "All" || CredentialStatus(c) == statusFilter) &&
        (string.IsNullOrWhiteSpace(search) || $"{c.Name} {c.Purpose} {OrganizationLabel(c.OrganizationId)}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)));
    private static string CredentialStatus(CredentialMetadata c) => c.RevokedAtUtc is not null ? "Revoked" : c.ExpiresAtUtc <= DateTimeOffset.UtcNow ? "Expired" : "Active";
    private static bool IsInactive(CredentialMetadata c) => CredentialStatus(c) != "Active";
    private int CountStatus(string status) => credentials.Count(c => status == "All" || CredentialStatus(c) == status);

    private string? error;

    private IEnumerable<string> AvailablePermissions
    {
        get
        {
            if (access?.IsHelpdeskAdmin == true)
            {
                return HelpdeskPermissions.AssignablePermissions;
            }

            if (access is null)
            {
                return [];
            }

            if (!access.UsesScopedPermissions && access.ScopedPermissionGrants.Count == 0)
            {
                return access.Permissions
                    .Where(permission => HelpdeskPermissions.AssignablePermissions.Contains(permission, StringComparer.OrdinalIgnoreCase))
                    .Order(StringComparer.OrdinalIgnoreCase);
            }

            return access.ScopedPermissionGrants
                .Where(grant => string.Equals(grant.OrganizationId, draft.OrganizationId, StringComparison.OrdinalIgnoreCase))
                .Select(grant => grant.Permission)
                .Where(permission => HelpdeskPermissions.AssignablePermissions.Contains(permission, StringComparer.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Order(StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        access = CurrentUserAccessProfile.FromClaims((await AuthenticationState.GetAuthenticationStateAsync()).User);
        await ReloadAsync();
        ApplyNavigation();
    }

    private async Task ReloadAsync()
    {
        var revision = ++listRevision;
        loading = true;
        error = null;
        try
        {
            var organizationTask = LoadOrganizationChoicesAsync();
            var credentialTask = Api.GetFromJsonAsync<List<CredentialMetadata>>("api/v1/integration-credentials/");
            await Task.WhenAll(organizationTask, credentialTask);
            if (revision != listRevision) return;
            organizationChoicesUnavailable = !organizationTask.Result.Available;
            organizations = organizationTask.Result.Items
                .Where(organization => organization.IsEnabled && (access?.IsHelpdeskAdmin == true || access?.AllowedOrganizationIds.Contains(organization.Id) == true))
                .OrderBy(organization => organization.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            credentials = (credentialTask.Result ?? [])
                .Where(c => !acknowledgedDeletes.Contains(c.Id))
                .Select(c => acknowledgedRevocations.TryGetValue(c.Id, out var revoked) && c.RevokedAtUtc is null ? c with { RevokedAtUtc = revoked } : c)
                .OrderByDescending(credential => credential.CreatedAtUtc)
                .ThenByDescending(credential => credential.Id)
                .ToList();
            selectedInactive.IntersectWith(VisibleCredentials.Where(IsInactive).Select(c => c.Id));
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            if (revision != listRevision) return;
            error = "Credentials could not be loaded. Confirm that your current session is authorized and retry.";
        }
        finally
        {
            if (revision == listRevision) loading = false;
        }
    }

    private async Task<(List<OrganizationDto> Items, bool Available)> LoadOrganizationChoicesAsync()
    {
        try
        {
            return (await Api.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations") ?? [], true);
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            // Account credential management does not require global organization
            // administration. Failure of this optional chooser must not discard
            // the independently authorized credential response.
            return ([], false);
        }
    }

    private void StartCreate()
    {
        if (saving) return;
        error = null;
        if (creationUncertain) { error = "Review the previous create result before creating a replacement."; return; }
        if (created is not null) { error = "Save or dismiss the displayed one-time credential before creating another."; return; }
        if (pendingSetup is not null) { showCreate = true; createStep = CreateStepCount; return; }
        confirmation = [];
        draft = new CreateCredentialDraft { OrganizationId = organizations.Count == 1 ? organizations[0].Id : string.Empty };
        createReference = new DateTimeOffset(DateTimeOffset.UtcNow.UtcTicks / 10 * 10, TimeSpan.Zero);
        draft.ExpiresAtUtcText = ExactUtc(createReference.AddDays(30));
        organizationDrafts.Clear();
        policyDrafts.Clear();
        basePolicy = null;
        setupRequestId = Guid.NewGuid();
        finalApproval = false;
        createStep = 1;
        showCreate = true;
    }

    private void CancelCreate()
    {
        if (saving) return;
        showCreate = false;
        if (pendingSetup is not null) return;
        createStep = 1;
        finalApproval = false;
        draft = new();
    }

    private void PreviousCreateStep() => EditCreateStep(createStep - 1);

    private async Task NextCreateStep()
    {
        if (saving) return;
        error = null;
        finalApproval = false;
        if (createStep == 1)
        {
            if (string.IsNullOrWhiteSpace(draft.Name) || draft.Name.Length > 128 || ParsedExpiry is not { } expiry ||
                expiry <= DateTimeOffset.UtcNow || expiry > DateTimeOffset.UtcNow.AddDays(90) ||
                (IsMcp && (!Uri.TryCreate(draft.McpResourceUri, UriKind.Absolute, out var resource) ||
                    resource.Scheme != Uri.UriSchemeHttps || resource.AbsolutePath.TrimEnd('/') != "/mcp" ||
                    !string.IsNullOrEmpty(resource.Query) || !string.IsNullOrEmpty(resource.Fragment) || !string.IsNullOrEmpty(resource.UserInfo))))
            {
                error = "Enter a name, an exact UTC expiry within 90 days, and the canonical HTTPS /mcp URL for HTTP MCP.";
                return;
            }
        }
        else if (createStep == 3 && (draft.Permissions.Count == 0 || string.IsNullOrWhiteSpace(draft.OrganizationId)))
        {
            error = "Choose one organization and at least one eligible permission.";
            return;
        }
        if (IsMcp && createStep == 3)
        {
            if (setupOperations.Length == 0)
            {
                var generation = setupRequestId;
                saving = true;
                try
                {
                    var choices = (await Api.GetFromJsonAsync<SetupOptions>("api/v1/integration-credentials/setup-options"))?.Operations ?? [];
                    if (!showCreate || setupRequestId != generation || createStep != 3) return;
                    setupOperations = choices;
                }
                catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
                { error = "Policy choices could not be loaded. Your connection and access selections are retained; retry this step."; return; }
                finally { saving = false; }
                if (setupOperations.Length == 0) { error = "No supported HTTP MCP operation choices were returned. Retry loading policy choices."; return; }
            }
            PrepareBasePolicy();
        }
        if (IsMcp && createStep == 4 && !ValidateBasePolicy()) return;
        createStep = Math.Min(CreateStepCount, createStep + 1);
    }

    private void PrepareBasePolicy()
    {
        var scope = IsOwnerAdministration ? "server" : "organization";
        var organization = IsOwnerAdministration ? null : draft.OrganizationId;
        if (basePolicy is not null && (basePolicy.Scope != scope || basePolicy.OrganizationId != organization))
        {
            policyDrafts[PolicyDraftKey(basePolicy.Scope, basePolicy.OrganizationId)] = basePolicy;
            basePolicy = policyDrafts.GetValueOrDefault(PolicyDraftKey(scope, organization));
        }
        if (basePolicy is null || basePolicy.Scope != scope || basePolicy.OrganizationId != organization)
        {
            var suffix = $" · {(IsOwnerAdministration ? "Server access" : OrganizationLabel(draft.OrganizationId))} · All access";
            if (suffix.Length > 100) suffix = " · All access";
            var name = draft.Name.Trim();
            var policyName = name[..Math.Min(name.Length, 128 - suffix.Length)] + suffix;
            basePolicy = new(policyName,
                scope, organization, "Allow", draft.Permissions.Order(StringComparer.Ordinal).ToArray(), setupOperations.Select(x => x.Key).ToArray(), ParsedExpiry!.Value.UtcDateTime, []);
        }
        else
        {
            basePolicy = basePolicy with { Permissions = basePolicy.Permissions.Intersect(draft.Permissions, StringComparer.OrdinalIgnoreCase).ToArray() };
        }
    }
    private static string PolicyDraftKey(string scope, string? organization) => $"{scope}:{organization}";
    private void BasePolicyChanged(McpPolicyScopeDraft value)
    {
        basePolicy = value;
        policyDrafts[PolicyDraftKey(value.Scope, value.OrganizationId)] = value;
        finalApproval = false;
    }
    private bool ValidateBasePolicy()
    {
        if (ParsedExpiry is not { } credentialExpiry || basePolicy is null || string.IsNullOrWhiteSpace(basePolicy.Name) || basePolicy.Name.Length > 128 ||
            basePolicy.Permissions.Length == 0 || basePolicy.Operations.Length == 0 ||
            basePolicy.ExpiresUtc <= DateTime.UtcNow || basePolicy.ExpiresUtc > credentialExpiry.UtcDateTime ||
            basePolicy.Exceptions.Any(x => string.IsNullOrWhiteSpace(x.Name) || x.Operations.Length == 0 || x.ExpiresUtc <= DateTime.UtcNow ||
                x.ExpiresUtc > basePolicy.ExpiresUtc || x.Operations.Except(basePolicy.Operations, StringComparer.Ordinal).Any()))
        {
            error = "Review the policy name, permission and operation selections, exact expiry, and exceptions. Each exception must stay inside the base policy and its lifetime.";
            return false;
        }
        return true;
    }
    private sealed record SetupOptions(McpPolicyOperation[] Operations);

    private CredentialDetailsModel DetailsModel(CredentialMetadata credential) => new(
        credential.Id, credential.Name, credential.Prefix, credential.Purpose, credential.OrganizationId,
        OrganizationLabel(credential.OrganizationId), credential.Permissions, credential.ExpiresAtUtc,
        credential.CreatedAtUtc, credential.LastUsedAtUtc, credential.RevokedAtUtc, credential.McpResourceUri);

    private void AccessChanged(IntegrationCredentialAccessDetails current)
    {
        ++listRevision; // A list started before the saved grant readback cannot restore old counts.
        loading = false;
        if (current.RevokedAtUtc is { } revoked) acknowledgedRevocations[current.CredentialId] = revoked;
        credentials = credentials.Select(c => c.Id == current.CredentialId
            ? c with { Permissions = current.Permissions, RevokedAtUtc = c.RevokedAtUtc ?? current.RevokedAtUtc } : c).ToList();
        if (details?.Id == current.CredentialId)
            details = details with { Permissions = current.Permissions, RevokedAtUtc = details.RevokedAtUtc ?? current.RevokedAtUtc };
    }

    private void ReviewDetails(CredentialMetadata credential) { details = credential; confirmation = []; }
    private void BeginRevoke(CredentialMetadata credential) => BeginMutation([credential], "revoke");
    private void BeginDelete(CredentialMetadata credential) => BeginMutation([credential], "delete");
    private void BeginCleanup() => BeginMutation(VisibleCredentials.Where(c => selectedInactive.Contains(c.Id) && IsInactive(c)).Take(50).ToList(), "delete");
    private void BeginMutation(List<CredentialMetadata> items, string action)
    { if (saving) return; error = null; details = null; confirmation = items; confirmationAction = action; cleanupFailures = []; }
    private void SearchCredentialsChanged(ChangeEventArgs args) { search = args.Value?.ToString() ?? ""; selectedInactive.Clear(); }
    private void FilterChanged(ChangeEventArgs args) { statusFilter = args.Value?.ToString() ?? "All"; selectedInactive.Clear(); }
    private void ClearSelection() => selectedInactive.Clear();
    private void SelectInactive(CredentialMetadata credential, ChangeEventArgs args)
    { if (saving || !IsInactive(credential)) return; if (args.Value is true && selectedInactive.Count < 50) selectedInactive.Add(credential.Id); else selectedInactive.Remove(credential.Id); }
    private void CloseDialog() { if (!saving) { details = null; confirmation = []; } }

    private Task OnOrganizationChanged(string value)
    {
        if (!IsOwnerAdministration && !string.IsNullOrWhiteSpace(draft.OrganizationId))
            organizationDrafts[draft.OrganizationId] = new(draft.Permissions, StringComparer.OrdinalIgnoreCase);
        draft.OrganizationId = value;
        draft.Permissions = IsOwnerAdministration ? [HelpdeskPermissions.HelpdeskAdmin] :
            organizationDrafts.TryGetValue(value, out var selected) ? new(selected, StringComparer.OrdinalIgnoreCase) : [];
        draft.OwnerAdministrationConsent = false;
        finalApproval = false;
        return Task.CompletedTask;
    }

    private void OnPurposeChanged(string purpose)
    {
        if (purpose == draft.Purpose) return;
        OnGrantKindChanged(IntegrationCredentialGrantKinds.Ordinary);
        draft.Purpose = purpose;
        finalApproval = false;
        createStep = 1;
    }

    private void OnGrantKindChanged(string grantKind)
    {
        if (draft.GrantKind == grantKind) return;
        if (!IsOwnerAdministration && !string.IsNullOrWhiteSpace(draft.OrganizationId))
            organizationDrafts[draft.OrganizationId] = new(draft.Permissions, StringComparer.OrdinalIgnoreCase);
        draft.GrantKind = grantKind;
        draft.Permissions = IsOwnerAdministration ? [HelpdeskPermissions.HelpdeskAdmin] :
            organizationDrafts.TryGetValue(draft.OrganizationId, out var selected) ? new(selected, StringComparer.OrdinalIgnoreCase) : [];
        draft.OwnerAdministrationConsent = false;
        finalApproval = false;
    }

    private Task OnPermissionsChanged(IEnumerable<string>? values)
    {
        draft.Permissions = values?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
        finalApproval = false;
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (saving || creationUncertain || created is not null) return;
        error = null;
        var isMcpSetup = pendingSetup is not null || IsMcp;
        var request = pendingSetup?.Credential;
        // Once submission begins, only the server can resolve its durable result.
        // A locally expired or changed draft must not strand the same-request retry.
        if (request is null)
        {
            if (!finalApproval || string.IsNullOrWhiteSpace(draft.Name) || string.IsNullOrWhiteSpace(draft.OrganizationId) ||
                ParsedExpiry is not { } expiresAtUtc || expiresAtUtc <= DateTimeOffset.UtcNow || draft.Permissions.Count == 0 ||
                (IsOwnerAdministration && !draft.OwnerAdministrationConsent))
            {
                error = "Review the connection, scope and exact expiry, then approve creating this integration.";
                return;
            }
            if (isMcpSetup && !ValidateBasePolicy()) return;
            request = new CreateCredentialRequest(
                draft.Name.Trim(), draft.Purpose, draft.OrganizationId, draft.Permissions.Order(StringComparer.OrdinalIgnoreCase).ToArray(), null)
            {
                GrantKind = draft.GrantKind,
                OwnerAdministrationConsent = draft.OwnerAdministrationConsent,
                ExpiresAtUtc = expiresAtUtc,
                McpResourceUri = isMcpSetup ? draft.McpResourceUri?.Trim() : null
            };
        }
        saving = true;
        ++listRevision;
        try
        {
            if (isMcpSetup)
            {
                pendingSetup ??= new SetupRequest(setupRequestId, request, [basePolicy!], true);
                using var response = await MutationApi.PostAsJsonAsync("api/v1/integration-credentials/setup", pendingSetup);
                if (!response.IsSuccessStatusCode)
                {
                    if (await IsTerminalSetupResponseAsync(response)) { await ResetTerminalSetupAsync(); return; }
                    error = $"Integration setup did not complete (HTTP {(int)response.StatusCode}). The approved setup is retained; retry delivery to recover its result.";
                    if (response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.UnprocessableEntity)
                    { pendingSetup = null; setupRequestId = Guid.NewGuid(); finalApproval = false; error = $"Integration setup was rejected (HTTP {(int)response.StatusCode}). Your draft is retained. Review the selected scope, policy bounds and current authority."; }
                    return;
                }
                var delivery = await response.Content.ReadFromJsonAsync<SetupResponse>();
                if (delivery is null || !MatchesApprovedDelivery(delivery, pendingSetup))
                { error = "Integration setup returned no matching credential delivery. Retry delivery with this approved setup."; return; }
                created = delivery.Credential;
                deliveredSetupRequestId = delivery.RequestId;
                deliveryExpiresAtUtc = delivery.HandoffExpiresAtUtc;
                pendingSetup = null;
            }
            else
            {
                using var response = await MutationApi.PostAsJsonAsync("api/v1/integration-credentials/", request);
                if ((int)response.StatusCode >= 500) { await MarkCreationUncertainAsync(); return; }
                if (!response.IsSuccessStatusCode)
                { error = $"Credential creation was rejected (HTTP {(int)response.StatusCode}). Your draft is retained. Review its organization, permissions and exact expiry."; return; }
                created = await response.Content.ReadFromJsonAsync<CreatedCredential>();
                if (created is null || created.Id == Guid.Empty || string.IsNullOrWhiteSpace(created.Secret))
                { await MarkCreationUncertainAsync(); return; }
            }
            showCreate = false;
            createStep = 1;
            confirmation = [];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            if (isMcpSetup) error = "The setup delivery could not be confirmed. Your approved draft is retained; retry delivery to recover the same integration.";
            else await MarkCreationUncertainAsync();
        }
        finally { saving = false; }
    }
    private static bool MatchesApprovedDelivery(SetupResponse delivery, SetupRequest request)
    {
        var credential = delivery.Credential;
        var canonicalResource = Uri.TryCreate(request.Credential.McpResourceUri, UriKind.Absolute, out var resource) ? resource.AbsoluteUri.TrimEnd('/') : null;
        return delivery.RequestId == request.RequestId && credential is not null &&
            credential.Id != Guid.Empty && !string.IsNullOrWhiteSpace(credential.Prefix) && !string.IsNullOrWhiteSpace(credential.Secret) &&
            credential.Purpose == "mcp" && credential.GrantKind == request.Credential.GrantKind &&
            credential.OrganizationId == request.Credential.OrganizationId && credential.ExpiresAtUtc == request.Credential.ExpiresAtUtc &&
            credential.McpResourceUri == canonicalResource && credential.Permissions is not null &&
            credential.Permissions.Order(StringComparer.Ordinal).SequenceEqual(request.Credential.Permissions.Order(StringComparer.Ordinal));
    }
    private async Task MarkCreationUncertainAsync()
    {
        creationUncertain = true; showCreate = false; created = null;
        await ReloadAsync();
        error = "The create result could not be confirmed. Review the newest records before replacing an unusable credential.";
    }
    private void AcknowledgeUncertainCreation() { creationUncertain = false; error = null; }

    private async Task ConfirmMutationAsync()
    {
        if (saving || confirmation.Count == 0) return;
        saving = true;
        ++listRevision; // A list fetched before this acknowledged write must never restore it.
        cleanupFailures = [];
        var failed = new List<CredentialMetadata>();
        using var deadline = new CancellationTokenSource(TimeSpan.FromMinutes(2));
        var pending = confirmation.Take(50).ToArray();
        try
        {
            for (var index = 0; index < pending.Length; index++)
            {
                var credential = pending[index];
                try
                {
                    var path = $"api/v1/integration-credentials/{credential.Id:N}" + (confirmationAction == "delete" ? "/record" : "");
                    using var response = await MutationApi.DeleteAsync(path, deadline.Token);
                    if (!response.IsSuccessStatusCode && !(confirmationAction == "delete" && response.StatusCode == System.Net.HttpStatusCode.NotFound))
                    { failed.Add(credential); cleanupFailures.Add($"{credential.Name}: action failed; retry"); continue; }
                    ++listRevision;
                    if (confirmationAction == "delete") acknowledgedDeletes.Add(credential.Id);
                    else acknowledgedRevocations[credential.Id] = DateTimeOffset.UtcNow;
                    credentials = confirmationAction == "delete" ? credentials.Where(c => c.Id != credential.Id).ToList() :
                        credentials.Select(c => c.Id == credential.Id ? c with { RevokedAtUtc = DateTimeOffset.UtcNow } : c).ToList();
                    selectedInactive.Remove(credential.Id);
                }
                catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
                {
                    failed.Add(credential); cleanupFailures.Add($"{credential.Name}: service unavailable or timed out; retry");
                    if (deadline.IsCancellationRequested)
                    {
                        failed.AddRange(pending.Skip(index + 1));
                        cleanupFailures.Add("Cleanup deadline reached. Remaining selected records are retained for retry.");
                        break;
                    }
                }
            }
            confirmation = failed;
        }
        finally { saving = false; loading = false; }
    }

    private async Task ClearCreatedCredential()
    {
        if (saving) return;
        if (deliveredSetupRequestId is not { } requestId) { created = null; return; }
        saving = true;
        try
        {
            using var response = await MutationApi.PostAsJsonAsync($"api/v1/integration-credentials/setup/{requestId}/acknowledge", new { });
            if (!response.IsSuccessStatusCode && await IsTerminalSetupResponseAsync(response)) { await ResetTerminalSetupAsync(); return; }
            if (!response.IsSuccessStatusCode) { error = $"The saved-credential acknowledgement failed (HTTP {(int)response.StatusCode}). The credential remains visible; retry after saving it."; return; }
            deliveredSetupRequestId = null; deliveryExpiresAtUtc = null; created = null; error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
        { error = "The saved-credential acknowledgement could not be confirmed. Retry after saving the displayed credential."; }
        finally { saving = false; }
    }

    private static async Task<bool> IsTerminalSetupResponseAsync(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Gone) return true;
        if (response.StatusCode != System.Net.HttpStatusCode.Conflict) return false;
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            return problem.TryGetProperty("code", out var code) && code.ValueKind == System.Text.Json.JsonValueKind.String &&
                code.GetString() is "setup_expired" or "setup_delivery_expired" or "setup_acknowledged" or "setup_completed" or "setup_revoked";
        }
        catch (System.Text.Json.JsonException) { return false; }
    }
    private async Task ResetTerminalSetupAsync()
    {
        pendingSetup = null; deliveredSetupRequestId = null; deliveryExpiresAtUtc = null; created = null; showCreate = false;
        finalApproval = false; setupRequestId = Guid.NewGuid();
        await ReloadAsync();
        error = "This setup handoff is no longer available. Review the integration list and start a new reviewed setup if you need another credential.";
    }

    private string OrganizationLabel(string? organizationId) =>
        organizations.FirstOrDefault(organization => string.Equals(organization.Id, organizationId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? organizationId
        ?? "No organization";

    private static string PermissionLabel(string permission) => CredentialPermissionLabels.Name(permission);

    private static string PurposeLabel(string purpose) => purpose == IntegrationCredentialGrantKinds.OwnerAdministrationPurpose ? "HTTP MCP owner administration"
        : string.Equals(purpose, "mcp", StringComparison.OrdinalIgnoreCase)
        ? "HTTP MCP client" : purpose == "mcp-setup" ? "Temporary verification client"
        : "API / CLI / stdio MCP";

    private sealed class CreateCredentialDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Purpose { get; set; } = "api";
        public string OrganizationId { get; set; } = string.Empty;
        public HashSet<string> Permissions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public int? LifetimeDays { get; set; } = 30;
        public string ExpiresAtUtcText { get; set; } = string.Empty;
        public string? McpResourceUri { get; set; }
        public string GrantKind { get; set; } = IntegrationCredentialGrantKinds.Ordinary;
        public bool OwnerAdministrationConsent { get; set; }
    }

    private sealed record CreateCredentialRequest(string Name, string Purpose, string OrganizationId, IReadOnlyList<string> Permissions, int? LifetimeDays)
    {
        public string? McpResourceUri { get; init; }
        public string GrantKind { get; init; } = IntegrationCredentialGrantKinds.Ordinary;
        public bool OwnerAdministrationConsent { get; init; }
        public DateTimeOffset? ExpiresAtUtc { get; init; }
    }

    private sealed record SetupRequest(Guid RequestId, CreateCredentialRequest Credential, McpPolicyScopeDraft[] Policies, bool Approved);
    private sealed record SetupResponse(Guid RequestId, CreatedCredential Credential)
    {
        public DateTimeOffset? HandoffExpiresAtUtc { get; init; }
    }

    private sealed record CredentialMetadata(Guid Id, string Name, string Prefix, string Purpose, string? OrganizationId, IReadOnlyList<string> Permissions, DateTimeOffset ExpiresAtUtc, DateTimeOffset CreatedAtUtc, DateTimeOffset? LastUsedAtUtc, DateTimeOffset? RevokedAtUtc)
    {
        public string? McpResourceUri { get; init; }
    }

    private sealed record CreatedCredential(Guid Id, string Prefix, string Secret, string Purpose, string? OrganizationId, IReadOnlyList<string> Permissions, DateTimeOffset ExpiresAtUtc)
    {
        public string? McpResourceUri { get; init; }
        public string GrantKind { get; init; } = IntegrationCredentialGrantKinds.Ordinary;
        public override string ToString() => $"CreatedCredential {{ Id = {Id}, Prefix = {Prefix}, Secret = [redacted], Purpose = {Purpose} }}";
    }
}

