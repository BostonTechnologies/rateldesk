@page "/account/integration-credentials"
@attribute [Authorize]
@using Helpdesk.Shared.Auth
@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<PageTitle>Integration credentials</PageTitle>

<MudPaper Class="helpdesk-content-surface pa-4" data-testid="integration-credentials-page" data-interactive="@interactive.ToString().ToLowerInvariant()">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" HtmlTag="h1" Class="helpdesk-page-title">Integration credentials</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Manage system connections separately from credentials for your account.</MudText>
                @if (SafeReturnUrl is not null) { <MudButton Href="@SafeReturnUrl" Size="Size.Small">Return to setup</MudButton> }
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
        }

        @if (creationUncertain)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                <MudText>The last create result could not be confirmed. Refresh the list and revoke any newly created credential whose one-time secret you did not receive before creating a replacement.</MudText>
                <MudButton OnClick="AcknowledgeUncertainCreation" Disabled="@saving">I have reviewed and revoked any unusable credential</MudButton>
            </MudAlert>
        }
        <div class="integration-tabs-shell">
        <MudTabs MinimumTabWidth="0" ActivePanelIndex="@activeTab" ActivePanelIndexChanged="ChangeTab" Rounded="true" PanelClass="pt-4" KeepPanelsAlive="true" data-testid="integration-credential-tabs">
            @if (access?.IsHelpdeskAdmin == true)
            {
                <MudTabPanel Text="System connections" Icon="@Icons.Material.Filled.Link" data-testid="integration-system-connections">
                    <PairingConnectionsPanel OrganizationId="@OrganizationId" />
                </MudTabPanel>
            }
            <MudTabPanel Text="API &amp; MCP credentials" Icon="@Icons.Material.Filled.Key" data-testid="integration-account-credentials">
                <IntegrationCredentialApproval Embedded="true" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudText Typo="Typo.body2">Credentials use your account's permissions. Each new secret is displayed once.</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate" Disabled="@(loading || creationUncertain)" data-testid="integration-credential-create">Create credential</MudButton>
                </MudStack>

        @if (created is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle2">Copy this credential now</MudText>
                <MudText Typo="Typo.body2">It will not be shown again. Store it in an approved secret manager.</MudText>
                <MudTextField Value="@created.Secret" Label="Credential" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" FullWidth="true" />
                @if (string.Equals(created.Purpose, "mcp", StringComparison.OrdinalIgnoreCase))
                {
                    <MudText Typo="Typo.caption" Class="mt-2">HTTP MCP header: <code>Authorization: Bearer &lt;credential&gt;</code>. Keep the credential bound to the exact configured public /mcp resource.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-2">CLI environment: <code>RATELDESK_CREDENTIAL_MODE=integration</code> and <code>RATELDESK_INTEGRATION_CREDENTIAL=&lt;credential&gt;</code>. Stdio MCP uses an isolated config file via <code>RATELDESK_MCP_CONFIG</code>, plus <code>RATELDESK_MCP_INSTANCE</code> and its pinned <code>RATELDESK_MCP_&lt;INSTANCE&gt;_API_BASE_URL</code>.</MudText>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearCreatedCredential">I have saved it</MudButton>
            </MudAlert>
        }

        @if (showCreate)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-1">Create credential</MudText>
                <MudSelect T="string" @bind-Value="draft.Purpose" Label="Purpose" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem Value='@("api")'>API / CLI / stdio MCP</MudSelectItem>
                    <MudSelectItem Value='@("mcp")'>HTTP MCP client</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Connection → Access → Review. Create a replacement before revoking an active credential.</MudText>
                <MudStack Row="true" Spacing="3" Class="mb-3">
                    <MudChip T="string" Color="@(createStep == 1 ? Color.Primary : Color.Default)">1. Connection</MudChip>
                    <MudChip T="string" Color="@(createStep == 2 ? Color.Primary : Color.Default)">2. Access</MudChip>
                    <MudChip T="string" Color="@(createStep == 3 ? Color.Primary : Color.Default)">3. Review</MudChip>
                </MudStack>

                @if (createStep == 3)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        <MudText Typo="Typo.subtitle2">Review before creating</MudText>
                        <MudText Typo="Typo.body2">Purpose: @PurposeLabel(draft.Purpose)</MudText>
                        <MudText Typo="Typo.body2">Destination: @(string.Equals(draft.Purpose, "mcp", StringComparison.OrdinalIgnoreCase) ? draft.McpResourceUri : "RatelDesk API / CLI / stdio MCP")</MudText>
                        <MudText Typo="Typo.body2">Organization: @OrganizationLabel(draft.OrganizationId)</MudText>
                        <MudText Typo="Typo.body2">Permissions: @string.Join(", ", draft.Permissions.Order(StringComparer.OrdinalIgnoreCase).Select(PermissionLabel))</MudText>
                        <MudText Typo="Typo.body2">Expiry: @(draft.LifetimeDays is null ? "30 days (default)" : $"{draft.LifetimeDays} days")</MudText>
                    </MudAlert>
                }
                else if (createStep == 1)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="draft.Name" Label="Name" Required="true" Immediate="true" HelperText="For example, a CI job or local MCP client." />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField T="int?" @bind-Value="draft.LifetimeDays" Label="Lifetime (days)" Min="1" Max="90" HelperText="1–90 days; defaults to 30." />
                        </MudItem>
                        @if (string.Equals(draft.Purpose, "mcp", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudItem xs="12">
                                <MudTextField @bind-Value="draft.McpResourceUri" Label="Public MCP resource URI" Required="true" Immediate="true" HelperText="Use the canonical HTTPS endpoint ending in /mcp. This binds the credential to that gateway only." />
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" Value="@draft.OrganizationId" ValueChanged="OnOrganizationChanged" Label="Organization" Required="true">
                                @foreach (var organization in organizations)
                                {
                                    <MudSelectItem Value="@organization.Id">@organization.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <CredentialPermissionSelector EligiblePermissions="@AvailablePermissions" SelectedValues="@draft.Permissions" SelectedValuesChanged="OnPermissionsChanged" Disabled="@saving" />
                        </MudItem>
                    </MudGrid>
                }
                @if (organizations.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">No enabled organization is currently available for a credential.</MudAlert>
                }
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                    <MudButton OnClick="CancelCreate" Disabled="@saving">Cancel</MudButton>
                    @if (createStep > 1)
                    {
                        <MudButton OnClick="PreviousCreateStep" Disabled="@saving">Back</MudButton>
                    }
                    @if (createStep < 3)
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NextCreateStep" Disabled="@(saving || organizations.Count == 0)">@(createStep == 1 ? "Choose access" : "Review credential")</MudButton>
                    }
                    else
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync" Disabled="@(saving || organizations.Count == 0)">@(saving ? "Creating…" : "Create and reveal")</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }

        <div class="credential-filters">
            <label>Search credentials <input type="search" value="@search" @oninput="SearchCredentialsChanged" placeholder="Name, purpose or organization" /></label>
            <label>Status <select value="@statusFilter" @onchange="FilterChanged">
                @foreach (var status in new[] { "All", "Active", "Revoked", "Expired" })
                { <option value="@status">@status (@CountStatus(status))</option> }
            </select></label>
            <MudButton Size="Size.Small" OnClick="ReloadAsync" Disabled="@(loading || saving)">Refresh</MudButton>
        </div>
        @if (selectedInactive.Count > 0)
        {
            <div class="credential-cleanup" role="status">
                <span>@selectedInactive.Count inactive credentials explicitly selected (maximum 50 per operation).</span>
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="BeginCleanup" Disabled="@saving">Delete selected inactive</MudButton>
                <MudButton Size="Size.Small" OnClick="ClearSelection" Disabled="@saving">Clear selection</MudButton>
            </div>
        }
        @if (loading)
        { <MudProgressLinear Indeterminate="true" /> }
        else if (credentials.Count == 0)
        { <MudAlert Severity="Severity.Info">No integration credentials have been created for this account.</MudAlert> }
        else
        {
            <MudTable Items="@VisibleCredentials" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Class="credential-table">
                <HeaderContent><MudTh>Select inactive</MudTh><MudTh>Name</MudTh><MudTh>Purpose / organization</MudTh><MudTh>Status</MudTh><MudTh>Expires / last used</MudTh><MudTh>Actions</MudTh></HeaderContent>
                <RowTemplate Context="credential">
                    <MudTd DataLabel="Select inactive">
                        @if (IsInactive(credential))
                        { <input type="checkbox" checked="@selectedInactive.Contains(credential.Id)" @onchange="args => SelectInactive(credential, args)" aria-label="@($"Select inactive {credential.Name}")" disabled="@saving" /> }
                    </MudTd>
                    <MudTd DataLabel="Name"><MudText Typo="Typo.subtitle2">@credential.Name</MudText><MudText Typo="Typo.caption">@credential.Prefix</MudText></MudTd>
                    <MudTd DataLabel="Purpose / organization"><MudText Typo="Typo.body2">@PurposeLabel(credential.Purpose)</MudText><MudText Typo="Typo.caption">@OrganizationLabel(credential.OrganizationId) · @credential.Permissions.Count permissions</MudText></MudTd>
                    <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(IsInactive(credential) ? Color.Default : Color.Success)">@CredentialStatus(credential)</MudChip></MudTd>
                    <MudTd DataLabel="Expires / last used"><MudText Typo="Typo.caption" HtmlTag="p">Expires @credential.ExpiresAtUtc.LocalDateTime.ToString("g")</MudText><MudText Typo="Typo.caption" HtmlTag="p">Last used: @(credential.LastUsedAtUtc?.LocalDateTime.ToString("g") ?? "Never")</MudText></MudTd>
                    <MudTd DataLabel="Actions"><div class="credential-row-actions">
                        <MudButton Size="Size.Small" OnClick="() => ReviewDetails(credential)">Details</MudButton>
                        @if (!IsInactive(credential))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => BeginRevoke(credential)" Disabled="@saving">Revoke</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => BeginDelete(credential)" Disabled="@saving">Revoke &amp; delete</MudButton>
                        }
                        else { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => BeginDelete(credential)" Disabled="@saving">Delete</MudButton> }
                    </div></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No credentials match these filters.</MudText></NoRecordsContent>
            </MudTable>
        }
        @if (details is not null || confirmation.Count > 0)
        {
            <CredentialReviewSurface Title="Credential details and lifecycle" OnClose="CloseDialog">
                    <h2 id="credential-dialog-title">@(details is not null ? details.Name : confirmationAction == "revoke" ? "Revoke credential" : "Delete credentials")</h2>
                    <div class="review-body">
                        @if (details is not null)
                        {
                            <dl><dt>Purpose</dt><dd>@PurposeLabel(details.Purpose)</dd><dt>Organization</dt><dd>@OrganizationLabel(details.OrganizationId)</dd><dt>Status</dt><dd>@CredentialStatus(details)</dd><dt>Created</dt><dd>@details.CreatedAtUtc.ToString("u")</dd><dt>Resource</dt><dd>@(details.McpResourceUri ?? "RatelDesk API")</dd><dt>Exact permissions</dt><dd>@string.Join(", ", details.Permissions)</dd></dl>
                        }
                        else
                        {
                            <p>@(confirmationAction == "revoke" ? "Access will stop. The inactive record will remain." : "These named records and their authentication material will be permanently removed. Active access will stop.")</p>
                            <ul>@foreach (var item in confirmation) { <li>@item.Name — @CredentialStatus(item)</li> }</ul>
                            @if (cleanupFailures.Count > 0) { <p role="alert">@string.Join("; ", cleanupFailures)</p> }
                        }
                    </div>
                    <footer><MudButton OnClick="CloseDialog" Disabled="@saving">@(details is not null ? "Close" : "Cancel")</MudButton>
                        @if (details is null) { <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmMutationAsync" Disabled="@saving">@(saving ? "Working…" : confirmationAction == "revoke" ? "Confirm revoke" : "Confirm delete")</MudButton> }
                    </footer>
            </CredentialReviewSurface>
        }
            </MudTabPanel>
        </MudTabs>
        </div>
    </MudStack>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }
    [SupplyParameterFromQuery(Name = "organizationId")] public string? OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string? SafeReturnUrl => !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') &&
        !ReturnUrl.StartsWith("//", StringComparison.Ordinal) && !ReturnUrl.Contains('\\') && !ReturnUrl.Any(char.IsControl) ? ReturnUrl : null;
    private void ChangeTab(int index)
    {
        // MudTabs emits registration callbacks during initial rendering. Only a
        // real interactive change should create a history entry or navigation.
        if (!interactive || activeTab == index) return;
        activeTab = index;
        var tab = access?.IsHelpdeskAdmin == true && index == 0 ? "connections" : "credentials";
        var target = Navigation.GetUriWithQueryParameter("tab", tab);
        if (target != Navigation.Uri) Navigation.NavigateTo(target);
    }
    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");
    // One-time issuance and bounded per-record writes must not be replayed by general HTTP retries.
    private HttpClient MutationApi => HttpClientFactory.CreateClient("SystemPairingApi");
    private CurrentUserAccessProfile? access;
    private List<OrganizationDto> organizations = [];
    private List<CredentialMetadata> credentials = [];
    private CreateCredentialDraft draft = new();
    private CreatedCredential? created;
    private bool interactive;
    private string? appliedTab;
    protected override void OnParametersSet()
    {
        if (access is null || appliedTab == InitialTab) return;
        ApplyNavigation();
    }
    private void ApplyNavigation()
    {
        appliedTab = InitialTab;
        activeTab = access?.IsHelpdeskAdmin == true && InitialTab == "credentials" ? 1 : 0;
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            interactive = true;
            StateHasChanged();
        }
    }

    private bool loading = true;
    private bool saving;
    private bool showCreate;
    private bool creationUncertain;
    private readonly HashSet<Guid> acknowledgedDeletes = [];
    private readonly Dictionary<Guid, DateTimeOffset> acknowledgedRevocations = [];
    private int activeTab;
    private int createStep = 1;
    private string search = "";
    private string statusFilter = "All";
    private HashSet<Guid> selectedInactive = [];
    private CredentialMetadata? details;
    private List<CredentialMetadata> confirmation = [];
    private string confirmationAction = "";
    private List<string> cleanupFailures = [];
    private long listRevision;
    private IEnumerable<CredentialMetadata> VisibleCredentials => credentials.Where(c =>
        (statusFilter == "All" || CredentialStatus(c) == statusFilter) &&
        (string.IsNullOrWhiteSpace(search) || $"{c.Name} {c.Purpose} {OrganizationLabel(c.OrganizationId)}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)));
    private static string CredentialStatus(CredentialMetadata c) => c.RevokedAtUtc is not null ? "Revoked" : c.ExpiresAtUtc <= DateTimeOffset.UtcNow ? "Expired" : "Active";
    private static bool IsInactive(CredentialMetadata c) => CredentialStatus(c) != "Active";
    private int CountStatus(string status) => credentials.Count(c => status == "All" || CredentialStatus(c) == status);

    private string? error;

    private IEnumerable<string> AvailablePermissions
    {
        get
        {
            if (access?.IsHelpdeskAdmin == true)
            {
                return HelpdeskPermissions.AssignablePermissions;
            }

            if (access is null)
            {
                return [];
            }

            if (!access.UsesScopedPermissions && access.ScopedPermissionGrants.Count == 0)
            {
                return access.Permissions
                    .Where(permission => HelpdeskPermissions.AssignablePermissions.Contains(permission, StringComparer.OrdinalIgnoreCase))
                    .Order(StringComparer.OrdinalIgnoreCase);
            }

            return access.ScopedPermissionGrants
                .Where(grant => string.Equals(grant.OrganizationId, draft.OrganizationId, StringComparison.OrdinalIgnoreCase))
                .Select(grant => grant.Permission)
                .Where(permission => HelpdeskPermissions.AssignablePermissions.Contains(permission, StringComparer.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Order(StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        access = CurrentUserAccessProfile.FromClaims((await AuthenticationState.GetAuthenticationStateAsync()).User);
        await ReloadAsync();
        ApplyNavigation();
    }

    private async Task ReloadAsync()
    {
        var revision = ++listRevision;
        loading = true;
        error = null;
        try
        {
            var organizationTask = Api.GetFromJsonAsync<List<OrganizationDto>>("api/v1/organizations");
            var credentialTask = Api.GetFromJsonAsync<List<CredentialMetadata>>("api/v1/integration-credentials/");
            await Task.WhenAll(organizationTask, credentialTask);
            if (revision != listRevision) return;
            organizations = (organizationTask.Result ?? [])
                .Where(organization => organization.IsEnabled && (access?.IsHelpdeskAdmin == true || access?.AllowedOrganizationIds.Contains(organization.Id) == true))
                .OrderBy(organization => organization.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            credentials = (credentialTask.Result ?? [])
                .Where(c => !acknowledgedDeletes.Contains(c.Id))
                .Select(c => acknowledgedRevocations.TryGetValue(c.Id, out var revoked) && c.RevokedAtUtc is null ? c with { RevokedAtUtc = revoked } : c)
                .OrderByDescending(credential => credential.CreatedAtUtc)
                .ThenByDescending(credential => credential.Id)
                .ToList();
            selectedInactive.IntersectWith(VisibleCredentials.Where(IsInactive).Select(c => c.Id));
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            if (revision != listRevision) return;
            error = "Credentials could not be loaded. Confirm that your current session is authorized and retry.";
        }
        finally
        {
            if (revision == listRevision) loading = false;
        }
    }

    private void StartCreate()
    {
        error = null;
        if (creationUncertain) { error = "Review the previous create result before creating a replacement."; return; }
        if (created is not null) { error = "Save or dismiss the displayed one-time credential before creating another."; return; }
        confirmation = [];
        draft = new CreateCredentialDraft { OrganizationId = organizations.Count == 1 ? organizations[0].Id : string.Empty };
        createStep = 1;
        showCreate = true;
    }

    private void CancelCreate()
    {
        showCreate = false;
        createStep = 1;
        draft = new();
    }

    private void PreviousCreateStep() => createStep = Math.Max(1, createStep - 1);

    private void NextCreateStep()
    {
        error = null;
        if (createStep == 1)
        {
            if (string.IsNullOrWhiteSpace(draft.Name) || draft.LifetimeDays is < 1 or > 90 ||
                (string.Equals(draft.Purpose, "mcp", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(draft.McpResourceUri)))
            {
                error = "Enter a name, a lifetime from 1–90 days, and the canonical MCP resource when using HTTP MCP.";
                return;
            }
        }
        else if (draft.Permissions.Count == 0 || string.IsNullOrWhiteSpace(draft.OrganizationId))
        {
            error = "Choose one organization and at least one permission.";
            return;
        }

        createStep = Math.Min(3, createStep + 1);
    }

    private void ReviewDetails(CredentialMetadata credential) { details = credential; confirmation = []; }
    private void BeginRevoke(CredentialMetadata credential) => BeginMutation([credential], "revoke");
    private void BeginDelete(CredentialMetadata credential) => BeginMutation([credential], "delete");
    private void BeginCleanup() => BeginMutation(VisibleCredentials.Where(c => selectedInactive.Contains(c.Id) && IsInactive(c)).Take(50).ToList(), "delete");
    private void BeginMutation(List<CredentialMetadata> items, string action)
    { if (saving) return; error = null; details = null; confirmation = items; confirmationAction = action; cleanupFailures = []; }
    private void SearchCredentialsChanged(ChangeEventArgs args) { search = args.Value?.ToString() ?? ""; selectedInactive.Clear(); }
    private void FilterChanged(ChangeEventArgs args) { statusFilter = args.Value?.ToString() ?? "All"; selectedInactive.Clear(); }
    private void ClearSelection() => selectedInactive.Clear();
    private void SelectInactive(CredentialMetadata credential, ChangeEventArgs args)
    { if (saving || !IsInactive(credential)) return; if (args.Value is true && selectedInactive.Count < 50) selectedInactive.Add(credential.Id); else selectedInactive.Remove(credential.Id); }
    private void CloseDialog() { if (!saving) { details = null; confirmation = []; } }

    private Task OnOrganizationChanged(string value)
    {
        draft.OrganizationId = value;
        draft.Permissions.Clear();
        return Task.CompletedTask;
    }

    private Task OnPermissionsChanged(IEnumerable<string>? values)
    {
        draft.Permissions = values?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (saving || creationUncertain || created is not null) return;
        error = null;
        if (string.IsNullOrWhiteSpace(draft.Name) || string.IsNullOrWhiteSpace(draft.OrganizationId) || draft.Permissions.Count == 0)
        {
            error = "Enter a name, organization, and at least one permission.";
            return;
        }

        saving = true;
        ++listRevision;
        try
        {
            var request = new CreateCredentialRequest(
                draft.Name.Trim(), draft.Purpose, draft.OrganizationId, draft.Permissions.Order(StringComparer.OrdinalIgnoreCase).ToArray(), draft.LifetimeDays)
            {
                McpResourceUri = string.Equals(draft.Purpose, "mcp", StringComparison.OrdinalIgnoreCase)
                    ? draft.McpResourceUri?.Trim()
                    : null
            };
            using var response = await MutationApi.PostAsJsonAsync("api/v1/integration-credentials/", request);
            if ((int)response.StatusCode >= 500) { await MarkCreationUncertainAsync(); return; }
            if (!response.IsSuccessStatusCode)
            {
                error = "The credential could not be created. Check its organization, permissions, purpose, resource URI, and lifetime.";
                return;
            }

            created = await response.Content.ReadFromJsonAsync<CreatedCredential>();
            if (created is null || created.Id == Guid.Empty || string.IsNullOrWhiteSpace(created.Secret))
            {
                await MarkCreationUncertainAsync(); return;
            }

            showCreate = false;
            createStep = 1;
            confirmation = [];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        { await MarkCreationUncertainAsync(); }
        finally { saving = false; }
    }
    private async Task MarkCreationUncertainAsync()
    {
        creationUncertain = true; showCreate = false; created = null;
        await ReloadAsync();
        error = "The create result could not be confirmed. Review the newest records before replacing an unusable credential.";
    }
    private void AcknowledgeUncertainCreation() { creationUncertain = false; error = null; }

    private async Task ConfirmMutationAsync()
    {
        if (saving || confirmation.Count == 0) return;
        saving = true;
        ++listRevision; // A list fetched before this acknowledged write must never restore it.
        cleanupFailures = [];
        var failed = new List<CredentialMetadata>();
        using var deadline = new CancellationTokenSource(TimeSpan.FromMinutes(2));
        var pending = confirmation.Take(50).ToArray();
        try
        {
            for (var index = 0; index < pending.Length; index++)
            {
                var credential = pending[index];
                try
                {
                    var path = $"api/v1/integration-credentials/{credential.Id:N}" + (confirmationAction == "delete" ? "/record" : "");
                    using var response = await MutationApi.DeleteAsync(path, deadline.Token);
                    if (!response.IsSuccessStatusCode && !(confirmationAction == "delete" && response.StatusCode == System.Net.HttpStatusCode.NotFound))
                    { failed.Add(credential); cleanupFailures.Add($"{credential.Name}: action failed; retry"); continue; }
                    ++listRevision;
                    if (confirmationAction == "delete") acknowledgedDeletes.Add(credential.Id);
                    else acknowledgedRevocations[credential.Id] = DateTimeOffset.UtcNow;
                    credentials = confirmationAction == "delete" ? credentials.Where(c => c.Id != credential.Id).ToList() :
                        credentials.Select(c => c.Id == credential.Id ? c with { RevokedAtUtc = DateTimeOffset.UtcNow } : c).ToList();
                    selectedInactive.Remove(credential.Id);
                }
                catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
                {
                    failed.Add(credential); cleanupFailures.Add($"{credential.Name}: service unavailable or timed out; retry");
                    if (deadline.IsCancellationRequested)
                    {
                        failed.AddRange(pending.Skip(index + 1));
                        cleanupFailures.Add("Cleanup deadline reached. Remaining selected records are retained for retry.");
                        break;
                    }
                }
            }
            confirmation = failed;
        }
        finally { saving = false; loading = false; }
    }

    private void ClearCreatedCredential() => created = null;

    private string OrganizationLabel(string? organizationId) =>
        organizations.FirstOrDefault(organization => string.Equals(organization.Id, organizationId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? organizationId
        ?? "No organization";

    private static string PermissionLabel(string permission) => permission.Replace('.', ' ');

    private static string PurposeLabel(string purpose) => string.Equals(purpose, "mcp", StringComparison.OrdinalIgnoreCase)
        ? "HTTP MCP client" : purpose == "mcp-setup" ? "Temporary verification client"
        : "API / CLI / stdio MCP";

    private sealed class CreateCredentialDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Purpose { get; set; } = "api";
        public string OrganizationId { get; set; } = string.Empty;
        public HashSet<string> Permissions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public int? LifetimeDays { get; set; } = 30;
        public string? McpResourceUri { get; set; }
    }

    private sealed record CreateCredentialRequest(string Name, string Purpose, string OrganizationId, IReadOnlyList<string> Permissions, int? LifetimeDays)
    {
        public string? McpResourceUri { get; init; }
    }

    private sealed record CredentialMetadata(Guid Id, string Name, string Prefix, string Purpose, string? OrganizationId, IReadOnlyList<string> Permissions, DateTimeOffset ExpiresAtUtc, DateTimeOffset CreatedAtUtc, DateTimeOffset? LastUsedAtUtc, DateTimeOffset? RevokedAtUtc)
    {
        public string? McpResourceUri { get; init; }
    }

    private sealed record CreatedCredential(Guid Id, string Prefix, string Secret, string Purpose, string? OrganizationId, IReadOnlyList<string> Permissions, DateTimeOffset ExpiresAtUtc)
    {
        public string? McpResourceUri { get; init; }
    }
