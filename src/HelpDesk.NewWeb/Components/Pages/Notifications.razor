    }

    private async Task ApplyCreatedFilterAsync()
    {
        var from = CombineLocalDateTime(pendingFromDate, pendingFromTime, endOfDay: false);
        var to = CombineLocalDateTime(pendingToDate, pendingToTime, endOfDay: true);

        if (from.HasValue && to.HasValue && from.Value > to.Value)
        {
            Snackbar.Add("Created From must be before To.", Severity.Warning);
            return;
        }

        createdFrom = from;
        createdTo = to;
        createdPopoverOpen = false;
        await ReloadTableAsync();
    }

    private async Task ClearCreatedFilterAsync()
    {
        pendingFromDate = null;
        pendingToDate = null;
        pendingFromTime = null;
        pendingToTime = null;
        createdFrom = null;
        createdTo = null;
        createdPopoverOpen = false;
        await ReloadTableAsync();
    }

    private void SetPendingCreatedFromApplied()
    {
        (pendingFromDate, pendingFromTime) = SplitLocalDateTime(createdFrom);
        (pendingToDate, pendingToTime) = SplitLocalDateTime(createdTo);
    }

    private static DateTimeOffset? CombineLocalDateTime(DateTime? date, TimeSpan? time, bool endOfDay)
    {
        if (!date.HasValue)
            return null;

        var localTime = time ?? (endOfDay ? new TimeSpan(23, 59, 59) : TimeSpan.Zero);
        var localDateTime = DateTime.SpecifyKind(date.Value.Date.Add(localTime), DateTimeKind.Unspecified);
        return new DateTimeOffset(localDateTime, TimeZoneInfo.Local.GetUtcOffset(localDateTime)).ToUniversalTime();
    }

    private static (DateTime? Date, TimeSpan? Time) SplitLocalDateTime(DateTimeOffset? value)
    {
        if (!value.HasValue)
            return (null, null);

        var local = value.Value.ToLocalTime();
        return (local.Date, local.TimeOfDay);
    }

    private string FormatCreatedFilterSummary()
    {
        if (!createdFrom.HasValue && !createdTo.HasValue)
            return "Filter by created date and time";

        if (createdFrom.HasValue && createdTo.HasValue)
            return $"Created: {FormatCreatedCompact(createdFrom.Value)} - {FormatCreatedCompact(createdTo.Value)}";

        return createdFrom.HasValue
            ? $"Created from {FormatCreatedCompact(createdFrom.Value)}"
            : $"Created to {FormatCreatedCompact(createdTo!.Value)}";
    }

    private static string FormatCreatedCompact(DateTimeOffset value)
        => value.ToLocalTime().ToString("MM/dd HH:mm");

    private bool MatchesTimelineContext(NotificationDto dto)
    {
        if (!string.Equals(dto.Category, CategoryDomainEvent, StringComparison.OrdinalIgnoreCase))
            return false;

        var referenceMatches = !string.IsNullOrWhiteSpace(timelineReference)
                               && string.Equals(dto.Reference, timelineReference, StringComparison.OrdinalIgnoreCase);
        var correlationMatches = !string.IsNullOrWhiteSpace(timelineCorrelationId)
                                 && string.Equals(dto.CorrelationId, timelineCorrelationId, StringComparison.OrdinalIgnoreCase);

        if (!(referenceMatches || correlationMatches))
            return false;

        if (!string.IsNullOrWhiteSpace(timelineTenantId)
            && !string.Equals(dto.TenantId, timelineTenantId, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

