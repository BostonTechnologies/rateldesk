    private Task OnPendingFromDateChanged(DateTime? value)
    {
        pendingFromDate = value?.Date;
        if (!pendingFromDate.HasValue)
            pendingFromTime = null;
        return Task.CompletedTask;
    }

    private Task OnPendingToDateChanged(DateTime? value)
    {
        pendingToDate = value?.Date;
        if (!pendingToDate.HasValue)
            pendingToTime = null;
