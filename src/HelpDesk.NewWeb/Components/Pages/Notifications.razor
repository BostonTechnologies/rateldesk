@page "/notifications"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using HelpDesk.NewWeb.Models
@using HelpDesk.NewWeb.Services
@using Helpdesk.Shared.DTOs.Notification
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Options
@using System.Text.Json
@using System.Web

@inject ISystemNotificationApiClient NotificationClient
@inject NotificationStreamService NotificationStream
@inject NotificationEventBus NotificationEventBus
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IOptions<NotificationPageOptions> NotificationOptions
@inject ISnackbar Snackbar

<PageTitle>Notifications</PageTitle>

@if (showDeepLinkBanner)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-2">
        Opened from alert
    </MudAlert>
}

<MudPaper Class="helpdesk-content-surface pa-3 premium-workspace notifications-workspace" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 notification-heading">
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="helpdesk-page-title">Notifications</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="notification-heading-status">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@summary.UnreadCount unread / @summary.TotalCount total</MudChip>
            <MudChip T="string"
                     Color="@(isStreamConnected ? Color.Default : Color.Warning)"
                     Variant="Variant.Outlined"
                     Size="Size.Small">
                @(isStreamConnected ? "Live" : "Reconnecting")
            </MudChip>
        </MudStack>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-2 notification-metrics">
        <MudChip T="string" Variant="Variant.Outlined">24h on this page: @last24hCount</MudChip>
        <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined">Errors: @last24hErrors</MudChip>
        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">Warnings: @last24hWarnings</MudChip>
    </MudStack>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="3">
            <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Value="@searchTerm" ValueChanged="OnSearchChanged"
                          Label="Search"
                          Placeholder="Reference, correlation, or text"
                          Immediate="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="NotificationSeverity?" Value="selectedSeverity" ValueChanged="OnSeverityChanged" Label="Severity" Clearable="true">
                <MudSelectItem T="NotificationSeverity?" Value="@(null)">All</MudSelectItem>
                @foreach (var severity in Enum.GetValues<NotificationSeverity>())
                {
                    <MudSelectItem T="NotificationSeverity?" Value="@severity">@severity</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" Value="selectedSource" ValueChanged="OnSourceChanged" Label="Source" Clearable="true">
                <MudSelectItem T="string" Value="@(null)">All</MudSelectItem>
                <MudSelectItem T="string" Value="@SourceApplication">Application</MudSelectItem>
                <MudSelectItem T="string" Value="@SourceInfrastructure">Infrastructure</MudSelectItem>
                <MudSelectItem T="string" Value="@SourceApi">API</MudSelectItem>
                <MudSelectItem T="string" Value="@SourceOrchestration">Orchestration</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" Value="selectedCategory" ValueChanged="OnCategoryChanged" Label="Category" Clearable="true">
                <MudSelectItem T="string" Value="@(null)">All</MudSelectItem>
                <MudSelectItem T="string" Value="@CategoryDomainEvent">DomainEvent</MudSelectItem>
                <MudSelectItem T="string" Value="@CategorySystem">System</MudSelectItem>
                <MudSelectItem T="string" Value="@CategoryWorkflow">Workflow</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Outlined"
                       Color="@(HasCreatedFilter ? Color.Primary : Color.Default)"
                       StartIcon="@Icons.Material.Filled.DateRange"
                       OnClick="OpenCreatedPopover"
                       title="@CreatedFilterSummary"
                       Class="notifications-created-button">
                @CreatedFilterLabel
            </MudButton>
            <MudPopover Open="createdPopoverOpen"
                        AnchorOrigin="Origin.BottomCenter"
                        TransformOrigin="Origin.TopCenter"
                        Class="pa-4 notifications-created-popover">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2">Created</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseCreatedPopover" />
                    </MudStack>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="7">
                            <MudDatePicker Label="From date"
                                           Date="pendingFromDate"
                                           DateChanged="OnPendingFromDateChanged"
                                           Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTimePicker Label="From time"
                                           Time="pendingFromTime"
                                           TimeChanged="OnPendingFromTimeChanged"
                                           Clearable="true"
                                           Disabled="@(!pendingFromDate.HasValue)" />
                        </MudItem>
                        <MudItem xs="12" sm="7">
                            <MudDatePicker Label="To date"
                                           Date="pendingToDate"
                                           DateChanged="OnPendingToDateChanged"
                                           Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTimePicker Label="To time"
                                           Time="pendingToTime"
                                           TimeChanged="OnPendingToTimeChanged"
                                           Clearable="true"
                                           Disabled="@(!pendingToDate.HasValue)" />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                        <MudButton Variant="Variant.Text" OnClick="ClearCreatedFilterAsync">Clear</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="CloseCreatedPopover">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyCreatedFilterAsync">Apply</MudButton>
                    </MudStack>
                </MudStack>
            </MudPopover>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear</MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(receiptBusy || selectedIds.Count == 0)"
                       OnClick="BulkMarkReadAsync">
                Mark Selected Read (@selectedIds.Count)
            </MudButton>
        </MudItem>
        @if (NotificationOptions.Value.EnablePurge)
        {
            <MudItem xs="12" sm="6" md="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Disabled="purgeWorking"
                           OnClick="PurgeNotificationsAsync">
                    @(purgeWorking ? "Purging..." : "Purge All")
                </MudButton>
            </MudItem>
        }
    </MudGrid>

    @if (tableError is not null) { <MudAlert Severity="Severity.Error">@tableError <MudButton OnClick="RefreshEventsAsync">Retry</MudButton></MudAlert> }
    @if (newEvents > 0 || streamGap)
    {
        <MudButton Class="mb-2" Variant="Variant.Outlined" OnClick="ShowNewEventsAsync">@(newEvents > 0 ? $"{newEvents} new events · Refresh" : (isStreamConnected ? "Connection restored · Refresh to reconcile events" : "Connection interrupted · Refresh to reconcile events"))</MudButton>
    }
    <MudTable T="NotificationDto"
              @ref="_table"
              ServerData="LoadServerData"
              CurrentPage="currentPage"
              CurrentPageChanged="OnCurrentPageChanged"
              Dense="true" RowsPerPage="25" FixedHeader="true" FixedFooter="true"
              Height="clamp(16rem, calc(100dvh - 27rem), 46rem)"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Class="helpdesk-table"
              RowClassFunc="GetRowClass"
              OnRowClick="OnRowClicked"
              Loading="tableLoading">
        <ColGroup><col style="width:44px" /><col style="width:112px" /><col /><col style="width:120px" /><col style="width:128px" /><col style="width:128px" /><col style="width:104px" /><col style="width:192px" /></ColGroup>
        <HeaderContent>
            <MudTh>
                <div @onclick:stopPropagation="true">
                    <MudCheckBox T="bool"
                                 Value="AreAllSelected" aria-label="Select unread on this page"
                                 ValueChanged="ToggleSelectAll" />
                </div>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="NotificationDto" SortLabel="severity">
                    Severity
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Event</MudTh>
            <MudTh>
                <MudTableSortLabel T="NotificationDto" SortLabel="source">
                    Source
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="NotificationDto" SortLabel="category">
                    Category
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="NotificationDto"
                                   SortLabel="created"
                                   InitialDirection="SortDirection.Descending">
                    Created
                </MudTableSortLabel>
            </MudTh>
            <MudTh>State</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Selection" @attributes="GetCellAttributes(context)">
                <div @onclick:stopPropagation="true">
                    <MudCheckBox T="bool"
                                 Value="@selectedIds.Contains(context.Id)" Disabled="context.IsRead" aria-label="@($"Select {context.Title}")"
                                 ValueChanged="@((bool value) => ToggleSelection(context.Id, value))" />
                </div>
            </MudTd>
            <MudTd DataLabel="Severity">
                <MudTooltip Text="@context.Severity.ToString()"><MudIcon Icon="@GetSeverityIcon(context.Severity)" Color="@GetSeverityColor(context.Severity)" aria-label="@context.Severity.ToString()" /></MudTooltip>
            </MudTd>
            <MudTd DataLabel="Event">
                <MudTooltip Text="@context.Title"><span class="workspace-primary">@WorkspaceLabels.Readable(context.Title)</span></MudTooltip>
                <span class="workspace-secondary">@EventSummary(context)</span>
            </MudTd>
            <MudTd DataLabel="Source"><MudTooltip Text="@context.Source"><span class="workspace-primary">@WorkspaceLabels.Source(context.Source)</span></MudTooltip></MudTd>
            <MudTd DataLabel="Category">@WorkspaceLabels.Readable(context.Category)</MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="State"><span class="@(context.IsRead ? "workspace-secondary" : "notification-unread")">@(context.IsRead ? "Read" : "● Unread")</span></MudTd>
            <MudTd DataLabel="Actions">
                <div class="workspace-actions" @onclick:stopPropagation="true">
                    @if (!context.IsRead)
                    {
                        <WorkspaceAction Label="Mark as read" Icon="@Icons.Material.Filled.MarkEmailRead" Disabled="receiptBusy" OnClick="() => MarkReadAsync(context)" />
                    }
                    @if (!string.IsNullOrWhiteSpace(context.Link))
                    {
                        <WorkspaceAction Label="Open related item" Icon="@Icons.Material.Filled.OpenInNew" OnClick="() => OpenLink(context)" />
                    }
                    <WorkspaceAction Label="Event details" Icon="@Icons.Material.Outlined.Info" OnClick="() => OpenEventDetail(context)" />
                    @if (IsTimelineCandidate(context)) { <WorkspaceAction Label="Correlated timeline" Icon="@Icons.Material.Filled.Timeline" OnClick="() => OpenTimelineAsync(context)" /> }
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@(tableError is null ? "No notifications match these filters." : "Notification list unavailable. Retry the request.")</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@if (drawerOpen)
{
<MudDrawer Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(560px, 100vw)" @bind-Open="drawerOpen">
    <MudStack Class="pa-4" Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@(drawerMode == DrawerMode.Timeline ? "Correlated Timeline" : "Event Detail")</MudText>
            <MudIconButton aria-label="Close notification details" Icon="@Icons.Material.Filled.Close" OnClick="CloseDrawer" />
        </MudStack>

        @if (drawerMode == DrawerMode.Timeline)
        {
            @if (timelineLoading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (!string.IsNullOrWhiteSpace(timelineError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@timelineError</MudAlert>
            }
            else if (timelineEvents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No correlated domain events found.</MudAlert>
            }
            else
            {
                <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Left">
                    @foreach (var item in timelineEvents)
                    {
                        <MudTimelineItem TimelineAlign="TimelineAlign.Start">
                            <ItemDot>
                                <MudIcon Icon="@GetSeverityIcon(item.Notification.Severity)" Color="@GetSeverityColor(item.Notification.Severity)" />
                            </ItemDot>
                            <ItemContent>
                                <MudPaper Class="pa-3 mb-2">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle1">@item.EventType</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @item.Notification.CreatedUtc.ToLocalTime().ToString("g")
                                        </MudText>
                                        <MudText Typo="Typo.body2">Source: @(item.Notification.Source ?? "-")</MudText>
                                        <MudText Typo="Typo.body2">Severity: @item.Notification.Severity</MudText>
                                        <MudText Typo="Typo.body2">Reference: @(item.Notification.Reference ?? "-")</MudText>
                                        @if (!string.IsNullOrWhiteSpace(item.Notification.CorrelationId))
                                        {
                                            <MudText Typo="Typo.body2">Correlation: @item.Notification.CorrelationId</MudText>
                                        }

                                        @if (item.StructuredFields.Count > 0)
                                        {
                                            <MudDivider Class="my-1" />
                                            @foreach (var field in item.StructuredFields)
                                            {
                                                <MudText Typo="Typo.body2"><strong>@field.Key:</strong> @field.Value</MudText>
                                            }
                                        }

                                        <MudExpansionPanels Dense="true">
                                            <MudExpansionPanel Text="Raw JSON">
                                                <MudText Typo="Typo.caption" Class="pa-2" Style="white-space: pre-wrap; word-break: break-word;">@item.RawJson</MudText>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    </MudStack>
                                </MudPaper>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
        }
        else if (drawerMode == DrawerMode.EventDetail && eventDetail is not null)
        {
            <MudPaper Class="pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@eventDetail.EventType</MudText>
                    <MudButton Size="Size.Small" OnClick="CopyDiagnosticsAsync">Copy diagnostics</MudButton>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@eventDetail.Notification.CreatedUtc.ToLocalTime().ToString("g")</MudText>
                    <MudText Typo="Typo.body2">Severity: @eventDetail.Notification.Severity</MudText>
                    <MudText Typo="Typo.body2">Source: @(eventDetail.Notification.Source ?? "-")</MudText>
                    <MudText Typo="Typo.body2">Category: @(eventDetail.Notification.Category ?? "-")</MudText>
                    @if (!string.IsNullOrWhiteSpace(eventDetail.Notification.TenantId))
                    {
                        <MudText Typo="Typo.body2">Tenant: @eventDetail.Notification.TenantId</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(eventDetail.Notification.Reference))
                    {
                        <MudText Typo="Typo.body2">Reference: @eventDetail.Notification.Reference</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(eventDetail.Notification.CorrelationId))
                    {
                        <MudText Typo="Typo.body2">Correlation: @eventDetail.Notification.CorrelationId</MudText>
                    }

                    @if (eventDetail.StructuredFields.Count > 0)
                    {
                        <MudDivider Class="my-1" />
                        @foreach (var field in eventDetail.StructuredFields)
                        {
                            <MudText Typo="Typo.body2"><strong>@field.Key:</strong> @field.Value</MudText>
                        }
                    }

                    <MudExpansionPanels Dense="true">
                        <MudExpansionPanel Text="Raw JSON">
                            <MudText Typo="Typo.caption" Class="pa-2" Style="white-space: pre-wrap; word-break: break-word;">@eventDetail.RawJson</MudText>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudDrawer>
}

<style>
    .notifications-workspace .mud-table-root {
        table-layout: fixed;
    }

    .notifications-workspace .mud-table td {
        word-break: break-word;
    }

    .notifications-workspace .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .notifications-workspace .notification-row-clickable {
        cursor: pointer;
    }

    .notifications-created-button {
        min-width: 100%;
        white-space: nowrap;
    }

    .notifications-created-popover {
        width: min(420px, calc(100vw - 32px));
    }

    .notifications-workspace .notification-row-live {
        animation: notification-live-fade 2.5s ease-out;
        background-color: rgba(33, 150, 243, 0.12);
    }

    @@keyframes notification-live-fade {
        0% {
            background-color: rgba(33, 150, 243, 0.26);
        }

        100% {
            background-color: transparent;
        }
    }
</style>

@code {
    private enum DrawerMode
    {
        None,
        Timeline,
        EventDetail
    }

    private MudTable<NotificationDto>? _table;
    private readonly List<NotificationDto> notifications = new();
    private readonly List<TimelineEventView> timelineEvents = new();
    private NotificationSummaryDto summary = new();
    private string? searchTerm;
    private NotificationSeverity? selectedSeverity;
    private string? selectedSource;
    private string? selectedCategory;
    private DateTimeOffset? createdFrom;
    private DateTimeOffset? createdTo;
    private DateTime? pendingFromDate;
    private DateTime? pendingToDate;
    private TimeSpan? pendingFromTime;
    private TimeSpan? pendingToTime;
    private bool createdPopoverOpen;
    private const int DefaultPageSize = 25;
    private int newEvents;
    private bool streamGap, receiptBusy, disposed;
    private string? tableError;
    private readonly HashSet<Guid> seenArrivals = [];
    private readonly Queue<Guid> arrivalOrder = [];
    private const string SourceApplication = "Application";
    private const string SourceInfrastructure = "Infrastructure";
    private const string SourceApi = "API";
    private const string SourceOrchestration = "Orchestration";
    private const string CategoryDomainEvent = "DomainEvent";
    private const string CategorySystem = "System";
    private const string CategoryWorkflow = "Workflow";
    private bool drawerOpen;
    private DrawerMode drawerMode;
    private bool timelineLoading;
    private bool tableLoading;
    private string? timelineError;
    private bool streamStarted;
    private bool isStreamConnected;
    private int last24hCount;
    private int last24hErrors;
    private int last24hWarnings;
    private int activePageSize = DefaultPageSize;
    private int currentPage;
    private CancellationTokenSource? debounceCts;
    private TimelineEventView? eventDetail;
    private readonly HashSet<Guid> highlightedNotificationIds = new();
    private string? timelineReference;
    private string? timelineCorrelationId;
    private string? timelineTenantId;
    private bool showDeepLinkBanner;
    private bool purgeWorking;
    private readonly HashSet<Guid> selectedIds = new();
    private string? lastAppliedQuerySignature;
    private bool HasCreatedFilter => createdFrom.HasValue || createdTo.HasValue;
    private string CreatedFilterLabel => HasCreatedFilter ? "Created *" : "Created";
    private string CreatedFilterSummary => FormatCreatedFilterSummary();
    [SupplyParameterFromQuery(Name = "event")]
    public Guid? EventId { get; set; }
    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "source")]
    public string? QuerySource { get; set; }
    private Guid? pendingDeepLinkId;
    private bool deepLinkHandled;
    private bool AreAllSelected => notifications.Count > 0
                                   && notifications.All(n => selectedIds.Contains(n.Id));

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        NotificationStream.ConnectionChanged += OnStreamConnectionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        searchTerm = NormalizeQueryValue(searchTerm);
        selectedSource = NormalizeQueryValue(selectedSource);
        selectedCategory = NormalizeQueryValue(selectedCategory);
        try { await RefreshSummaryAsync(); }
        catch (HttpRequestException) { tableError = "Notification counts unavailable. Refresh to reconcile."; }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location);
        var query = HttpUtility.ParseQueryString(uri.Query);

        if (Guid.TryParse(query["event"], out var id))
        {
            pendingDeepLinkId = id;
            deepLinkHandled = false;

            if (_table is not null)
                await InvokeAsync(() => _table.ReloadServerData());
        }
    }

    protected override void OnParametersSet()
    {
        if (EventId.HasValue)
        {
            pendingDeepLinkId = EventId.Value;
            deepLinkHandled = false;
        }

        var normalizedSearch = NormalizeQueryValue(QuerySearch);
        var normalizedSource = NormalizeQueryValue(QuerySource);
        var querySignature = $"{normalizedSearch}|{normalizedSource}";
        if (string.Equals(lastAppliedQuerySignature, querySignature, StringComparison.Ordinal))
        {
            return;
        }

        lastAppliedQuerySignature = querySignature;
        searchTerm = normalizedSearch;
        selectedSource = normalizedSource;

        if (_table is not null)
        {
            _ = InvokeAsync(ReloadTableAsync);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !streamStarted)
        {
            streamStarted = true;
            try
            {
                await NotificationStream.StartAsync(
                    async notification =>
                    {
                        await InvokeAsync(async () =>
                        {
                            InsertNotification(notification);
                            try { await RefreshSummaryAsync(); }
                            catch (HttpRequestException) { tableError = "Notification counts unavailable. Refresh to reconcile."; }
                            StateHasChanged();
                        });
                    },
                    tenantId: null,
                    category: null);

                isStreamConnected = NotificationStream.IsConnected;
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                isStreamConnected = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task<TableData<NotificationDto>> LoadServerData(TableState state, CancellationToken token)
    {
        tableLoading = true; tableError = null;
        var safePageIndex = Math.Max(state.Page, 0);
        currentPage = safePageIndex;
        var page = safePageIndex + 1;
        var pageSize = state.PageSize <= 0 ? DefaultPageSize : state.PageSize;
        var sortBy = state.SortLabel;
        var sortDir = state.SortDirection == SortDirection.Ascending ? "asc" : "desc";
        activePageSize = pageSize;

        try
        {
            var summaryTask = NotificationClient.GetSummaryAsync();
            var dataTask = NotificationClient.GetPagedNotificationsAsync(
                page,
                pageSize,
                searchTerm,
                selectedSeverity,
                selectedSource,
                selectedCategory,
                createdFrom,
                createdTo,
                sortBy,
                sortDir,
                token);

            await Task.WhenAll(summaryTask, dataTask);

            summary = await summaryTask;
            var result = await dataTask;

            notifications.Clear();
            notifications.AddRange(result.Items);
            selectedIds.RemoveWhere(id => notifications.All(n => n.Id != id));

            if (pendingDeepLinkId.HasValue && !deepLinkHandled)
                await HandleDeepLinkAsync(pendingDeepLinkId.Value);

            Recalculate24hSummary();

            return new TableData<NotificationDto>
            {
                Items = notifications,
                TotalItems = result.TotalCount
            };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
        catch (Exception)
        {
            tableError = "Could not load notifications. Retry the request.";
            return new() { Items = notifications.ToArray(), TotalItems = summary.TotalCount };
        }
        finally
        {
            tableLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkReadAsync(NotificationDto item)
    {
        if (item.IsRead || receiptBusy) return;
        receiptBusy = true;
        try
        {
            await NotificationClient.MarkReadAsync(item.Id);
            item.IsRead = true;
            selectedIds.Remove(item.Id);
            await RefreshSummaryAsync();
            await NotificationEventBus.NotifyReadAsync(1);
        }
        catch (HttpRequestException) { Snackbar.Add("Read receipt could not be confirmed. Refresh to reconcile; selection is retained.", Severity.Error); }
        finally { receiptBusy = false; }
    }

    private async Task OnSeverityChanged(NotificationSeverity? value)
    {
        selectedSeverity = value;
        await ReloadTableAsync();
    }

    private async Task OnSourceChanged(string? value)
    {
        selectedSource = string.IsNullOrWhiteSpace(value) ? null : value;
        await ReloadTableAsync();
    }

    private async Task OnCategoryChanged(string? value)
    {
        selectedCategory = string.IsNullOrWhiteSpace(value) ? null : value;
        await ReloadTableAsync();
    }

    private async Task ClearFilters()
    {
        searchTerm = null;
        selectedSeverity = null;
        selectedSource = null;
        selectedCategory = null;
        createdFrom = null;
        createdTo = null;
        pendingFromDate = null;
        pendingToDate = null;
        pendingFromTime = null;
        pendingToTime = null;
        createdPopoverOpen = false;
        await ReloadTableAsync();
    }

    private async Task ReloadTableAsync()
    {
        if (_table is null)
            return;

        selectedIds.Clear();
        currentPage = 0;
        _table.NavigateTo(0);
        await _table.ReloadServerData();
    }

    private Task OnCurrentPageChanged(int page)
    {
        currentPage = Math.Max(page, 0);
        return Task.CompletedTask;
    }

    private async Task OnSearchChanged(string? value)
    {
        searchTerm = value;
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, debounceCts.Token);
            await ReloadTableAsync();
        }
        catch (TaskCanceledException)
        {
            // ignore debounce cancellation
        }
    }

    private async Task RefreshSummaryAsync()
    {
        summary = await NotificationClient.GetSummaryAsync();
    }

    private async Task PurgeNotificationsAsync()
    {
        if (purgeWorking)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Purge all notifications in this development environment?");
        if (!confirmed)
            return;

        purgeWorking = true;
        try
        {
            var deleted = await NotificationClient.PurgeAllAsync();
            notifications.Clear();
            selectedIds.Clear();
            timelineEvents.Clear();
            eventDetail = null;
            drawerOpen = false;
            summary = new NotificationSummaryDto();
            Recalculate24hSummary();
            Snackbar.Add($"Purged {deleted} notification rows.", Severity.Success);
            await ReloadTableAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Notification purge failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            purgeWorking = false;
        }
    }

    private static string? NormalizeQueryValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void OpenLink(NotificationDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Link))
            Navigation.NavigateTo(item.Link);
    }

    private async Task OnRowClicked(TableRowClickEventArgs<NotificationDto> args)
    {
        if (args.Item is null)
            return;

        if (IsTimelineCandidate(args.Item))
        {
            await OpenTimelineAsync(args.Item);
            return;
        }

        OpenEventDetail(args.Item);
    }

    private bool IsTimelineCandidate(NotificationDto item)
    {
        return string.Equals(item.Category, CategoryDomainEvent, StringComparison.OrdinalIgnoreCase)
               && (!string.IsNullOrWhiteSpace(item.Reference) || !string.IsNullOrWhiteSpace(item.CorrelationId));
    }

    private async Task OpenTimelineAsync(NotificationDto item)
    {
        drawerOpen = true;
        drawerMode = DrawerMode.Timeline;
        timelineLoading = true;
        timelineError = null;
        eventDetail = null;
        timelineEvents.Clear();
        timelineReference = item.Reference;
        timelineCorrelationId = item.CorrelationId;
        timelineTenantId = item.TenantId;

        try
        {
            var timeline = await NotificationClient.GetTimelineAsync(
                reference: item.Reference,
                correlationId: item.CorrelationId,
                tenantId: item.TenantId,
                take: 500);

            timelineEvents.AddRange(timeline.Select(MapTimelineItem));
        }
        catch (Exception ex)
        {
            timelineError = ex.Message;
        }
        finally
        {
            timelineLoading = false;
        }
    }

    private void OpenEventDetail(NotificationDto item)
    {
        drawerOpen = true;
        drawerMode = DrawerMode.EventDetail;
        timelineError = null;
        timelineLoading = false;
        timelineEvents.Clear();
        eventDetail = MapTimelineItem(item);
    }

    private void CloseDrawer()
    {
        drawerOpen = false;
        drawerMode = DrawerMode.None;
    }

    private void InsertNotification(NotificationDto dto)
    {
        if (notifications.Any(x => x.Id == dto.Id) || !seenArrivals.Add(dto.Id)) return;
        arrivalOrder.Enqueue(dto.Id);
        if (arrivalOrder.Count > 2048) seenArrivals.Remove(arrivalOrder.Dequeue());
        // Hold the operator's rows, selection, sorting and scroll position until an explicit refresh.
        if (MatchesCurrentFilters(dto)) newEvents++;
        if (drawerOpen && drawerMode == DrawerMode.Timeline && MatchesTimelineContext(dto) &&
            timelineEvents.All(x => x.Notification.Id != dto.Id)) timelineEvents.Add(MapTimelineItem(dto));
    }

    private void OnStreamConnectionChanged(bool connected) => _ = InvokeAsync(() =>
    {
        if (disposed) return;
        if (isStreamConnected && !connected) streamGap = true;
        isStreamConnected = connected;
        StateHasChanged();
    });

    private async Task RefreshEventsAsync()
    {
        if (_table is not null) await _table.ReloadServerData();
        if (tableError is null) { newEvents = 0; streamGap = false; }
    }

    private async Task ShowNewEventsAsync()
    {
        await ReloadTableAsync();
        if (tableError is null) { newEvents = 0; streamGap = false; }
    }

    private static string EventSummary(NotificationDto item)
    {
        try
        {
            using var document = JsonDocument.Parse(item.Message);
            if (document.RootElement.ValueKind == JsonValueKind.Object &&
                document.RootElement.TryGetProperty("summary", out var summary) && summary.ValueKind == JsonValueKind.String)
                return summary.GetString() ?? "";
        }
        catch (JsonException) { return item.Message; }
        return "Details available";
    }

    private async Task CopyDiagnosticsAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", JsonSerializer.Serialize(eventDetail?.Notification)); }
        catch (JSException) { Snackbar.Add("Select and copy the diagnostics; clipboard access is unavailable.", Severity.Info); }
    }

    private bool MatchesCurrentFilters(NotificationDto dto)
    {
        if (selectedSeverity.HasValue && dto.Severity != selectedSeverity.Value)
            return false;

        if (!string.IsNullOrWhiteSpace(selectedSource)
            && !string.Equals(dto.Source, selectedSource, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(selectedCategory)
            && !string.Equals(dto.Category, selectedCategory, StringComparison.OrdinalIgnoreCase))
            return false;

        if (createdFrom.HasValue && dto.CreatedUtc < createdFrom.Value.UtcDateTime)
            return false;

        if (createdTo.HasValue && dto.CreatedUtc > createdTo.Value.UtcDateTime)
            return false;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            var matches = (dto.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (dto.Message?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (dto.Reference?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (dto.CorrelationId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
            if (!matches)
                return false;
        }

        return true;
    }

    private void OpenCreatedPopover()
    {
        SetPendingCreatedFromApplied();
        createdPopoverOpen = true;
    }

