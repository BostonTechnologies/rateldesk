    private void ToggleSelectAll(bool value)
    {
        selectedIds.Clear();

        if (!value)
            return;

        foreach (var notification in notifications.Where(n => !n.IsRead))
            selectedIds.Add(notification.Id);
    }

    private void Recalculate24hSummary()
    {
        var cutoff = DateTime.UtcNow.AddHours(-24);
        var recent = notifications.Where(n => n.CreatedUtc >= cutoff).ToList();
        last24hCount = recent.Count;
        last24hErrors = recent.Count(n => n.Severity is NotificationSeverity.Error or NotificationSeverity.Critical);
        last24hWarnings = recent.Count(n => n.Severity == NotificationSeverity.Warning);
    }

    private async Task HandleDeepLinkAsync(Guid id)
    {
        deepLinkHandled = true;
        pendingDeepLinkId = null;

        var match = notifications.FirstOrDefault(n => n.Id == id);

        if (match == null)
        {
            var single = await NotificationClient.GetByIdAsync(id);
            if (single != null)
            {
                notifications.Insert(0, single);
                match = single;
            }
        }

        if (match == null)
            return;

        highlightedNotificationIds.Add(match.Id);
        showDeepLinkBanner = true;

        if (!match.IsRead) await MarkReadAsync(match);

        if (IsTimelineCandidate(match))
            await OpenTimelineAsync(match);
        else
            OpenEventDetail(match);

        await JS.InvokeVoidAsync("scrollToNotificationRow", id.ToString());

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                showDeepLinkBanner = false;
                StateHasChanged();
            });
        });

        Navigation.NavigateTo("/notifications", replace: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task BulkMarkReadAsync()
    {
        if (receiptBusy || selectedIds.Count == 0) return;
        receiptBusy = true;
        var ids = selectedIds.ToList();
        try
        {
            var updated = await NotificationClient.MarkReadBulkAsync(ids);
            // The endpoint reports an aggregate. Re-read actor-specific receipts rather than
            // claiming every submitted ID succeeded when only part of the selection changed.
            await RefreshEventsAsync();
            if (tableError is null)
            {
                selectedIds.ExceptWith(notifications.Where(x => x.IsRead).Select(x => x.Id));
                if (selectedIds.Count > 0) Snackbar.Add("Some receipts remain unread. Review the retained selection before retrying.", Severity.Warning);
            }
            await NotificationEventBus.NotifyReadAsync(updated);
        }
        catch (HttpRequestException) { Snackbar.Add("Read receipts could not be confirmed. Selection is retained; refresh to reconcile.", Severity.Error); }
        finally { receiptBusy = false; }
    }

    private static TimelineEventView MapTimelineItem(NotificationDto notification)
    {
        var rawJson = notification.Message;
        var structuredFields = new List<KeyValuePair<string, string>>();
        var eventType = notification.Title;

        if (!string.IsNullOrWhiteSpace(rawJson))
        {
            try
            {
                using var doc = JsonDocument.Parse(rawJson);
                if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    if (doc.RootElement.TryGetProperty("eventType", out var eventTypeProp)
                        && eventTypeProp.ValueKind == JsonValueKind.String)
                    {
                        eventType = eventTypeProp.GetString() ?? eventType;
                    }

                    foreach (var property in doc.RootElement.EnumerateObject())
                    {
                        if (property.NameEquals("eventType") || property.NameEquals("occurredUtc"))
                            continue;

                        var value = property.Value.ValueKind switch
                        {
                            JsonValueKind.String => property.Value.GetString(),
                            JsonValueKind.Number => property.Value.GetRawText(),
                            JsonValueKind.True => "true",
                            JsonValueKind.False => "false",
                            JsonValueKind.Null => null,
                            _ => property.Value.GetRawText()
                        };

                        if (!string.IsNullOrWhiteSpace(value))
                            structuredFields.Add(new KeyValuePair<string, string>(property.Name, value!));
                    }
                }
            }
            catch
            {
                // Keep raw JSON visible even if payload parsing fails.
            }
        }

        return new TimelineEventView(notification, eventType, rawJson, structuredFields);
    }

    private static string GetSeverityIcon(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Warning => Icons.Material.Filled.Warning,
        NotificationSeverity.Error => Icons.Material.Filled.Error,
        NotificationSeverity.Critical => Icons.Material.Filled.Dangerous,
        NotificationSeverity.Success => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.Info
    };

    private static Color GetSeverityColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Warning => Color.Warning,
        NotificationSeverity.Error => Color.Error,
        NotificationSeverity.Critical => Color.Error,
        NotificationSeverity.Success => Color.Success,
        _ => Color.Info
    };

    private sealed record TimelineEventView(
        NotificationDto Notification,
        string EventType,
        string RawJson,
        List<KeyValuePair<string, string>> StructuredFields);

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        NotificationStream.ConnectionChanged -= OnStreamConnectionChanged;
        try
        {
            await NotificationStream.StopAsync();
        }
        catch
        {
            // ignore teardown exceptions
        }
        finally
        {
            Navigation.LocationChanged -= OnLocationChanged;
            isStreamConnected = false;
            debounceCts?.Cancel();
            debounceCts?.Dispose();
        }
    }
