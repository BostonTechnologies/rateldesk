@using Helpdesk.Shared.DTOs.Organization
@using Helpdesk.Shared.DTOs.Service
@using Helpdesk.Shared.DTOs.RequestForm
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<WorkspaceEditGuard Dirty="@(!selectedOrgIds.SetEquals(Item.AllowedOrganizationIds ?? []))" Message="Discard unsaved audience changes and leave?" />
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Manage access – @Item.Name</MudText>
    </TitleContent>

    <DialogContent>
        <div class="organization-access-review">
        @if (selectedOrgIds.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mb-2">Not visible in self service. Assign at least one organization.</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">@selectedOrgIds.Count assigned organizations</MudText>
            <div class="organization-access-selected" role="region" aria-label="Assigned organizations" tabindex="0">
            <MudChipSet T="string"
                        AllClosable="true"
                        Filter="false"
                        Class="mb-4">
                @foreach (var orgId in selectedOrgIds.OrderBy(GetOrganizationName))
                {
                    <MudChip T="string"
                             Value="@orgId"
                             Color="Color.Primary"
                             Variant="Variant.Outlined"
                             OnClose="@(() => RemoveOrganization(orgId))">
                        @GetOrganizationName(orgId)
                    </MudChip>
                }
            </MudChipSet>
            </div>
        }

        @if (Item.ParentOrganizationIds is { } parentAudience && selectedOrgIds.Any(id => !parentAudience.Contains(id)))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">A parent folder blocks some assigned organizations. Each parent folder must assign the organization.</MudAlert>
        }

        <OrganizationSearchPicker SearchUrl="api/v1/admin/directories/organizations/search?assignable=true" Label="Add permitted organization"
                                  Required="false" Disabled="@saving" AutoSelectSingle="false" ClearAfterSelection="true" ValueChanged="AddOrganization" />
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@saving" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ServiceItemDto Item { get; set; } = default!;
    [Parameter] public List<OrganizationDto> Organizations { get; set; } = new();

    private HttpClient Api => HttpClientFactory.CreateClient("HelpdeskApi");

    private HashSet<string> selectedOrgIds = new(StringComparer.OrdinalIgnoreCase);
    private bool saving;
    protected override void OnInitialized()
    {
        selectedOrgIds = new HashSet<string>(Item.AllowedOrganizationIds ?? new(), StringComparer.OrdinalIgnoreCase);
    }

    private void RemoveOrganization(string organizationId)
    {
        selectedOrgIds.Remove(organizationId);
    }

    private string GetOrganizationName(string organizationId) =>
        Organizations.FirstOrDefault(org => string.Equals(org.Id, organizationId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? organizationId;

    private void AddOrganization(string? organizationId)
    {
        if (!string.IsNullOrWhiteSpace(organizationId)) selectedOrgIds.Add(organizationId);
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            var audience = selectedOrgIds.ToList();
            using var resp = Item.ItemType == ServiceItemType.Service
                ? await Api.PutAsJsonAsync($"api/v1/services/{Item.Id}", new UpdateServiceDto { AllowedOrganizationIds = audience })
                : await Api.PutAsJsonAsync($"api/v1/request-forms/{Item.Id}", new UpdateRequestFormDto { AllowedOrganizationIds = audience });

            if (resp.IsSuccessStatusCode) MudDialog.Close(DialogResult.Ok(true));
            else Snackbar.Add($"Save failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { saving = false; }
    }

    private void Cancel() { if (!saving) MudDialog.Cancel(); }
}
