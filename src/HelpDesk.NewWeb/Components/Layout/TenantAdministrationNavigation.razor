<AuthorizeView Roles="HelpdeskAdmin" Context="instanceAdmin">
    <NotAuthorized>
        <AuthorizeView Roles="Tenant.Users.Manage,Tenant.Roles.Assign,Tenant.Settings.Manage" Context="delegatedAdmin">
            <div class="nav-section-heading"><span>Administration</span></div>
            <HelpdeskNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" RoutePrefixes="@AdministrationRoutes">
                <HelpdeskNavLink Href="@(delegatedAdmin.User.IsInRole("Tenant.Users.Manage") || delegatedAdmin.User.IsInRole("Tenant.Roles.Assign") ? "/admin/users" : "/admin/organizations")" Aliases="@PermittedAliases(delegatedAdmin.User)" Icon="@Icons.Material.Filled.AccountTree" Title="People &amp; Organizations">People &amp; Organizations</HelpdeskNavLink>
                <AuthorizeView Roles="Tenant.Roles.Assign" Context="roleAdministrator">
                    <HelpdeskNavLink Href="/admin/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security" Title="Roles &amp; Permissions">Roles &amp; Permissions</HelpdeskNavLink>
                </AuthorizeView>
            </HelpdeskNavGroup>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string[] PermittedAliases(System.Security.Claims.ClaimsPrincipal user)
    {
        var settings = user.IsInRole("Tenant.Settings.Manage");
        if (user.IsInRole("Tenant.Roles.Assign")) return settings ? [.. AccountRoutes, "admin/support-routing"] : AccountRoutes;
        if (!user.IsInRole("Tenant.Users.Manage"))
            return settings ? ["admin/organizations", "tenant-settings", "admin/support-routing"] : ["admin/organizations", "tenant-settings"];
        return settings ? [.. AccountRoutes, "admin/support-routing"] : ["admin/users", "tenant-administration"];
    }

    private static readonly string[] OrganizationAliases = ["tenant-administration", "tenant-settings"];
    private static readonly string[] AccountRoutes = ["admin/users", "admin/organizations", .. OrganizationAliases];
    private static readonly string[] AdministrationRoutes = [.. AccountRoutes, "admin/roles", "admin/support-routing"];
}
