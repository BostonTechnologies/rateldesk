@implements IDisposable
@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink Href="home" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    <AuthorizeView Roles="SelfService.User,HelpdeskAdmin">
        <MudNavGroup Title="Portal" Icon="@Icons.Material.Filled.Apps" Expanded="false">
            <MudNavLink Href="self-service" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storefront">Self Service</MudNavLink>
            <MudNavLink Href="self-service/my-requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">My Requests</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Incident.User,Incident.Read,Incident.Write,Incident.Manager,Request.User,Request.Read,Request.Write,Request.Execute,Request.Manager,Change.User,Change.Read,Change.Write,Change.Manager,DataManagement.Admin,HelpdeskAdmin">
        @*
        <MudNavLink Href="/technician/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Technician Dashboard</MudNavLink>
        *@
        
        <MudNavGroup Title="Workspace" Icon="@Icons.Material.Filled.Workspaces" Expanded="false">
            <AuthorizeView Roles="Incident.User,Incident.Read,Incident.Write,Incident.Manager,HelpdeskAdmin" Context="incidentAuth">
                <MudNavLink Href="incidents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ListAlt">Incidents</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Request.User,Request.Read,Request.Write,Request.Execute,Request.Manager,HelpdeskAdmin" Context="requestAuth">
                <MudNavLink Href="requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">Requests</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Request.Read,Request.Write,Request.Execute,Request.Manager,HelpdeskAdmin" Context="tasksAuth">
                <MudNavLink Href="tasks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TaskAlt">Tasks</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Change.User,Change.Read,Change.Write,Change.Manager,HelpdeskAdmin" Context="changeAuth">
                <MudNavLink Href="changes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ChangeCircle">Changes</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>

        <AuthorizeView Roles="Incident.Write,Incident.Manager,Request.Read,Request.Write,Request.Execute,Request.Manager,Change.Write,Change.Manager,HelpdeskAdmin" Context="opsGate">
        <MudNavGroup Title="Operations" Icon="@Icons.Material.Filled.SettingsSuggest" Expanded="false">
            <AuthorizeView Roles="Incident.Write,Incident.Manager,Request.Write,Request.Manager,Change.Write,Change.Manager,HelpdeskAdmin" Context="slaOpsAuth">
                <MudNavLink Href="/ops/slas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Schedule">SLA Ops</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Request.Read,Request.Write,Request.Execute,Request.Manager,HelpdeskAdmin" Context="workflowOpsAuth">
