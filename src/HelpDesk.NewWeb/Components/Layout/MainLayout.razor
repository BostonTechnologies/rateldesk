@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration

<PageTitle>@_branding.ApplicationName</PageTitle>
<HeadContent><link rel="icon" href="@_branding.FaviconUrl" /></HeadContent>

<ThemePreferenceProvider Context="themePreference">
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Class="helpdesk-app-bar">
        <div class="helpdesk-appbar-left">
            <AuthorizeView>
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="ToggleDrawer"
                               aria-label="Toggle navigation"
                               data-testid="navigation-toggle" Disabled="@(!interactive)" />
            </AuthorizeView>
            <MudText Typo="Typo.h6" Class="helpdesk-appbar-title">@_branding.ApplicationName</MudText>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="helpdesk-appbar-search-wrap">
                    <button type="button" class="helpdesk-appbar-search" @onclick="OpenSearch" disabled="@(!interactive)">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                        <span>Search</span>
                        <kbd>Shift + S</kbd>
                    </button>
                </div>
                <div class="helpdesk-appbar-actions">
                    <MudChip T="string"
                             Class="helpdesk-appbar-chip helpdesk-appbar-api-chip"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="Color.Default"
                             Href="/api/docs/">
                        API
                    </MudChip>
                    <AppBarVersionChip Version="_appBarVersion" />
                    <MudIcon Icon="@Icons.Material.Filled.LockPerson" Color="Color.Success" />
                    <NotificationBell />
                    <MudTooltip Text="@themePreference.Label">
                        <MudMenu Icon="@themePreference.Icon" Color="Color.Inherit" aria-label="Choose colour theme" data-testid="theme-preference-menu">
                            <MudMenuItem Icon="@Icons.Material.Rounded.AutoMode" data-testid="theme-option-system" OnClick="@(() => themePreference.SetModeAsync(ThemePreferenceMode.System))">
                                System@(themePreference.Mode is ThemePreferenceMode.System ? " (current)" : string.Empty)
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.LightMode" data-testid="theme-option-light" OnClick="@(() => themePreference.SetModeAsync(ThemePreferenceMode.Light))">
                                Light@(themePreference.Mode is ThemePreferenceMode.Light ? " (current)" : string.Empty)
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.DarkMode" data-testid="theme-option-dark" OnClick="@(() => themePreference.SetModeAsync(ThemePreferenceMode.Dark))">
                                Dark@(themePreference.Mode is ThemePreferenceMode.Dark ? " (current)" : string.Empty)
                            </MudMenuItem>
                        </MudMenu>
                    </MudTooltip>
                    <MudMenu Icon="@Icons.Material.Filled.Settings">
                        <MudMenuItem>Profile</MudMenuItem>
                        <MudMenuItem>Preferences</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Href="/account/integration-credentials">Integration credentials</MudMenuItem>
                        @if (SupportsLocalAccounts)
                        {
                            <MudMenuItem Href="/account/change-password">Change passphrase</MudMenuItem>
                            <MudMenuItem Href="/account/authenticator">Authenticator app</MudMenuItem>
                        }
                        <MudMenuItem Href="/logout">Logout</MudMenuItem>
                    </MudMenu>
                </div>
                <div class="helpdesk-appbar-mobile-actions">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             Color="Color.Inherit"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Class="helpdesk-appbar-mobile-menu">
                        <MudMenuItem Href="/api/docs/" Icon="@Icons.Material.Filled.Api">API Docs</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.NewReleases">
                            @_appBarVersion.DisplayVersion
                        </MudMenuItem>
                        <MudMenuItem Href="/notifications" Icon="@Icons.Material.Filled.Notifications">Notifications</MudMenuItem>
                        <MudMenuItem Icon="@themePreference.Icon" Disabled="true">Theme: @themePreference.Label</MudMenuItem>
                        <MudMenuItem OnClick="@(() => themePreference.SetModeAsync(ThemePreferenceMode.System))" Icon="@Icons.Material.Rounded.AutoMode">System</MudMenuItem>
                        <MudMenuItem OnClick="@(() => themePreference.SetModeAsync(ThemePreferenceMode.Light))" Icon="@Icons.Material.Outlined.LightMode">Light</MudMenuItem>
                        <MudMenuItem OnClick="@(() => themePreference.SetModeAsync(ThemePreferenceMode.Dark))" Icon="@Icons.Material.Outlined.DarkMode">Dark</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Person">Profile</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Tune">Preferences</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Href="/account/integration-credentials" Icon="@Icons.Material.Filled.Key">Integration credentials</MudMenuItem>
                        @if (SupportsLocalAccounts)
                        {
                            <MudMenuItem Href="/account/change-password" Icon="@Icons.Material.Filled.Password">Change passphrase</MudMenuItem>
                            <MudMenuItem Href="/account/authenticator" Icon="@Icons.Material.Filled.Security">Authenticator app</MudMenuItem>
                        }
                        <MudMenuItem Href="/logout" Icon="@Icons.Material.Filled.Logout">Logout</MudMenuItem>
                    </MudMenu>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <AuthorizeView>
        <MudDrawer id="nav-drawer"
                   @bind-Open="_drawerOpen"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Lg"
                   Overlay="true"
                   OverlayAutoClose="true"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Class="helpdesk-nav-drawer"
                   data-testid="app-navigation-drawer">
            <NavMenu />
        </MudDrawer>
    </AuthorizeView>

    <MudMainContent Class="helpdesk-main-content pa-4" data-testid="app-main-content" data-interactive="@interactive.ToString().ToLowerInvariant()">
        @Body
    </MudMainContent>
    <GlobalSearchOverlay Open="searchOpen" OpenChanged="OnSearchOpenChanged" />
</MudLayout>
</ThemePreferenceProvider>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<AuthorizeView><Authorized><SessionAccessMonitor /></Authorized></AuthorizeView>

@code {
    private bool SupportsLocalAccounts =>
        string.Equals(Configuration["Authentication:Mode"], "Local", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Configuration["Authentication:Mode"], "Hybrid", StringComparison.OrdinalIgnoreCase);

    private bool _drawerOpen = true;
    private bool searchOpen;
    private bool interactive;
    private Helpdesk.Shared.Build.BuildInfo _appBarVersion = new("dev", "unknown", "unknown", "HelpDesk.NewWeb", "unknown");
    private DotNetObjectReference<MainLayout>? dotNetRef;
    private int? hotkeyRegistrationId;
    private BrandingSnapshot _branding = new();

    protected override void OnInitialized()
    {
        _appBarVersion = AppBarVersionResolver.ResolveDetails(typeof(MainLayout).Assembly, HostEnvironment.EnvironmentName);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branding = await HttpClientFactory.CreateClient("HelpdeskApi")
                .GetFromJsonAsync<BrandingSnapshot>("api/v1/branding") ?? _branding;
        }
        catch (HttpRequestException exception)
        {
            System.Diagnostics.Debug.WriteLine($"Branding endpoint unavailable while rendering the application shell: {exception.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);
        hotkeyRegistrationId = await JS.InvokeAsync<int>("helpdeskGlobalSearchHotkeys.register", dotNetRef);
        interactive = true;
        StateHasChanged();
    }

    private void OpenSearch()
    {
        searchOpen = true;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    [JSInvokable]
    public Task OpenGlobalSearchFromShortcut()
    {
        searchOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnSearchOpenChanged(bool value)
    {
        searchOpen = value;
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (hotkeyRegistrationId.HasValue)
        {
            try
            {
                await JS.InvokeVoidAsync("helpdeskGlobalSearchHotkeys.dispose", hotkeyRegistrationId.Value);
            }
            catch (JSDisconnectedException exception)
            {
                System.Diagnostics.Debug.WriteLine($"Global-search hotkey cleanup was interrupted by circuit disposal: {exception.Message}");
            }
        }

        dotNetRef?.Dispose();
    }
    private sealed class BrandingSnapshot
    {
        public string ApplicationName { get; set; } = "RatelDesk";
        public string FaviconUrl { get; set; } = "/favicon.ico";
    }
}
