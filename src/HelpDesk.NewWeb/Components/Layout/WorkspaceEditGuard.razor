@inject IJSRuntime JS

@if (Dirty || Saving)
{
    <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="ConfirmAsync" />
}

@code {
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    private async Task ConfirmAsync(LocationChangingContext context)
    {
        if (Saving || !await JS.InvokeAsync<bool>("confirm", Message))
            context.PreventNavigation();
    }
}
