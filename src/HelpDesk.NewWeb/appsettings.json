{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataProtection": {
    "ApplicationName": "RatelDesk"
  },
  "ApiBaseUrl": "http://127.0.0.1:8222/",
  "LoginUi": {
    "EnvironmentLabel": "Self-hosted"
  },
  "SystemToken": {
    "Issuer": "https://id.example.com/application/o/rateldesk/",
    "Audience": "rateldesk-api"
  },
  "Authentication": {
    "Authentik": {
      "Authority": "https://id.example.com/application/o/rateldesk/",
      "ClientId": "",
      "ResponseType": "code",
      "ApiScope": "rateldesk-api",
      "CallbackPath": "/signin-authentik",
      "SignedOutCallbackPath": "/signout-authentik",
      "SecretStorePath": ""
    },
    "AuthentikAiAgent": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "Audience": "",
      "CallbackPath": "/signin-authentik-ai-agent",
      "SecretStorePath": "",
      "RequiredGroups": [],
      "SessionRoles": []
    }
  },
  "AI": {
    "DefaultEmbeddingModel": "text-embedding-3-small",
    "DefaultEmbeddingDimensions": 1536
  },
  "WebGateway": {
    "Mcp": {
      "Enabled": false,
      "HardDisable": false,
      "AuthenticationMode": "gateway",
      "ActivityTimeout": "00:05:00"
    }
  }
}
