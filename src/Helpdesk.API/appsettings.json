{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Helpdesk": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HelpdeskDb": ""
  },
  "DataProtection": {
    "ApplicationName": "RatelDesk"
  },
  "SystemToken": {
    "Issuer": "https://id.example.com/application/o/rateldesk/",
    "Audience": "rateldesk-api"
  },
  "Authentication": {
    "Authentik": {
      "Authority": "https://id.example.com/application/o/rateldesk/",
      "Audience": "rateldesk-api",
      "RoleMappings": {
        "rateldesk:role:admin": "HelpdeskAdmin",
        "rateldesk:role:technician": "Technician"
      }
    },
    "AuthentikAdmin": {
      "BaseUrl": "https://id.example.com/",
      "ApiToken": "",
      "SecretStorePath": "",
      "InviteFlowId": "",
      "RecoveryEmailStageId": "",
      "CustomerDefaultGroups": [ "rateldesk:role:customer" ]
    },
    "AuthentikAiAgent": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "Audience": "",
      "CallbackPath": "/signin-authentik-ai-agent",
      "SecretStorePath": "",
      "RequiredGroups": [],
      "SessionRoles": []
    }
  },
  "Jwt": {
    "Issuer": "https://id.example.com/application/o/rateldesk/",
    "Audience": "rateldesk-api"
  },
  "AzureAd": {
    "TenantId": "",
    "ClientId": "",
    "AppIdUri": ""
  },
  "EmailIngestion": {
    "IntervalSeconds": 60
  },
  "ExchangeEmail": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "MailboxAddress": ""
  },
  "AI": {
    "DefaultEmbeddingModel": "text-embedding-3-small",
    "DefaultEmbeddingDimensions": 1536
  },
  "PublicWebAppUrl": "https://helpdesk.example.com/",
  "EmailBrand": {
    "BrandName": "RatelDesk",
    "PrimaryColor": "#176f6a",
    "LogoPath": "",
    "FromName": "RatelDesk",
    "FooterHtml": "<div><strong>RatelDesk</strong><br />This message was sent by your service desk.</div>"
  },
  "StorageOptions": {
    "RootPath": "storage",
    "PublicApiBaseUrl": "",
    "ImageSigningSecret": ""
  },
  "Hangfire": {
    "Enabled": false,
    "SlaEvaluationEnabled": false,
    "ConnectionStringName": "HelpdeskDb",
    "QueueName": "default",
    "SlaEvaluationCron": "*/10 * * * *",
    "BatchSize": 500
  },
  "SlaReporting": {
    "NearBreachCandidateLimit": 500
  },
  "Orchestration": {
    "Provider": {
      "Enabled": false,
      "ProviderName": "Example external orchestration provider",
      "BaseUrl": "",
      "Authority": "",
      "Audience": "external-orchestration-api",
      "Scope": "external-orchestration-api",
      "TokenEndpoint": "",
      "ClientId": "",
      "ClientSecret": "",
      "HealthPath": "/api/v1/health",
      "IngestPath": "/api/v1/orchestration/ingest",
      "CatalogPath": "/api/v1/orchestration/catalog",
      "AllowedCallerClientIds": []
    }
  },
  "M2M": {
    "ClientId": "rateldesk-api",
    "ClientSecret": ""
  }
